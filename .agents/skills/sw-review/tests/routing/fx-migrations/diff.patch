+<?php declare(strict_types=1);
+
+namespace Shopwell\Core\Migration\V6_7;
+
+use Doctrine\DBAL\Connection;
+use Shopwell\Core\Framework\Log\Package;
+use Shopwell\Core\Framework\Migration\MigrationStep;
+use Shopwell\Core\Framework\Util\Database\TableHelper;
+
+/**
+ * Copies the `locked` flag into `is_system` and removes the old column.
+ *
+ * @internal
+ */
+#[Package('inventory')]
+class Migration1791537318RemoveLockedFromProductSorting extends MigrationStep
+{
+    public function getCreationTimestamp(): int
+    {
+        return 1791537318;
+    }
+
+    public function update(Connection $connection): void
+    {
+        if (TableHelper::columnExists($connection, 'product_sorting', 'locked')) {
+            $connection->executeStatement('UPDATE `product_sorting` SET `is_system` = `locked`');
+            $connection->executeStatement('ALTER TABLE `product_sorting` DROP COLUMN `locked`');
+        }
+    }
+}
