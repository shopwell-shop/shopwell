{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://shopwell.com/approval-flow/publication/1.0.0/artifact-manifest.schema.json",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "formatVersion",
        "artifacts",
        "services"
    ],
    "properties": {
        "formatVersion": {
            "const": "1.0.0"
        },
        "artifacts": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "id",
                    "version",
                    "file",
                    "sha256",
                    "requires"
                ],
                "properties": {
                    "id": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_-]*:[a-z][a-zA-Z0-9_-]*$"
                    },
                    "version": {
                        "type": "string",
                        "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
                    },
                    "file": {
                        "type": "string",
                        "pattern": "^[a-zA-Z0-9_.-]+(?:/[a-zA-Z0-9_.-]+)*$"
                    },
                    "sha256": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                    },
                    "requires": {
                        "type": "array",
                        "uniqueItems": true,
                        "items": {
                            "type": "string",
                            "pattern": "^[a-z][a-z0-9_-]*:[a-z][a-zA-Z0-9_-]*@(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
                        }
                    }
                }
            }
        },
        "services": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "class",
                    "artifact"
                ],
                "properties": {
                    "class": {
                        "type": "string",
                        "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\\\[A-Za-z_][A-Za-z0-9_]*)*$"
                    },
                    "artifact": {
                        "type": "string",
                        "minLength": 1
                    }
                }
            }
        }
    }
}
