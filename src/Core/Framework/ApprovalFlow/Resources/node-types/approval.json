{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "$id": "urn:shopwell:approval-flow:node:approval:1.0.0",
    "properties": {
        "assignees": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                    "kind": {
                        "const": "core:users"
                    },
                    "userIds": {
                        "type": "array",
                        "minItems": 1,
                        "uniqueItems": true,
                        "items": {
                            "type": "string",
                            "minLength": 1
                        }
                    }
                },
                "required": [
                    "kind",
                    "userIds"
                ]
            }
        },
        "policy": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "kind": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_-]*:[a-z][a-zA-Z0-9_-]*$"
                },
                "reject": {
                    "const": "veto"
                },
                "version": {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
                }
            },
            "required": [
                "kind",
                "reject"
            ]
        },
        "fields": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                    "field": {
                        "type": "string",
                        "pattern": "^form\\..+"
                    },
                    "access": {
                        "enum": [
                            "hidden",
                            "readOnly",
                            "editable"
                        ]
                    },
                    "required": {
                        "type": "boolean"
                    },
                    "when": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                            "language": {
                                "const": "core:expr"
                            },
                            "languageVersion": {
                                "type": "string",
                                "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
                            },
                            "text": {
                                "type": "string"
                            },
                            "fieldRefs": {
                                "type": "array",
                                "items": {
                                    "type": "string",
                                    "pattern": "^form\\..+"
                                }
                            },
                            "context": {
                                "const": "requestSnapshot"
                            }
                        },
                        "required": [
                            "language",
                            "languageVersion",
                            "text",
                            "fieldRefs",
                            "context"
                        ]
                    }
                },
                "required": [
                    "field",
                    "access",
                    "required"
                ]
            }
        },
        "emptyAssignees": {
            "enum": [
                "incident",
                "skip"
            ]
        }
    },
    "required": [
        "assignees",
        "policy",
        "fields",
        "emptyAssignees"
    ]
}
