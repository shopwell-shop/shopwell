{
    "paths": {
        "/_action/approval-flow/instances/{instanceId}/tasks/{taskId}/decide": {
            "post": {
                "summary": "Submit a personal approval decision",
                "description": "Only the active assigned Administration user may decide a pending task. Retry an uncertain response using the identical command ID, expected version, outcome and reason. A successful receipt records one opinion and does not imply that the instance has completed.",
                "operationId": "decideApprovalTask",
                "tags": [
                    "Approval Flow"
                ],
                "parameters": [
                    {
                        "name": "instanceId",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "pattern": "^[0-9a-fA-F]{32}$"
                        }
                    },
                    {
                        "name": "taskId",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "pattern": "^[0-9a-fA-F]{32}$"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/ApprovalDecisionRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Committed opinion receipt, including an identical replay after later progression.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApprovalDecisionReceipt"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Malformed input"
                    },
                    "401": {
                        "description": "Authentication required"
                    },
                    "403": {
                        "description": "Decision privilege or active personal task assignment required"
                    },
                    "404": {
                        "description": "Instance or task not found"
                    },
                    "409": {
                        "description": "Version, task state or command identity conflict"
                    }
                }
            }
        },
        "/_action/approval-flow/instances/{instanceId}/tasks/{taskId}/return-targets": {
            "get": {
                "summary": "List available return targets for a pending approval task",
                "description": "Only the active assignee may list targets. A target is an approved execution on the active review path in the same branch and scope generation.",
                "operationId": "listApprovalReturnTargets",
                "tags": [
                    "Approval Flow"
                ],
                "parameters": [
                    {
                        "name": "instanceId",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "pattern": "^[0-9a-fA-F]{32}$"
                        }
                    },
                    {
                        "name": "taskId",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "pattern": "^[0-9a-fA-F]{32}$"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Available return targets.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "additionalProperties": false,
                                    "required": [
                                        "data"
                                    ],
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "type": "object",
                                                "additionalProperties": false,
                                                "required": [
                                                    "executionId",
                                                    "nodeId",
                                                    "sequence"
                                                ],
                                                "properties": {
                                                    "executionId": {
                                                        "type": "string",
                                                        "pattern": "^[0-9a-fA-F]{32}$"
                                                    },
                                                    "nodeId": {
                                                        "type": "string"
                                                    },
                                                    "sequence": {
                                                        "type": "integer",
                                                        "minimum": 1
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Malformed input"
                    },
                    "401": {
                        "description": "Authentication required"
                    },
                    "403": {
                        "description": "Decision privilege or active personal task assignment required"
                    },
                    "404": {
                        "description": "Instance or task not found"
                    },
                    "409": {
                        "description": "Version, task state or command identity conflict"
                    }
                }
            }
        },
        "/_action/approval-flow/instances/{instanceId}/tasks/{taskId}/return": {
            "post": {
                "summary": "Return a pending approval task to an earlier review",
                "description": "Closes the current approval group and opens a fresh review at the selected historical target. Retry an uncertain response with the identical command ID, expected version, target and reason.",
                "operationId": "returnApprovalTask",
                "tags": [
                    "Approval Flow"
                ],
                "parameters": [
                    {
                        "name": "instanceId",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "pattern": "^[0-9a-fA-F]{32}$"
                        }
                    },
                    {
                        "name": "taskId",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "pattern": "^[0-9a-fA-F]{32}$"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/ApprovalReturnRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Committed return receipt.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApprovalDecisionReceipt"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Malformed input"
                    },
                    "401": {
                        "description": "Authentication required"
                    },
                    "403": {
                        "description": "Decision privilege or active personal task assignment required"
                    },
                    "404": {
                        "description": "Instance or task not found"
                    },
                    "409": {
                        "description": "Version, task state, return target or command identity conflict"
                    }
                }
            }
        },
        "/_action/approval-flow/instances/{instanceId}/tasks/{taskId}/transfer-candidates": {
            "get": {
                "summary": "Find eligible reviewers for a pending approval task",
                "description": "The active assignee can search for up to 20 reviewers by name for transfer or preliminary approval.",
                "operationId": "listApprovalTransferCandidates",
                "tags": [
                    "Approval Flow"
                ],
                "parameters": [
                    {
                        "name": "instanceId",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "pattern": "^[0-9a-fA-F]{32}$"
                        }
                    },
                    {
                        "name": "taskId",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "pattern": "^[0-9a-fA-F]{32}$"
                        }
                    },
                    {
                        "name": "term",
                        "in": "query",
                        "schema": {
                            "type": "string",
                            "default": ""
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Eligible reviewers.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "additionalProperties": false,
                                    "required": [
                                        "data"
                                    ],
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "type": "object",
                                                "additionalProperties": false,
                                                "required": [
                                                    "id",
                                                    "name"
                                                ],
                                                "properties": {
                                                    "id": {
                                                        "type": "string",
                                                        "pattern": "^[0-9a-f]{32}$"
                                                    },
                                                    "name": {
                                                        "type": "string"
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Malformed input"
                    },
                    "401": {
                        "description": "Authentication required"
                    },
                    "403": {
                        "description": "Decision privilege or active personal task assignment required"
                    },
                    "404": {
                        "description": "Instance or task not found"
                    },
                    "409": {
                        "description": "Version, task state or command identity conflict"
                    }
                }
            }
        },
        "/_action/approval-flow/instances/{instanceId}/tasks/{taskId}/transfer": {
            "post": {
                "summary": "Transfer a pending approval task to another reviewer",
                "description": "Closes the assigned task and opens its replacement within the same execution. Retry an uncertain response with the identical command ID, expected version, assignee and reason.",
                "operationId": "transferApprovalTask",
                "tags": [
                    "Approval Flow"
                ],
                "parameters": [
                    {
                        "name": "instanceId",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "pattern": "^[0-9a-fA-F]{32}$"
                        }
                    },
                    {
                        "name": "taskId",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "pattern": "^[0-9a-fA-F]{32}$"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/ApprovalTransferRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Committed task transfer receipt.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApprovalDecisionReceipt"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Malformed input"
                    },
                    "401": {
                        "description": "Authentication required"
                    },
                    "403": {
                        "description": "Decision privilege or active personal task assignment required"
                    },
                    "404": {
                        "description": "Instance or task not found"
                    },
                    "409": {
                        "description": "Version, task state, assignee eligibility or command identity conflict"
                    }
                }
            }
        },
        "/_action/approval-flow/instances/{instanceId}/tasks/{taskId}/add-sign": {
            "post": {
                "summary": "Add a preliminary reviewer for a pending approval task",
                "description": "Holds the original task and opens a preliminary review within the same execution. An approval reopens the original task. A rejection vetoes the group.",
                "operationId": "addApprovalTaskReviewer",
                "tags": [
                    "Approval Flow"
                ],
                "parameters": [
                    {
                        "name": "instanceId",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "pattern": "^[0-9a-fA-F]{32}$"
                        }
                    },
                    {
                        "name": "taskId",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "pattern": "^[0-9a-fA-F]{32}$"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/ApprovalTransferRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Committed preliminary review receipt.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApprovalDecisionReceipt"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Malformed input"
                    },
                    "401": {
                        "description": "Authentication required"
                    },
                    "403": {
                        "description": "Decision privilege or active personal task assignment required"
                    },
                    "404": {
                        "description": "Instance or task not found"
                    },
                    "409": {
                        "description": "Version, task state, assignee eligibility or command identity conflict"
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "ApprovalDecisionRequest": {
                "type": "object",
                "required": [
                    "commandId",
                    "expectedVersion",
                    "outcome"
                ],
                "properties": {
                    "commandId": {
                        "type": "string",
                        "pattern": "^[0-9a-fA-F]{32}$"
                    },
                    "expectedVersion": {
                        "type": "integer",
                        "minimum": 1
                    },
                    "outcome": {
                        "type": "string",
                        "enum": [
                            "approved",
                            "rejected"
                        ]
                    },
                    "reason": {
                        "type": "string",
                        "maxLength": 1000,
                        "default": ""
                    }
                }
            },
            "ApprovalDecisionReceipt": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "instanceId",
                    "commandId",
                    "status",
                    "aggregateVersion",
                    "outcome"
                ],
                "properties": {
                    "instanceId": {
                        "type": "string",
                        "pattern": "^[0-9a-fA-F]{32}$"
                    },
                    "commandId": {
                        "type": "string",
                        "pattern": "^[0-9a-fA-F]{32}$"
                    },
                    "status": {
                        "type": "string",
                        "enum": [
                            "running"
                        ]
                    },
                    "aggregateVersion": {
                        "type": "integer",
                        "minimum": 1
                    },
                    "outcome": {
                        "type": "null"
                    }
                }
            },
            "ApprovalReturnRequest": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "commandId",
                    "expectedVersion",
                    "targetExecutionId",
                    "reason"
                ],
                "properties": {
                    "commandId": {
                        "type": "string",
                        "pattern": "^[0-9a-fA-F]{32}$"
                    },
                    "expectedVersion": {
                        "type": "integer",
                        "minimum": 1
                    },
                    "targetExecutionId": {
                        "type": "string",
                        "pattern": "^[0-9a-fA-F]{32}$"
                    },
                    "reason": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1000
                    }
                }
            },
            "ApprovalTransferRequest": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "commandId",
                    "expectedVersion",
                    "assigneeId",
                    "reason"
                ],
                "properties": {
                    "commandId": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{32}$"
                    },
                    "expectedVersion": {
                        "type": "integer",
                        "minimum": 1
                    },
                    "assigneeId": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{32}$"
                    },
                    "reason": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1000
                    }
                }
            }
        }
    }
}
