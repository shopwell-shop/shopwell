{
    "openapi": "3.2.0",
    "info": [],
    "paths": {
        "/_action/payment/methods/{paymentMethodId}/channel": {
            "get": {
                "tags": [
                    "Payment"
                ],
                "operationId": "readPaymentMethodChannel",
                "summary": "Read checkout payment routing choices",
                "description": "Requires payment_method:read. Returns logical method and app choices directly; separate payment-app or provider configuration permissions are unnecessary.",
                "responses": {
                    "200": {
                        "description": "Current payment configuration.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/paymentMethodChannel"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Invalid configuration.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/failure"
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "The administration role lacks permission.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/failure"
                                }
                            }
                        }
                    }
                },
                "parameters": [
                    {
                        "name": "paymentMethodId",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ]
            },
            "put": {
                "tags": [
                    "Payment"
                ],
                "operationId": "savePaymentMethodChannel",
                "summary": "Bind checkout to an app and logical payment method",
                "description": "Requires payment_method:update. Selects the gateway handler and stores the app, logical method and routing policy. Each app/method pair belongs to one checkout method.",
                "responses": {
                    "200": {
                        "description": "Current payment configuration.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/paymentMethodChannel"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Invalid configuration.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/failure"
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "The administration role lacks permission.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/failure"
                                }
                            }
                        }
                    }
                },
                "parameters": [
                    {
                        "name": "paymentMethodId",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "methodTechnicalName": {
                                        "type": "string"
                                    },
                                    "paymentAppId": {
                                        "type": [
                                            "string",
                                            "null"
                                        ]
                                    },
                                    "routingPolicy": {
                                        "type": "string",
                                        "default": "priority"
                                    }
                                },
                                "required": [
                                    "methodTechnicalName"
                                ]
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "paymentMethodChannel": {
                "type": "object",
                "properties": {
                    "binding": {
                        "oneOf": [
                            {
                                "type": "object",
                                "properties": {
                                    "paymentAppId": {
                                        "type": "string"
                                    },
                                    "methodTechnicalName": {
                                        "type": "string"
                                    },
                                    "routingPolicy": {
                                        "type": "string"
                                    }
                                },
                                "required": [
                                    "paymentAppId",
                                    "methodTechnicalName",
                                    "routingPolicy"
                                ]
                            },
                            {
                                "type": "null"
                            }
                        ]
                    },
                    "paymentApp": {
                        "type": "object",
                        "properties": {
                            "id": {
                                "type": "string"
                            },
                            "name": {
                                "type": "string"
                            },
                            "technicalName": {
                                "type": "string"
                            },
                            "type": {
                                "type": "string",
                                "enum": [
                                    "platform",
                                    "external"
                                ]
                            }
                        },
                        "required": [
                            "id",
                            "technicalName",
                            "type"
                        ]
                    },
                    "collectThroughGateway": {
                        "type": "boolean"
                    },
                    "taken": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "paymentAppId": {
                                    "type": "string"
                                },
                                "paymentAppName": {
                                    "type": "string"
                                },
                                "methodTechnicalName": {
                                    "type": "string"
                                },
                                "paymentMethodId": {
                                    "type": "string"
                                },
                                "paymentMethodName": {
                                    "type": "string"
                                }
                            },
                            "required": [
                                "paymentAppId",
                                "methodTechnicalName",
                                "paymentMethodId"
                            ]
                        }
                    },
                    "apps": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "id": {
                                    "type": "string"
                                },
                                "name": {
                                    "type": "string"
                                },
                                "technicalName": {
                                    "type": "string"
                                },
                                "type": {
                                    "type": "string",
                                    "enum": [
                                        "platform",
                                        "external"
                                    ]
                                },
                                "active": {
                                    "type": "boolean"
                                },
                                "methods": {
                                    "type": "array",
                                    "items": {
                                        "type": "object",
                                        "properties": {
                                            "technicalName": {
                                                "type": "string"
                                            },
                                            "translationKey": {
                                                "type": "string"
                                            }
                                        },
                                        "required": [
                                            "technicalName",
                                            "translationKey"
                                        ]
                                    }
                                }
                            },
                            "required": [
                                "id",
                                "name",
                                "technicalName",
                                "type",
                                "active",
                                "methods"
                            ]
                        }
                    }
                },
                "required": [
                    "binding",
                    "paymentApp",
                    "collectThroughGateway",
                    "taken",
                    "apps"
                ],
                "description": "Checkout binding and minimal selectable app metadata. App methods require enabled product and active account grants with browser redirect or QR interactions. No merchant identities, credentials, account IDs or configuration values are returned."
            }
        }
    }
}
