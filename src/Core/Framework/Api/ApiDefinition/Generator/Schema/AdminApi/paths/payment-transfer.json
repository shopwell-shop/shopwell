                  ],
                  "properties": {
                    "releaseId": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "releaseName": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "revision": {
                      "type": [
                        "integer",
