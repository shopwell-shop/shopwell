                    "detailRoute": {
                      "type": [
                        "object",
                        "null"
                      ],
                      "properties": {
                        "name": {
                          "type": "string"
                        },
                        "params": {
                          "type": "object",
                          "properties": {
                            "id": {
                              "type": "string"
                            }
                          }
                        }
                      }
                    },
                    "canCancel": {
                      "type": "boolean"
                    },
                    "recipientLabel": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "paymentAccountLabel": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "canReapply": {
                      "type": "boolean",
                      "description": "Original initiator may create a fresh request after rejection or cancellation, before any payment attempt."
                    },
                    "previousTransfer": {
                      "type": [
                        "object",
                        "null"
                      ],
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "transferNo": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "id",
