    "/_action/payment/transfers/approvals": {
      "post": {
        "tags": [
          "Payment transfer"
        ],
        "summary": "Read approval summaries for a page of authorized transfers",
        "description": "Requires payment_transfer:read. Read projection only; it never authorizes executing a transfer. Detail links are offered only to workflow participants with workflow_instance:access.",
        "operationId": "readPaymentTransferApprovalSummaries",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "ids"
                ],
                "properties": {
                  "ids": {
                    "type": "array",
                    "maxItems": 100,
                    "items": {
                      "type": "string",
                      "pattern": "^[0-9a-fA-F]{32}$"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Status and current reviewers keyed by transfer ID. Missing runtime summaries are unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "approvals"
                  ],
                  "properties": {
                    "approvals": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "object",
                        "required": [
                          "status",
                          "currentAssignees",
                          "detailRoute"
                        ],
                        "properties": {
                          "status": {
                            "enum": [
                              "not_started",
                              "pending",
                              "approved",
                              "rejected",
                              "canceled",
                              "unavailable"
                            ]
                          },
                          "currentAssignees": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "required": [
                                "id",
                                "name"
                              ],
                              "properties": {
                                "id": {
                                  "type": "string"
                                },
                                "name": {
                                  "type": "string"
                                }
                              }
                            }
                          },
                          "detailRoute": {
                            "type": [
                              "object",
                              "null"
                            ],
                            "properties": {
                              "name": {
                                "type": "string"
                              },
                              "params": {
                                "type": "object",
                                "additionalProperties": {
                                  "type": "string"
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid IDs or more than 100 IDs."
          },
          "403": {
            "description": "Missing payment_transfer:read privilege."
          }
        }
      }
    },
    "/_action/payment/transfers/approval/preview": {
      "post": {
        "tags": [
          "Payment Transfer"
