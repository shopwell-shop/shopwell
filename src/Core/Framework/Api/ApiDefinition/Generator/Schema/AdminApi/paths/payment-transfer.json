                  },
                  "recipientId": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "An existing recipient to book the payout to. When omitted, the identity fields below describe a new recipient."
                  },
                  "identityType": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "The identity type of a new recipient, as the interface declares it."
                  },
                  "identityValue": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "The identity of a new recipient. It is trimmed, never rewritten, because the hash and the ciphertext are derived from exactly this value."
                  },
                  "holderName": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "maxLength": 255,
                    "description": "The name the account is held by."
                  },
                  "bankInfo": {
                    "type": [
                      "object",
                      "null"
                    ],
                    "description": "The bank details a card payout needs, as the interface declares them."
                  },
                  "amount": {
                    "type": "integer",
                    "description": "The amount in the smallest unit of the currency, for example fen for CNY. A decimal amount is refused instead of being rounded.",
                    "minimum": 1,
                    "maximum": 10000000000
                  },
                  "currency": {
                    "type": "string",
                    "description": "The three letter ISO code of the currency. A lower case code is accepted and stored upper case.",
                    "pattern": "^[A-Za-z]{3}$"
                  },
                  "outNo": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "The out number of the payout, which is also its idempotency key.",
                    "pattern": "^[0-9a-zA-Z]{1,30}$"
                  },
                  "note": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "maxLength": 255,
                    "description": "A note that is stored in the metadata of the payout."
                  },
                  "accountId": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "The selected payment account authorized for the application."
                  }
                },
                "required": [
                  "paymentAppId",
                  "provider",
                  "channel",
                  "amount",
                  "currency"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Advisory path or a specific unavailability reason.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "available",
                    "reason",
                    "releaseId",
                    "releaseName",
                    "revision",
                    "steps"
                  ],
                  "properties": {
                    "available": {
                      "type": "boolean"
                    },
                    "reason": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "releaseId": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "releaseName": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "revision": {
                      "type": [
                        "integer",
                        "null"
                      ]
                    },
                    "steps": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "nodeId",
                          "type",
                          "name",
                          "rule",
                          "assignees",
                          "branch"
                        ],
                        "properties": {
                          "nodeId": {
                            "type": "string"
                          },
                          "type": {
                            "type": "string"
                          },
                          "name": {
                            "type": "string"
                          },
                          "rule": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "branch": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "assignees": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "required": [
                                "id",
                                "name"
                              ],
                              "properties": {
                                "id": {
                                  "type": "string"
                                },
                                "name": {
                                  "type": "string"
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Missing transfer creation privilege."
          },
          "422": {
            "description": "Invalid transfer input."
          }
        }
      }
    },
    "/_action/payment/transfers/{id}/reapply": {
      "post": {
        "tags": [
          "Payment transfer"
        ],
        "summary": "Edit and reapply a refused or withdrawn payout",
        "description": "Only the original initiator with payment_transfer:create may reapply a rejected or canceled approval before any payment attempt. Uses the currently configured release and a new outNo, preserving the original request. The new approval snapshot records the authoritative original transfer reference. Retries with the same outNo return the same new transfer.",
        "operationId": "reapplyPaymentTransfer",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "paymentAppId": {
                    "type": "string",
                    "description": "The id of the app the payout is booked in."
                  },
                  "provider": {
                    "type": "string",
                    "description": "The payment interface that pays out."
                  },
                  "channel": {
                    "type": "string",
                    "description": "The channel of the interface the payout is booked for."
                  },
                  "recipientId": {
                    "type": "string",
                    "description": "An existing recipient to book the payout to. When omitted, the identity fields below describe a new recipient."
                  },
                  "identityType": {
                    "type": "string",
                    "description": "The identity type of a new recipient, as the interface declares it."
                  },
                  "identityValue": {
                    "type": "string",
                    "description": "The identity of a new recipient. It is trimmed, never rewritten, because the hash and the ciphertext are derived from exactly this value."
                  },
                  "holderName": {
                    "type": "string",
                    "maxLength": 255,
                    "description": "The name the account is held by."
                  },
                  "bankInfo": {
                    "type": "object",
                    "description": "The bank details a card payout needs, as the interface declares them."
                  },
                  "amount": {
                    "type": "integer",
                    "description": "The amount in the smallest unit of the currency, for example fen for CNY. A decimal amount is refused instead of being rounded.",
                    "minimum": 1,
                    "maximum": 10000000000
                  },
                  "currency": {
                    "type": "string",
                    "description": "The three letter ISO code of the currency. A lower case code is accepted and stored upper case.",
                    "pattern": "^[A-Za-z]{3}$"
                  },
                  "outNo": {
                    "type": "string",
                    "description": "The out number of the payout, which is also its idempotency key.",
                    "pattern": "^[0-9a-zA-Z]{1,30}$"
                  },
                  "note": {
                    "type": "string",
                    "maxLength": 255,
                    "description": "A note that is stored in the metadata of the payout."
                  }
                },
                "required": [
                  "paymentAppId",
                  "provider",
                  "channel",
                  "amount",
                  "currency",
                  "outNo"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The payout was booked.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/paymentTransferResult"
                }
              }
            }
          },
          "200": {
            "description": "The out number is already booked with the same recipient, amount and currency. The answer carries the booked payout with replayed set to true.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/paymentTransferResult"
                }
              }
            }
          },
          "409": {
            "description": "The out number is already taken by a payout with another recipient, amount or currency.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/failure"
                }
              }
            }
          },
          "422": {
            "description": "The payload is invalid, for example when the amount is above the ceiling of a manual payout.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/failure"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Original transfer ID."
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "paymentTransferResult": {
        "type": "object",
        "description": "The answer of a payout call: what the platform knows and the payout as the administration renders it.",
        "properties": {
          "outcome": {
            "type": "string",
            "description": "What the platform learned: accepted, failed, unknown or canceled.",
            "enum": [
              "accepted",
              "failed",
              "unknown",
              "canceled"
            ]
          },
          "transfer": {
            "type": "object",
            "description": "The payout after the call, as the administration renders it."
          },
          "replayed": {
            "type": "boolean",
            "description": "Whether the booking answered a payout that was already booked with this out number."
          },
          "message": {
            "type": "string",
            "description": "A human readable note, present when the platform does not know whether the money moved."
          }
        }
      }
    }
  }
}
