{
  "openapi": "3.2.0",
  "info": [],
  "paths": {
    "/_action/payment/transfers/options": {
      "get": {
        "tags": [
          "Payment transfer"
        ],
        "summary": "Everything the new payout modal renders",
        "description": "Answers the active apps of the shop, their payout capable interfaces, the channels of those interfaces and the identity rules of each interface. The declarations are read on the server because which identity type an interface can pay out to is a property of the interface - a copy in the administration would be a second truth that rots as soon as a provider is added.",
        "operationId": "getPaymentTransferOptions",
        "responses": {
          "200": {
            "description": "The apps, providers, channels and identity types a payout can be booked with.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "The options of the payout modal, grouped by app and provider.",
                  "properties": {
                    "workflowAvailable": {
                      "type": "boolean",
                      "description": "Whether a mandatory compatible approval workflow is configured and executable."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/_action/payment/transfers/recipients": {
      "get": {
        "tags": [
          "Payment transfer"
        ],
        "summary": "List the recipients a payout can be booked to",
        "description": "Answers the payout enabled recipients of one app and one interface. The generic entity route must not be the source of this list: the identity of a recipient is stored encrypted, and this endpoint returns it decrypted and masked while the ciphertext is dropped, so the response never carries an identity value.",
        "operationId": "listPaymentTransferRecipients",
        "parameters": [
          {
            "name": "paymentAppId",
            "in": "query",
            "description": "The id of the app whose recipients are listed.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "provider",
            "in": "query",
            "description": "The payment interface the recipients belong to.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The recipients of the app and interface, newest first, capped at 500 entries.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "recipients": {
                      "type": "array",
                      "description": "The payout enabled recipients, with a masked identity.",
                      "items": {
                        "type": "object",
                        "description": "One recipient. The identity value is masked and the ciphertext is not part of the answer."
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "The app or the provider is missing.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/failure"
                }
              }
            }
          }
        }
      }
    },
    "/_action/payment/transfers": {
      "post": {
        "tags": [
          "Payment transfer"
        ],
        "summary": "Book a payout",
        "description": "Books an immutable financial request and starts its configured published approval workflow atomically. A real administration actor and an available compatible finance workflow are required. No provider is called. Replaying the same business out number returns its existing transfer and approval instance.",
        "operationId": "requestPaymentTransfer",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "paymentAppId": {
                    "type": "string",
                    "description": "The id of the app the payout is booked in."
                  },
                  "provider": {
                    "type": "string",
                    "description": "The payment interface that pays out."
                  },
                  "channel": {
                    "type": "string",
                    "description": "The channel of the interface the payout is booked for."
                  },
                  "recipientId": {
                    "type": "string",
                    "description": "An existing recipient to book the payout to. When omitted, the identity fields below describe a new recipient."
                  },
                  "identityType": {
                    "type": "string",
                    "description": "The identity type of a new recipient, as the interface declares it."
                  },
                  "identityValue": {
                    "type": "string",
                    "description": "The identity of a new recipient. It is trimmed, never rewritten, because the hash and the ciphertext are derived from exactly this value."
                  },
                  "holderName": {
                    "type": "string",
                    "maxLength": 255,
                    "description": "The name the account is held by."
                  },
                  "bankInfo": {
                    "type": "object",
                    "description": "The bank details a card payout needs, as the interface declares them."
                  },
                  "amount": {
                    "type": "integer",
                    "description": "The amount in the smallest unit of the currency, for example fen for CNY. A decimal amount is refused instead of being rounded.",
                    "minimum": 1,
                    "maximum": 10000000000
                  },
                  "currency": {
                    "type": "string",
                    "description": "The three letter ISO code of the currency. A lower case code is accepted and stored upper case.",
                    "pattern": "^[A-Za-z]{3}$"
                  },
                  "outNo": {
                    "type": "string",
                    "description": "The out number of the payout, which is also its idempotency key.",
                    "pattern": "^[0-9a-zA-Z]{1,30}$"
                  },
                  "note": {
                    "type": "string",
                    "maxLength": 255,
                    "description": "A note that is stored in the metadata of the payout."
                  }
                },
                "required": [
                  "paymentAppId",
                  "provider",
                  "channel",
                  "amount",
                  "currency"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The payout was booked.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/paymentTransferResult"
                }
              }
            }
          },
          "200": {
            "description": "The out number is already booked with the same recipient, amount and currency. The answer carries the booked payout with replayed set to true.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/paymentTransferResult"
                }
              }
            }
          },
          "409": {
            "description": "The out number is already taken by a payout with another recipient, amount or currency.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/failure"
                }
              }
            }
          },
          "422": {
            "description": "The payload is invalid, for example when the amount is above the ceiling of a manual payout.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/failure"
                }
              }
            }
          }
        }
      }
    },
    "/_action/payment/transfers/{id}/submit": {
      "post": {
        "tags": [
          "Payment transfer"
        ],
        "summary": "Hand a booked payout to its channel",
        "description": "Manually executes a transfer only after its bound workflow has finally approved the immutable amount, currency, account and recipient snapshot. Approval is checked again under the atomic first-attempt claim. Missing, pending, rejected, canceled or unavailable approval cannot execute. Unknown provider outcomes cannot be submitted again.",
        "operationId": "submitPaymentTransfer",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The id of the payout that is handed to the channel.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The answer of the submission. The outcome is accepted, failed, unknown or canceled.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/paymentTransferResult"
                }
              }
            }
          },
          "400": {
            "description": "The payout provably never left the platform - only then is the standard error envelope used, and nothing was booked.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/failure"
                }
              }
            }
          }
        }
      }
    },
    "/_action/payment/transfers/{id}/cancel": {
      "post": {
        "tags": [
          "Payment transfer"
        ],
        "summary": "Abandon a payout that was never handed to a channel",
        "description": "The reject of the approval flow. The reason is mandatory: a dead row without one can not be told apart from a mistake, and it is the only audit trail a rejection has. Only a payout in the state created can be abandoned - anything else has been submitted, and cancelling it would mean calling the channel.",
        "operationId": "cancelPaymentTransfer",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The id of the payout that is abandoned.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "reason": {
                    "type": "string",
                    "maxLength": 255,
                    "description": "Why the payout is abandoned. It is written to the metadata of the payout."
                  }
                },
                "required": [
                  "reason"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The payout was abandoned. The outcome is canceled.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/paymentTransferResult"
                }
              }
            }
          },
          "400": {
            "description": "The reason is missing or the payout is not in the state created anymore.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/failure"
                }
              }
            }
          }
        }
      }
    },
    "/_action/payment/transfers/workflow": {
      "get": {
        "tags": [
          "Payment transfer"
        ],
        "summary": "Read finance approval configuration and compatible releases",
        "operationId": "getPaymentTransferWorkflow",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "releaseId",
                    "releaseName",
                    "revision",
                    "available",
                    "releases",
                    "reason"
                  ],
                  "properties": {
                    "releaseId": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "releaseName": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "revision": {
                      "type": [
                        "integer",
                        "null"
                      ]
                    },
                    "available": {
                      "type": "boolean"
                    },
                    "releases": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "id",
                          "name",
                          "revision",
                          "available",
                          "reason"
                        ],
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "name": {
                            "type": "string"
                          },
                          "revision": {
                            "type": "integer"
                          },
                          "available": {
                            "type": "boolean"
                          },
                          "reason": {
                            "type": [
                              "string",
                              "null"
                            ]
                          }
                        }
                      }
                    },
                    "reason": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "Machine-readable reason when the configured release is unavailable."
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "Workflow missing, unavailable or incompatible; approval does not authorize this operation."
          }
        }
      },
      "put": {
        "tags": [
          "Payment transfer"
        ],
        "summary": "Select the mandatory finance approval release",
        "operationId": "configurePaymentTransferWorkflow",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "releaseId",
                    "releaseName",
                    "revision",
                    "available",
                    "releases",
                    "reason"
                  ],
                  "properties": {
                    "releaseId": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "releaseName": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "revision": {
                      "type": [
                        "integer",
                        "null"
                      ]
                    },
                    "available": {
                      "type": "boolean"
                    },
                    "releases": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "id",
                          "name",
                          "revision",
                          "available",
                          "reason"
                        ],
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "name": {
                            "type": "string"
                          },
                          "revision": {
                            "type": "integer"
                          },
                          "available": {
                            "type": "boolean"
                          },
                          "reason": {
                            "type": [
                              "string",
                              "null"
                            ]
                          }
                        }
                      }
                    },
                    "reason": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "Machine-readable reason when the configured release is unavailable."
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "Workflow missing, unavailable or incompatible; approval does not authorize this operation."
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "releaseId"
                ],
                "properties": {
                  "releaseId": {
                    "type": "string",
                    "format": "uuid"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/_action/payment/transfers/{id}/approval": {
      "get": {
        "tags": [
          "Payment transfer"
        ],
        "summary": "Read authoritative approval status without executing payment",
        "operationId": "getPaymentTransferApproval",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "releaseId",
                    "releaseName",
                    "revision",
                    "status",
                    "instanceId",
                    "detailRoute",
                    "canCancel",
                    "recipientLabel",
                    "paymentAccountLabel",
                    "canReapply",
