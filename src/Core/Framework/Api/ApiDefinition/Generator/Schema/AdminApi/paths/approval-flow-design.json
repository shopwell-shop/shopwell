{
    "paths": {
        "/_action/approval-flow/design/catalog": {
            "get": {
                "operationId": "approvalDefinitionCatalog",
                "summary": "Read exact registered design declarations",
                "description": "Requires approval_flow_definition:read. This read does not grant editing, publication, business activation or execution authority.",
                "tags": [
                    "Approval Flow"
                ],
                "responses": {
                    "200": {
                        "description": "Design projection",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApprovalDesignCatalog"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Invalid read parameters"
                    },
                    "401": {
                        "description": "Authentication required"
                    },
                    "403": {
                        "description": "Definition read privilege required"
                    },
                    "404": {
                        "description": "Definition not found"
                    }
                }
            }
        },
        "/_action/approval-flow/design/diagnose": {
            "post": {
                "operationId": "approvalDesignDiagnose",
                "summary": "Diagnose a draft graph without persisting changes",
                "tags": [
                    "Approval Flow"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": [
                                    "graphJson"
                                ],
                                "properties": {
                                    "graphJson": {
                                        "type": "string"
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Located graph diagnostics",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/ApprovalGraphDiagnostic"
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Invalid payload"
                    },
                    "401": {
                        "description": "Authentication required"
                    },
                    "403": {
                        "description": "Definition read privilege required"
                    }
                }
            }
        },
        "/_action/approval-flow/design/drafts": {
            "post": {
                "operationId": "approvalDesignCreateDraft",
                "summary": "Create an approval definition and draft",
                "tags": [
                    "Approval Flow"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": [
                                    "name",
                                    "graphJson"
                                ],
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "maxLength": 255
                                    },
                                    "graphJson": {
                                        "type": "string"
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Saved draft",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApprovalDesignDraft"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Invalid name, revision or graph"
                    },
                    "401": {
                        "description": "Authentication required"
                    },
                    "403": {
                        "description": "Draft write privileges required"
                    }
                }
            }
        },
        "/_action/approval-flow/design/drafts/{definitionId}": {
            "patch": {
                "operationId": "approvalDesignSaveDraft",
                "summary": "Save the graph at the expected draft revision",
                "tags": [
                    "Approval Flow"
                ],
                "parameters": [
                    {
                        "name": "definitionId",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "pattern": "^[0-9a-f]{32}$"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": [
                                    "expectedRevision",
                                    "graphJson"
                                ],
                                "properties": {
                                    "expectedRevision": {
                                        "type": "integer",
                                        "minimum": 1
                                    },
                                    "graphJson": {
                                        "type": "string"
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Saved draft",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ApprovalDesignDraft"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Invalid name, revision or graph"
                    },
                    "401": {
                        "description": "Authentication required"
                    },
                    "403": {
                        "description": "Draft write privileges required"
                    },
                    "404": {
                        "description": "Draft not found"
                    },
                    "409": {
                        "description": "Draft revision conflict"
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "ApprovalDesignNodeType": {
                "type": "object",
                "required": [
                    "key",
                    "type",
                    "version",
                    "labelSnippet",
                    "configurationSchema",
                    "configurationSchemaId",
                    "configurationSchemaHash",
                    "draftConfigurationSchema",
                    "ports",
                    "allowedEffects"
                ],
                "properties": {
                    "key": {
                        "type": "string"
                    },
                    "type": {
                        "type": "string"
                    },
                    "version": {
                        "type": "string"
                    },
                    "labelSnippet": {
                        "type": "string"
                    },
                    "configurationSchema": {
                        "type": "string"
                    },
                    "configurationSchemaId": {
                        "type": "string"
                    },
                    "configurationSchemaHash": {
                        "type": "string"
                    },
                    "draftConfigurationSchema": {
                        "type": "string"
                    },
                    "ports": {
                        "type": "object",
                        "additionalProperties": {
                            "type": "string",
                            "enum": [
                                "input",
                                "output"
                            ]
                        }
                    },
                    "allowedEffects": {
                        "type": "array",
                        "items": {
                            "type": "string",
                            "enum": [
                                "advance",
                                "requestApproval",
                                "complete",
                                "openScope",
                                "wait"
                            ]
                        }
                    }
                }
            },
            "ApprovalDesignBusinessType": {
                "type": "object",
                "required": [
                    "key",
                    "type",
                    "version",
                    "labelSnippet",
                    "formSchema",
                    "formSchemaId",
                    "formSchemaHash"
                ],
                "properties": {
                    "key": {
                        "type": "string"
                    },
                    "type": {
                        "type": "string"
                    },
                    "version": {
                        "type": "string"
                    },
                    "labelSnippet": {
                        "type": "string"
                    },
                    "formSchema": {
                        "type": "string"
                    },
                    "formSchemaId": {
                        "type": "string"
                    },
                    "formSchemaHash": {
                        "type": "string"
                    }
                }
            },
            "ApprovalDesignCatalog": {
                "type": "object",
                "required": [
                    "graphSchema",
                    "nodeTypes",
                    "businessTypes"
                ],
                "properties": {
                    "graphSchema": {
                        "type": "string"
                    },
                    "nodeTypes": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/ApprovalDesignNodeType"
                        }
                    },
                    "businessTypes": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/ApprovalDesignBusinessType"
                        }
                    }
                }
            },
            "ApprovalGraphDiagnostic": {
                "type": "object",
                "required": [
                    "category",
                    "code",
                    "path",
                    "message"
                ],
                "properties": {
                    "category": {
                        "type": "string",
                        "enum": [
                            "structure",
                            "draft",
                            "capability"
                        ]
                    },
                    "code": {
                        "type": "string"
                    },
                    "path": {
                        "type": "string"
                    },
                    "message": {
                        "type": "string"
                    }
                }
            },
            "ApprovalDesignDraft": {
                "type": "object",
                "required": [
                    "definitionId",
                    "revision",
                    "graphJson",
                    "diagnostics"
                ],
                "properties": {
                    "definitionId": {
                        "type": "string"
                    },
                    "revision": {
                        "type": "integer",
                        "minimum": 1
                    },
                    "graphJson": {
                        "type": "string"
                    },
                    "diagnostics": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/ApprovalGraphDiagnostic"
                        }
                    }
                }
            }
        }
    }
}
