        ],
        "operationId": "listPaymentDefinitions",
        "summary": "Read provider and product field declarations",
        "description": "Requires payment_app:read. Returns registered definitions with no stored credentials, account values or admission state. Use this catalog to render app account forms.",
        "responses": {
          "200": {
            "description": "Current payment configuration.",
