{
  "openapi": "3.2.0",
  "info": [],
  "paths": {
    "/_action/payment/apps": {
      "get": {
        "tags": [
          "Payment"
        ],
        "operationId": "listPaymentApps",
        "summary": "List payment apps and explicit account grants",
        "description": "Requires payment_app:read. Lists apps with grant-only account references and all selectable central account choices. Merchant credentials, product parameters, and account settings are never returned.",
        "responses": {
          "200": {
            "description": "Current payment configuration.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "apps": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/paymentAppConfiguration"
                      }
                    },
                    "accounts": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/paymentAccountChoice"
                      }
                    }
                  },
                  "required": [
                    "apps",
                    "accounts"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid configuration.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/failure"
                }
              }
            }
          },
          "403": {
            "description": "The administration role lacks permission.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/failure"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Payment"
        ],
        "operationId": "savePaymentApp",
        "summary": "Create or update a payment app",
        "description": "Requires payment_app:update. Stores app authentication and account/product grants. Existing central accounts must be created or edited through the independent account API.",
        "responses": {
          "200": {
            "description": "Current payment configuration.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "app": {
                      "$ref": "#/components/schemas/paymentAppConfiguration"
                    },
                    "appSecret": {
                      "type": "string"
                    },
                    "secretGenerated": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "app"
                  ],
                  "description": "The plain appSecret and secretGenerated are returned only when a secret was created or rotated."
                }
              }
            }
          },
          "400": {
            "description": "Invalid configuration.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/failure"
                }
              }
            }
          },
          "403": {
            "description": "The administration role lacks permission.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/failure"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/paymentAppWrite"
              }
            }
          }
        }
      }
    },
    "/_action/payment/apps/{id}": {
      "delete": {
        "tags": [
          "Payment"
        ],
        "operationId": "deletePaymentApp",
        "summary": "Delete an external payment app",
        "description": "Requires payment_app:delete. The platform app cannot be deleted. Merchant accounts retained by payment history cannot be reassigned.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "App deleted."
          },
          "400": {
            "description": "The platform app cannot be deleted.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/failure"
                }
              }
            }
          }
        }
      }
    },
