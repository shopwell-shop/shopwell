                  },
                  "settings": {
                    "type": "object",
                    "additionalProperties": {}
                  }
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Payment"
        ],
        "operationId": "resetPaymentProviderChannel",
        "summary": "Disable platform product admission",
        "description": "Requires payment_channel_config:delete. Historical attempt parameters and account keys remain available.",
        "responses": {
          "200": {
            "description": "Current payment configuration.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
