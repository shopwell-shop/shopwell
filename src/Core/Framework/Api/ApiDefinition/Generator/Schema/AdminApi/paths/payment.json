          "200": {
            "description": "Read a central payment account.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "account": {
                      "$ref": "#/components/schemas/paymentAccount"
                    }
                  },
                  "required": [
