          },
          "403": {
            "description": "The administration role lacks permission.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/failure"
                }
              }
            }
          }
        }
      }
    },
    "/_action/payment/providers/{provider}": {
      "post": {
        "tags": [
          "Payment"
        ],
        "operationId": "savePaymentProvider",
        "summary": "Save a platform merchant account",
        "description": "Requires payment_provider_config:update. Empty secret fields retain current keys. Enabling admission requires complete declared credentials.",
        "responses": {
          "200": {
            "description": "Current payment configuration.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "provider": {
                      "$ref": "#/components/schemas/paymentProviderConfiguration"
                    }
                  },
                  "required": [
                    "provider"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid configuration.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/failure"
                }
              }
            }
          },
          "403": {
            "description": "The administration role lacks permission.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/failure"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "provider",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "enabled": {
                    "type": "boolean"
                  },
                  "credentials": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    }
                  },
                  "settings": {
                    "type": "object",
                    "additionalProperties": {}
                  }
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Payment"
        ],
        "operationId": "resetPaymentProvider",
        "summary": "Disable platform provider admission",
        "description": "Requires payment_provider_config:delete. Retains the account identity and keys for historical attempts.",
        "responses": {
          "200": {
            "description": "Current payment configuration.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "provider": {
                      "$ref": "#/components/schemas/paymentProviderConfiguration"
                    }
                  },
                  "required": [
                    "provider"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid configuration.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/failure"
                }
              }
            }
          },
          "403": {
            "description": "The administration role lacks permission.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/failure"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "provider",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
