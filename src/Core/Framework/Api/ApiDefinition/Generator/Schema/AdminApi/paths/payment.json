  "components": {
    "schemas": {
      "paymentConfigurationField": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "label": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "additionalProperties": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "type": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "secret": {
            "type": "boolean"
          },
          "options": {
            "type": "object",
            "additionalProperties": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "object",
                  "additionalProperties": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              ]
            }
          },
          "default": {
            "type": [
              "string",
              "null"
            ]
          },
          "helpText": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "additionalProperties": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "value": {
            "type": [
              "string",
              "null"
            ]
          },
          "configured": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "type",
          "required",
          "secret"
        ],
        "description": "Field declaration. Stored secret values are null; configured reports whether a value exists."
      },
      "paymentAppProductGrant": {
        "type": "object",
        "properties": {
          "channelTechnicalName": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          },
          "settings": {
            "type": "object",
            "additionalProperties": {}
          }
        },
        "required": [
          "channelTechnicalName"
        ]
      },
      "paymentAppAccountWrite": {
        "type": "object",
        "properties": {
          "accountId": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          },
          "position": {
            "type": "integer"
          }
        },
        "required": [
          "accountId"
        ],
        "additionalProperties": false,
        "description": "Grant an existing central account. Apps may change only the grant, priority, and enabled state."
      },
      "paymentAppAccount": {
        "type": "object",
        "properties": {
          "accountId": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          },
          "position": {
            "type": "integer"
          }
        },
        "required": [
          "accountId",
          "enabled",
          "position"
        ],
        "additionalProperties": false,
        "description": "Grant an existing central account. Apps may change only the grant, priority, and enabled state."
      },
      "paymentAppConfiguration": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "technicalName": {
            "type": "string"
