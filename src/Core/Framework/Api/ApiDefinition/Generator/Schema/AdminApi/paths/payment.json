              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "providers": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/paymentProviderConfiguration"
                      }
                    }
                  },
                  "required": [
                    "providers"
                  ]
