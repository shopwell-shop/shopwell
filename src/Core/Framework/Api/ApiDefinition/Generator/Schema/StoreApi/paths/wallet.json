{
    "openapi": "3.2.0",
    "info": [],
    "paths": {
        "/wallet": {
            "get": {
                "tags": [
                    "Wallet"
                ],
                "summary": "Fetch the wallet of the customer",
                "description": "Returns the wallet balances per currency and the paginated wallet transaction history of the authenticated customer.",
                "operationId": "readWallet",
                "parameters": [
                    {
                        "name": "page",
                        "in": "query",
                        "description": "The page of the wallet transaction history to read.",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "minimum": 1
                        }
                    },
                    {
                        "name": "limit",
                        "in": "query",
                        "description": "The number of wallet transactions per page.",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 100
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "The wallet balances and transactions of the customer.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "wallets": {
                                            "type": "array",
                                            "description": "The wallet balances of the customer per currency.",
                                            "items": {
                                                "type": "object",
                                                "properties": {
                                                    "currencyId": {
                                                        "type": "string"
                                                    },
                                                    "balance": {
                                                        "type": "number"
                                                    },
                                                    "lockedBalance": {
                                                        "type": [
                                                            "number",
                                                            "null"
                                                        ]
                                                    }
                                                }
                                            }
                                        },
                                        "transactions": {
                                            "type": "array",
                                            "description": "The wallet transactions of the customer, newest first.",
                                            "items": {
                                                "type": "object",
                                                "properties": {
                                                    "id": {
                                                        "type": "string"
                                                    },
                                                    "type": {
                                                        "type": "string"
                                                    },
                                                    "amount": {
                                                        "type": "number"
                                                    },
                                                    "balanceAfter": {
                                                        "type": "number"
                                                    },
                                                    "currencyId": {
                                                        "type": [
                                                            "string",
                                                            "null"
                                                        ]
                                                    },
                                                    "orderId": {
                                                        "type": [
                                                            "string",
                                                            "null"
                                                        ]
                                                    },
                                                    "externalReference": {
                                                        "type": [
                                                            "string",
                                                            "null"
                                                        ]
                                                    },
                                                    "comment": {
                                                        "type": [
                                                            "string",
                                                            "null"
                                                        ]
                                                    },
                                                    "createdAt": {
                                                        "type": [
                                                            "string",
                                                            "null"
                                                        ]
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "The customer wallet is disabled.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/failure"
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/401",
                        "description": "The customer is not logged in."
                    }
                },
                "security": [
                    {
                        "ApiKey": []
                    }
                ]
            }
        },
        "/wallet/payment": {
            "post": {
                "tags": [
                    "Wallet"
                ],
                "summary": "Pay part of the current cart with the wallet balance",
                "description": "Stores the amount the customer wants to pay from the wallet balance for the current cart and returns the recalculated cart. The amount is applied as a discount on the next cart calculation.",
                "operationId": "payWithWallet",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "amount": {
                                        "type": "number",
                                        "description": "The amount to pay from the wallet balance. Use 0 to remove a previous wallet payment."
                                    }
                                },
                                "required": [
                                    "amount"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "The recalculated cart.",
                        "headers": {
                            "sw-context-token": {
                                "description": "Contains sw-context-token value",
                                "required": true,
                                "schema": {
                                    "type": "string"
                                }
                            }
                        },
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Cart"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "The wallet is disabled or the requested amount is invalid.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/failure"
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/401",
                        "description": "The customer is not logged in."
                    }
                },
                "security": [
                    {
                        "ApiKey": []
                    }
                ]
            }
        }
    }
}
