{
    "openapi": "3.2.0",
    "info": [],
    "paths": {
        "/loyalty": {
            "get": {
                "tags": [
                    "Loyalty"
                ],
                "summary": "Fetch the loyalty summary of the customer",
                "description": "Returns the points balance, tier points, current membership tier, the redemption settings and the available membership tiers of the authenticated customer.",
                "operationId": "readLoyalty",
                "responses": {
                    "200": {
                        "description": "The loyalty summary of the customer.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "pointsBalance": {
                                            "type": "integer",
                                            "description": "The currently available points balance."
                                        },
                                        "tierPoints": {
                                            "type": "integer",
                                            "description": "The accumulated tier points."
                                        },
                                        "tierId": {
                                            "type": [
                                                "string",
                                                "null"
                                            ],
                                            "description": "The id of the membership tier the customer currently belongs to."
                                        },
                                        "membershipPaidUntil": {
                                            "type": [
                                                "string",
                                                "null"
                                            ],
                                            "description": "The date until which the current membership is valid."
                                        },
                                        "pointValueInCurrency": {
                                            "type": "number",
                                            "description": "The amount a single point is worth when redeeming points."
                                        },
                                        "minRedeemablePoints": {
                                            "type": "integer",
                                            "description": "The minimum number of points that must be redeemed in a single order."
                                        },
                                        "maxRedeemablePercent": {
                                            "type": "number",
                                            "description": "The maximum share of the order total that may be paid with points."
                                        },
                                        "tiers": {
                                            "type": "array",
                                            "description": "The available membership tiers ordered by level.",
                                            "items": {
                                                "type": "object",
                                                "properties": {
                                                    "id": {
                                                        "type": "string"
                                                    },
                                                    "technicalName": {
                                                        "type": "string"
                                                    },
                                                    "name": {
                                                        "type": [
                                                            "string",
                                                            "null"
                                                        ]
                                                    },
                                                    "level": {
                                                        "type": "integer"
                                                    },
                                                    "minTierPoints": {
                                                        "type": [
                                                            "integer",
                                                            "null"
                                                        ]
                                                    },
                                                    "benefits": {
                                                        "type": "object",
                                                        "description": "What the tier grants, keyed by benefit type (earn_multiplier, cart_discount, free_shipping, birthday_gift, points_expiry_days). A type that is absent grants nothing.",
                                                        "additionalProperties": {
                                                            "type": "number"
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "The loyalty program is disabled.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/failure"
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/401",
                        "description": "The customer is not logged in."
                    }
                },
                "security": [
                    {
                        "ApiKey": []
                    }
                ]
            }
        },
        "/loyalty/redeem-points": {
            "post": {
                "tags": [
                    "Loyalty"
                ],
                "summary": "Redeem loyalty points for the current cart",
                "description": "Stores the number of points the customer wants to redeem for the current cart and returns the recalculated cart. The points are applied as a discount on the next cart calculation.",
                "operationId": "redeemLoyaltyPoints",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "points": {
                                        "type": "integer",
                                        "description": "The number of points to redeem. Use 0 to remove a previous redemption."
                                    }
                                },
                                "required": [
                                    "points"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "The recalculated cart.",
                        "headers": {
                            "sw-context-token": {
                                "description": "Contains sw-context-token value",
                                "required": true,
                                "schema": {
                                    "type": "string"
                                }
                            }
                        },
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Cart"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "The loyalty program is disabled or the requested points are invalid.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/failure"
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/401",
                        "description": "The customer is not logged in."
                    }
                },
                "security": [
                    {
                        "ApiKey": []
                    }
                ]
            }
        },
        "/membership/purchase": {
            "post": {
                "tags": [
                    "Loyalty"
                ],
                "summary": "Buy a membership plan and open the payment for it",
                "description": "Creates a membership purchase and selects an eligible payment product for the chosen payment method and the browser scene. Membership activates after payment is confirmed.",
                "operationId": "purchaseMembership",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "planId": {
                                        "type": "string",
                                        "description": "The id of the membership plan to buy. The plan has to be purchasable in the currency of the context."
                                    },
                                    "returnUrl": {
                                        "type": "string",
                                        "description": "Where the payer lands after a redirect channel. The account page of the loyalty program is used when this is missing."
                                    },
                                    "method": {
                                        "type": "string",
                                        "description": "The payment method technical name returned by GET /membership, such as alipay or wechat."
                                    }
                                },
                                "required": [
                                    "planId",
                                    "method"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "The created membership order and the payment data of the channel.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "id": {
                                            "type": "string",
                                            "description": "The id of the membership order."
                                        },
                                        "amount": {
                                            "type": "number",
                                            "description": "The price of the plan, in the currency of the order."
                                        },
                                        "currency": {
                                            "type": "string",
                                            "description": "The iso code of the currency of the order."
                                        },
                                        "payment_no": {
                                            "type": "string",
                                            "description": "The payment number of the channel."
                                        },
                                        "channel": {
                                            "type": "string",
                                            "description": "The actual payment product selected by the server."
                                        },
                                        "params": {
                                            "type": "object",
                                            "additionalProperties": true,
                                            "description": "The data the payer needs to pay, in the form the channel declared it."
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "The plan is not purchasable or the payment method has no eligible product for this payment scene.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/failure"
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/401",
                        "description": "The customer is not logged in."
                    }
                },
                "security": [
                    {
                        "ApiKey": []
                    }
                ]
            }
        },
        "/membership": {
            "get": {
                "tags": [
                    "Loyalty"
                ],
                "summary": "Read membership plans and payment options",
                "description": "Returns purchasable plans, payment methods eligible in the browser scene, recent purchases, and the active subscription.",
                "operationId": "readMembership",
                "responses": {
                    "200": {
                        "description": "The membership offer for the authenticated customer.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "plans": {
                                            "type": "array",
                                            "items": {
                                                "type": "object",
                                                "additionalProperties": true
                                            }
                                        },
                                        "channels": {
                                            "type": "array",
                                            "items": {
                                                "type": "object",
                                                "required": [
                                                    "method",
                                                    "channel",
                                                    "label",
                                                    "flow"
                                                ],
                                                "properties": {
                                                    "method": {
                                                        "type": "string"
                                                    },
                                                    "channel": {
                                                        "type": "string"
                                                    },
                                                    "label": {
                                                        "type": "string"
                                                    },
                                                    "flow": {
                                                        "type": "string"
                                                    }
                                                }
                                            }
                                        },
                                        "orders": {
                                            "type": "array",
                                            "items": {
                                                "type": "object",
                                                "additionalProperties": true
                                            }
                                        },
                                        "subscription": {
                                            "type": [
                                                "object",
                                                "null"
                                            ],
                                            "additionalProperties": true
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/401"
                    }
                }
            }
        }
    }
}
