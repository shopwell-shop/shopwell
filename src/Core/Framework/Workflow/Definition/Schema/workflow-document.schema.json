{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Experimental Workflow document v1",
    "description": "Control flow definition only. View state and execution state are separate. Structural validity does not imply publishability or executable support.",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schemaVersion",
        "nodes",
        "connections",
        "policy"
    ],
    "properties": {
        "schemaVersion": {
            "const": 1,
            "type": "integer"
        },
        "nodes": {
            "type": "array",
            "maxItems": 1000,
            "items": {
                "$ref": "#/$defs/node"
            }
        },
        "connections": {
            "type": "array",
            "maxItems": 5000,
            "items": {
                "$ref": "#/$defs/connection"
            }
        },
        "policy": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*:[a-z][a-z0-9-]*$",
            "maxLength": 255
        }
    },
    "$defs": {
        "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$",
            "maxLength": 128
        },
        "port": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$",
            "maxLength": 128
        },
        "node": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "type",
                "typeVersion",
                "config"
            ],
            "properties": {
                "id": {
                    "$ref": "#/$defs/id"
                },
                "type": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]*:[a-z][a-z0-9-]*$",
                    "maxLength": 255
                },
                "typeVersion": {
                    "type": "integer",
                    "minimum": 1
                },
                "config": {
                    "oneOf": [
                        {
                            "type": "object"
                        },
                        {
                            "type": "array",
                            "maxItems": 0
                        }
                    ],
                    "description": "Opaque node configuration. Empty maps may be serialized as [] by DAL-compatible PHP values."
                }
            }
        },
        "connection": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "source",
                "sourcePort",
                "target",
                "targetPort"
            ],
            "properties": {
                "id": {
                    "$ref": "#/$defs/id"
                },
                "source": {
                    "$ref": "#/$defs/id"
                },
                "sourcePort": {
                    "$ref": "#/$defs/port"
                },
                "target": {
                    "$ref": "#/$defs/id"
                },
                "targetPort": {
                    "$ref": "#/$defs/port"
                }
            }
        }
    }
}
