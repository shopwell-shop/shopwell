rules:
    - Shopwell\Core\DevOps\StaticAnalyze\PHPStan\Rules\McpToolResponseRule
    - Shopwell\Core\DevOps\StaticAnalyze\PHPStan\Rules\ScheduledTaskTooLowIntervalRule
    - Shopwell\Core\DevOps\StaticAnalyze\PHPStan\Rules\RuleAreasFlagNotAllowedRule
    - Shopwell\Core\DevOps\StaticAnalyze\PHPStan\Rules\RuleConditionHasRuleConfigRule
    - Shopwell\Core\DevOps\StaticAnalyze\PHPStan\Rules\NoFlowStoreFunctionRule
    - Shopwell\Core\DevOps\StaticAnalyze\PHPStan\Rules\NoUnserializeUsageRule
    - Shopwell\Core\DevOps\StaticAnalyze\PHPStan\Rules\NoStripTagsRule
    - Shopwell\Core\DevOps\StaticAnalyze\PHPStan\Rules\NoEnvironmentHelperInsideCompilerPassRule
    - Shopwell\Core\DevOps\StaticAnalyze\PHPStan\Rules\NoFileExistsRule
    - Shopwell\Core\DevOps\StaticAnalyze\PHPStan\Rules\NoSuperGlobalsInsideCompilerPassRule
    - Shopwell\Core\DevOps\StaticAnalyze\PHPStan\Rules\NoDALAutoload
    - Shopwell\Core\DevOps\StaticAnalyze\PHPStan\Rules\DALFieldsMustBeRegisteredWithSchemaBuilder
    - Shopwell\Core\DevOps\StaticAnalyze\PHPStan\Rules\RouteScopeRule
    - Shopwell\Core\DevOps\StaticAnalyze\PHPStan\Rules\MessagesShouldNotUsePHPStanTypes
    - Shopwell\Core\DevOps\StaticAnalyze\PHPStan\Rules\UseCLIContextRule
    - Shopwell\Core\DevOps\StaticAnalyze\PHPStan\Rules\NoUnconfiguredMetricAllowed
    - Shopwell\Core\DevOps\StaticAnalyze\PHPStan\Rules\UseHasherRule
    - Shopwell\Core\DevOps\StaticAnalyze\PHPStan\Rules\PropertyNativeTypeRule
    - Shopwell\Core\DevOps\StaticAnalyze\PHPStan\Rules\NoManualSalesChannelContextCreationRule
    - Shopwell\Core\DevOps\StaticAnalyze\PHPStan\Rules\NoDelayStampRule
    - Shopwell\Core\DevOps\StaticAnalyze\PHPStan\Rules\NoAddCacheTagEventRule
    - Shopwell\Core\DevOps\StaticAnalyze\PHPStan\Rules\NoUpdatesInExecuteQueryRule
    - Shopwell\Core\DevOps\StaticAnalyze\PHPStan\Rules\NoUnsafeRequestHasSessionRule
    - Shopwell\Core\DevOps\StaticAnalyze\PHPStan\Rules\NoConstraintViolationGetMessageRule
    - Shopwell\Core\DevOps\StaticAnalyze\PHPStan\Rules\NoLegacySqlHashFunctionRule
    - Shopwell\Core\DevOps\StaticAnalyze\PHPStan\Rules\NoLocaleAwareSprintfFloatRule
    - Shopwell\Core\DevOps\StaticAnalyze\PHPStan\Rules\PublicServiceDecoratorRule
    - Shopwell\Core\DevOps\StaticAnalyze\PHPStan\Rules\NoRouteOverrideInDecoratorsRule
    - Shopwell\Core\DevOps\StaticAnalyze\PHPStan\Rules\Tests\AssertEqualsCanonicalizingListArgumentRule
    - Shopwell\Core\DevOps\StaticAnalyze\PHPStan\Rules\Tests\CoversAttributeRule
    - Shopwell\Core\DevOps\StaticAnalyze\PHPStan\Rules\Tests\DataProviderRowArityRule
    - Shopwell\Core\DevOps\StaticAnalyze\PHPStan\Rules\Tests\MockingSimpleObjectsNotAllowedRule
    - Shopwell\Core\DevOps\StaticAnalyze\PHPStan\Rules\Tests\NoAnyInvocationMatcherRule
    - Shopwell\Core\DevOps\StaticAnalyze\PHPStan\Rules\Tests\NoAssertEqualsOnClosureRule
    - Shopwell\Core\DevOps\StaticAnalyze\PHPStan\Rules\Tests\NoAssertsOnObjectsRule
    - Shopwell\Core\DevOps\StaticAnalyze\PHPStan\Rules\Tests\NoDependsWithDataProviderRule
    - Shopwell\Core\DevOps\StaticAnalyze\PHPStan\Rules\Tests\NoExpectExceptionMessageRule
    - Shopwell\Core\DevOps\StaticAnalyze\PHPStan\Rules\Tests\NoFeatureSkipInUnitTestsRule
    - Shopwell\Core\DevOps\StaticAnalyze\PHPStan\Rules\Tests\NoKernelInUnitTestsRule
    - Shopwell\Core\DevOps\StaticAnalyze\PHPStan\Rules\Tests\NoKernelLifecycleManagerInUnitTestsRule
    - Shopwell\Core\DevOps\StaticAnalyze\PHPStan\Rules\Tests\NoKernelBootInSetUpBeforeClassRule
    - Shopwell\Core\DevOps\StaticAnalyze\PHPStan\Rules\Tests\NoMockBuilderConstructorBypassRule
    - Shopwell\Core\DevOps\StaticAnalyze\PHPStan\Rules\Tests\NoUnreachableAssertionAfterExpectExceptionRule
    - Shopwell\Core\DevOps\StaticAnalyze\PHPStan\Rules\Tests\PHPUnitClassAttributesOverAnnotationsRule
    - Shopwell\Core\DevOps\StaticAnalyze\PHPStan\Rules\Tests\PHPUnitMethodAttributesOverAnnotationsRule
    - Shopwell\Core\DevOps\StaticAnalyze\PHPStan\Rules\NoNativeTimeFunctionRule
    - Shopwell\Core\DevOps\StaticAnalyze\PHPStan\Rules\NoNativeTimeClassRule
    - Shopwell\Core\DevOps\StaticAnalyze\PHPStan\Rules\CodeCoverageIgnoreEvaluationRule

    # rules from https://github.com/symplify/phpstan-rules
    # domain
    - Symplify\PHPStanRules\Rules\Enum\RequireUniqueEnumConstantRule
    - Symplify\PHPStanRules\Rules\PreventParentMethodVisibilityOverrideRule

    # explicit naming
    - Symplify\PHPStanRules\Rules\ForbiddenMultipleClassLikeInOneFileRule

    - Symplify\PHPStanRules\Rules\Complexity\ForbiddenArrayMethodCallRule

    # naming rules
    - Shopwell\Core\DevOps\StaticAnalyze\PHPStan\Rules\Symplify\NoReturnSetterMethodWithFluentSettersRule
    - Symplify\PHPStanRules\Rules\UppercaseConstantRule

services:
    - # needs the analysis parser to read inherited fixture methods from abstract test-case ancestors
        class: Shopwell\Core\DevOps\StaticAnalyze\PHPStan\Rules\Tests\NoCreateMockWithoutExpectationsRule
        arguments:
            parser: @defaultAnalysisParser
        tags:
            - phpstan.rules.rule

    - # register the class, so we can decorate it, but don't tag it as a rule, so only our decorator is used by PHPStan
        class: Symplify\PHPStanRules\Rules\NoReturnSetterMethodRule

    -
        class: Shopwell\Core\DevOps\StaticAnalyze\PHPStan\Rules\NotExtendFlowEventAwareRule
        tags:
            - phpat.test
