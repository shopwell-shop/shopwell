<?xml version="1.0" encoding="UTF-8"?>
<provider>

    <name>alipay</name>
    <label>支付宝</label>

    <!-- 一个支付宝开放平台应用 = 一套凭据，其下所有支付渠道共用 -->
    <credentials>
        <field name="app_id" type="text" required="true">
            <label>支付宝应用 APPID</label>
        </field>
        <field name="sandbox" type="bool" default="0">
            <label>沙箱模式</label>
        </field>
        <field name="private_key" type="textarea" required="true" secret="true">
            <label>应用私钥</label>
        </field>
        <field name="alipay_public_key" type="textarea" required="true">
            <label>支付宝公钥</label>
        </field>
        <field name="sign_type" type="select" default="RSA2">
            <label>签名算法</label>
            <help-text>支付宝 SDK 目前只实现 RSA2（SHA256withRSA），因此这是唯一可选值。</help-text>
            <option value="RSA2">RSA2</option>
        </field>
        <field name="gateway_url" type="text" default="https://openapi.alipay.com">
            <label>网关地址</label>
            <help-text>留空使用默认网关；开启沙箱模式时自动使用沙箱网关。</help-text>
        </field>
    </credentials>

    <channels>
        <channel name="alipay_h5">
            <label>支付宝 手机网站支付</label>
            <flow>redirect</flow>
            <currencies>CNY</currencies>
            <devices>wap</devices>
            <params>
                <field name="http_method" type="select" default="GET">
                    <label>跳转方式</label>
                    <help-text>GET 直接把用户跳转到支付宝页面；POST 由平台返回自提交表单，参数过长时使用。</help-text>
                    <option value="GET">GET（直接跳转）</option>
                    <option value="POST">POST（自提交表单）</option>
                </field>
            </params>
        </channel>

        <channel name="alipay_web">
            <label>支付宝 电脑网站支付</label>
            <flow>redirect</flow>
            <currencies>CNY</currencies>
            <devices>web</devices>
            <params>
                <field name="http_method" type="select" default="GET">
                    <label>跳转方式</label>
                    <help-text>GET 直接把用户跳转到支付宝页面；POST 由平台返回自提交表单，参数过长时使用。</help-text>
                    <option value="GET">GET（直接跳转）</option>
                    <option value="POST">POST（自提交表单）</option>
                </field>
            </params>
        </channel>

        <channel name="alipay_qr">
            <label>支付宝 当面付（扫码）</label>
            <flow>qrcode</flow>
            <currencies>CNY</currencies>
            <devices>web,wap</devices>
        </channel>

        <channel name="alipay_app">
            <label>支付宝 APP 支付</label>
            <flow>sdk</flow>
            <currencies>CNY</currencies>
            <devices>app</devices>
        </channel>

        <channel name="alipay_mini">
            <label>支付宝 小程序支付</label>
            <flow>sdk</flow>
            <currencies>CNY</currencies>
            <devices>mini</devices>
            <params>
                <field name="op_app_id" type="text">
                    <label>小程序 APPID</label>
                    <help-text>拉起收银台的小程序 APPID，须在商家平台与 JSAPI 支付产品绑定；留空使用凭据中的应用 APPID。</help-text>
                </field>
            </params>
            <runtime-params>
                <param name="buyer_id" required="true"/>
            </runtime-params>
        </channel>
    </channels>

</provider>
