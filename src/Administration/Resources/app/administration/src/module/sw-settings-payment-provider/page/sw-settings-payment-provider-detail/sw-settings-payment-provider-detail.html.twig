{% block sw_settings_payment_provider_detail %}
<sw-page class="sw-settings-payment-provider-detail">
    <template #smart-bar-header>
        <h2>{{ $t('sw-settings-payment-provider.accounts.title') }}</h2>
    </template>
    <template #smart-bar-actions>
        <mt-button
            variant="secondary"
            @click="$router.push({ name: 'sw.settings.payment.provider.index' })"
        >
            {{ $t('global.default.cancel') }}
        </mt-button>
        <mt-button
            class="sw-payment-account-detail__save"
            variant="primary"
            :is-loading="isSaving"
            :disabled="isLoading || isSaving || !canEdit || !account || !account.name.trim() || !provider || undefined"
            @click="save"
        >
            {{ $t('global.default.save') }}
        </mt-button>
    </template>
    <template #content>
        <sw-card-view>
            <mt-banner
                v-if="error"
                variant="critical"
            >
                {{ error }}
            </mt-banner>
            <sw-skeleton v-if="isLoading" />
            <template v-else-if="account">
                <mt-card
                    position-identifier="sw-payment-account-identity"
                    :title="$t('sw-settings-payment-provider.accounts.identity')"
                >
                    <div class="sw-payment-account-detail__identity">
                        <mt-text-field
                            v-model="accountName"
                            class="sw-payment-account-detail__name"
                            :label="$t('sw-settings-payment-provider.accounts.name')"
                            :disabled="!canEdit || undefined"
                            required
                        />
                        <mt-select
                            class="sw-payment-account-detail__provider"
                            :model-value="account.providerTechnicalName"
                            :options="providerOptions"
                            :label="$t('sw-settings-payment-provider.accounts.provider')"
                            :disabled="!!accountId || !canEdit || undefined"
                            @update:model-value="selectProvider"
                        />
                        <mt-switch
                            v-model="account.active"
                            class="sw-payment-account-detail__active"
                            :label="$t('sw-settings-payment-provider.accounts.enabled')"
                            :disabled="!canEdit || undefined"
                        />
                    </div>
                </mt-card>
                <mt-card
                    v-if="provider"
                    position-identifier="sw-payment-account-credentials"
                    :title="$t('sw-settings-payment-provider.accounts.credentials')"
                    :subtitle="$t('sw-settings-payment-provider.accounts.credentialsHelp')"
                >
                    <div class="sw-payment-account-detail__fields">
                        <sw-payment-config-field
                            v-for="field in shortFields"
                            :key="field.name"
                            v-model="credentials[field.name]"
                            :field="field"
                            :disabled="!canEdit"
                        />
                    </div>
                    <div class="sw-payment-account-detail__keys">
                        <sw-payment-config-field
                            v-for="field in multilineFields"
                            :key="field.name"
                            v-model="credentials[field.name]"
                            :field="field"
                            :disabled="!canEdit"
                        />
                    </div>
                </mt-card>
                <mt-card
                    v-if="products.length"
                    position-identifier="sw-payment-account-products"
                    :title="$t('sw-settings-payment-provider.accounts.products')"
                >
                    <div class="sw-payment-account-detail__products">
                        <section
                            v-for="product in products"
                            :key="product.product"
                            class="sw-payment-account-detail__product"
                        >
                            <mt-switch
                                :model-value="account.enabledProducts.includes(product.product)"
                                :label="label(product.label)"
                                :disabled="!canEdit || undefined"
                                @update:model-value="setProduct(product.product, $event)"
                            />
                            <div
                                v-if="product.paramFields.length"
                                class="sw-payment-account-detail__fields"
                            >
                                <sw-payment-config-field
                                    v-for="field in product.paramFields"
                                    :key="field.name"
                                    v-model="productParams[product.product][field.name]"
                                    :field="field"
                                    :disabled="!canEdit"
                                />
                            </div>
                        </section>
                    </div>
                </mt-card>
            </template>
        </sw-card-view>
    </template>
</sw-page>
{% endblock %}
