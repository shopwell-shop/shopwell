{% block sw_settings_payment_provider_list %}
<sw-page class="sw-settings-payment-provider-list">
    <template #search-bar>
        <mt-search
            v-model="term"
            class="sw-payment-account-list__search"
            :placeholder="$t('sw-settings-payment-provider.accounts.search')"
        />
    </template>
    <template #smart-bar-header>
        <h2>
            {{ $t('sw-settings-payment-provider.general.mainMenuItemGeneral') }}
            <span
                v-if="!isLoading"
                class="sw-page__smart-bar-amount"
            >({{ filteredAccounts.length }})</span>
        </h2>
    </template>
    <template #smart-bar-actions>
        <mt-button
            class="sw-payment-account-list__create"
            variant="primary"
            :disabled="!acl.can('payment_account.creator') || undefined"
            @click="$router.push({ name: 'sw.settings.payment.provider.create' })"
        >
            {{ $t('sw-settings-payment-provider.accounts.create') }}
        </mt-button>
    </template>
    <template #content>
        <div class="sw-settings-payment-provider-list__content">
            <mt-banner
                v-if="error"
                class="sw-payment-account-list__error"
                variant="critical"
            >
                {{ error }}
            </mt-banner>
            <sw-data-grid
                v-if="isLoading || filteredAccounts.length"
                class="sw-payment-account-list__grid"
                identifier="sw-payment-account-list"
                :data-source="visibleAccounts"
                :columns="columns"
                :is-loading="isLoading"
                :full-page="true"
                :show-selection="false"
                :show-settings="true"
                :allow-inline-edit="false"
                :allow-column-edit="true"
                :sort-by="sortBy"
                :sort-direction="sortDirection"
                @column-sort="onSort"
            >
                <template #column-name="{ item }">
                    <router-link
                        class="sw-payment-account-list__name"
                        :to="{ name: 'sw.settings.payment.provider.detail', params: { id: item.id } }"
                    >
                        {{ accountLabel(item) }}
                    </router-link>
                </template>
                <template #column-providerTechnicalName="{ item }">
                    {{ providerLabel(item.providerTechnicalName) }}
                </template>
                <template #column-active="{ item }">
                    <mt-badge
                        class="sw-payment-account-list__status"
                        size="small"
                        :variant="item.active ? 'positive' : 'neutral'"
                    >
                        {{ item.active ? $t('sw-settings-payment-provider.accounts.enabled') : $t('sw-settings-payment-provider.accounts.disabled') }}
                    </mt-badge>
                </template>
                <template #column-enabledProducts="{ item }">
                    {{ item.enabledProducts.length }}
                </template>
                <template #actions="{ item }">
                    <sw-context-menu-item
                        class="sw-payment-account-list__edit"
                        :router-link="{ name: 'sw.settings.payment.provider.detail', params: { id: item.id } }"
                        :disabled="!acl.can('payment_account.editor') || undefined"
                    >
                        {{ $t('global.default.edit') }}
                    </sw-context-menu-item>
                    <sw-context-menu-item
                        v-if="!item.isDefault"
                        class="sw-payment-account-list__delete"
                        variant="danger"
                        :disabled="!acl.can('payment_account.deleter') || undefined"
                        @click="openDelete(item)"
                    >
                        {{ $t('global.default.delete') }}
                    </sw-context-menu-item>
                </template>
                <template #pagination>
                    <sw-pagination
                        :page="page"
                        :limit="limit"
                        :total="filteredAccounts.length"
                        :total-visible="7"
                        @page-change="onPageChange"
                    />
                </template>
            </sw-data-grid>
            <mt-empty-state
                v-else
                class="sw-payment-account-list__empty"
                centered
                icon="regular-credit-card"
                :headline="term ? $t('sw-empty-state.messageNoResultTitle') : $t('sw-settings-payment-provider.accounts.empty')"
                :description="term ? '' : $t('sw-settings-payment-provider.accounts.description')"
            >
                <template
                    v-if="!term && acl.can('payment_account.creator')"
                    #button
                >
                    <mt-button
                        variant="primary"
                        @click="$router.push({ name: 'sw.settings.payment.provider.create' })"
                    >
                        {{ $t('sw-settings-payment-provider.accounts.create') }}
                    </mt-button>
                </template>
            </mt-empty-state>
        </div>
        <mt-modal-root
            v-if="deleteTarget"
            is-open
            @change="onDeleteModalChange"
        >
            <mt-modal
                width="s"
                :title="$t('sw-settings-payment-provider.accounts.deleteTitle')"
            >
                <p>{{ $t('sw-settings-payment-provider.accounts.deleteMessage', { name: accountLabel(deleteTarget) }) }}</p>
                <template #footer>
                    <mt-modal-close
                        as="mt-button"
                        variant="secondary"
                        size="small"
                        @click="closeDelete"
                    >
                        {{ $t('global.default.cancel') }}
                    </mt-modal-close>
                    <mt-modal-action
                        as="mt-button"
                        class="sw-payment-account-list__confirm-delete"
                        variant="critical"
                        size="small"
                        :is-loading="isDeleting"
                        @click="confirmDelete"
                    >
                        {{ $t('global.default.delete') }}
                    </mt-modal-action>
                </template>
            </mt-modal>
        </mt-modal-root>
    </template>
</sw-page>
{% endblock %}
