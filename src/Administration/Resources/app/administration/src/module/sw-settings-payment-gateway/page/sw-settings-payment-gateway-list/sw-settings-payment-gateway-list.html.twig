{% block sw_settings_payment_gateway_list %}
<sw-page class="sw-settings-payment-gateway-list">

    {% block sw_settings_payment_gateway_list_search_bar %}
    <template #search-bar>
        <mt-search
            v-model="term"
            class="sw-settings-payment-gateway-list__search"
            :placeholder="$t('sw-settings-payment-gateway.list.placeholderSearchBar')"
            @change="onSearch"
        />
    </template>
    {% endblock %}

    {% block sw_settings_payment_gateway_list_smart_bar_header %}
    <template #smart-bar-header>
        {% block sw_settings_payment_gateway_list_smart_bar_header_title %}
        <h2>
            {% block sw_settings_payment_gateway_list_smart_bar_header_title_text %}
            {{ $t('sw-settings.index.title') }}
            <mt-icon
                name="regular-chevron-right-xs"
                size="12px"
            />
            {{ $t('sw-settings-payment-gateway.general.mainMenuItemGeneral') }}
            {% endblock %}

            {% block sw_settings_payment_gateway_list_smart_bar_header_amount %}
            <span
                v-if="!isLoading && filteredApps.length > 0"
                class="sw-page__smart-bar-amount"
            >
                ({{ filteredApps.length }})
            </span>
            {% endblock %}
        </h2>
        {% endblock %}
    </template>
    {% endblock %}

    {% block sw_settings_payment_gateway_list_smart_bar_actions %}
    <template #smart-bar-actions>
        {% block sw_settings_payment_gateway_list_smart_bar_actions_create %}
        <mt-button
            v-tooltip.bottom="createButtonTooltip"
            class="sw-settings-payment-gateway-list__create-action"
            variant="primary"
            size="default"
            :disabled="!acl.can('payment_app.creator') || undefined"
            @click="onCreate"
        >
            {{ $t('sw-settings-payment-gateway.list.buttonCreate') }}
        </mt-button>
        {% endblock %}
    </template>
    {% endblock %}

    {% block sw_settings_payment_gateway_list_content %}
    <template #content>
        <sw-card-view>
            {% block sw_settings_payment_gateway_list_card %}
            <mt-card position-identifier="sw-settings-payment-gateway-list">
                {% block sw_settings_payment_gateway_list_grid %}
                <template #grid>
                    <sw-data-grid
                        v-if="isLoading || filteredApps.length > 0"
                        class="sw-settings-payment-gateway-list__grid"
                        identifier="sw-settings-payment-gateway-list"
                        :data-source="filteredApps"
                        :columns="appColumns"
                        :is-loading="isLoading"
                        :full-page="false"
                        :show-selection="false"
                        :show-settings="true"
                        :show-header="true"
                        :show-actions="hasRowActions"
                        :is-record-disabled="isPlatformApp"
                        :allow-inline-edit="false"
                        :allow-column-edit="true"
                    >
                        {% block sw_settings_payment_gateway_list_grid_columns_name %}
                        <template #column-name="{ item }">
                            {% block sw_settings_payment_gateway_list_grid_columns_name_link %}
                            <router-link
                                v-if="!isPlatformApp(item)"
                                class="sw-settings-payment-gateway-list__name-link"
                                :to="{ name: 'sw.settings.payment.gateway.detail', params: { id: item.id } }"
                            >
                                {{ item.name }}
                            </router-link>
                            {% endblock %}

                            {% block sw_settings_payment_gateway_list_grid_columns_name_platform %}
                            <span
                                v-else
                                class="sw-settings-payment-gateway-list__name"
                            >
                                {{ item.name }}
                            </span>
                            {% endblock %}

                            {% block sw_settings_payment_gateway_list_grid_columns_name_platform_badge %}
                            <mt-badge
                                v-if="isPlatformApp(item)"
                                class="sw-settings-payment-gateway-list__platform-badge"
                                variant="info"
                                size="small"
                            >
                                {{ $t('sw-settings-payment-gateway.list.badgePlatform') }}
                            </mt-badge>
                            {% endblock %}
                        </template>
                        {% endblock %}

                        {% block sw_settings_payment_gateway_list_grid_columns_active %}
                        <template #column-active="{ item }">
                            <mt-badge
                                class="sw-settings-payment-gateway-list__status"
                                size="small"
                                :variant="item.active ? 'positive' : 'neutral'"
                            >
                                {{ item.active ? $t('sw-settings-payment-gateway.list.labelActive') : $t('sw-settings-payment-gateway.list.labelInactive') }}
                            </mt-badge>
                        </template>
                        {% endblock %}

                        {% block sw_settings_payment_gateway_list_grid_columns_providers %}
                        <template #column-providers="{ item }">
                            {{ enabledProviderCount(item) }}
                        </template>
                        {% endblock %}

                        {% block sw_settings_payment_gateway_list_grid_columns_channels %}
                        <template #column-channels="{ item }">
                            {{ enabledChannelCount(item) }}
                        </template>
                        {% endblock %}

                        {% block sw_settings_payment_gateway_list_grid_columns_actions %}
                        <template #actions="{ item }">
                            {% block sw_settings_payment_gateway_list_grid_columns_actions_edit %}
                            <sw-context-menu-item
                                v-if="!isPlatformApp(item)"
                                class="sw-settings-payment-gateway-list__edit-action"
                                :router-link="{ name: 'sw.settings.payment.gateway.detail', params: { id: item.id } }"
                                :disabled="!acl.can('payment_app.editor') || undefined"
                            >
                                {{ $t('global.default.edit') }}
                            </sw-context-menu-item>
                            {% endblock %}

                            {% block sw_settings_payment_gateway_list_grid_columns_actions_delete %}
                            <sw-context-menu-item
                                v-if="!isPlatformApp(item)"
                                class="sw-settings-payment-gateway-list__delete-action"
                                variant="danger"
                                :disabled="!acl.can('payment_app.deleter') || undefined"
                                @click="onOpenDeleteModal(item)"
                            >
                                {{ $t('global.default.delete') }}
                            </sw-context-menu-item>
                            {% endblock %}
                        </template>
                        {% endblock %}
                    </sw-data-grid>

                    {% block sw_settings_payment_gateway_list_empty_state %}
                    <mt-empty-state
                        v-if="!isLoading && filteredApps.length === 0"
                        class="sw-settings-payment-gateway-list__empty-state"
                        centered
                        :icon="$route.meta.$module.icon"
                        :headline="term === '' ? $t('sw-settings-payment-gateway.list.messageEmpty') : $t('sw-empty-state.messageNoResultTitle')"
                        :description="term === '' ? $t('sw-settings-payment-gateway.list.sublineEmpty') : ''"
                    >
                        {% block sw_settings_payment_gateway_list_empty_state_button %}
                        <template
                            v-if="term === '' && acl.can('payment_app.creator')"
                            #button
                        >
                            <mt-button
                                variant="primary"
                                size="default"
                                @click="onCreate"
                            >
                                {{ $t('sw-settings-payment-gateway.list.buttonCreate') }}
                            </mt-button>
                        </template>
                        {% endblock %}
                    </mt-empty-state>
                    {% endblock %}
                </template>
                {% endblock %}
            </mt-card>
            {% endblock %}
        </sw-card-view>

        {% block sw_settings_payment_gateway_list_delete_modal %}
        <mt-modal-root
            v-if="deleteTarget"
            is-open
            @change="onDeleteModalChange"
        >
            <mt-modal
                width="s"
                :title="$t('sw-settings-payment-gateway.list.deleteModalTitle')"
            >
                {% block sw_settings_payment_gateway_list_delete_modal_content %}
                <p class="sw-settings-payment-gateway-list__delete-modal-content">
                    {{ $t('sw-settings-payment-gateway.list.deleteModalMessage', { app: deleteTarget.name }) }}
                </p>
                {% endblock %}

                {% block sw_settings_payment_gateway_list_delete_modal_footer %}
                <template #footer>
                    {% block sw_settings_payment_gateway_list_delete_modal_footer_cancel %}
                    <mt-modal-close
                        as="mt-button"
                        variant="secondary"
                        size="small"
                    >
                        {{ $t('global.default.cancel') }}
                    </mt-modal-close>
                    {% endblock %}

                    {% block sw_settings_payment_gateway_list_delete_modal_footer_confirm %}
                    <mt-modal-action
                        as="mt-button"
                        variant="critical"
                        size="small"
                        :is-loading="isDeleting"
                        @click="onConfirmDelete"
                    >
                        {{ $t('global.default.delete') }}
                    </mt-modal-action>
                    {% endblock %}
                </template>
                {% endblock %}
            </mt-modal>
        </mt-modal-root>
        {% endblock %}
    </template>
    {% endblock %}
</sw-page>
{% endblock %}
