{% block sw_settings_payment_gateway_detail %}
<sw-page class="sw-settings-payment-gateway-detail">

    {% block sw_settings_payment_gateway_detail_smart_bar_header %}
    <template #smart-bar-header>
        {% block sw_settings_payment_gateway_detail_smart_bar_header_title %}
        <h2>
            {% block sw_settings_payment_gateway_detail_smart_bar_header_title_text %}
            {{ $t('sw-settings.index.title') }}
            <mt-icon
                name="regular-chevron-right-xs"
                size="var(--scale-size-12)"
            />
            <router-link :to="{ name: 'sw.settings.payment.gateway.list' }">
                {{ $t('sw-settings-payment-gateway.general.mainMenuItemGeneral') }}
            </router-link>
            <mt-icon
                name="regular-chevron-right-xs"
                size="var(--scale-size-12)"
            />
            {{ isNew ? $t('sw-settings-payment-gateway.detail.createTitle') : pageTitle }}
            {% endblock %}
        </h2>
        {% endblock %}
    </template>
    {% endblock %}

    {% block sw_settings_payment_gateway_detail_smart_bar_actions %}
    <template #smart-bar-actions>
        {% block sw_settings_payment_gateway_detail_smart_bar_actions_delete %}
        <mt-button
            v-if="!isNew"
            class="sw-settings-payment-gateway-detail__delete-action"
            variant="critical"
            ghost
            size="default"
            :disabled="isLoading || isSaving || !canDelete || isPlatformTenant || undefined"
            @click="onOpenDeleteModal"
        >
            {{ $t('global.default.delete') }}
        </mt-button>
        {% endblock %}

        {% block sw_settings_payment_gateway_detail_smart_bar_actions_save %}
        <mt-button
            v-if="activeSection !== 'cashier' || isNew"
            class="sw-settings-payment-gateway-detail__save-action"
            variant="primary"
            size="default"
            :is-loading="isSaving"
            :disabled="isLoading || isSaving || (isNew ? !canCreate : isReadOnly) || undefined"
            @click="onSave"
        >
            {{ $t('global.default.save') }}
        </mt-button>
        {% endblock %}
    </template>
    {% endblock %}

    {% block sw_settings_payment_gateway_detail_content %}
    <template #content>
        <sw-card-view>
            <mt-tabs
                v-if="!isLoading && app"
                position-identifier="sw-settings-payment-gateway-detail-views"
                :default-item="activeSection"
                :items="viewTabs"
                :small="true"
            />
            {% block sw_settings_payment_gateway_detail_content_loading %}
            <template v-if="isLoading">
                <sw-skeleton />
                <sw-skeleton />
            </template>
            {% endblock %}

            {% block sw_settings_payment_gateway_detail_content_form %}
            <template v-else-if="app">

                {% block sw_settings_payment_gateway_detail_content_application %}
                <mt-card
                    v-if="activeSection === 'collection'"
                    position-identifier="sw-settings-payment-gateway-detail-application"
                    :title="$t('sw-settings-payment-gateway.detail.cardApplicationTitle')"
                    :subtitle="$t('sw-settings-payment-gateway.detail.cardApplicationSubtitle')"
                >
                    {% block sw_settings_payment_gateway_detail_content_application_grid %}
                    <div
                        class="sw-settings-payment-gateway-detail__grid sw-settings-payment-gateway-detail__identity-grid"
                    >
                        {% block sw_settings_payment_gateway_detail_content_application_technical_name %}

                        <mt-text-field
                            v-if="!isPlatformTenant && isNew"
                            v-model="app.technicalName"
                            name="sw-field--payment-app-technical-name"
                            :label="$t('sw-settings-payment-gateway.detail.labelTechnicalName')"
                            :help-text="$t('sw-settings-payment-gateway.detail.labelTechnicalNameHelpText')"
                            required
                            :disabled="isReadOnly || undefined"
                        />
                        {% endblock %}

                        {% block sw_settings_payment_gateway_detail_content_application_name %}
                        <mt-text-field
                            v-model="app.name"
                            name="sw-field--payment-app-name"
                            :label="$t('sw-settings-payment-gateway.detail.labelName')"
                            :disabled="isReadOnly || undefined"
                        />
                        {% endblock %}
                    {% block sw_settings_payment_gateway_detail_content_application_active %}
                        <mt-switch
                            v-model="app.active"
                            class="sw-settings-payment-gateway-detail__active"
                            bordered
                            :disabled="isReadOnly || undefined"
                            :label="$t('sw-settings-payment-gateway.detail.labelActive')"
                            :help-text="$t('sw-settings-payment-gateway.detail.labelActiveHelpText')"
                        />
                    {% endblock %}
                    </div>
                    {% endblock %}

                </mt-card>
                {% endblock %}

                {% block sw_settings_payment_gateway_detail_content_account %}
                <mt-card
                    v-if="activeSection === 'collection'"
                    class="sw-settings-payment-gateway-detail__grants"
                    position-identifier="sw-settings-payment-gateway-detail-account"
                    :title="$t('sw-settings-payment-gateway.detail.cardAccountTitle')"
                    :subtitle="$t('sw-settings-payment-gateway.detail.cardAccountSubtitle')"
                >
                    <template #headerRight>
                        <mt-button
                            class="sw-settings-payment-gateway-detail__add-account"
                            size="small"
                            variant="secondary"
                            :disabled="isReadOnly || !canAddAccount || undefined"
                            @click="addAccount"
                        >
                            {{ $t('sw-settings-payment-gateway.detail.addGrant') }}
                        </mt-button>
                    </template>
                    <p
                        v-if="providers.length === 0"
                        class="sw-settings-payment-gateway-detail__hint"
                    >
                        {{ $t('sw-settings-payment-gateway.detail.noGrants') }}
                    </p>
                    <table
                        v-if="providers.length > 0"
                        class="sw-payment-account-list__table"
                    >
                        <thead><tr><th>{{ $t('sw-settings-payment-gateway.detail.cardAccountTitle') }}</th><th>{{ $t('sw-settings-payment-provider.accounts.provider') }}</th><th>{{ $t('sw-settings-payment-gateway.detail.accountPosition') }}</th><th>{{ $t('sw-settings-payment-gateway.detail.grantEnabled') }}</th><th>{{ $t('sw-settings-payment-provider.accounts.actions') }}</th></tr></thead>
                        <tbody>
                            <tr
                                v-for="grant in providers"
                                :key="grant.key"
                                class="sw-settings-payment-gateway-detail__account"
                            >
                                <td><mt-select
                                    v-model="grant.accountId"
                                    class="sw-settings-payment-gateway-detail__grant-field"
                                    :options="accountOptions(grant)"
                                    :label="$t('sw-settings-payment-gateway.detail.existingAccount')"
                                    :disabled="isReadOnly || undefined"
                                /></td>
                                <td>{{ selectedAccount(grant) ? providerLabel(selectedAccount(grant).providerTechnicalName) : '' }}
                                </td>
                                <td><mt-number-field
                                    v-model="grant.position"
                                    class="sw-settings-payment-gateway-detail__account-position sw-settings-payment-gateway-detail__grant-field"
                                    :label="$t('sw-settings-payment-gateway.detail.accountPosition')"
                                    :disabled="isReadOnly || undefined"
                                    :min="0"
                                    number-type="int"
                                /></td>
                                <td><mt-switch
                                    v-model="grant.enabled"
                                    class="sw-settings-payment-gateway-detail__grant-field"
                                    :label="$t('sw-settings-payment-gateway.detail.labelProviderEnabled')"
                                    :disabled="isReadOnly || undefined"
                                /></td>
                                <td><mt-button
                                    class="sw-settings-payment-gateway-detail__remove-account"
                                    size="small"
                                    variant="secondary"
                                    :disabled="isReadOnly || undefined"
                                    @click="removeAccount(grant)"
                                >
                                    {{ $t('sw-settings-payment-gateway.detail.removeGrant') }}
                                </mt-button></td>
                            </tr>
                        </tbody>
                    </table>
                    <router-link
                        class="sw-settings-payment-gateway-detail__manage-accounts"
                        :to="{ name: 'sw.settings.payment.provider.index' }"
                    >
                        {{ $t('sw-settings-payment-gateway.detail.manageAccounts') }}
                    </router-link>
                </mt-card>
                {% endblock %}

                {% block sw_settings_payment_gateway_detail_content_channel %}
                <mt-card
                    v-if="activeSection === 'collection'"
                    position-identifier="sw-settings-payment-gateway-detail-channel"
                    :title="$t('sw-settings-payment-gateway.detail.cardChannelTitle')"
                    :subtitle="$t('sw-settings-payment-gateway.detail.cardChannelSubtitle')"
                >
                    <div class="sw-settings-payment-gateway-detail__products">
                        <div
                            v-for="product in products"
                            :key="product.technicalName"
                            class="sw-settings-payment-gateway-detail__product"
                        >
                            <span class="sw-settings-payment-gateway-detail__product-name">{{ displayLabel(product.label) }}</span>
                            <mt-switch
                                v-model="product.enabled"
                                class="sw-settings-payment-gateway-detail__product-enabled"
                                :label="displayLabel(product.label)"
                                :disabled="isReadOnly || !hasGrantedAccount(product) || undefined"
                            />
                        </div>
                    </div>
                </mt-card>
                {% endblock %}

                <template v-if="activeSection === 'cashier'">
                    <mt-banner
                        v-if="isNew"
                        variant="info"
                    >
                        {{ $t('sw-settings-payment-gateway.cashier.saveAppFirst') }}
                    </mt-banner>
                    <sw-payment-cashier-profiles
                        v-else
                        :app-id="app.id"
                        :method-options="methodOptions"
                    />
                </template>

                {% block sw_settings_payment_gateway_detail_content_security %}
                <mt-card
                    v-if="activeSection === 'integration'"
                    position-identifier="sw-settings-payment-gateway-detail-security"
                    :title="$t('sw-settings-payment-gateway.detail.cardSecurityTitle')"
                    :subtitle="$t('sw-settings-payment-gateway.detail.cardSecuritySubtitle')"
                >
                    <div class="sw-settings-payment-gateway-detail__access-fields">
                        <mt-text-field
                            v-if="!isPlatformTenant && !isNew"
                            v-model="app.technicalName"
                            name="sw-field--payment-app-technical-name"
                            :label="$t('sw-settings-payment-gateway.detail.labelTechnicalName')"
                            :help-text="$t('sw-settings-payment-gateway.detail.labelTechnicalNameHelpText')"
                            :disabled="isReadOnly || undefined"
                            required
                        />

                    {% block sw_settings_payment_gateway_detail_content_security_urls %}
                        <div
                            class="sw-settings-payment-gateway-detail__grid"
                        >
                        {% block sw_settings_payment_gateway_detail_content_security_notify_url %}
                            <mt-url-field
                                v-model="app.notifyUrl"
                                name="sw-field--payment-app-notify-url"
                                :label="$t('sw-settings-payment-gateway.detail.labelNotifyUrl')"
                                :disabled="isReadOnly || undefined"
                            />
                        {% endblock %}

                        {% block sw_settings_payment_gateway_detail_content_security_return_url %}
                            <mt-url-field
                                v-model="app.returnUrl"
                                name="sw-field--payment-app-return-url"
                                :label="$t('sw-settings-payment-gateway.detail.labelReturnUrl')"
                                :disabled="isReadOnly || undefined"
                            />
                        {% endblock %}
                        </div>
                    {% endblock %}

                    {% block sw_settings_payment_gateway_detail_content_security_limits %}
                        <div
                            class="sw-settings-payment-gateway-detail__grid"
                        >
                        {% block sw_settings_payment_gateway_detail_content_security_rate_limit %}
                            <mt-number-field
                                v-model="app.rateLimit"
                                name="sw-field--payment-app-rate-limit"
                                number-type="int"
                                :min="0"
                                :label="$t('sw-settings-payment-gateway.detail.labelRateLimit')"
                                :help-text="$t('sw-settings-payment-gateway.detail.labelRateLimitHelpText')"
                                :disabled="isReadOnly || undefined"
                            />
                        {% endblock %}

                        {% block sw_settings_payment_gateway_detail_content_security_secret %}
                            <div class="sw-settings-payment-gateway-detail__secret">
                            {% block sw_settings_payment_gateway_detail_content_security_secret_field %}
                                <mt-password-field
                                    v-model="appSecretInput"
                                    name="sw-field--payment-app-secret"
                                    :label="$t('sw-settings-payment-gateway.detail.labelAppSecret')"
                                    :help-text="$t('sw-settings-payment-gateway.detail.labelAppSecretHelpText')"
                                    :disabled="isReadOnly || undefined"
                                />
                            {% endblock %}

                            {% block sw_settings_payment_gateway_detail_content_security_secret_generate %}
                                <mt-button
                                    class="sw-settings-payment-gateway-detail__secret-generate"
                                    variant="secondary"
                                    size="small"
                                    :disabled="isReadOnly || undefined"
                                    @click="onGenerateSecret"
                                >
                                    {{ $t('sw-settings-payment-gateway.detail.buttonGenerateSecret') }}
                                </mt-button>
                            {% endblock %}
                            </div>
                        {% endblock %}
                        </div>
                    {% endblock %}

                    {% block sw_settings_payment_gateway_detail_content_security_allowed_ips %}
                        <mt-textarea
                            v-model="allowedIpsInput"
                            class="sw-settings-payment-gateway-detail__allowed-ips"
                            name="sw-field--payment-app-allowed-ips"
                            :label="$t('sw-settings-payment-gateway.detail.labelAllowedIps')"
                            :placeholder="$t('sw-settings-payment-gateway.detail.placeholderAllowedIps')"
                            :help-text="$t('sw-settings-payment-gateway.detail.labelAllowedIpsHelpText')"
                            :disabled="isReadOnly || undefined"
                        />
                    {% endblock %}

                    {% block sw_settings_payment_gateway_detail_content_security_secret_hint %}
                        <mt-banner
                            class="sw-settings-payment-gateway-detail__secret-hint"
                            variant="attention"
                        >
                            {{ $t('sw-settings-payment-gateway.detail.secretHint') }}
                        </mt-banner>
                    {% endblock %}
                    </div>
                </mt-card>
                {% endblock %}

            </template>
            {% endblock %}
        </sw-card-view>

        {% block sw_settings_payment_gateway_detail_secret_modal %}
        <mt-modal-root
            v-if="isSecretModalOpen"
            is-open
            @change="onSecretModalChange"
        >
            <mt-modal
                width="s"
                :title="$t('sw-settings-payment-gateway.detail.secretModalTitle')"
            >
                {% block sw_settings_payment_gateway_detail_secret_modal_content %}
                <p class="sw-settings-payment-gateway-detail__secret-modal-message">
                    {{ $t('sw-settings-payment-gateway.detail.secretModalMessage') }}
                </p>

                <pre class="sw-settings-payment-gateway-detail__secret-value">{{ generatedSecret }}</pre>
                {% endblock %}

                {% block sw_settings_payment_gateway_detail_secret_modal_footer %}
                <template #footer>
                    {% block sw_settings_payment_gateway_detail_secret_modal_footer_confirm %}
                    <mt-modal-action
                        as="mt-button"
                        variant="primary"
                        size="small"
                        @click="onCloseSecretModal"
                    >
                        {{ $t('sw-settings-payment-gateway.detail.secretModalConfirm') }}
                    </mt-modal-action>
                    {% endblock %}
                </template>
                {% endblock %}
            </mt-modal>
        </mt-modal-root>
        {% endblock %}

        {% block sw_settings_payment_gateway_detail_delete_modal %}
        <mt-modal-root
            v-if="isDeleteModalOpen"
            is-open
            @change="onDeleteModalChange"
        >
            <mt-modal
                width="s"
                :title="$t('sw-settings-payment-gateway.detail.deleteModalTitle')"
            >
                {% block sw_settings_payment_gateway_detail_delete_modal_content %}
                <p class="sw-settings-payment-gateway-detail__delete-modal-message">
                    {{ $t('sw-settings-payment-gateway.detail.deleteModalMessage', { app: pageTitle }) }}
                </p>
                {% endblock %}

                {% block sw_settings_payment_gateway_detail_delete_modal_footer %}
                <template #footer>
                    {% block sw_settings_payment_gateway_detail_delete_modal_footer_cancel %}
                    <mt-modal-close
                        as="mt-button"
                        variant="secondary"
                        size="small"
                    >
                        {{ $t('global.default.cancel') }}
                    </mt-modal-close>
                    {% endblock %}

                    {% block sw_settings_payment_gateway_detail_delete_modal_footer_confirm %}
                    <mt-modal-action
                        as="mt-button"
                        variant="critical"
                        size="small"
                        :is-loading="isDeleting"
                        @click="onConfirmDelete"
                    >
                        {{ $t('global.default.delete') }}
                    </mt-modal-action>
                    {% endblock %}
                </template>
                {% endblock %}
            </mt-modal>
        </mt-modal-root>
        {% endblock %}
    </template>
    {% endblock %}
</sw-page>
{% endblock %}
