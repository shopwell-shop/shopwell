{% block sw_settings_payment_gateway_detail %}
<sw-page class="sw-settings-payment-gateway-detail">

    {% block sw_settings_payment_gateway_detail_smart_bar_header %}
    <template #smart-bar-header>
        {% block sw_settings_payment_gateway_detail_smart_bar_header_title %}
        <h2>
            {% block sw_settings_payment_gateway_detail_smart_bar_header_title_text %}
            {{ $t('sw-settings.index.title') }}
            <mt-icon
                name="regular-chevron-right-xs"
                size="var(--scale-size-12)"
            />
            <router-link :to="{ name: 'sw.settings.payment.gateway.list' }">
                {{ $t('sw-settings-payment-gateway.general.mainMenuItemGeneral') }}
            </router-link>
            <mt-icon
                name="regular-chevron-right-xs"
                size="var(--scale-size-12)"
            />
            {{ isNew ? $t('sw-settings-payment-gateway.detail.createTitle') : pageTitle }}
            {% endblock %}
        </h2>
        {% endblock %}
    </template>
    {% endblock %}

    {% block sw_settings_payment_gateway_detail_smart_bar_actions %}
    <template #smart-bar-actions>
        {% block sw_settings_payment_gateway_detail_smart_bar_actions_delete %}
        <mt-button
            v-if="!isNew"
            class="sw-settings-payment-gateway-detail__delete-action"
            variant="critical"
            ghost
            size="default"
            :disabled="isLoading || isSaving || !canDelete || isPlatformTenant || undefined"
            @click="onOpenDeleteModal"
        >
            {{ $t('global.default.delete') }}
        </mt-button>
        {% endblock %}

        {% block sw_settings_payment_gateway_detail_smart_bar_actions_save %}
        <mt-button
            class="sw-settings-payment-gateway-detail__save-action"
            variant="primary"
            size="default"
            :is-loading="isSaving"
            :disabled="isLoading || isSaving || (isNew ? !canCreate : isReadOnly) || undefined"
            @click="onSave"
        >
            {{ $t('global.default.save') }}
        </mt-button>
        {% endblock %}
    </template>
    {% endblock %}

    {% block sw_settings_payment_gateway_detail_content %}
    <template #content>
        <sw-card-view>
            {% block sw_settings_payment_gateway_detail_content_loading %}
            <template v-if="isLoading">
                <sw-skeleton />
                <sw-skeleton />
            </template>
            {% endblock %}

            {% block sw_settings_payment_gateway_detail_content_form %}
            <template v-else-if="app">
                {% block sw_settings_payment_gateway_detail_content_platform_notice %}
                <mt-banner
                    v-if="isPlatformTenant"
                    class="sw-settings-payment-gateway-detail__platform-notice"
                    variant="info"
                >
                    {{ $t('sw-settings-payment-gateway.detail.platformReadOnlyNotice') }}
                </mt-banner>
                {% endblock %}

                {% block sw_settings_payment_gateway_detail_content_application %}
                <mt-card
                    position-identifier="sw-settings-payment-gateway-detail-application"
                    :title="$t('sw-settings-payment-gateway.detail.cardApplicationTitle')"
                    :subtitle="$t('sw-settings-payment-gateway.detail.cardApplicationSubtitle')"
                >
                    {% block sw_settings_payment_gateway_detail_content_application_grid %}
                    <sw-container
                        class="sw-settings-payment-gateway-detail__grid"
                        columns="1fr 1fr"
                        gap="0px 30px"
                    >
                        {% block sw_settings_payment_gateway_detail_content_application_technical_name %}
                        <mt-text-field
                            v-model="app.technicalName"
                            name="sw-field--payment-app-technical-name"
                            :label="$t('sw-settings-payment-gateway.detail.labelTechnicalName')"
                            :help-text="$t('sw-settings-payment-gateway.detail.labelTechnicalNameHelpText')"
                            required
                            :disabled="isReadOnly || undefined"
                        />
                        {% endblock %}

                        {% block sw_settings_payment_gateway_detail_content_application_name %}
                        <mt-text-field
                            v-model="app.name"
                            name="sw-field--payment-app-name"
                            :label="$t('sw-settings-payment-gateway.detail.labelName')"
                            :disabled="isReadOnly || undefined"
                        />
                        {% endblock %}
                    </sw-container>
                    {% endblock %}

                    {% block sw_settings_payment_gateway_detail_content_application_active %}
                    <mt-switch
                        v-model="app.active"
                        class="sw-settings-payment-gateway-detail__active"
                        bordered
                        :disabled="isReadOnly || undefined"
                        :label="$t('sw-settings-payment-gateway.detail.labelActive')"
                        :help-text="$t('sw-settings-payment-gateway.detail.labelActiveHelpText')"
                    />
                    {% endblock %}
                </mt-card>
                {% endblock %}

                {% block sw_settings_payment_gateway_detail_content_security %}
                <mt-card
                    position-identifier="sw-settings-payment-gateway-detail-security"
                    :title="$t('sw-settings-payment-gateway.detail.cardSecurityTitle')"
                    :subtitle="$t('sw-settings-payment-gateway.detail.cardSecuritySubtitle')"
                >
                    <template #headerRight>
                        {% block sw_settings_payment_gateway_detail_content_security_secret_state %}
                        <mt-badge
                            v-if="app.hasSecret"
                            class="sw-settings-payment-gateway-detail__secret-state"
                            variant="positive"
                        >
                            {{ $t('sw-settings-payment-gateway.detail.secretConfigured') }}
                        </mt-badge>
                        {% endblock %}
                    </template>

                    {% block sw_settings_payment_gateway_detail_content_security_urls %}
                    <sw-container
                        class="sw-settings-payment-gateway-detail__grid"
                        columns="1fr 1fr"
                        gap="0px 30px"
                    >
                        {% block sw_settings_payment_gateway_detail_content_security_notify_url %}
                        <mt-url-field
                            v-model="app.notifyUrl"
                            name="sw-field--payment-app-notify-url"
                            :label="$t('sw-settings-payment-gateway.detail.labelNotifyUrl')"
                            :disabled="isReadOnly || undefined"
                        />
                        {% endblock %}

                        {% block sw_settings_payment_gateway_detail_content_security_return_url %}
                        <mt-url-field
                            v-model="app.returnUrl"
                            name="sw-field--payment-app-return-url"
                            :label="$t('sw-settings-payment-gateway.detail.labelReturnUrl')"
                            :disabled="isReadOnly || undefined"
                        />
                        {% endblock %}
                    </sw-container>
                    {% endblock %}

                    {% block sw_settings_payment_gateway_detail_content_security_limits %}
                    <sw-container
                        class="sw-settings-payment-gateway-detail__grid"
                        columns="1fr 1fr"
                        gap="0px 30px"
                    >
                        {% block sw_settings_payment_gateway_detail_content_security_rate_limit %}
                        <mt-number-field
                            v-model="app.rateLimit"
                            name="sw-field--payment-app-rate-limit"
                            number-type="int"
                            :min="0"
                            :label="$t('sw-settings-payment-gateway.detail.labelRateLimit')"
                            :help-text="$t('sw-settings-payment-gateway.detail.labelRateLimitHelpText')"
                            :disabled="isReadOnly || undefined"
                        />
                        {% endblock %}

                        {% block sw_settings_payment_gateway_detail_content_security_secret %}
                        <div class="sw-settings-payment-gateway-detail__secret">
                            {% block sw_settings_payment_gateway_detail_content_security_secret_field %}
                            <mt-password-field
                                v-model="appSecretInput"
                                name="sw-field--payment-app-secret"
                                :label="$t('sw-settings-payment-gateway.detail.labelAppSecret')"
                                :help-text="$t('sw-settings-payment-gateway.detail.labelAppSecretHelpText')"
                                :disabled="isReadOnly || undefined"
                            />
                            {% endblock %}

                            {% block sw_settings_payment_gateway_detail_content_security_secret_generate %}
                            <mt-button
                                class="sw-settings-payment-gateway-detail__secret-generate"
                                variant="secondary"
                                size="small"
                                :disabled="isReadOnly || undefined"
                                @click="onGenerateSecret"
                            >
                                {{ $t('sw-settings-payment-gateway.detail.buttonGenerateSecret') }}
                            </mt-button>
                            {% endblock %}
                        </div>
                        {% endblock %}
                    </sw-container>
                    {% endblock %}

                    {% block sw_settings_payment_gateway_detail_content_security_allowed_ips %}
                    <mt-textarea
                        v-model="allowedIpsInput"
                        class="sw-settings-payment-gateway-detail__allowed-ips"
                        name="sw-field--payment-app-allowed-ips"
                        :label="$t('sw-settings-payment-gateway.detail.labelAllowedIps')"
                        :placeholder="$t('sw-settings-payment-gateway.detail.placeholderAllowedIps')"
                        :help-text="$t('sw-settings-payment-gateway.detail.labelAllowedIpsHelpText')"
                        :disabled="isReadOnly || undefined"
                    />
                    {% endblock %}

                    {% block sw_settings_payment_gateway_detail_content_security_secret_hint %}
                    <mt-banner
                        class="sw-settings-payment-gateway-detail__secret-hint"
                        variant="attention"
                    >
                        {{ $t('sw-settings-payment-gateway.detail.secretHint') }}
                    </mt-banner>
                    {% endblock %}
                </mt-card>
                {% endblock %}

                {% block sw_settings_payment_gateway_detail_content_account %}
                <mt-card
                    position-identifier="sw-settings-payment-gateway-detail-account"
                    :title="$t('sw-settings-payment-gateway.detail.cardAccountTitle')"
                    :subtitle="$t('sw-settings-payment-gateway.detail.cardAccountSubtitle')"
                >
                    {% block sw_settings_payment_gateway_detail_content_account_row %}
                    <div
                        v-for="provider in providers"
                        :key="provider.technicalName"
                        class="sw-settings-payment-gateway-detail__account"
                    >
                        {% block sw_settings_payment_gateway_detail_content_account_head %}
                        <div class="sw-settings-payment-gateway-detail__account-head">
                            <div class="sw-settings-payment-gateway-detail__account-identity">
                                <span class="sw-settings-payment-gateway-detail__account-name">
                                    {{ displayLabel(provider.label) }}
                                </span>

                                {% block sw_settings_payment_gateway_detail_content_account_authorized %}
                                <mt-badge
                                    v-if="provider.enabled"
                                    class="sw-settings-payment-gateway-detail__account-badge"
                                    size="small"
                                    variant="positive"
                                >
                                    {{ $t('sw-settings-payment-gateway.detail.providerAuthorized') }}
                                </mt-badge>
                                {% endblock %}

                                {% block sw_settings_payment_gateway_detail_content_account_credentials %}
                                <mt-badge
                                    v-if="provider.enabled && !isAccountInherited(provider) && provider.hasCredentials"
                                    class="sw-settings-payment-gateway-detail__account-badge"
                                    size="small"
                                    variant="info"
                                >
                                    {{ $t('sw-settings-payment-gateway.detail.credentialsConfigured') }}
                                </mt-badge>
                                {% endblock %}
                            </div>

                            {% block sw_settings_payment_gateway_detail_content_account_enabled %}
                            <mt-switch
                                v-model="provider.enabled"
                                class="sw-settings-payment-gateway-detail__account-enabled"
                                :disabled="isReadOnly || undefined"
                                :label="$t('sw-settings-payment-gateway.detail.labelProviderEnabled')"
                            />
                            {% endblock %}
                        </div>
                        {% endblock %}

                        {% block sw_settings_payment_gateway_detail_content_account_source %}
                        <sw-container
                            class="sw-settings-payment-gateway-detail__grid"
                            columns="1fr 1fr"
                            gap="0px 30px"
                        >
                            <mt-select
                                v-model="provider.sourceAppId"
                                class="sw-settings-payment-gateway-detail__account-source"
                                :name="`sw-field--payment-app-provider-${provider.technicalName}-source`"
                                :label="$t('sw-settings-payment-gateway.detail.labelAccountSource')"
                                :help-text="$t('sw-settings-payment-gateway.detail.labelAccountSourceHelpText')"
                                :options="accountSourceOptions()"
                                label-property="label"
                                value-property="value"
                                :disabled="isReadOnly || !provider.enabled || undefined"
                            />
                        </sw-container>
                        {% endblock %}

                        {% block sw_settings_payment_gateway_detail_content_account_own_credentials %}
                        <sw-container
                            v-if="!isAccountInherited(provider)"
                            class="sw-settings-payment-gateway-detail__grid"
                            columns="1fr 1fr"
                            gap="0px 30px"
                        >
                            <sw-payment-config-field
                                v-for="field in provider.credentialFields"
                                :key="field.name"
                                v-model="provider.credentialInput[field.name]"
                                class="sw-settings-payment-gateway-detail__field"
                                :field="field"
                                :disabled="isReadOnly || !provider.enabled"
                            />
                        </sw-container>
                        {% endblock %}

                        {% block sw_settings_payment_gateway_detail_content_account_inheritance %}
                        <template v-if="isAccountInherited(provider)">
                            {% block sw_settings_payment_gateway_detail_content_account_inheritance_note %}
                            <p class="sw-settings-payment-gateway-detail__inheritance">
                                {{ inheritanceText(provider) }}
                            </p>
                            {% endblock %}

                            {% block sw_settings_payment_gateway_detail_content_account_inheritance_warning %}
                            <mt-banner
                                v-if="sourceAppMissesInterface(provider)"
                                class="sw-settings-payment-gateway-detail__inheritance-warning"
                                variant="attention"
                            >
                                {{ sourceAppWarning(provider) }}
                            </mt-banner>
                            {% endblock %}
                        </template>
                        {% endblock %}
                    </div>
                    {% endblock %}
                </mt-card>
                {% endblock %}

                {% block sw_settings_payment_gateway_detail_content_channel %}
                <mt-card
                    position-identifier="sw-settings-payment-gateway-detail-channel"
                    :title="$t('sw-settings-payment-gateway.detail.cardChannelTitle')"
                    :subtitle="$t('sw-settings-payment-gateway.detail.cardChannelSubtitle')"
                >
                    {% block sw_settings_payment_gateway_detail_content_channel_group %}
                    <div
                        v-for="provider in providers"
                        :key="provider.technicalName"
                        class="sw-settings-payment-gateway-detail__channel-group"
                    >
                        {% block sw_settings_payment_gateway_detail_content_channel_group_head %}
                        <div class="sw-settings-payment-gateway-detail__channel-group-head">
                            <h4 class="sw-settings-payment-gateway-detail__channel-group-title">
                                {{ displayLabel(provider.label) }}
                            </h4>

                            {% block sw_settings_payment_gateway_detail_content_channel_group_hint %}
                            <span
                                v-if="!provider.enabled"
                                class="sw-settings-payment-gateway-detail__channel-group-hint"
                            >
                                {{ $t('sw-settings-payment-gateway.detail.providerNotAuthorizedHint') }}
                            </span>
                            {% endblock %}
                        </div>
                        {% endblock %}

                        {% block sw_settings_payment_gateway_detail_content_channel_row %}
                        <div
                            v-for="channel in provider.channels"
                            :key="channel.technicalName"
                            class="sw-settings-payment-gateway-detail__channel"
                        >
                            {% block sw_settings_payment_gateway_detail_content_channel_enabled %}
                            <mt-switch
                                v-model="channel.enabled"
                                class="sw-settings-payment-gateway-detail__channel-enabled"
                                :disabled="isReadOnly || !provider.enabled || undefined"
                                :label="displayLabel(channel.label)"
                            />
                            {% endblock %}

                            {% block sw_settings_payment_gateway_detail_content_channel_meta %}
                            <div class="sw-settings-payment-gateway-detail__channel-meta">
                                <mt-badge
                                    size="small"
                                    variant="neutral"
                                >
                                    {{ flowLabel(channel.flow) }}
                                </mt-badge>

                                <span class="sw-settings-payment-gateway-detail__channel-meta-item">
                                    <mt-icon
                                        name="regular-money-bill"
                                        size="var(--scale-size-14)"
                                    />
                                    {{ currencyList(channel) }}
                                </span>

                                <span class="sw-settings-payment-gateway-detail__channel-meta-item">
                                    <mt-icon
                                        name="regular-mobile"
                                        size="var(--scale-size-14)"
                                    />
                                    {{ deviceList(channel) }}
                                </span>

                                <span
                                    v-if="runtimeParamList(channel).length > 0"
                                    class="sw-settings-payment-gateway-detail__channel-meta-item"
                                >
                                    <mt-icon
                                        name="regular-key"
                                        size="var(--scale-size-14)"
                                    />
                                    {{ runtimeParamList(channel).join(' / ') }}
                                </span>
                            </div>
                            {% endblock %}

                            {% block sw_settings_payment_gateway_detail_content_channel_params %}
                            <sw-container
                                v-if="!isAccountInherited(provider) && channel.enabled && channel.paramFields.length > 0"
                                class="sw-settings-payment-gateway-detail__grid sw-settings-payment-gateway-detail__channel-params"
                                columns="1fr 1fr"
                                gap="0px 30px"
                            >
                                <sw-payment-config-field
                                    v-for="field in channel.paramFields"
                                    :key="field.name"
                                    v-model="channel.paramInput[field.name]"
                                    class="sw-settings-payment-gateway-detail__field"
                                    :field="field"
                                    :disabled="isReadOnly"
                                />
                            </sw-container>
                            {% endblock %}

                            {% block sw_settings_payment_gateway_detail_content_channel_params_inherited %}
                            <p
                                v-if="isAccountInherited(provider) && channel.enabled && channel.paramFields.length > 0"
                                class="sw-settings-payment-gateway-detail__channel-params-inherited"
                            >
                                {{ channelParamsInheritedText(provider) }}
                            </p>
                            {% endblock %}
                        </div>
                        {% endblock %}
                    </div>
                    {% endblock %}
                </mt-card>
                {% endblock %}
            </template>
            {% endblock %}
        </sw-card-view>

        {% block sw_settings_payment_gateway_detail_secret_modal %}
        <mt-modal-root
            v-if="isSecretModalOpen"
            is-open
            @change="onSecretModalChange"
        >
            <mt-modal
                width="s"
                :title="$t('sw-settings-payment-gateway.detail.secretModalTitle')"
            >
                {% block sw_settings_payment_gateway_detail_secret_modal_content %}
                <p class="sw-settings-payment-gateway-detail__secret-modal-message">
                    {{ $t('sw-settings-payment-gateway.detail.secretModalMessage') }}
                </p>

                <pre class="sw-settings-payment-gateway-detail__secret-value">{{ generatedSecret }}</pre>
                {% endblock %}

                {% block sw_settings_payment_gateway_detail_secret_modal_footer %}
                <template #footer>
                    {% block sw_settings_payment_gateway_detail_secret_modal_footer_confirm %}
                    <mt-modal-action
                        as="mt-button"
                        variant="primary"
                        size="small"
                        @click="onCloseSecretModal"
                    >
                        {{ $t('sw-settings-payment-gateway.detail.secretModalConfirm') }}
                    </mt-modal-action>
                    {% endblock %}
                </template>
                {% endblock %}
            </mt-modal>
        </mt-modal-root>
        {% endblock %}

        {% block sw_settings_payment_gateway_detail_delete_modal %}
        <mt-modal-root
            v-if="isDeleteModalOpen"
            is-open
            @change="onDeleteModalChange"
        >
            <mt-modal
                width="s"
                :title="$t('sw-settings-payment-gateway.detail.deleteModalTitle')"
            >
                {% block sw_settings_payment_gateway_detail_delete_modal_content %}
                <p class="sw-settings-payment-gateway-detail__delete-modal-message">
                    {{ $t('sw-settings-payment-gateway.detail.deleteModalMessage', { app: pageTitle }) }}
                </p>
                {% endblock %}

                {% block sw_settings_payment_gateway_detail_delete_modal_footer %}
                <template #footer>
                    {% block sw_settings_payment_gateway_detail_delete_modal_footer_cancel %}
                    <mt-modal-close
                        as="mt-button"
                        variant="secondary"
                        size="small"
                    >
                        {{ $t('global.default.cancel') }}
                    </mt-modal-close>
                    {% endblock %}

                    {% block sw_settings_payment_gateway_detail_delete_modal_footer_confirm %}
                    <mt-modal-action
                        as="mt-button"
                        variant="critical"
                        size="small"
                        :is-loading="isDeleting"
                        @click="onConfirmDelete"
                    >
                        {{ $t('global.default.delete') }}
                    </mt-modal-action>
                    {% endblock %}
                </template>
                {% endblock %}
            </mt-modal>
        </mt-modal-root>
        {% endblock %}
    </template>
    {% endblock %}
</sw-page>
{% endblock %}
