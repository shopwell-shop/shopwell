{% block sw_permissions_detailed_additional %}
<mt-card
    class="sw-permissions-detailed-additional"
    position-identifier="sw-permissions-detailed-additional"
    :is-loading="isLoading"
    :title="$t('sw-permissions.roles.detailed-additional-permissions.title')"
>
    {% block sw_permissions_detailed_additional_additional_privileges %}
    <template v-if="role">
        <template
            v-for="privilege in detailedAdditionalPermissions"
            :key="privilege.key"
        >
            {% block sw_permissions_detailed_additional_additional_privileges_headline %}
            <h4
                class="sw-permissions-detailed-additional__headline"
                :class="'sw-permissions-additional_' + privilege.key"
            >
                {% block sw_permissions_detailed_additional_additional_privileges_headline_content %}
                {{ $t('sw-privileges.additional_permissions.' + privilege.key + '.label') }}
                {% endblock %}
            </h4>
            {% endblock %}

            {% block sw_permissions_detailed_additional_additional_privileges_switches %}
            <div
                class="sw-permissions-detailed-additional__switches"
            >
                {% block sw_permissions_detailed_additional_additional_privileges_switches_content %}
                <template
                    v-for="(value, roleName) in privilege.roles"
                    :key="roleName"
                >
                    {% block sw_permissions_detailed_additional_additional_privileges_switches_content_switch %}
                    <mt-switch
                        :class="'sw_permissions_detailed_additional_' + privilege.key + '_' + roleName"
                        :model-value="isEntitySelected(roleName)"
                        :disabled="isEntityDisabled(roleName) || disabled"
                        :label="roleName"
                        :bordered="true"
                        @update:model-value="changePermissionForEntity(roleName)"
                    />
                    {% endblock %}
                </template>
                {% endblock %}
            </div>
            {% endblock %}
        </template>
    </template>
    {% endblock %}
</mt-card>
{% endblock %}
