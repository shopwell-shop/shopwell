{% block sw_permissions_role_view_menus %}
<div class="sw-permissions-role-view-menus">
    <section
        class="sw-permissions-role-view-menus__table"
        :aria-label="$t('sw-permissions.roles.assignment.title')"
        :aria-busy="isLoading || store.isLoading"
    >
        <header class="sw-permissions-role-view-menus__toolbar">
            <h3>{{ $t('sw-permissions.roles.assignment.title') }}</h3>
            <mt-button
                class="sw-permissions-role-view-menus__toggle-all"
                variant="tertiary"
                size="small"
                :disabled="!permissionRows.length || !!searchTerm.trim()"
                @click="toggleAll"
            >
                {{ $t(isAllExpanded ? 'sw-permissions.menu.collapseAll' : 'sw-permissions.menu.expandAll') }}
            </mt-button>
        </header>
        <mt-banner
            v-if="store.isLoadFailed"
            variant="critical"
        >
            {{ $t('sw-permissions.roles.menus.loadFailed') }}
            <mt-button
                variant="secondary"
                size="small"
                @click="loadMenus"
            >
                {{ $t('sw-permissions.menu.retry') }}
            </mt-button>
        </mt-banner>
        <div class="sw-permissions-role-view-menus__scroll">
            <table>
                <thead>
                    <tr>
                        <th scope="col">
                            {{ $t('sw-permissions.menu.headline') }}
                        </th>
                        <th scope="col">
                            {{ $t('sw-permissions.roles.additional-permissions.title') }}
                        </th>
                    </tr>
                </thead>
                <tbody>
                    <tr
                        v-for="row in visibleRows"
                        :key="row.item.id"
                        :data-id="row.item.id"
                        :class="{ 'sw-permissions-role-view-menus__group': row.item.children.length > 0 }"
                    >
                        <td>
                            <div
                                class="sw-permissions-role-view-menus__menu"
                                :class="`sw-permissions-role-view-menus__menu--depth-${Math.min(row.depth, 8)}`"
                            >
                                <mt-button
                                    v-if="row.item.children.length"
                                    class="sw-permissions-role-view-menus__toggle"
                                    variant="tertiary"
                                    size="x-small"
                                    square
                                    :aria-expanded="searchTerm.trim() ? true : expandedIds.includes(row.item.id)"
                                    :aria-label="`${searchTerm.trim() || expandedIds.includes(row.item.id) ? $t('sw-permissions.menu.collapse') : $t('sw-permissions.menu.expand')} ${row.item.label}`"
                                    @click="toggleExpanded(row.item.id)"
                                >
                                    <mt-icon
                                        :name="searchTerm.trim() || expandedIds.includes(row.item.id) ? 'regular-chevron-down-xs' : 'regular-chevron-right-xs'"
                                        size="12px"
                                    />
                                </mt-button>
                                <span
                                    v-else
                                    class="sw-permissions-role-view-menus__toggle-spacer"
                                ></span>
                                <mt-checkbox
                                    v-if="hasMenuSelection(row.item)"
                                    class="sw-permissions-role-view-menus__menu-checkbox"
                                    :model-value="selectionState(row.item).checked"
                                    :indeterminate="selectionState(row.item).partial"
                                    :disabled="disabled || (!selectionState(row.item).checked && !selectionState(row.item).partial && !canSelectMenu(row.item))"
                                    :aria-label="menuLabel(row.item)"
                                    @update:model-value="toggleSelection(row.item, $event)"
                                />
                                <span>{{ row.item.label }}</span>
                            </div>
                        </td>
                        <td>
                            <div
                                class="sw-permissions-role-view-menus__operations"
                                :aria-label="operationLabel(row.item, $t('sw-permissions.roles.additional-permissions.title'))"
                            >
                                <mt-checkbox
                                    v-for="operation in row.item.operations"
                                    :key="operation.id"
                                    :data-permission="operation.id"
                                    :label="operation.label"
                                    :aria-label="operationLabel(row.item, operation.label)"
                                    :model-value="effectivePrivileges.includes(operation.id)"
                                    :disabled="isOperationDisabled(row.item, operation.id)"
                                    @update:model-value="toggleOperation(row.item, operation.id, $event)"
                                />
                            </div>
                        </td>
                    </tr>
                    <tr v-if="!visibleRows.length && !isLoading && !store.isLoading && !store.isLoadFailed">
                        <td
                            class="sw-permissions-role-view-menus__empty"
                            colspan="2"
                        >
                            {{ $t('sw-permissions.menu.searchEmptyHeadline') }}
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
        <sw-loader v-if="isLoading || store.isLoading" />
    </section>
    <sw-permissions-role-view-general
        v-if="role"
        :role="role"
        :is-loading="isLoading"
        mcp-only
    />
</div>
{% endblock %}
