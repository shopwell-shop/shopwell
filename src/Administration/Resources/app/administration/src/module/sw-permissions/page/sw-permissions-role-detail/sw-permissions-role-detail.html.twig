{% block sw_permissions_role_detail %}
<sw-page class="sw-permissions-role-detail">
    {% block sw_permissions_role_detail_smart_bar_header %}
    <template #smart-bar-header>
        {% block sw_permissions_role_detail_smart_bar_header_title %}
        <h2 v-if="role && role.isNew() && role.name.length <= 0">
            {{ $t('sw-permissions.roles.general.labelCreateNewRole') }}
        </h2>

        <h2 v-else-if="role">
            {{ role.name }}
        </h2>

        <h2 v-else>
            {{ $t('sw-permissions.roles.detail.role') }}
        </h2>
        {% endblock %}
    </template>
    {% endblock %}

    {% block sw_permissions_role_detail_smart_bar_actions %}
    <template #smart-bar-actions>
        {% block sw_permissions_role_detail_smart_bar_actions_button_cancel %}
        <mt-button
            v-tooltip.bottom="tooltipCancel"
            variant="secondary"
            size="default"
            @click="onCancel"
        >
            {{ $t('global.default.cancel') }}
        </mt-button>
        {% endblock %}

        {% block sw_permissions_role_detail_smart_bar_actions_button_save %}
        <sw-button-process
            v-tooltip.bottom="tooltipSave"
            class="sw-permissions-role-detail__button-save"
            :is-loading="isLoading"
            :process-success="isSaveSuccessful"
            :disabled="isLoading || !acl.can('permissions.editor')"
            variant="primary"
            @update:process-success="saveFinish"
            @click.prevent="onSave"
        >
            {{ $t('global.default.save') }}
        </sw-button-process>
        {% endblock %}
    </template>
    {% endblock %}

    {% block sw_permissions_role_detail_content %}
    <template #content>
        {% block sw_permissions_role_detail_content_card_view %}
        <sw-card-view>
            {% block sw_permissions_role_detail_content_card_view_tabs %}
            <mt-tabs
                position-identifier="sw-permissions-role-detail-content"
                :default-item="$route.name"
                :items="roleDetailTabs"
                :small="true"
            />
            {% endblock %}

            <router-view
                v-slot="{ Component }"
            >
                <component
                    :is="Component"
                    :role="role"
                    :is-loading="isLoading"
                    :detailed-privileges="detailedPrivileges"
                    @update-role="updateRole"
                />
            </router-view>
        </sw-card-view>
        {% endblock %}

        {% block sw_permissions_role_detail_content_verify_modal %}
        <sw-verify-user-modal
            v-if="confirmPasswordModal"
            @verified="saveRole"
            @close="onCloseConfirmPasswordModal"
        />
        {% endblock %}
    </template>
    {% endblock %}
</sw-page>
{% endblock %}
