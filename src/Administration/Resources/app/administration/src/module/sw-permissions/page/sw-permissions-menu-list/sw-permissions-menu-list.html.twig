{% block sw_permissions_menu_list %}
<sw-page
    class="sw-permissions-menu-list"
>
    <template #search-bar>
        {% block sw_permissions_menu_list_search_bar %}
        <sw-search-bar
            initial-search-type="admin_menu_item"
            :initial-search="searchTerm"
            :type-search-always-in-container="false"
            @search="searchTerm = $event"
        />
        {% endblock %}
    </template>
    {% block sw_permissions_menu_list_smart_bar_header %}
    <template #smart-bar-header>
        <h2>{{ $t('sw-permissions.menu.headline') }}</h2>
    </template>
    {% endblock %}

    {% block sw_permissions_menu_list_language_switch %}
    <template #language-switch>
        <sw-language-switch
            :disabled="isBusy"
            :save-changes-function="saveOnLanguageChange"
            :abort-change-function="abortOnLanguageChange"
            @on-change="onLanguageChange"
        />
    </template>
    {% endblock %}

    {% block sw_permissions_menu_list_smart_bar_actions %}
    <template #smart-bar-actions>
        {% block sw_permissions_menu_list_smart_bar_actions_create %}
        <mt-button
            v-if="canCreate"
            class="sw-permissions-menu-list__button-create"
            size="default"
            variant="primary"
            :disabled="isBusy || undefined"
            @click="onCreateNew"
        >
            {{ $t('sw-permissions.menu.createAction') }}
        </mt-button>
        {% endblock %}
    </template>
    {% endblock %}

    {% block sw_permissions_menu_list_side_content %}
    {% endblock %}

    {% block sw_permissions_menu_list_content %}
    <template #content>
        {% block sw_permissions_menu_list_content_empty %}{% endblock %}
        <sw-card-view>
        {% block sw_permissions_menu_list_collapse %}
            <mt-card
                class="sw-permissions-menu-list__table-card"
                position-identifier="sw-permissions-menu-list"
                :title="$t('sw-permissions.menu.treeHeadline')"
            >
                <template #headerRight>
                    <mt-button
                        class="sw-permissions-menu-list__button-expand"
                        variant="tertiary"
                        size="small"
                        :disabled="!hasTree || isSearching || undefined"
                        @click="onToggleAll"
                    >
                        {{ $t(isAllExpanded ? 'sw-permissions.menu.collapseAll' : 'sw-permissions.menu.expandAll') }}
                    </mt-button>
                </template>
                <template #grid>
                {% block sw_permissions_menu_list_tree %}
                    <sw-extension-component-section position-identifier="sw-permissions-menu-list-tree" />
                    <mt-skeleton-bar v-if="isLoading" />
                    <mt-banner
                        v-else-if="store.isLoadFailed"
                        variant="critical"
                    >
                        {{ $t('sw-permissions.menu.notification.loadError') }}
                        <mt-button
                            variant="secondary"
                            size="small"
                            @click="loadTree"
                        >
                            {{ $t('sw-permissions.menu.retry') }}
                        </mt-button>
                    </mt-banner>
                    <sw-permissions-menu-tree
                        v-else-if="hasTree"
                        :items="filteredTree"
                        :route-labels="routeLabels"
                        :expanded-ids="effectiveExpandedIds"
                        :selected-id="selectedId"
                        :sortable="canEdit && !isSearching && !isBusy"
                        :editable="canEdit && !isBusy"
                        :creatable="canCreate && !isBusy"
                        :deletable="canDelete && !isBusy"
                        @toggle="onToggle"
                        @select="onItemSelect"
                        @edit="onItemSelect"
                        @create-above="onCreateAbove"
                        @create-below="onCreateBelow"
                        @add-child="onAddChild"
                        @remove="onDelete"
                        @move="onMove"
                    />
                    <mt-empty-state
                        v-else
                        icon="regular-list"
                        :headline="$t(isSearching ? 'sw-permissions.menu.searchEmptyHeadline' : 'sw-permissions.menu.treeEmpty')"
                    />
                {% endblock %}
                </template>
            </mt-card>
        {% endblock %}
        </sw-card-view>

        <mt-modal-root
            v-if="showEditModal && draft"
            is-open
            @change="onCloseEditModal"
        >
            <mt-modal
                class="sw-permissions-menu-list__edit-modal"
                :title="$t(draft.id ? 'sw-permissions.menu.editModalTitle' : 'sw-permissions.menu.createAction')"
                width="m"
            >
                <sw-permissions-menu-detail
                    :draft="draft"
                    :disabled="!canEditDraft"
                    :locked="isLocked"
                    :provenance="provenance"
                    :target-privilege="targetPrivilege"
                    :language-label="languageLabel"
                    :type-options="typeOptions"
                    :parent-options="parentOptions"
                    :route-options="routeOptions"
                    :field-errors="fieldErrors"
                    @update-draft="updateDraft"
                    @type-change="onTypeChange"
                    @parent-change="onParentChange"
                />
                <template #footer>
                    <div class="sw-permissions-menu-list__modal-footer">
                        <mt-button
                            class="sw-permissions-menu-list__button-cancel"
                            variant="secondary"
                            size="small"
                            :disabled="isBusy"
                            @click="onCloseEditModal"
                        >
                            {{ $t('global.default.cancel') }}
                        </mt-button>
        {% block sw_permissions_menu_list_smart_bar_actions_save %}
                        <mt-button
                            v-if="draft && canSaveDraft"
                            class="sw-permissions-menu-list__button-save"
                            size="small"
                            variant="primary"
                            :is-loading="isSaving"
                            :disabled="isBusy || undefined"
                            @click="onSave"
                        >
                            {{ $t('global.default.save') }}
                        </mt-button>
        {% endblock %}

                    </div>
                </template>
            </mt-modal>
        </mt-modal-root>

        {% block sw_permissions_menu_list_delete_modal %}
        <mt-modal-root
            v-if="showDeleteModal"
            is-open
            @change="onCloseDeleteModal"
        >
            <mt-modal
                :title="$t('sw-permissions.menu.deleteModalTitle')"
                width="s"
                class="sw-permissions-menu-list__delete-modal"
            >
                <p class="sw-permissions-menu-list__delete-confirm">
                    {{ deleteConfirmMessage }}
                </p>

                <template #footer>
                    <div class="sw-permissions-menu-list__modal-footer">
                        <mt-button
                            size="small"
                            variant="secondary"
                            @click="onCloseDeleteModal"
                        >
                            {{ $t('global.default.cancel') }}
                        </mt-button>

                        <mt-button
                            class="sw-permissions-menu-list__confirm-delete-button"
                            variant="critical"
                            size="small"
                            :is-loading="isDeleting"
                            @click="onConfirmDelete"
                        >
                            {{ $t('global.default.delete') }}
                        </mt-button>
                    </div>
                </template>
            </mt-modal>
        </mt-modal-root>
        {% endblock %}
        <mt-modal-root
            v-if="showUnsavedModal"
            is-open
            @change="onKeepEditing"
        >
            <mt-modal
                class="sw-permissions-menu-list__unsaved-modal"
                width="s"
                :title="$t('sw-permissions.menu.unsavedTitle')"
            >
                <p>{{ $t('sw-permissions.menu.unsavedDescription') }}</p>
                <template #footer>
                    <div class="sw-permissions-menu-list__modal-footer">
                        <mt-button
                            variant="secondary"
                            @click="onKeepEditing"
                        >
                            {{ $t('sw-permissions.menu.keepEditing') }}
                        </mt-button>
                        <mt-button
                            class="sw-permissions-menu-list__discard-changes"
                            variant="critical"
                            :disabled="isBusy || undefined"
                            @click="onDiscardChanges"
                        >
                            {{ $t('sw-permissions.menu.discardChanges') }}
                        </mt-button>
                        <mt-button
                            variant="primary"
                            :is-loading="isSaving"
                            @click="onSaveChanges"
                        >
                            {{ $t('global.default.save') }}
                        </mt-button>
                    </div>
                </template>
            </mt-modal>
        </mt-modal-root>

    </template>
    {% endblock %}

</sw-page>
{% endblock %}
