{% block sw_shopwell_updates_extensions %}
<mt-card
    position-identifier="sw-shopwell-updates-extensions"
    :title="$t('sw-settings-shopwell-updates.cards.extensions')"
    :is-loading="isLoading"
>
    {% block sw_shopwell_updates_extensions_empty_state %}
    <mt-empty-state
        v-if="!isLoading && !hasExtensions"
        class="sw-shopwell-updates-extensions__empty-state"
        :centered="true"
        icon="regular-plug"
        :headline="$t('sw-settings-shopwell-updates.extensions.emptyStateHeadline')"
        :description="$t('sw-settings-shopwell-updates.extensions.emptyStateDescription')"
    />
    {% endblock %}

    <template
        v-if="hasExtensions"
        #grid
    >
        <sw-data-grid
            :show-selection="false"
            :data-source="extensions"
            :columns="columns"
        >

            {% block sw_shopwell_updates_extensions_column_icon %}
            <template
                #column-icon="{ item, isInlineEdit }"
            >
                <sw-color-badge
                    v-if="item.statusVariant"
                    :variant="item.statusVariant"
                    :rounded="true"
                />
                <sw-color-badge
                    v-else
                    :color="item.statusColor"
                    :rounded="true"
                />&nbsp;

                <template v-if="item.statusMessage === 'notCompatible'">
                    {{ item.statusMessage }} {{ $t('sw-settings-shopwell-updates.extensions.extensionWillBeDeactivatedHint') }}
                </template>
                <template v-else-if="item.statusMessage">
                    {{ item.statusMessage }}
                </template>
                <template v-else>
                    {{ $t('sw-settings-shopwell-updates.extensions.extensionNotInStore') }}
                </template>
            </template>
            {% endblock %}

            {% block sw_shopwell_updates_extensions_column_action %}
            <template #actions="{item}">
                <sw-context-menu-item @click="openMyExtensions()">
                    {{ $t('sw-settings-shopwell-updates.extensions.actions.openMyExtensions') }}
                </sw-context-menu-item>
            </template>
            {% endblock %}
        </sw-data-grid>
    </template>
</mt-card>
{% endblock %}
