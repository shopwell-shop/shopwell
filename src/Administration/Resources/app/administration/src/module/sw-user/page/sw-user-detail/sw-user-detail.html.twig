{% block sw_user_detail %}
<sw-page class="sw-user-detail">
    {% block sw_user_detail_header %}
    <template #smart-bar-header>
        <h2 v-if="!isLoading">
            {% block sw_user_detail_header_breadcrumb %}
            <span>{{ $t('global.sw-admin-menu.navigation.mainMenuItemSystem') }}</span>

            <mt-icon
                name="regular-chevron-right-xs"
                size="12px"
            />

            <span>{{ $t('sw-user.general.label') }}</span>

            <mt-icon
                name="regular-chevron-right-xs"
                size="12px"
            />
            {% endblock %}

            {% block sw_user_detail_header_title %}
            <span>{{ fullName }}</span>
            {% endblock %}

            {% block sw_user_detail_header_inactive_badge %}
            <mt-badge
                v-if="user && !user.active"
                class="sw-user-detail__inactive-badge"
                size="s"
                variant="attention"
            >
                {{ $t('sw-user.users.user-detail.labelInactiveBadge') }}
            </mt-badge>
            {% endblock %}
        </h2>
    </template>
    {% endblock %}

    {% block sw_user_detail_actions %}
    <template #smart-bar-actions>
        {% block sw_user_detail_actions_cancel %}
        <mt-button
            v-tooltip.bottom="tooltipCancel"
            variant="secondary"
            size="default"
            @click="onCancel"
        >
            {{ $t('global.default.cancel') }}
        </mt-button>
        {% endblock %}

        {% block sw_user_detail_actions_save %}
        <sw-button-process
            v-tooltip.bottom="tooltipSave"
            class="sw-user-detail__save-action"
            :is-loading="isLoading"
            :process-success="isSaveSuccessful"
            :disabled="isLoading || !acl.can('user.editor') || undefined"
            variant="primary"
            @update:process-success="saveFinish"
            @click.prevent="onSave"
        >
            {{ $t('global.default.save') }}
        </sw-button-process>
        {% endblock %}
    </template>
    {% endblock %}

    {% block sw_user_detail_content %}
    <template #content>
        <sw-card-view>
            {% block sw_user_detail_content_inner %}
            <div class="sw-user-detail__cards">
                {% block sw_user_detail_content_tabs %}
                <mt-tabs
                    class="sw-user-detail__tabs"
                    position-identifier="sw-user-detail-tabs"
                    :default-item="activeTab"
                    :items="detailTabs"
                    @new-item-active="onTabChange"
                />
                {% endblock %}

                {% block sw_user_detail_tab_extension %}
                {# A tab registered by an extension is not one of ours: render its component section instead. #}
                <div
                    v-if="activeTabExtension"
                    class="sw-user-detail__tab-panel"
                >
                    <sw-extension-component-section :position-identifier="activeTabExtension" />
                </div>
                {% endblock %}

                {% block sw_user_detail_tab_general %}
                <div
                    v-if="isSectionVisible('general')"
                    class="sw-user-detail__tab-panel"
                >
                    {% block sw_user_detail_card_basic_information %}
                    <mt-card
                        position-identifier="sw-user-detail"
                        :title="$t('sw-user.users.user-detail.labelCard')"
                        :is-loading="isLoading"
                    >
                        {% block sw_user_detail_content_grid %}
                        <div
                            v-if="user"
                            class="sw-user-detail__grid sw-user-detail__information-grid"
                        >
                            {% block sw_user_detail_content_name %}
                            <mt-text-field
                                v-model="user.name"
                                name="sw-field--user-name"
                                class="sw-user-detail__grid-name"
                                :disabled="!acl.can('user.editor') || undefined"
                                :error="userNameError"
                                required
                                :label="$t('sw-user.users.user-detail.labelName')"
                            />
                            {% endblock %}

                            {% block sw_user_detail_content_email %}
                            <mt-text-field
                                v-model="user.email"
                                name="sw-field--user-email"
                                class="sw-user-detail__grid-eMail"
                                :error="userEmailError"
                                :disabled="!acl.can('user.editor') || undefined"
                                required
                                :label="$t('sw-user.users.user-detail.labelEmail')"
                            />
                            {% endblock %}

                            {% block sw_user_detail_content_phone_number %}
                            <mt-text-field
                                v-model="user.phoneNumber"
                                name="sw-field--user-phoneNumber"
                                class="sw-user-detail__grid-phoneNumber"
                                :disabled="!acl.can('user.editor') || undefined"
                                :label="$t('sw-user.users.user-detail.labelPhoneNumber')"
                            />
                            {% endblock %}

                            {% block sw_user_detail_content_username %}
                            <mt-text-field
                                v-model="user.username"
                                name="sw-field--user-username"
                                class="sw-user-detail__grid-username"
                                :error-message="isUsernameUsed ? $t('sw-user.users.user-detail.errorUsernameUsed') : ''"
                                :error="userUsernameError"
                                :disabled="!acl.can('user.editor') || undefined"
                                required
                                :label="$t('sw-user.users.user-detail.labelUsername')"
                                @update:model-value="checkUsername"
                            />
                            {% endblock %}

                            {% block sw_user_detail_content_password %}
                            <mt-password-field
                                class="sw-user-detail__grid-password"
                                :model-value="user.password"
                                name="sw-field--user-password"
                                :disabled="!acl.can('user.editor') || undefined"
                                :label="$t('sw-user.users.user-detail.labelPassword')"
                                :error="userPasswordError"
                                autocomplete="new-password"
                                @update:model-value="setPassword"
                            />
                            {% endblock %}

                            {% block sw_user_detail_grid_content_active %}
                            <mt-switch
                                v-model="user.active"
                                name="sw-field--user-active"
                                class="sw-user-detail__grid-active"
                                :label="$t('sw-user.users.user-detail.labelActive')"
                                :disabled="isCurrentUser || !acl.can('user.editor') || undefined"
                            />
                            {% endblock %}

                            {% block sw_user_detail_content_media_upload %}
                            <sw-upload-listener
                                :upload-tag="user.id"
                                auto-upload
                                @media-upload-finish="setMediaItem"
                            />
                            <sw-media-upload-v2
                                class="sw-user-detail__grid-profile-picture"
                                :source="avatarMedia"
                                :label="$t('sw-user.users.user-detail.labelProfilePicture')"
                                :upload-tag="user.id"
                                :allow-multi-select="false"
                                :source-context="user"
                                :disabled="!acl.can('user.editor') || undefined"
                                default-folder="user"
                                @media-drop="onDropMedia"
                                @media-upload-sidebar-open="onOpenMedia"
                                @media-upload-remove-image="onUnlinkLogo"
                            />
                            {% endblock %}
                        </div>
                        {% endblock %}
                    </mt-card>
                    {% endblock %}

                    {% block sw_user_detail_card_user_interface %}
                    <mt-card
                        position-identifier="sw-user-detail-user-interface"
                        :title="$t('sw-user.users.user-detail.labelUserInterface')"
                        :is-loading="isLoading"
                    >
                        {% block sw_user_detail_user_interface_grid %}
                        <div
                            v-if="user"
                            class="sw-user-detail__grid sw-user-detail__user-interface-grid"
                        >
                            {% block sw_user_detail_grid_content_language %}
                            <mt-select
                                v-model="user.localeId"
                                name="sw-field--user-localeId"
                                class="sw-user-detail__grid-language"
                                :label="$t('sw-user.users.user-detail.labelLanguage')"
                                :disabled="!acl.can('user.editor') || undefined"
                                :error="userLocaleIdError"
                                :options="localeOptions"
                                required
                                hide-clearable-button
                                :placeholder="$t('sw-user.users.user-detail.labelLanguagePlaceholder')"
                            />
                            {% endblock %}

                            {% block sw_user_detail_grid_content_timezone %}
                            <sw-single-select
                                v-model:value="user.timeZone"
                                name="sw-field--user-timeZone"
                                class="sw-user-detail__grid-timezone"
                                :options="timezoneOptions"
                                required
                                :label="$t('sw-user.users.user-detail.labelTimezone')"
                                :is-loading="timezoneOptions.length <= 0"
                                :disabled="!acl.can('user.update_profile') || undefined"
                            />
                            {% endblock %}

                            {% block sw_user_detail_grid_content_theme %}
                            <mt-theme-select
                                v-if="isCurrentUser"
                                v-model="userTheme"
                                name="sw-field--user-theme"
                                class="sw-user-detail__grid-theme"
                                :label="$t('sw-profile.index.labelThemeField') + ' (Experimental)'"
                            />
                            {% endblock %}

                            {% block sw_user_detail_grid_content_module_icon_colors %}
                            <mt-select
                                v-if="isCurrentUser"
                                v-model="userModuleIconColors"
                                name="sw-field--user-module-icon-colors"
                                class="sw-user-detail__grid-module-icon-colors"
                                :label="$t('sw-profile.index.labelModuleIconColorsField')"
                                :options="moduleIconColorsOptions"
                                hide-clearable-button
                            />
                            {% endblock %}
                        </div>
                        {% endblock %}
                    </mt-card>
                    {% endblock %}
                </div>
                {% endblock %}

                {% block sw_user_detail_tab_permissions %}
                <div
                    v-if="isSectionVisible('permissions')"
                    class="sw-user-detail__tab-panel"
                >
                    {% block sw_user_detail_card_roles_permissions %}
                    <mt-card
                        position-identifier="sw-user-detail-roles-permissions"
                        :title="$t('sw-user.users.user-detail.labelRolesPermissionsCard')"
                        :is-loading="isLoading"
                    >
                        {% block sw_user_detail_roles_permissions_hint %}
                        {# This page grants permissions through roles only; spell it out so nobody looks for checkboxes here. #}
                        <mt-banner
                            v-if="user"
                            class="sw-user-detail__roles-hint"
                            variant="info"
                        >
                            {{ $t('sw-user.users.user-detail.hintPermissionsFromRoles') }}
                        </mt-banner>
                        {% endblock %}

                        {% block sw_user_detail_roles_permissions_grid %}
                        <div
                            v-if="user"
                            class="sw-user-detail__grid sw-user-detail__roles-permissions-grid"
                        >
                            {% block sw_user_detail_grid_content_acl_roles %}
                            <sw-entity-multi-select
                                v-model:entity-collection="user.aclRoles"
                                v-tooltip="{
                                    showDelay: 300,
                                    message: $t('sw-user.users.user-detail.disabledRoleSelectWarning'),
                                    disabled: !user.admin || !acl.can('user.editor')
                                }"
                                name="sw-field--user-aclRoles"
                                class="sw-user-detail__grid-aclRoles"
                                :label="$t('sw-user.users.user-detail.labelRoles')"
                                :disabled="user.admin || !acl.can('user.editor') || undefined"
                                :criteria="aclRoleCriteria"
                                label-property="name"
                            />
                            {% endblock %}

                            {% block sw_user_detail_grid_content_job_title %}
                            <mt-text-field
                                v-model="user.title"
                                name="sw-field--user-title"
                                class="sw-user-detail__grid-jobTitle"
                                :disabled="!acl.can('user.editor') || undefined"
                                :label="$t('sw-user.users.user-detail.labelJobTitle')"
                            />
                            {% endblock %}

                            {% block sw_user_detail_grid_content_acl_is_admin %}
                            {# Only a super admin can grant or revoke the admin flag. The API rejects the write otherwise. #}
                            <mt-switch
                                v-model="user.admin"
                                name="sw-field--user-admin"
                                class="sw-user-detail__grid-is-admin"
                                :label="$t('sw-user.users.user-detail.labelAdministrator')"
                                :disabled="isCurrentUser || !acl.isAdmin() || undefined"
                            />
                            {% endblock %}
                        </div>
                        {% endblock %}
                    </mt-card>
                    {% endblock %}

                    {% block sw_user_detail_card_integrations %}
                    <mt-card
                        :title="$t('sw-user.users.user-detail.labelIntegrationsCard')"
                        position-identifier="sw-user-detail-integrations"
                    >
                        {% block sw_user_detail_grid_toolbar %}
                        <template #headerRight>
                            {% block sw_user_detail_grid_add_key %}
                            <mt-button
                                variant="secondary"
                                size="small"
                                :disabled="!$route.params.id || !acl.can('user.editor') || undefined"
                                @click="addAccessKey"
                            >
                                {{ $t('sw-user.users.user-detail.addAccessKey') }}
                            </mt-button>
                            {% endblock %}
                        </template>
                        {% endblock %}

                        {% block sw_user_detail_key_grid %}
                        <template #grid>
                            {% block sw_user_detail_key_grid_content %}
                            <sw-data-grid
                                :is-loading="isLoading"
                                :data-source="integrations"
                                :columns="integrationColumns"
                                identifier="user-grid"
                                :show-settings="true"
                                :skeleton-item-amount="skeletonItemAmount"
                            >
                                {% block sw_user_detail_grid_columns_actions %}
                                <template #actions="{ item }">
                                    {% block sw_user_detail_grid_columns_actions_edit %}
                                    <sw-context-menu-item
                                        class="sw-user-detail__grid-context-menu-edit sw-product-list__edit-action"
                                        :disabled="!acl.can('user.editor') || undefined"
                                        @click="onShowDetailModal(item.id)"
                                    >
                                        {{ $t('sw-user.users.user-detail.contextMenuEdit') }}
                                    </sw-context-menu-item>
                                    {% endblock %}

                                    {% block sw_user_detail_grid_columns_actions_delete %}
                                    <sw-context-menu-item
                                        class="sw-user-detail__grid-context-menu-delete"
                                        :disabled="!acl.can('user.editor') || undefined"
                                        variant="danger"
                                        @click="showDeleteModal = item.id"
                                    >
                                        {{ $t('global.default.delete') }}
                                    </sw-context-menu-item>
                                    {% endblock %}
                                </template>
                                {% endblock %}
                            </sw-data-grid>

                            <mt-empty-state
                                v-if="integrations.length === 0 && !isLoading"
                                centered
                                :icon="$route.meta.$module.icon"
                                :headline="$t('sw-user.users.user-detail.noAccessKeysTitle')"
                                :description="$t('sw-user.users.user-detail.noAccessKeysSubline')"
                            />
                            {% endblock %}
                        </template>
                        {% endblock %}
                    </mt-card>
                    {% endblock %}

                    {% block sw_user_detail_card_mcp_allowlist %}
                    <mt-card
                        v-if="user && acl.can('integration_mcp.editor')"
                        :title="$t('sw-user.users.user-detail.mcpAllowlistTitle')"
                        position-identifier="sw-user-detail-mcp-allowlist"
                    >
                        <sw-integration-mcp-allowlist
                            :allowlist="user.mcpAllowlist"
                            :disabled="!acl.can('user.editor') || !$route.params.id"
                            :is-admin="user.admin"
                            :unrestricted-when-unset="user.admin"
                            :granted-privileges="mcpGrantedPrivileges"
                            @update:allowlist="onMcpAllowlistUpdate"
                        />
                    </mt-card>
                    {% endblock %}
                </div>
                {% endblock %}

                {% block sw_user_detail_tab_organization %}
                <div
                    v-if="isSectionVisible('organization')"
                    class="sw-user-detail__tab-panel"
                >
                    {% block sw_user_detail_card_organization_units %}
                    <mt-card
                        v-if="user"
                        class="sw-user-detail__organization-units-card"
                        position-identifier="sw-user-detail-organization-units"
                        :title="$t('sw-user.users.user-detail.cardOrganizationUnits')"
                        :is-loading="isLoading"
                    >
                        {% block sw_user_detail_card_organization_units_select %}
                        <sw-entity-multi-id-select
                            v-model:value="selectedUnitIds"
                            class="sw-user-detail__organization-units-select"
                            :repository="organizationUnitRepository"
                            :disabled="!acl.can('user.editor') || undefined"
                            :label="$t('sw-user.users.user-detail.labelOrganizationUnits')"
                            :placeholder="$t('sw-user.users.user-detail.placeholderSelectUnits')"
                            :help-text="selectedUnitIds.length === 0 ? $t('sw-user.users.user-detail.helperNoUnit') : ''"
                        />
                        {% endblock %}

                        {% block sw_user_detail_card_organization_units_primary %}
                        <mt-select
                            v-if="selectedUnitIds.length > 0"
                            class="sw-user-detail__primary-unit-select"
                            :model-value="primaryUnitId"
                            :disabled="!acl.can('user.editor') || undefined"
                            :label="$t('sw-user.users.user-detail.labelPrimaryUnit')"
                            :placeholder="$t('sw-user.users.user-detail.placeholderSelectPrimaryUnit')"
                            :help-text="$t('sw-user.users.user-detail.helperPrimaryUnit')"
                            :options="selectedUnitOptions"
                            @update:model-value="onPrimaryUnitChange"
                        />
                        {% endblock %}
                    </mt-card>
                    {% endblock %}

                    {% block sw_user_detail_card_positions %}
                    <mt-card
                        v-if="user"
                        class="sw-user-detail__positions-card"
                        position-identifier="sw-user-detail-positions"
                        :title="$t('sw-user.users.user-detail.cardPositions')"
                        :is-loading="isLoading"
                    >
                        {% block sw_user_detail_card_positions_select %}
                        <sw-entity-multi-id-select
                            v-model:value="selectedPositionIds"
                            class="sw-user-detail__positions-select"
                            :repository="positionRepository"
                            :disabled="!acl.can('user.editor') || undefined"
                            :label="$t('sw-user.users.user-detail.labelPositions')"
                            :placeholder="$t('sw-user.users.user-detail.placeholderSelectPositions')"
                        />
                        {% endblock %}
                    </mt-card>
                    {% endblock %}
                </div>
                {% endblock %}
            </div>

            <!-- Outside the cards container: its layout containment would trap the fixed-position modal. -->
            {% block sw_user_detail_content_confirm_password_modal %}
            <sw-verify-user-modal
                v-if="confirmPasswordModal"
                @verified="saveUser"
                @close="onCloseConfirmPasswordModal"
            />
            {% endblock %}
            {% endblock %}
        </sw-card-view>

        {% block sw_user_detail_grid_inner_slot_media_modal %}
        <sw-media-modal-v2
            v-if="showMediaModal"
            :allow-multi-select="false"
            :initial-folder-id="mediaDefaultFolderId"
            entity-context="user"
            @modal-close="showMediaModal = false"
            @media-modal-selection-change="onMediaSelectionChange"
        />
        {% endblock %}

        {% block sw_user_detail_grid_inner_slot_delete_modal %}
        <sw-modal
            v-if="showDeleteModal"
            :title="$t('global.default.warning')"
            @modal-close="onCloseDeleteModal"
        >
            {% block sw_user_detail_grid_inner_slot_delete_modal_confirm_text %}
            <p>
                {{ $t('sw-user.users.user-detail.modal.confirmDelete') }}
            </p>
            {% endblock %}

            {% block sw_user_detail_grid_inner_slot_delete_modal_footer %}
            <template #modal-footer>
                <mt-button
                    size="small"
                    variant="secondary"
                    @click="onCloseDeleteModal"
                >
                    {{ $t('global.default.cancel') }}
                </mt-button>

                <mt-button
                    size="small"
                    variant="critical"
                    @click="onConfirmDelete(showDeleteModal)"
                >
                    {{ $t('global.default.delete') }}
                </mt-button>
            </template>
            {% endblock %}
        </sw-modal>
        {% endblock %}

        {% block sw_user_detail_detail_modal %}
        <sw-modal
            v-if="currentIntegration"
            size="550px"
            class="sw-user-detail__detail"
            :is-loading="isModalLoading"
            :title="showSecretAccessKey ? $t('global.default.warning') : $t('global.default.edit')"
            @modal-close="onCloseDetailModal"
        >
            {% block sw_user_detail_detail_modal_inner %}
            {% block sw_user_detail_detail_modal_inner_field_access_key %}
            <mt-text-field
                v-model="currentIntegration.accessKey"
                :label="$t('sw-user.users.user-detail.modal.idFieldLabel')"
                :disabled="true"
                :copyable="true"
                :copyable-tooltip="true"
            />
            {% endblock %}

            {% block sw_user_detail_detail_modal_inner_field_secret_access_key %}
            {% block sw_user_detail_detail_modal_inner_field_secret_access_key_field %}
            <mt-text-field
                v-if="showSecretAccessKey"
                v-model="currentIntegration.secretAccessKey"
                :label="$t('sw-user.users.user-detail.modal.secretFieldLabel')"
                :disabled="true"
                :password-toggle-able="false"
                :copyable="showSecretAccessKey"
                :copyable-tooltip="true"
            />

            <mt-password-field
                v-else
                v-model="currentIntegration.secretAccessKey"
                :label="$t('sw-user.users.user-detail.modal.secretFieldLabel')"
                :disabled="true"
                :password-toggle-able="false"
                :copyable="showSecretAccessKey"
                :copyable-tooltip="true"
                autocomplete="off"
            />
            {% endblock %}

            {% block sw_user_detail_detail_modal_inner_field_secret_access_key_button %}
            <mt-button
                v-if="!showSecretAccessKey"
                class="sw-user-detail__secret-help-text-button sw-field"
                variant="critical"
                :block="true"
                @click="addAccessKey"
            >
                {{ $t('sw-user.users.user-detail.modal.buttonCreateNewApiKeys') }}
            </mt-button>
            {% endblock %}

            {% block sw_user_detail_detail_modal_inner_field_help_text %}
            <mt-banner
                v-if="!showSecretAccessKey"
                variant="attention"
                class="sw-user-detail__secret-help-text-alert"
            >
                {{ $t('sw-user.users.user-detail.modal.hintCreateNewApiKeys') }}
            </mt-banner>
            {% endblock %}
            {% endblock %}

            {% block sw_user_detail_detail_modal_inner_help_text %}
            <mt-banner
                v-else
                variant="attention"
                class="sw-user-detail__secret-help-text-alert"
            >
                {{ $t('sw-user.users.user-detail.modal.secretHelpText') }}
            </mt-banner>
            {% endblock %}

            {% block sw_user_detail_detail_modal_inner_footer %}
            <template #modal-footer>
                {% block sw_user_detail_detail_modal_inner_footer_cancel %}
                <mt-button
                    size="small"
                    :disabled="isModalLoading || undefined"
                    variant="secondary"
                    @click="onCloseDetailModal"
                >
                    {{ $t('global.default.cancel') }}
                </mt-button>
                {% endblock %}

                {% block sw_user_detail_detail_modal_inner_footer_apply %}
                <mt-button
                    size="small"
                    class="sw-user-detail__save-action"
                    :disabled="isModalLoading && !!currentIntegration.label || undefined"
                    variant="primary"
                    @click="onSaveIntegration"
                >
                    {{ showSecretAccessKey ? $t('sw-user.users.user-detail.modal.buttonApply') : $t('sw-user.users.user-detail.modal.buttonApplyEdit') }}
                </mt-button>
                {% endblock %}
            </template>
            {% endblock %}
            {% endblock %}
        </sw-modal>
        {% endblock %}
    </template>
    {% endblock %}
</sw-page>
{% endblock %}
