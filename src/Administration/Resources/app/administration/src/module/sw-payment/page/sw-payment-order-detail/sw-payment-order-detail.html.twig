{% block sw_payment_order_detail %}
<sw-page
    class="sw-payment-order-detail"
    position-identifier="sw-payment-order-detail"
>

    {% block sw_payment_order_detail_smart_bar_header %}
    <template #smart-bar-header>
        {% block sw_payment_order_detail_smart_bar_header_title %}
        <h2 class="sw-payment-order-detail__header">
            {% block sw_payment_order_detail_smart_bar_header_breadcrumb %}
            <mt-link
                class="sw-payment-order-detail__breadcrumb"
                :to="{ name: 'sw.payment.index' }"
            >
                {{ $t('sw-payment.order.list.title') }}
            </mt-link>

            <mt-icon
                name="regular-chevron-right-xs"
                size="12px"
            />

            <span>{{ order ? order.paymentNo : $t('sw-payment.order.detail.title') }}</span>
            {% endblock %}

            {% block sw_payment_order_detail_smart_bar_header_state %}
            <mt-badge
                v-if="order && order.stateId"
                class="sw-payment-order-detail__header-state"
                :variant="orderStateVariant(order.stateId)"
            >
                {{ orderStateLabel(order.stateId) }}
            </mt-badge>
            {% endblock %}
        </h2>
        {% endblock %}
    </template>
    {% endblock %}

    {% block sw_payment_order_detail_smart_bar_actions %}
    <template #smart-bar-actions>
        {% block sw_payment_order_detail_smart_bar_actions_order %}
        <mt-button
            v-if="orderLink"
            class="sw-payment-order-detail__button-order"
            variant="secondary"
            size="default"
            @click="$router.push(orderLink)"
        >
            {{ $t('sw-payment.order.detail.buttonShopOrder') }}
        </mt-button>
        {% endblock %}

        {% block sw_payment_order_detail_smart_bar_actions_refresh %}
        <mt-button
            v-tooltip.bottom="$t('sw-payment.order.detail.buttonRefresh')"
            class="sw-payment-order-detail__button-refresh"
            variant="secondary"
            size="default"
            :disabled="!order || undefined"
            @click="onRefresh"
        >
            {{ $t('sw-payment.order.detail.buttonRefresh') }}
        </mt-button>
        {% endblock %}
    </template>
    {% endblock %}

    {% block sw_payment_order_detail_content %}
    <template #content>
        {% block sw_payment_order_detail_loading %}
        <mt-card
            v-if="!order && isLoading"
            class="sw-payment-order-detail__loading"
            position-identifier="sw-payment-order-detail-loading"
            :is-loading="true"
        >
            <div class="sw-payment-order-detail__loading-placeholder"></div>
        </mt-card>
        {% endblock %}

        {% block sw_payment_order_detail_not_found %}
        <mt-empty-state
            v-if="!order && !isLoading"
            class="sw-payment-order-detail__not-found"
            centered
            icon="regular-credit-card"
            :headline="$t('sw-payment.order.detail.messageNotFound')"
            :description="$t('sw-payment.order.detail.messageNotFoundSubline')"
        >
            <template #button>
                <mt-button
                    variant="primary"
                    @click="$router.push({ name: 'sw.payment.index' })"
                >
                    {{ $t('sw-payment.order.list.title') }}
                </mt-button>
            </template>
        </mt-empty-state>
        {% endblock %}

        {% block sw_payment_order_detail_layout %}
        <div
            v-if="order"
            class="sw-payment-order-detail__layout"
        >
            {% block sw_payment_order_detail_main %}
            <div class="sw-payment-order-detail__main">
                {% block sw_payment_order_detail_summary %}
                <mt-card
                    class="sw-payment-order-detail__summary"
                    position-identifier="sw-payment-order-detail-summary"
                >
                    <sw-payment-order-summary :order="order" />
                </mt-card>
                {% endblock %}

                {% block sw_payment_order_detail_alerts %}
                <mt-banner
                    v-for="alert in alerts"
                    :key="alert.id"
                    class="sw-payment-order-detail__alert"
                    :variant="alert.variant"
                >
                    {{ alert.message }}
                </mt-banner>
                {% endblock %}

                {% block sw_payment_order_detail_activity %}
                <mt-card
                    class="sw-payment-order-detail__activity"
                    position-identifier="sw-payment-order-detail-activity"
                    :title="$t('sw-payment.order.detail.cardActivityTitle')"
                >
                    <sw-payment-order-activity :activities="activities" />
                </mt-card>
                {% endblock %}

                {% block sw_payment_order_detail_channel_data %}
                <mt-card
                    v-if="hasChannelData"
                    class="sw-payment-order-detail__channel-data"
                    position-identifier="sw-payment-order-detail-channel-data"
                    :title="$t('sw-payment.order.detail.cardChannelDataTitle')"
                >
                    <pre class="sw-payment-order-detail__payload">{{ channelDataJson }}</pre>
                </mt-card>
                {% endblock %}
            </div>
            {% endblock %}

            {% block sw_payment_order_detail_rail %}
            <aside class="sw-payment-order-detail__rail">
                {% block sw_payment_order_detail_refunds %}
                <mt-card
                    v-if="refunds.length > 0"
                    class="sw-payment-order-detail__refunds"
                    position-identifier="sw-payment-order-detail-refunds"
                    :title="$t('sw-payment.order.detail.cardRefundsTitle')"
                >
                    <ul class="sw-payment-order-detail__refund-list">
                        <li
                            v-for="refund in refunds"
                            :key="refund.id"
                            class="sw-payment-order-detail__refund"
                        >
                            <div class="sw-payment-order-detail__refund-head">
                                <router-link
                                    class="sw-payment-order-detail__refund-link"
                                    :to="{ name: 'sw.payment.refundDetail', params: { id: refund.id } }"
                                >
                                    {{ refund.refundNo }}
                                </router-link>

                                <span class="sw-payment-order-detail__refund-amount">
                                    {{ formatAmount(refund.amount, refund.currency) }}
                                </span>
                            </div>

                            <div class="sw-payment-order-detail__refund-meta">
                                <mt-badge :variant="refundStateVariant(refund.stateId)">
                                    {{ refundStateLabel(refund.stateId) }}
                                </mt-badge>

                                <span>{{ formatDateOrDash(refund.refundedAt || refund.createdAt) }}</span>
                            </div>
                        </li>
                    </ul>
                </mt-card>
                {% endblock %}

                {% block sw_payment_order_detail_identifiers %}
                <mt-card
                    class="sw-payment-order-detail__identifiers"
                    position-identifier="sw-payment-order-detail-identifiers"
                    :title="$t('sw-payment.order.detail.cardIdentifiersTitle')"
                >
                    <sw-description-list grid="1fr 2fr">
                        <dt>{{ $t('sw-payment.order.detail.labelPaymentNo') }}</dt>
                        <dd><sw-payment-identifier :value="order.paymentNo" /></dd>

                        <dt>{{ $t('sw-payment.order.detail.labelOutTradeNo') }}</dt>
                        <dd><sw-payment-identifier :value="order.outTradeNo" /></dd>

                        <dt>{{ $t('sw-payment.order.detail.labelOutPaymentNo') }}</dt>
                        <dd><sw-payment-identifier :value="order.outPaymentNo" /></dd>

                        <dt>{{ $t('sw-payment.order.detail.labelIdempotencyKey') }}</dt>
                        <dd><sw-payment-identifier :value="order.idempotencyKey" /></dd>
                    </sw-description-list>
                </mt-card>
                {% endblock %}

                {% block sw_payment_order_detail_request %}
                <mt-card
                    class="sw-payment-order-detail__request"
                    position-identifier="sw-payment-order-detail-request"
                    :title="$t('sw-payment.order.detail.cardRequestTitle')"
                >
                    <sw-description-list grid="1fr 2fr">
                        <dt>{{ $t('sw-payment.order.detail.labelSubject') }}</dt>
                        <dd>{{ order.subject }}</dd>

                        <dt>{{ $t('sw-payment.order.detail.labelBody') }}</dt>
                        <dd>{{ order.body || '–' }}</dd>

                        <dt>{{ $t('sw-payment.order.detail.labelAttach') }}</dt>
                        <dd>{{ order.attach || '–' }}</dd>

                        <dt>{{ $t('sw-payment.order.detail.labelClientIp') }}</dt>
                        <dd>{{ order.clientIp || '–' }}</dd>

                        <dt>{{ $t('sw-payment.order.detail.labelDevice') }}</dt>
                        <dd>{{ order.device || '–' }}</dd>

                        <dt>{{ $t('sw-payment.order.detail.labelReturnUrl') }}</dt>
                        <dd>{{ order.returnUrl || '–' }}</dd>

                        <dt>{{ $t('sw-payment.order.detail.labelNotifyUrl') }}</dt>
                        <dd>{{ order.notifyUrl || '–' }}</dd>
                    </sw-description-list>
                </mt-card>
                {% endblock %}

                {% block sw_payment_order_detail_timeline_dates %}
                <mt-card
                    class="sw-payment-order-detail__dates"
                    position-identifier="sw-payment-order-detail-dates"
                    :title="$t('sw-payment.order.detail.cardDatesTitle')"
                >
                    <sw-description-list grid="1fr 2fr">
                        <dt>{{ $t('sw-payment.order.detail.labelCreatedAt') }}</dt>
                        <dd>{{ formatDateOrDash(order.createdAt) }}</dd>

                        <dt>{{ $t('sw-payment.order.detail.labelPaidAt') }}</dt>
                        <dd>{{ formatDateOrDash(order.paidAt) }}</dd>

                        <dt>{{ $t('sw-payment.order.detail.labelExpireAt') }}</dt>
                        <dd>{{ formatDateOrDash(order.expireAt) }}</dd>

                        <dt>{{ $t('sw-payment.order.detail.labelClosedAt') }}</dt>
                        <dd>{{ formatDateOrDash(order.closedAt) }}</dd>

                        <dt>{{ $t('sw-payment.order.detail.labelUpdatedAt') }}</dt>
                        <dd>{{ formatDateOrDash(order.updatedAt) }}</dd>
                    </sw-description-list>
                </mt-card>
                {% endblock %}
            </aside>
            {% endblock %}
        </div>
        {% endblock %}
    </template>
    {% endblock %}

</sw-page>
{% endblock %}
