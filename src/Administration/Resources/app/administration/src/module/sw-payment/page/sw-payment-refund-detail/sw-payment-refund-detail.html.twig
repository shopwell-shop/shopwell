{% block sw_payment_refund_detail %}
<sw-page
    class="sw-payment-refund-detail"
    position-identifier="sw-payment-refund-detail"
>

    {% block sw_payment_refund_detail_smart_bar_header %}
    <template #smart-bar-header>
        {% block sw_payment_refund_detail_smart_bar_header_title %}
        <h2 class="sw-payment-refund-detail__header">
            {% block sw_payment_refund_detail_smart_bar_header_breadcrumb %}
            <mt-link
                class="sw-payment-refund-detail__breadcrumb"
                :to="{ name: 'sw.payment.refund' }"
            >
                {{ $t('sw-payment.refund.list.title') }}
            </mt-link>

            <mt-icon
                name="regular-chevron-right-xs"
                size="12px"
            />

            <span>{{ refund ? refund.refundNo : $t('sw-payment.refund.detail.title') }}</span>
            {% endblock %}

            {% block sw_payment_refund_detail_smart_bar_header_state %}
            <mt-badge
                v-if="refund && refund.stateId"
                class="sw-payment-refund-detail__header-state"
                :variant="refundStateVariant(refund.stateId)"
            >
                {{ refundStateLabel(refund.stateId) }}
            </mt-badge>
            {% endblock %}
        </h2>
        {% endblock %}
    </template>
    {% endblock %}

    {% block sw_payment_refund_detail_smart_bar_actions %}
    <template #smart-bar-actions>
        {% block sw_payment_refund_detail_smart_bar_actions_order %}
        <mt-button
            v-if="orderLink"
            class="sw-payment-refund-detail__button-order"
            variant="secondary"
            size="default"
            @click="$router.push(orderLink)"
        >
            {{ $t('sw-payment.refund.detail.buttonPaymentOrder') }}
        </mt-button>
        {% endblock %}

        {% block sw_payment_refund_detail_smart_bar_actions_refresh %}
        <mt-button
            v-tooltip.bottom="$t('sw-payment.refund.detail.buttonRefresh')"
            class="sw-payment-refund-detail__button-refresh"
            variant="secondary"
            size="default"
            :disabled="!refund || undefined"
            @click="onRefresh"
        >
            {{ $t('sw-payment.refund.detail.buttonRefresh') }}
        </mt-button>
        {% endblock %}
    </template>
    {% endblock %}

    {% block sw_payment_refund_detail_content %}
    <template #content>
        {% block sw_payment_refund_detail_loading %}
        <mt-card
            v-if="!refund && isLoading"
            class="sw-payment-refund-detail__loading"
            position-identifier="sw-payment-refund-detail-loading"
            :is-loading="true"
        >
            <div class="sw-payment-refund-detail__loading-placeholder"></div>
        </mt-card>
        {% endblock %}

        {% block sw_payment_refund_detail_not_found %}
        <mt-empty-state
            v-if="!refund && !isLoading"
            class="sw-payment-refund-detail__not-found"
            centered
            icon="regular-money-bill"
            :headline="$t('sw-payment.refund.detail.messageNotFound')"
            :description="$t('sw-payment.refund.detail.messageNotFoundSubline')"
        >
            <template #button>
                <mt-button
                    variant="primary"
                    @click="$router.push({ name: 'sw.payment.refund' })"
                >
                    {{ $t('sw-payment.refund.list.title') }}
                </mt-button>
            </template>
        </mt-empty-state>
        {% endblock %}

        {% block sw_payment_refund_detail_layout %}
        <div
            v-if="refund"
            class="sw-payment-refund-detail__layout"
        >
            {% block sw_payment_refund_detail_main %}
            <div class="sw-payment-refund-detail__main">
                {% block sw_payment_refund_detail_summary %}
                <mt-card
                    class="sw-payment-refund-detail__summary"
                    position-identifier="sw-payment-refund-detail-summary"
                >
                    <div class="sw-payment-refund-detail__amount">
                        <span class="sw-payment-refund-detail__amount-label">
                            {{ $t('sw-payment.refund.detail.labelAmount') }}
                        </span>
                        <span class="sw-payment-refund-detail__amount-value">
                            {{ formatAmount(refund.amount, refund.currency) }}
                        </span>
                    </div>

                    <sw-description-list
                        class="sw-payment-refund-detail__facts"
                        grid="1fr 2fr"
                    >
                        <dt>{{ $t('sw-payment.refund.detail.labelReason') }}</dt>
                        <dd>{{ refund.reason || '–' }}</dd>

                        <dt>{{ $t('sw-payment.refund.detail.labelRefundedAt') }}</dt>
                        <dd>{{ formatDateOrDash(refund.refundedAt) }}</dd>

                        <dt>{{ $t('sw-payment.refund.detail.labelCreatedAt') }}</dt>
                        <dd>{{ formatDateOrDash(refund.createdAt) }}</dd>

                        <dt>{{ $t('sw-payment.refund.detail.labelUpdatedAt') }}</dt>
                        <dd>{{ formatDateOrDash(refund.updatedAt) }}</dd>
                    </sw-description-list>
                </mt-card>
                {% endblock %}

                {% block sw_payment_refund_detail_order %}
                <mt-card
                    class="sw-payment-refund-detail__order"
                    position-identifier="sw-payment-refund-detail-order"
                    :title="$t('sw-payment.refund.detail.cardOrderTitle')"
                >
                    <sw-description-list
                        v-if="order"
                        grid="1fr 2fr"
                    >
                        <dt>{{ $t('sw-payment.refund.detail.labelPaymentOrder') }}</dt>
                        <dd>
                            <router-link
                                v-if="orderLink"
                                class="sw-payment-refund-detail__order-link"
                                :to="orderLink"
                            >
                                {{ order.paymentNo }}
                            </router-link>
                        </dd>

                        <dt>{{ $t('sw-payment.refund.detail.labelOutPaymentNo') }}</dt>
                        <dd><sw-payment-identifier :value="order.outPaymentNo" /></dd>

                        <dt>{{ $t('sw-payment.order.detail.labelAmount') }}</dt>
                        <dd>{{ formatAmount(order.amount, order.currency) }}</dd>

                        <dt>{{ $t('sw-payment.order.detail.labelPaidAmount') }}</dt>
                        <dd>{{ formatAmount(order.paidAmount, order.currency) }}</dd>

                        <dt>{{ $t('sw-payment.order.detail.labelRefundedAmount') }}</dt>
                        <dd>{{ formatAmount(order.refundedAmount, order.currency) }}</dd>

                        <dt>{{ $t('sw-payment.refund.detail.labelChannel') }}</dt>
                        <dd>{{ order.channelTechnicalName }}</dd>

                        <dt>{{ $t('sw-payment.refund.detail.labelPaymentApp') }}</dt>
                        <dd>{{ paymentAppLabel() }}</dd>

                        <dt>{{ $t('sw-payment.order.detail.labelPaidAt') }}</dt>
                        <dd>{{ formatDateOrDash(order.paidAt) }}</dd>
                    </sw-description-list>

                    <p v-else>
                        {{ $t('sw-payment.refund.list.messageEmpty') }}
                    </p>
                </mt-card>
                {% endblock %}

                {% block sw_payment_refund_detail_payload %}
                <mt-card
                    v-if="hasPayload"
                    class="sw-payment-refund-detail__payload-card"
                    position-identifier="sw-payment-refund-detail-payload"
                    :title="$t('sw-payment.refund.detail.cardPayloadTitle')"
                >
                    <div class="sw-payment-refund-detail__payload-grid">
                        <div class="sw-payment-refund-detail__payload-block">
                            <h4>{{ $t('sw-payment.refund.detail.labelRequestPayload') }}</h4>
                            <pre class="sw-payment-refund-detail__payload">{{ requestPayloadJson || '–' }}</pre>
                        </div>

                        <div class="sw-payment-refund-detail__payload-block">
                            <h4>{{ $t('sw-payment.refund.detail.labelResponsePayload') }}</h4>
                            <pre class="sw-payment-refund-detail__payload">{{ responsePayloadJson || '–' }}</pre>
                        </div>
                    </div>
                </mt-card>
                {% endblock %}
            </div>
            {% endblock %}

            {% block sw_payment_refund_detail_rail %}
            <aside class="sw-payment-refund-detail__rail">
                {% block sw_payment_refund_detail_identifiers %}
                <mt-card
                    class="sw-payment-refund-detail__identifiers"
                    position-identifier="sw-payment-refund-detail-identifiers"
                    :title="$t('sw-payment.refund.detail.cardIdentifiersTitle')"
                >
                    <sw-description-list grid="1fr 2fr">
                        <dt>{{ $t('sw-payment.refund.detail.labelRefundNo') }}</dt>
                        <dd><sw-payment-identifier :value="refund.refundNo" /></dd>

                        <dt>{{ $t('sw-payment.refund.detail.labelOutRefundNo') }}</dt>
                        <dd><sw-payment-identifier :value="refund.outRefundNo" /></dd>

                        <dt>{{ $t('sw-payment.refund.detail.labelOutRefundId') }}</dt>
                        <dd><sw-payment-identifier :value="refund.outRefundId" /></dd>
                    </sw-description-list>
                </mt-card>
                {% endblock %}
            </aside>
            {% endblock %}
        </div>
        {% endblock %}
    </template>
    {% endblock %}

</sw-page>
{% endblock %}
