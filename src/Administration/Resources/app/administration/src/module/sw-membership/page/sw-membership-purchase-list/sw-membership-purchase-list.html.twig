{% block sw_loyalty_order_list %}
<sw-page class="sw-membership-purchase-list">

    {% block sw_loyalty_order_list_search_bar %}
    <template #search-bar>
        <sw-search-bar
            initial-search-type="membership_purchase"
            :initial-search="term"
            @search="onSearch"
        />
    </template>
    {% endblock %}

    {% block sw_loyalty_order_list_smart_bar_header %}
    <template #smart-bar-header>
        {% block sw_loyalty_order_list_smart_bar_header_title %}
        <h2>
            {% block sw_loyalty_order_list_smart_bar_header_title_text %}
            {{ $t('sw-membership.purchase.general.mainMenuItemGeneral') }}
            {% endblock %}

            {% block sw_loyalty_order_list_smart_bar_header_amount %}
            <span
                v-if="!isLoading"
                class="sw-page__smart-bar-amount"
            >
                ({{ total }})
            </span>
            {% endblock %}
        </h2>
        {% endblock %}
    </template>
    {% endblock %}

    {% block sw_loyalty_order_list_content %}
    <template #content>
        {% block sw_loyalty_order_list_content %}
        <div class="sw-membership-purchase-list__content">
            <sw-extension-component-section position-identifier="sw-membership-purchase-list" />

            {% block sw_loyalty_order_list_empty_state %}
            <mt-empty-state
                v-if="!isLoading && !total"
                centered
                :icon="$route.meta.$module.icon"
                :headline="hasActiveSearchOrFilter ? $t('sw-empty-state.messageNoResultTitle') : $t('sw-membership.purchase.list.emptyStateHeadline')"
                :description="hasActiveSearchOrFilter ? $t('sw-empty-state.messageNoResultSubline') : $t('sw-membership.purchase.list.emptyStateDescription')"
            />
            {% endblock %}

            {% block sw_loyalty_order_list_grid %}
            <sw-entity-listing
                v-else-if="isLoading || purchases"
                ref="listing"
                class="sw-membership-purchase-list__grid"
                identifier="sw-membership-purchase-list"
                :data-source="purchases"
                :columns="columns"
                :repository="purchaseRepository"
                :sort-by="sortBy"
                :sort-direction="sortDirection"
                :is-loading="isLoading"
                :full-page="true"
                :show-selection="false"
                :show-settings="true"
                :disable-data-fetching="true"
                :allow-inline-edit="false"
                :allow-column-edit="true"
                :allow-edit="false"
                :allow-delete="false"
                :allow-view="false"
                @page-change="onPageChange"
                @column-sort="onSortColumn"
            >
                {% block sw_loyalty_order_list_grid_column_customer %}
                <template #column-customer="{ item }">
                    <mt-link
                        v-if="item.customer"
                        :to="{ name: 'sw.customer.detail', params: { id: item.customerId } }"
                    >
                        {{ formatCustomer(item) }}
                    </mt-link>
                    <span v-else>{{ formatCustomer(item) }}</span>
                </template>
                {% endblock %}

                {% block sw_loyalty_order_list_grid_column_plan %}
                <template #column-planName="{ item }">
                    {{ item.planName || '-' }}
                </template>
                {% endblock %}

                {% block sw_loyalty_order_list_grid_column_amount %}
                <template #column-amount="{ item }">
                    {{ formatAmount(item) }}
                </template>
                {% endblock %}

                {% block sw_loyalty_order_list_grid_column_state %}
                <template #column-state="{ item }">
                    <mt-badge
                        class="sw-membership-purchase-list__state"
                        size="small"
                        :variant="getStateVariant(item.state)"
                    >
                        {{ getStateLabel(item.state) }}
                    </mt-badge>
                </template>
                {% endblock %}

                {% block sw_loyalty_order_list_grid_column_paid_at %}
                <template #column-paidAt="{ item }">
                    {{ formatDate(item.paidAt) }}
                </template>
                {% endblock %}

                {% block sw_loyalty_order_list_grid_column_created_at %}
                <template #column-createdAt="{ item }">
                    <sw-time-ago :date="item.createdAt" />
                </template>
                {% endblock %}
            </sw-entity-listing>
            {% endblock %}
        </div>
        {% endblock %}
    </template>
    {% endblock %}

    {% block sw_loyalty_order_list_sidebar %}
    <template #sidebar>
        <sw-sidebar class="sw-membership-purchase-list__sidebar">
            {% block sw_loyalty_order_list_sidebar_refresh %}
            <sw-sidebar-item
                icon="regular-undo"
                :title="$t('sw-membership.purchase.list.titleSidebarItemRefresh')"
                @click="onRefresh"
            />
            {% endblock %}

            {% block sw_loyalty_order_list_sidebar_filter %}
            <sw-sidebar-filter-panel
                entity="membership_purchase"
                :store-key="storeKey"
                :filters="listFilters"
                :defaults="defaultFilters"
                :active-filter-number="activeFilterNumber"
                @criteria-changed="updateCriteria"
            />
            {% endblock %}
        </sw-sidebar>
    </template>
    {% endblock %}

</sw-page>
{% endblock %}
