{% block sw_dashboard_metrics %}
<div
    v-if="canViewOrders"
    class="sw-dashboard-metrics"
>
    {% block sw_dashboard_metrics_grid %}
    <div class="sw-dashboard-metrics__grid">
        {% block sw_dashboard_metrics_grid_card %}
        <div
            v-for="card in metricCards"
            :key="card.key"
            class="sw-dashboard-metrics__card"
            :class="`sw-dashboard-metrics__card--${card.key}`"
        >
            <span class="sw-dashboard-metrics__label">{{ card.label }}</span>
            <span class="sw-dashboard-metrics__value">
                {{ card.value }}
                <span
                    v-if="card.unit"
                    class="sw-dashboard-metrics__unit"
                >{{ card.unit }}</span>
            </span>
            {% block sw_dashboard_metrics_grid_card_delta %}
            <div class="sw-dashboard-metrics__footnote">
                <span
                    v-if="card.footnote"
                    class="sw-dashboard-metrics__detail"
                >{{ card.footnote }}</span>
                <span
                    v-if="card.delta"
                    class="sw-dashboard-metrics__comparison"
                >
                    <span
                        class="sw-dashboard-metrics__delta"
                        :class="`is-${card.delta.tone}`"
                    >{{ card.delta.text }}</span>
                    {{ $t('sw-dashboard.metrics.comparedToPrevious') }}
                </span>
            </div>
            {% endblock %}
        </div>
        {% endblock %}
    </div>
    {% endblock %}
</div>
{% endblock %}
