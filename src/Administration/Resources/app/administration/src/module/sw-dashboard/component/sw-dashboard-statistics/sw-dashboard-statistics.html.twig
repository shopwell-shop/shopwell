{% block sw_dashboard_statistics %}
<mt-card
    v-if="canViewOrders"
    class="sw-dashboard-statistics mt-card--future-ignore-max-width"
    :is-loading="isLoading"
    position-identifier="sw-dashboard-statistics"
>
    {% block sw_dashboard_statistics_title %}
    <template #title>
        <div class="sw-dashboard-statistics__title">
            {{ $t('sw-dashboard.statistics.headline') }}

            <mt-icon
                v-if="helpText"
                v-tooltip="helpText"
                class="sw-dashboard-statistics__title-help-text"
                name="solid-question-circle"
                size="16px"
            />
        </div>
    </template>
    {% endblock %}

    {% block sw_dashboard_statistics_header %}
    <template #headerRight>
        <div class="sw-dashboard-statistics__header">
            <mt-select
                v-model="selectedMetric"
                class="sw-dashboard-statistics__metric-select"
                name="sw-field--selectedMetric"
                small
                :options="metricOptions"
                hide-clearable-button
            />

            <mt-select
                v-model="selectedRange"
                class="sw-dashboard-statistics__range-select"
                name="sw-field--selectedRange"
                small
                :options="rangeOptions"
                hide-clearable-button
            />
        </div>
    </template>
    {% endblock %}

    {% block sw_dashboard_statistics_chart %}
    <div class="sw-dashboard-statistics__chart">
        <sw-chart
            type="line"
            :series="series"
            :options="options"
            :fill-empty-values="activeRange.aggregate"
            :height="255"
            sort
        />
    </div>
    {% endblock %}
</mt-card>
{% endblock %}
