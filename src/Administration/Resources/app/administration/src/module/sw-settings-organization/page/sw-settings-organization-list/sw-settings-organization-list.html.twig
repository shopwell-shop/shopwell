{% block sw_settings_organization_list %}
{% block sw_settings_organization_index %}
<sw-page class="sw-settings-organization-list">

    {% block sw_settings_organization_list_search_bar %}
    <template #search-bar>
        <sw-search-bar
            initial-search-type="organization"
            :placeholder="$t('sw-settings-organization.general.placeholderSearchBar')"
            :initial-search="term"
            @search="onSearch"
        />
    </template>
    {% endblock %}

    {% block sw_settings_organization_list_smart_bar_header %}
    <template #smart-bar-header>
        {% block sw_settings_organization_list_smart_bar_header_title %}
        <h2>
            {% block sw_settings_organization_list_smart_bar_header_title_text %}
            {{ $t('sw-settings.index.title') }}
            <mt-icon
                name="regular-chevron-right-xs"
                size="12px"
            /> {{ $t('sw-settings-organization.list.textHeadline') }}
            {% endblock %}

            {% block sw_settings_organization_list_smart_bar_header_amount %}
            <span
                v-if="!isLoading"
                class="sw-page__smart-bar-amount"
            >
                ({{ total }})
            </span>
            {% endblock %}
        </h2>
        {% endblock %}
    </template>
    {% endblock %}

    {% block sw_settings_organization_list_language_switch %}
    <template #language-switch>
        <sw-language-switch @on-change="onChangeLanguage" />
    </template>
    {% endblock %}

    {% block sw_settings_organization_list_smart_bar_actions %}
    <template #smart-bar-actions>
        {% block sw_settings_organization_list_smart_bar_actions_add %}
        <mt-button
            v-tooltip="{
                message: $t('sw-privileges.tooltip.warning'),
                disabled: acl.can('organization.creator'),
                showOnDisabledElements: true
            }"
            class="sw-settings-organization-list__add-organization"
            variant="primary"
            :disabled="!acl.can('organization.creator') || undefined"
            size="default"
            @click="onAddOrganization"
        >
            {{ $t('sw-settings-organization.list.buttonAddOrganization') }}
        </mt-button>
        {% endblock %}
    </template>
    {% endblock %}

    {% block sw_settings_organization_list_content %}
    <template #content>
        <sw-card-view>
            {% block sw_settings_organization_list_content_card %}
            <mt-card
                v-if="isLoading || organizations"
                position-identifier="sw-settings-organization-list-content"
            >
                {% block sw_settings_organization_list_grid %}
                <template #grid>
                    {% block sw_settings_organization_list_grid_inner %}
                    <sw-entity-listing
                        ref="swSettingsOrganizationGrid"
                        class="sw-settings-organization-list-grid"
                        :data-source="organizations"
                        :columns="organizationColumns"
                        :repository="organizationRepository"
                        :disable-data-fetching="true"
                        :sort-by="sortBy"
                        :sort-direction="sortDirection"
                        :full-page="false"
                        detail-route="sw.settings.organization.detail"
                        :show-selection="false"
                        :is-loading="isLoading"
                        :allow-edit="acl.can('organization.editor') || undefined"
                        :allow-inline-edit="acl.can('organization.editor') || undefined"
                        :allow-delete="acl.can('organization.deleter') || undefined"
                        :allow-view="acl.can('organization.viewer') || undefined"
                        @page-change="onPageChange"
                        @column-sort="onSortColumn"
                        @inline-edit-save="onInlineEditSave"
                    >
                        {% block sw_settings_organization_list_grid_columns_units %}
                        <template #column-units="{ item }">
                            {{ getUnitCount(item) }}
                        </template>
                        {% endblock %}

                        {% block sw_settings_organization_list_grid_columns_active %}
                        <template #column-active="{ item }">
                            <mt-switch
                                v-if="acl.can('organization.editor')"
                                :key="item.id"
                                :model-value="item.active"
                                :disabled="undefined"
                                @change="onActiveChange(item, $event)"
                            />
                            <mt-icon
                                v-else
                                :name="item.active ? 'regular-checkmark-xs' : 'regular-times-xs'"
                            />
                        </template>
                        {% endblock %}

                        {% block sw_settings_organization_list_grid_columns_actions %}
                        <template #actions="{ item }">
                            {% block sw_settings_organization_list_grid_columns_actions_edit %}
                            <sw-context-menu-item
                                class="sw-entity-listing__context-menu-edit-action"
                                :disabled="!acl.can('organization.editor') || undefined"
                                :router-link="{ name: 'sw.settings.organization.detail', params: { id: item.id } }"
                            >
                                {{ $t('global.default.edit') }}
                            </sw-context-menu-item>
                            {% endblock %}

                            {% block sw_settings_organization_list_grid_columns_actions_delete %}
                            <sw-context-menu-item
                                class="sw-entity-listing__context-menu-delete"
                                variant="danger"
                                :disabled="!acl.can('organization.deleter') || undefined"
                                @click="onDelete(item.id)"
                            >
                                {{ $t('global.default.delete') }}
                            </sw-context-menu-item>
                            {% endblock %}
                        </template>
                        {% endblock %}

                        {% block sw_settings_organization_list_grid_action_modals %}
                        <template #action-modals="{ item }">
                            {% block sw_settings_organization_list_delete_modal %}
                            <sw-modal
                                v-if="showDeleteModal === item.id"
                                :title="$t('global.default.warning')"
                                variant="small"
                                @modal-close="onCloseDeleteModal"
                            >
                                {% block sw_settings_organization_list_delete_modal_confirm_text %}
                                <p class="sw-settings-organization-list__confirm-delete-text">
                                    {{ $t('sw-settings-organization.list.textDeleteConfirm', { name: item.name }, 0) }}
                                </p>
                                {% endblock %}

                                {% block sw_settings_organization_list_delete_modal_footer %}
                                <template #modal-footer>
                                    <mt-button
                                        size="small"
                                        variant="secondary"
                                        @click="onCloseDeleteModal"
                                    >
                                        {{ $t('global.default.cancel') }}
                                    </mt-button>

                                    <mt-button
                                        variant="critical"
                                        size="small"
                                        @click="onConfirmDelete(item.id)"
                                    >
                                        {{ $t('global.default.delete') }}
                                    </mt-button>
                                </template>
                                {% endblock %}
                            </sw-modal>
                            {% endblock %}
                        </template>
                        {% endblock %}
                    </sw-entity-listing>

                    {% block sw_settings_organization_list_empty_message %}
                    <mt-empty-state
                        v-if="!isLoading && !total"
                        centered
                        :icon="$route.meta.$module.icon"
                        :headline="isValidTerm(term) ? $t('sw-empty-state.messageNoResultTitle') : $t('sw-settings-organization.list.messageEmpty')"
                        :description="isValidTerm(term) ? $t('sw-empty-state.messageNoResultSublineSimple') : ''"
                    >
                        <template
                            v-if="!isValidTerm(term)"
                            #button
                        >
                            <mt-button
                                v-tooltip="{
                                    message: $t('sw-privileges.tooltip.warning'),
                                    disabled: acl.can('organization.creator'),
                                    showOnDisabledElements: true
                                }"
                                variant="primary"
                                :disabled="!acl.can('organization.creator')"
                                @click="onAddOrganization"
                            >
                                {{ $t('sw-settings-organization.list.buttonAddOrganization') }}
                            </mt-button>
                        </template>
                    </mt-empty-state>
                    {% endblock %}
                    {% endblock %}
                </template>
                {% endblock %}
            </mt-card>
            {% endblock %}
        </sw-card-view>
    </template>
    {% endblock %}

    {% block sw_settings_organization_create_modal %}
    <sw-modal
        v-if="showCreateModal && newOrganization"
        class="sw-settings-organization-list__create-modal"
        :title="$t('sw-settings-organization.list.modalTitleCreate')"
        variant="small"
        @modal-close="onCloseCreateModal"
    >
        {% block sw_settings_organization_create_modal_fields %}
        <mt-text-field
            v-model="newOrganization.name"
            class="sw-settings-organization-list__create-name"
            required
            :label="$t('sw-settings-organization.list.labelName')"
            :placeholder="$t('sw-settings-organization.list.placeholderName')"
        />

        <mt-switch
            v-model="newOrganization.active"
            class="sw-settings-organization-list__create-active"
            :label="$t('sw-settings-organization.list.labelActive')"
        />
        {% endblock %}

        {% block sw_settings_organization_create_modal_footer %}
        <template #modal-footer>
            <mt-button
                size="small"
                variant="secondary"
                @click="onCloseCreateModal"
            >
                {{ $t('global.default.cancel') }}
            </mt-button>

            <mt-button
                variant="primary"
                size="small"
                @click="onCreateSave"
            >
                {{ $t('global.default.save') }}
            </mt-button>
        </template>
        {% endblock %}
    </sw-modal>
    {% endblock %}
</sw-page>
{% endblock %}
{% endblock %}
