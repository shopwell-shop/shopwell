{% block sw_approval_flow_decision_modal %}
<sw-modal
    variant="small"
    :title="$t(`sw-approval-flow.decision.${action}`)"
    :closable="!isSubmitting"
    @modal-close="close"
>
    {% block sw_approval_flow_decision_modal_content %}
    <sw-loader v-if="isLoadingTargets" />
    <p v-else-if="!isReturn">
        {{ $t('sw-approval-flow.decision.confirmation') }}
    </p>
    <mt-select
        v-else-if="returnOptions.length"
        v-model="targetExecutionId"
        :label="$t('sw-approval-flow.decision.returnTarget')"
        :options="returnOptions"
        :disabled="command !== null"
        required
    />
    <p v-else-if="!failure">
        {{ $t('sw-approval-flow.decision.noReturnTargets') }}
    </p>
    <mt-textarea
        v-if="!isReturn || returnOptions.length"
        v-model="reason"
        :label="$t(isReturn ? 'sw-approval-flow.decision.returnReason' : 'sw-approval-flow.decision.reason')"
        :disabled="command !== null"
        :max-length="1000"
        :required="isReturn"
    />
    <mt-banner
        v-if="failure"
        variant="critical"
        role="alert"
    >
        {{ $t(`sw-approval-flow.decision.${failure}`) }}
    </mt-banner>
    {% endblock %}
    <template #modal-footer>
        {% block sw_approval_flow_decision_modal_actions %}
        <mt-button
            variant="secondary"
            size="small"
            :disabled="isSubmitting"
            @click="close"
        >
            {{ $t('global.default.cancel') }}
        </mt-button>
        <mt-button
            v-if="(!failure || canRetry) && (!isReturn || returnOptions.length)"
            data-testid="decision-submit"
            :variant="action === 'rejected' ? 'critical' : 'primary'"
            size="small"
            :is-loading="isSubmitting"
            :disabled="!canSubmit"
            @click="submit"
        >
            {{ canRetry ? $t('sw-approval-flow.general.retry') : $t(`sw-approval-flow.decision.${action}`) }}
        </mt-button>
        <mt-button
            v-else-if="failure"
            data-testid="decision-refresh"
            variant="primary"
            size="small"
            @click="$emit('refresh')"
        >
            {{ $t('sw-approval-flow.general.refresh') }}
        </mt-button>
        {% endblock %}
    </template>
</sw-modal>
{% endblock %}
