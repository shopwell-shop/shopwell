{% block sw_approval_flow_list %}
<sw-page
    class="sw-approval-flow-list"
    :show-search-bar="false"
>
    {# The list routes are tabs of the same page, even when they declare a sidebar parent. #}
    <template #smart-bar-back>
        <span hidden></span>
    </template>
    <template #smart-bar-header>
        <h2>{{ $t('sw-approval-flow.list.title') }} <span
            v-if="!isLoading && !hasError"
            class="sw-page__smart-bar-amount"
        >({{ total }})</span></h2>
    </template>
    <template #smart-bar-actions>
        <mt-button
            variant="secondary"
            :disabled="isLoading"
            @click="loadRequests"
        >
            {{ $t('sw-approval-flow.general.refresh') }}
        </mt-button>
    </template>
    <template #content>
        {% block sw_approval_flow_list_content %}
        <div
            v-if="acl.can('approval_flow.viewer')"
            class="sw-approval-flow-list__content sw-approval-flow-listing"
        >
            <mt-tabs
                class="sw-approval-flow-list__tabs"
                :items="tabs"
                :aria-label="$t('sw-approval-flow.list.title')"
                :default-item="view"
                @new-item-active="onViewChange"
            />
            <mt-data-table
                class="sw-approval-flow-list__table sw-approval-flow-listing__table"
                :data-source="requests"
                :columns="columns"
                :caption="$t(`sw-approval-flow.views.${view}`)"
                layout="full"
                :is-loading="isLoading"
                :allow-row-selection="false"
                :search-value="term"
                :disable-edit="true"
                :disable-delete="true"
                :disable-settings-table="true"
                :additional-context-buttons="[{ key: 'view', label: $t('global.default.view') }]"
                :show-outlines="false"
                :enable-outline-framing="false"
                :current-page="page"
                :pagination-limit="limit"
                :pagination-total-items="total"
                :pagination-options="[10, 25, 50, 100]"
                @search-value-change="onSearch"
                @context-select="$event.key === 'view' && $router.push(detailRoute($event.data.id))"
                @pagination-current-page-change="onPageChange({ page: $event, limit })"
                @pagination-limit-change="onPageChange({ page: 1, limit: $event })"
            >
                <template #toolbar>
                    <div class="sw-approval-flow-list__tools">
                        <mt-popover
                            v-if="view !== 'todo' || status"
                            :title="$t('sw-approval-flow.list.status')"
                            width="small"
                        >
                            <template #trigger="{ toggleFloatingUi, isOpened }">
                                <mt-button
                                    variant="secondary"
                                    size="default"
                                    :aria-expanded="isOpened"
                                    @click="toggleFloatingUi"
                                >
                                    <mt-icon
                                        name="solid-filter-s"
                                        size="14px"
                                    />
                                    {{ status ? $t(`sw-approval-flow.status.${status}`) : $t('sw-approval-flow.list.filters') }}
                                </mt-button>
                            </template>
                            <template #popover-items__base="{ toggleFloatingUi }">
                                <mt-popover-item
                                    v-for="option in statusOptions"
                                    :key="option.value"
                                    :label="option.label"
                                    :type="status === option.value ? 'active' : 'default'"
                                    :on-label-click="() => onStatusChange(option.value, toggleFloatingUi)"
                                />
                            </template>
                        </mt-popover>
                    </div>
                </template>
                {% block sw_approval_flow_list_columns %}
                <template #column-title="{ data }">
                    <router-link
                        class="sw-approval-flow-list__request sw-approval-flow-listing__link"
                        :to="detailRoute(data.id)"
                    >
                        {{ data.title }}
                    </router-link>
                </template>
                <template #column-initiatorName="{ data }">
                    {{ data.initiatorName ?? $t('sw-approval-flow.general.deletedUser') }}
                </template>
                <template #column-status="{ data }">
                    <sw-approval-flow-status-badge
                        :status="data.status"
                        :outcome="data.outcome"
                    />
                </template>
                <template #column-createdAt="{ data }">
                    {{ date(data.createdAt) }}
                </template>
                {% endblock %}
                <template #empty-state>
                    <mt-banner
                        v-if="hasError"
                        variant="critical"
                        role="alert"
                    >
                        {{ $t('sw-approval-flow.list.loadError') }}
                        <mt-button
                            variant="secondary"
                            size="small"
                            @click="loadRequests"
                        >
                            {{ $t('sw-approval-flow.general.retry') }}
                        </mt-button>
                    </mt-banner>
                    <mt-empty-state
                        v-else
                        centered
                        icon="regular-check-circle"
                        :headline="$t(status || term ? 'sw-approval-flow.empty.filtered' : `sw-approval-flow.empty.${view}`)"
                    />
                </template>
            </mt-data-table>
        </div>
        {% endblock %}
    </template>
</sw-page>
{% endblock %}
