{% block sw_finance_transfer_approval_preview %}
<section
    class="sw-finance-transfer-approval-preview"
    :aria-busy="isLoading"
    aria-live="polite"
>
    <h3>{{ $t('sw-finance.transfer.approvalPreview.title') }}</h3>
    <p v-if="!payload">
        {{ $t('sw-finance.transfer.approvalPreview.incomplete') }}
    </p>
    <p v-else-if="isLoading">
        {{ $t('sw-finance.transfer.approvalPreview.loading') }}
    </p>
    <mt-banner
        v-else-if="loadFailed"
        variant="attention"
    >
        {{ $t('sw-finance.transfer.approvalPreview.loadFailed') }}
        <mt-button
            class="sw-finance-transfer-approval-preview__retry"
            variant="secondary"
            size="small"
            @click="schedulePreview"
        >{{ $t('global.default.retry') }}</mt-button>
    </mt-banner>
    <mt-banner
        v-else-if="preview && !preview.available"
        variant="attention"
    >
        {{ unavailableMessage }}
    </mt-banner>
    <template v-else-if="preview?.available">
        {% block sw_finance_transfer_approval_preview_path %}
        <p class="sw-finance-transfer-approval-preview__release">
            {{ preview.releaseName }} · {{ $t('sw-finance.transfer.workflow.revision', { revision: preview.revision }) }}
        </p>
        <div class="sw-finance-transfer-approval-preview__diagram">
            <div class="sw-finance-transfer-approval-preview__terminal">
                <mt-icon
                    name="regular-play"
                    size="14px"
                />
                {{ $t('sw-finance.transfer.approvalPreview.start') }}
            </div>
            <ol
                class="sw-finance-transfer-approval-preview__steps"
                :aria-label="$t('sw-finance.transfer.approvalPreview.pathLabel')"
            >
                <li
                    v-for="step in preview.steps"
                    :key="step.nodeId"
                    :data-node-id="step.nodeId"
                    class="sw-finance-transfer-approval-preview__step"
                >
                    <span
                        class="sw-finance-transfer-approval-preview__connector"
                        aria-hidden="true"
                    ><span></span></span>
                    <article
                        class="sw-finance-transfer-approval-preview__node"
                        :class="{ 'is-condition': step.type === 'condition' }"
                    >
                        <header class="sw-finance-transfer-approval-preview__node-heading">
                            <span class="sw-finance-transfer-approval-preview__node-icon"><mt-icon
                                :name="step.type === 'approval' ? 'regular-user-shield' : 'regular-flow'"
                                size="18px"
                            /></span>
                            <strong>{{ step.name }}</strong>
                            <span
                                v-if="step.type === 'approval'"
                                class="sw-finance-transfer-approval-preview__rule"
                            >{{ $t(`sw-finance.transfer.approvalPreview.rules.${step.rule}`) }}</span>
                        </header>
                        <p
                            v-if="step.type === 'approval'"
                            class="sw-finance-transfer-approval-preview__node-summary"
                        >
                            {{ participantNames(step) }}
                        </p>
                        <p
                            v-else
                            class="sw-finance-transfer-approval-preview__node-summary"
                        >
                            {{ $t('sw-finance.transfer.approvalPreview.matchedBranch', { name: step.branch }) }}
                        </p>
                    </article>
                </li>
            </ol>
            <span
                class="sw-finance-transfer-approval-preview__connector"
                aria-hidden="true"
            ><span></span></span>
            <div class="sw-finance-transfer-approval-preview__terminal">
                <mt-icon
                    name="regular-checkmark"
                    size="14px"
                />
                {{ $t('sw-finance.transfer.approvalPreview.end') }}
            </div>
        </div>
        <p class="sw-finance-transfer-approval-preview__hint">
            {{ $t('sw-finance.transfer.approvalPreview.hint') }}
        </p>
        {% endblock %}
    </template>
</section>
{% endblock %}
