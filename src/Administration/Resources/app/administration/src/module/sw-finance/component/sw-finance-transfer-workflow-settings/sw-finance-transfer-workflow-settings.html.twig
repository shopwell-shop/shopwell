<sw-modal
    class="sw-finance-transfer-workflow-settings"
    :title="$t('sw-finance.transfer.workflow.settingsTitle')"
    variant="default"
    @modal-close="onClose"
>
    <sw-loader v-if="isLoading" />
    <template v-else-if="loadFailed">
        <mt-banner variant="critical">
            {{ $t('sw-finance.errors.loadFailed') }}
        </mt-banner>
        <mt-button
            class="sw-finance-transfer-workflow-settings__retry"
            variant="secondary"
            @click="loadConfiguration"
        >
            {{ $t('sw-finance.transfer.detail.buttonRefresh') }}
        </mt-button>
    </template>
    <template v-else>
        <mt-banner variant="info">
            {{ $t('sw-finance.transfer.workflow.configurationHint') }}
        </mt-banner>
        <mt-banner
            v-if="selectedReason"
            class="sw-finance-transfer-workflow-settings__check"
            variant="attention"
        >
            {{ selectedReasonMessage }}
        </mt-banner>
        <mt-select
            v-model="releaseId"
            class="sw-finance-transfer-workflow-settings__release"
            :label="$t('sw-finance.transfer.workflow.release')"
            :options="releaseOptions"
            :disabled="isSaving || !releaseOptions.length"
            required
        />
        <mt-banner
            v-if="!releaseOptions.length"
            variant="attention"
        >
            {{ $t('sw-finance.transfer.workflow.noReleases') }}
        </mt-banner>
        <mt-link
            v-if="acl.can('workflow.viewer')"
            :to="{ name: 'sw.workflow.index' }"
        >
            {{ $t('sw-finance.transfer.workflow.openDesigner') }}
        </mt-link>
    </template>
    <template #modal-footer>
        <mt-button
            variant="secondary"
            size="default"
            :disabled="isSaving"
            @click="onClose"
        >
            {{ $t('global.default.cancel') }}
        </mt-button>
        <mt-button
            class="sw-finance-transfer-workflow-settings__save"
            variant="primary"
            size="default"
            :disabled="!canSave"
            :is-loading="isSaving"
            @click="onSave"
        >
            {{ $t('global.default.save') }}
        </mt-button>
    </template>
</sw-modal>
