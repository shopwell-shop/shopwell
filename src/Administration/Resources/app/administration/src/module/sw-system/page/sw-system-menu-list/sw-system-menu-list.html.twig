{% block sw_system_menu_list %}
<sw-page
    class="sw-system-menu-list"
>
    <template #search-bar>
        {% block sw_system_menu_list_search_bar %}
        <sw-search-bar
            initial-search-type="admin_menu_item"
            :initial-search="searchTerm"
            @search="searchTerm = $event"
        />
        {% endblock %}
    </template>
    {% block sw_system_menu_list_smart_bar_header %}
    <template #smart-bar-header>
        <h2>{{ selectedItem ? selectedItem.label : $t('sw-system.menu.headline') }}</h2>
    </template>
    {% endblock %}

    {% block sw_system_menu_list_language_switch %}
    <template #language-switch>
        <sw-language-switch
            :disabled="isBusy"
            :save-changes-function="saveOnLanguageChange"
            :abort-change-function="abortOnLanguageChange"
            @on-change="onLanguageChange"
        />
    </template>
    {% endblock %}

    {% block sw_system_menu_list_smart_bar_actions %}
    <template #smart-bar-actions>
        {% block sw_system_menu_list_smart_bar_actions_cancel %}
        <mt-button
            v-if="draft"
            class="sw-system-menu-list__button-cancel"
            size="default"
            variant="secondary"
            :disabled="isBusy || undefined"
            @click="onCancelEdit"
        >
            {{ $t('global.default.cancel') }}
        </mt-button>
        {% endblock %}

        {% block sw_system_menu_list_smart_bar_actions_save %}
        <mt-button
            v-if="draft && canSaveDraft"
            class="sw-system-menu-list__button-save"
            size="default"
            variant="primary"
            :is-loading="isSaving"
            :disabled="isBusy || undefined"
            @click="onSave"
        >
            {{ $t('global.default.save') }}
        </mt-button>
        {% endblock %}

        {% block sw_system_menu_list_smart_bar_actions_create %}
        <mt-button
            v-if="canCreate"
            class="sw-system-menu-list__button-create"
            size="default"
            variant="primary"
            :disabled="isBusy || undefined"
            @click="onCreateNew"
        >
            {{ $t('sw-system.menu.createAction') }}
        </mt-button>
        {% endblock %}
    </template>
    {% endblock %}

    {% block sw_system_menu_list_side_content %}
    <template #side-content>
        {% block sw_system_menu_list_collapse %}
        <section class="sw-system-menu-list__navigation">
            <header class="sw-system-menu-list__tree-header">
                <div class="sw-system-menu-list__tree-heading">
                    <h3>{{ $t('sw-system.menu.treeHeadline') }}</h3>
                    <mt-button
                        class="sw-system-menu-list__button-expand"
                        variant="tertiary"
                        square
                        size="small"
                        :disabled="!hasTree || isSearching || undefined"
                        :aria-label="isAllExpanded ? $t('sw-system.menu.collapseAll') : $t('sw-system.menu.expandAll')"
                        @click="onToggleAll"
                    >
                        <mt-icon
                            :name="isAllExpanded ? 'regular-chevron-down-xs' : 'regular-chevron-right-xs'"
                            size="12px"
                        />
                    </mt-button>
                </div>

            </header>
            <div class="sw-system-menu-list__tree-content">
                {% block sw_system_menu_list_tree %}
                <sw-extension-component-section position-identifier="sw-system-menu-list-tree" />
                <mt-skeleton-bar v-if="isLoading" />
                <mt-banner
                    v-else-if="store.isLoadFailed"
                    variant="critical"
                >
                    {{ $t('sw-system.menu.notification.loadError') }}
                    <mt-button
                        variant="secondary"
                        size="small"
                        @click="loadTree"
                    >
                        {{ $t('sw-system.menu.retry') }}
                    </mt-button>
                </mt-banner>
                <sw-system-menu-tree
                    v-else-if="hasTree"
                    :items="filteredTree"
                    :expanded-ids="effectiveExpandedIds"
                    :selected-id="selectedId"
                    :sortable="canEdit && !isSearching && !isBusy"
                    :editable="canEdit && !isBusy"
                    :creatable="canCreate && !isBusy"
                    :deletable="canDelete && !isBusy"
                    @toggle="onToggle"
                    @select="onItemSelect"
                    @edit="onItemSelect"
                    @create-above="onCreateAbove"
                    @create-below="onCreateBelow"
                    @add-child="onAddChild"
                    @remove="onDelete"
                    @move="onMove"
                />
                <mt-empty-state
                    v-else
                    icon="regular-list"
                    :headline="$t(isSearching ? 'sw-system.menu.searchEmptyHeadline' : 'sw-system.menu.treeEmpty')"
                />
                {% endblock %}
            </div>
        </section>
        {% endblock %}
    </template>
    {% endblock %}

    {% block sw_system_menu_list_content %}
    <template #content>
        <template v-if="isLoading">
            <mt-skeleton-bar />
        </template>

        <div
            v-else
            class="sw-system-menu-list__content"
        >
            <sw-system-menu-detail
                v-if="draft"
                :draft="draft"
                :disabled="!canEditDraft"
                :locked="isLocked"
                :provenance="provenance"
                :target-privilege="targetPrivilege"
                :language-label="languageLabel"
                :type-options="typeOptions"
                :parent-options="parentOptions"
                :route-options="routeOptions"
                :privilege-options="privilegeOptions"
                :acl-role-repository="aclRoleRepository"
                :role-criteria="roleCriteria"
                :field-errors="fieldErrors"
                @update-draft="updateDraft"
                @type-change="onTypeChange"
                @parent-change="onParentChange"
            />

            {% block sw_system_menu_list_content_empty %}
            <mt-empty-state
                v-else
                class="sw-system-menu-list__empty-state"
                centered
                icon="regular-list"
                :headline="$t('sw-system.menu.emptyStateHeadline')"
                :description="$t('sw-system.menu.emptyStateDescription')"
            >
                <template
                    v-if="canCreate"
                    #button
                >
                    <mt-button
                        variant="primary"
                        size="default"
                        @click="onCreateNew"
                    >
                        {{ $t('sw-system.menu.createAction') }}
                    </mt-button>
                </template>
            </mt-empty-state>
            {% endblock %}
        </div>

        {% block sw_system_menu_list_delete_modal %}
        <mt-modal-root
            v-if="showDeleteModal"
            is-open
            @change="onCloseDeleteModal"
        >
            <mt-modal
                :title="$t('sw-system.menu.deleteModalTitle')"
                width="s"
                class="sw-system-menu-list__delete-modal"
            >
                <p class="sw-system-menu-list__delete-confirm">
                    {{ deleteConfirmMessage }}
                </p>

                <template #footer>
                    <mt-button
                        size="small"
                        variant="secondary"
                        @click="onCloseDeleteModal"
                    >
                        {{ $t('global.default.cancel') }}
                    </mt-button>

                    <mt-button
                        class="sw-system-menu-list__confirm-delete-button"
                        variant="critical"
                        size="small"
                        :is-loading="isDeleting"
                        @click="onConfirmDelete"
                    >
                        {{ $t('global.default.delete') }}
                    </mt-button>
                </template>
            </mt-modal>
        </mt-modal-root>
        {% endblock %}
        <mt-modal-root
            v-if="showUnsavedModal"
            is-open
            @change="onKeepEditing"
        >
            <mt-modal
                class="sw-system-menu-list__unsaved-modal"
                width="s"
                :title="$t('sw-system.menu.unsavedTitle')"
            >
                <p>{{ $t('sw-system.menu.unsavedDescription') }}</p>
                <template #footer>
                    <mt-button
                        variant="secondary"
                        @click="onKeepEditing"
                    >
                        {{ $t('sw-system.menu.keepEditing') }}
                    </mt-button>
                    <mt-button
                        class="sw-system-menu-list__discard-changes"
                        variant="critical"
                        :disabled="isBusy || undefined"
                        @click="onDiscardChanges"
                    >
                        {{ $t('sw-system.menu.discardChanges') }}
                    </mt-button>
                    <mt-button
                        variant="primary"
                        :is-loading="isSaving"
                        @click="onSaveChanges"
                    >
                        {{ $t('global.default.save') }}
                    </mt-button>
                </template>
            </mt-modal>
        </mt-modal-root>

    </template>
    {% endblock %}

</sw-page>
{% endblock %}
