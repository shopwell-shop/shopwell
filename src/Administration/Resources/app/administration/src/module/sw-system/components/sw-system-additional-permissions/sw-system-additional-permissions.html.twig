{% block sw_system_additional_permissions %}
<mt-card
    class="sw-system-additional-permissions"
    position-identifier="sw-system-additional-permissions"
    :is-loading="isLoading"
    :title="$t('sw-system.roles.additional-permissions.title')"
>
    <template v-if="role">
        {% block sw_system_additional_permissions_additional_privileges %}
        <template
            v-for="privilege in additionalPermissions"
            :key="`head-${privilege.key}`"
        >
            {% block sw_system_additional_permissions_additional_privileges_headline %}
            <h4
                class="sw-system-additional-permissions__headline"
                :class="' sw-system-additional-permissions_' + privilege.key"
            >
                {% block sw_system_additional_permissions_additional_privileges_headline_content %}
                {{ $t('sw-privileges.additional_permissions.' + privilege.key + '.label') }}
                {% endblock %}
            </h4>
            {% endblock %}

            {% block sw_system_additional_permissions_additional_privileges_switches %}
            <div
                class="sw-system-additional-permissions__switches"
            >
                {% block sw_system_additional_permissions_additional_privileges_switches_content %}
                <template
                    v-for="(value, roleName) in privilege.roles"
                    :key="roleName"
                >
                    {% block sw_system_additional_permissions_additional_privileges_switches_content_switch %}
                    <mt-switch
                        v-tooltip="{
                            message: lockedPrivilegeTooltip(privilege.key + '.' + roleName),
                            disabled: !isPrivilegeLocked(privilege.key + '.' + roleName) || disabled,
                            showOnDisabledElements: false
                        }"
                        :disabled="isPrivilegeLocked(privilege.key + '.' + roleName) || disabled"
                        :class="'sw_system_additional_permissions_' + privilege.key + '_' + roleName"
                        :model-value="isPrivilegeSelected(privilege.key + '.' + roleName)"
                        :label="$t('sw-privileges.additional_permissions.' + privilege.key + '.' + roleName)"
                        :bordered="true"
                        @update:model-value="onSelectPrivilege(privilege.key + '.' + roleName, $event)"
                    />
                    {% endblock %}
                </template>
                {% endblock %}
            </div>
            {% endblock %}
        </template>
        {% endblock %}

        {% block sw_system_additional_permissions_app_privileges %}
        <template
            v-for="privilege in appPermissions"
            :key="privilege.key"
        >
            {% block sw_system_additional_permissions_app_privileges_headline %}
            <h4
                class="sw-system-additional-permissions-app"
            >
                {% block sw_system_additional_permissions_app_privileges_headline_content %}
                {{ $t('sw-privileges.additional_permissions.app.label') }}
                {% endblock %}
            </h4>
            {% endblock %}

            {% block sw_system_additional_permissions_app_privileges_switches %}
            <div
                class="sw-system-additional-permissions__switches"
            >
                {% block sw_system_additional_permissions_app_privileges_switches_content %}
                <template
                    v-for="(key, roleName) in privilege.roles"
                    :key="roleName"
                >
                    {% block sw_system_additional_permissions_app_privileges_switches_content_switch %}
                    <mt-switch
                        v-if="roleName === 'all'"
                        :disabled="disabled"
                        class="sw_system_additional_permissions_app_all"
                        :model-value="isPrivilegeSelected('app.' + roleName)"
                        :label="$t('sw-privileges.additional_permissions.app.all')"
                        :bordered="true"
                        @update:model-value="changeAllAppPermissionsForKey('app.' + roleName, $event)"
                    />

                    <mt-switch
                        v-else
                        v-tooltip="{
                            message: $t('sw-privileges.additional_permissions.app.disabledCheckboxMessage'),
                            disabled: !isPrivilegeSelected('app.all') || disabled,
                            showOnDisabledElements: false
                        }"
                        :disabled="isPrivilegeSelected('app.all') || disabled"
                        :class="'sw_system_additional_permissions_app_' + roleName"
                        :model-value="isPrivilegeSelected('app.' + roleName)"
                        :label="roleName"
                        :bordered="true"
                        @update:model-value="onSelectPrivilege('app.' + roleName, $event)"
                    />
                    {% endblock %}
                </template>
                {% endblock %}
            </div>
            {% endblock %}
        </template>
        {% endblock %}
    </template>
</mt-card>
{% endblock %}
