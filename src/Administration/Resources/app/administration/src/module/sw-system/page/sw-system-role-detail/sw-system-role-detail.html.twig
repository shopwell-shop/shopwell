{% block sw_system_role_detail %}
<sw-page class="sw-system-role-detail">
    {% block sw_system_role_detail_smart_bar_header %}
    <template #smart-bar-header>
        {% block sw_system_role_detail_smart_bar_header_title %}
        <h2 v-if="role && role.isNew() && role.name.length <= 0">
            {{ $t('sw-system.roles.general.labelCreateNewRole') }}
        </h2>

        <h2 v-else-if="role">
            {{ role.name }}
        </h2>

        <h2 v-else>
            {{ $t('sw-system.roles.detail.role') }}
        </h2>
        {% endblock %}
    </template>
    {% endblock %}

    {% block sw_system_role_detail_smart_bar_actions %}
    <template #smart-bar-actions>
        {% block sw_system_role_detail_smart_bar_actions_button_cancel %}
        <mt-button
            v-tooltip.bottom="tooltipCancel"
            variant="secondary"
            size="default"
            @click="onCancel"
        >
            {{ $t('global.default.cancel') }}
        </mt-button>
        {% endblock %}

        {% block sw_system_role_detail_smart_bar_actions_button_save %}
        <sw-button-process
            v-tooltip.bottom="tooltipSave"
            class="sw-system-role-detail__button-save"
            :is-loading="isLoading"
            :process-success="isSaveSuccessful"
            :disabled="isLoading || !acl.can('users_and_permissions.editor')"
            variant="primary"
            @update:process-success="saveFinish"
            @click.prevent="onSave"
        >
            {{ $t('global.default.save') }}
        </sw-button-process>
        {% endblock %}
    </template>
    {% endblock %}

    {% block sw_system_role_detail_content %}
    <template #content>
        {% block sw_system_role_detail_content_card_view %}
        <sw-card-view>
            {% block sw_system_role_detail_content_card_view_tabs %}
            <template v-if="feature.isActive('v6.8.0.0')">
                {% block sw_system_role_detail_content_card_view_mt_tabs %}
                <mt-tabs
                    position-identifier="sw-system-role-detail-content"
                    :default-item="$route.name"
                    :items="roleDetailTabs"
                    :small="true"
                />
                {% endblock %}
            </template>

            <template v-else>
                <sw-tabs
                    default-item="general"
                    position-identifier="sw-system-role-detail-content"
                >
                    <template #default="{ active }">
                        <sw-tabs-item
                            :route="{ name: 'sw.system.role.detail.general', params: { id: $route.params.id } }"
                            :title="$t('sw-system.roles.tabs.general')"
                        >
                            {{ $t('sw-system.roles.tabs.general') }}
                        </sw-tabs-item>

                        <sw-tabs-item
                            :route="{ name: 'sw.system.role.detail.detailed-privileges', params: { id: $route.params.id } }"
                            :title="$t('sw-system.roles.tabs.detailed')"
                        >
                            {{ $t('sw-system.roles.tabs.detailed') }}
                        </sw-tabs-item>
                    </template>
                </sw-tabs>
            </template>
            {% endblock %}

            <router-view
                v-slot="{ Component }"
            >
                <component
                    :is="Component"
                    :role="role"
                    :is-loading="isLoading"
                    :detailed-privileges="detailedPrivileges"
                />
            </router-view>
        </sw-card-view>
        {% endblock %}

        {% block sw_system_role_detail_content_verify_modal %}
        <sw-verify-user-modal
            v-if="confirmPasswordModal"
            @verified="saveRole"
            @close="onCloseConfirmPasswordModal"
        />
        {% endblock %}
    </template>
    {% endblock %}
</sw-page>
{% endblock %}
