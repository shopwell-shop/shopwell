{% block sw_system_menu_tree %}
<div
    class="sw-system-menu-tree"
    role="tree"
    :aria-label="$t('sw-system.menu.treeLabel')"
>
    {% block sw_system_menu_tree_rows %}
    <div
        v-for="row in rows"
        :key="row.item.id"
        class="sw-system-menu-tree__row"
        :class="rowClasses(row.item)"
        :style="{ '--sw-system-menu-tree-depth': row.depth }"
        role="treeitem"
        :aria-level="row.depth + 1"
        :aria-expanded="row.hasChildren ? String(isExpanded(row.item)) : undefined"
        :draggable="isSortableItem(row.item)"
        @dragstart="onDragStart($event, row.item)"
        @dragover.prevent="onDragOver($event, row.item)"
        @dragleave="onDragLeave(row.item)"
        @drop.prevent="onDrop($event, row.item)"
        @dragend="onDragEnd"
    >
        {% block sw_system_menu_tree_row_toggle %}
        <button
            v-if="row.hasChildren"
            type="button"
            class="sw-system-menu-tree__toggle"
            :aria-label="isExpanded(row.item) ? $t('sw-system.menu.collapse') : $t('sw-system.menu.expand')"
            @click.stop="toggle(row.item)"
        >
            <mt-icon
                :name="isExpanded(row.item) ? 'regular-chevron-down-xs' : 'regular-chevron-right-xs'"
                size="12px"
            />
        </button>
        <span
            v-else
            class="sw-system-menu-tree__toggle-spacer"
        ></span>
        {% endblock %}

        {% block sw_system_menu_tree_row_icon %}
        <mt-icon
            class="sw-system-menu-tree__icon"
            :name="iconOf(row.item)"
            size="16px"
        />
        {% endblock %}

        {% block sw_system_menu_tree_row_label %}
        <button
            type="button"
            class="sw-system-menu-tree__label"
            @click="toggle(row.item)"
        >
            {{ row.item.label }}
        </button>
        {% endblock %}

        {% block sw_system_menu_tree_row_group %}
        <span
            v-if="row.item.groupLabel"
            class="sw-system-menu-tree__badge sw-system-menu-tree__badge--group"
        >
            {{ row.item.groupLabel }}
        </span>
        {% endblock %}

        {% block sw_system_menu_tree_row_meta %}
        <span class="sw-system-menu-tree__meta">
            <mt-icon
                v-if="row.item.sysLocked"
                v-tooltip="{ message: $t('sw-system.menu.tooltipLockedItem') }"
                name="regular-lock"
                size="12px"
            />

            <span
                v-if="!row.item.active"
                class="sw-system-menu-tree__badge"
            >
                {{ $t('sw-system.menu.labelInactive') }}
            </span>

            <span
                v-if="row.item.pluginName"
                class="sw-system-menu-tree__badge"
            >
                {{ row.item.pluginName }}
            </span>

            <span class="sw-system-menu-tree__type">
                {{ $t(typeLabel(row.item)) }}
            </span>
        </span>
        {% endblock %}

        {% block sw_system_menu_tree_row_actions %}
        <span class="sw-system-menu-tree__actions">
            {% block sw_system_menu_tree_row_actions_edit %}
            <mt-button
                v-if="editable"
                class="sw-system-menu-tree__action"
                size="x-small"
                variant="secondary"
                square
                :title="$t('global.default.edit')"
                @click="onEdit(row.item)"
            >
                <mt-icon
                    name="regular-pen"
                    size="14px"
                />
            </mt-button>
            {% endblock %}

            {% block sw_system_menu_tree_row_actions_delete %}
            <mt-button
                v-if="deletable && !row.item.sysLocked"
                class="sw-system-menu-tree__action"
                size="x-small"
                variant="secondary"
                square
                :title="$t('global.default.delete')"
                @click="onRemove(row.item)"
            >
                <mt-icon
                    name="regular-trash"
                    size="14px"
                />
            </mt-button>
            {% endblock %}
        </span>
        {% endblock %}
    </div>
    {% endblock %}
</div>
{% endblock %}
