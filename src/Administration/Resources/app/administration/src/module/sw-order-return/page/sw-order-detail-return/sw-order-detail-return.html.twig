{% block sw_order_detail_return %}
<div class="sw-order-detail-return">
    {% block sw_order_detail_return_header %}
    <div class="sw-order-detail-return__header">
        <div class="sw-order-detail-return__heading">
            <h3 class="sw-order-detail-return__title">
                {{ $t('sw-order-return.orderTab.cardTitle') }}
            </h3>

            <span class="sw-order-detail-return__count">
                ({{ totalCount }})
            </span>
        </div>

        {% block sw_order_detail_return_header_create %}
        <mt-button
            v-if="canEdit"
            class="sw-order-detail-return__button-create"
            size="small"
            variant="secondary"
            @click="onOpenCreateModal"
        >
            {{ $t('sw-order-return.orderTab.buttonCreate') }}
        </mt-button>
        {% endblock %}
    </div>
    {% endblock %}

    {% block sw_order_detail_return_grid %}
    <sw-data-grid
        v-if="hasReturns"
        class="sw-order-detail-return__grid"
        identifier="sw-order-detail-return"
        :data-source="orderReturns"
        :columns="columns"
        :is-loading="isLoading"
        :show-selection="false"
        :show-actions="false"
        :show-settings="false"
        :allow-inline-edit="false"
        :allow-column-edit="false"
    >
        {% block sw_order_detail_return_grid_column_return_number %}
        <template #column-returnNumber="{ item }">
            <router-link :to="{ name: 'sw.order.return.detail', params: { id: item.id } }">
                {{ item.returnNumber }}
            </router-link>
        </template>
        {% endblock %}

        {% block sw_order_detail_return_grid_column_type %}
        <template #column-type="{ item }">
            {{ typeLabel(item.type) }}
        </template>
        {% endblock %}

        {% block sw_order_detail_return_grid_column_state %}
        <template #column-stateMachineState.technicalName="{ item }">
            <mt-badge :variant="stateVariant(item)">
                {{ stateLabel(item) }}
            </mt-badge>
        </template>
        {% endblock %}

        {% block sw_order_detail_return_grid_column_refund_amount %}
        <template #column-refundAmount="{ item }">
            {{ formatAmount(item.refundAmount, item.currency) }}
        </template>
        {% endblock %}

        {% block sw_order_detail_return_grid_column_deadline %}
        <template #column-deadlineAt="{ item }">
            <span :class="{ 'sw-order-detail-return__overdue': isOverdue(item) }">
                {{ deadlineLabel(item) }}
            </span>
        </template>
        {% endblock %}

        {% block sw_order_detail_return_grid_column_created_at %}
        <template #column-createdAt="{ item }">
            {{ formatDateOrDash(item.createdAt) }}
        </template>
        {% endblock %}

        {% block sw_order_detail_return_grid_empty_state %}
        <template #empty-state>
            <mt-empty-state
                centered
                icon="regular-undo"
                :headline="$t('sw-order-return.orderTab.messageEmpty')"
                :description="$t('sw-order-return.orderTab.messageEmptySubline')"
            />
        </template>
        {% endblock %}
    </sw-data-grid>
    {% endblock %}

    {% block sw_order_detail_return_empty_state %}
    <mt-empty-state
        v-if="!isLoading && isEmptyList"
        class="sw-order-detail-return__empty-state"
        centered
        icon="regular-undo"
        :headline="$t('sw-order-return.orderTab.messageEmpty')"
        :description="$t('sw-order-return.orderTab.messageEmptySubline')"
    />
    {% endblock %}

    {% block sw_order_detail_return_create_modal %}
    <sw-modal
        v-if="showCreateModal"
        class="sw-order-detail-return__create-modal"
        :title="$t('sw-order-return.orderTab.modalTitle')"
        variant="large"
        @modal-close="onCloseCreateModal"
    >
        {% block sw_order_detail_return_create_modal_loading %}
        <sw-loader
            v-if="isLoadingForm"
            class="sw-order-detail-return__create-loader"
        />
        {% endblock %}

        {% block sw_order_detail_return_create_modal_form %}
        <div class="sw-order-detail-return__create">
            {% block sw_order_detail_return_create_modal_hint %}
            <mt-banner
                class="sw-order-detail-return__create-hint"
                variant="info"
            >
                {{ $t('sw-order-return.orderTab.hintAmountComputed') }}
            </mt-banner>
            {% endblock %}

            {% block sw_order_detail_return_create_modal_positions %}
            <section class="sw-order-detail-return__section">
                <h4 class="sw-order-detail-return__section-title">
                    {{ $t('sw-order-return.orderTab.headlinePositions') }}
                </h4>

                {% block sw_order_detail_return_create_modal_no_positions %}
                <mt-banner
                    v-if="noReturnablePositions"
                    variant="attention"
                >
                    {{ $t('sw-order-return.orderTab.messageNoReturnablePositions') }}
                </mt-banner>
                {% endblock %}

                {% block sw_order_detail_return_create_modal_position_rows %}
                <div
                    v-if="hasDraftPositions"
                    class="sw-order-detail-return__positions"
                >
                    {% block sw_order_detail_return_create_modal_position_head %}
                    <div class="sw-order-detail-return__position-head">
                        <span>{{ $t('sw-order-return.orderTab.columnProduct') }}</span>
                        <span class="sw-order-detail-return__align-end">{{ $t('sw-order-return.orderTab.columnUnitPrice') }}</span>
                        <span>{{ $t('sw-order-return.orderTab.columnReturnable') }}</span>
                        <span class="sw-order-detail-return__align-end">{{ $t('sw-order-return.orderTab.columnQuantity') }}</span>
                    </div>
                    {% endblock %}

                    <div
                        v-for="position in draftPositions"
                        :key="position.lineItemId"
                        class="sw-order-detail-return__position"
                    >
                        <mt-checkbox
                            v-model:checked="position.selected"
                            class="sw-order-detail-return__position-product"
                            :label="position.label"
                        />

                        <span class="sw-order-detail-return__position-unit-price">
                            {{ formatUnitPrice(position.unitPrice) }}
                        </span>

                        <span class="sw-order-detail-return__position-returnable">
                            {{ position.returnable }}
                        </span>

                        <mt-number-field
                            v-model="position.draftQuantity"
                            class="sw-order-detail-return__position-quantity"
                            number-type="int"
                            size="small"
                            :min="1"
                            :max="position.returnable"
                            :disabled="!position.selected"
                            number-align-end
                        />
                    </div>
                </div>
                {% endblock %}
            </section>
            {% endblock %}

            {% block sw_order_detail_return_create_modal_details %}
            <section class="sw-order-detail-return__section">
                <h4 class="sw-order-detail-return__section-title">
                    {{ $t('sw-order-return.orderTab.headlineDetails') }}
                </h4>

                <div class="sw-order-detail-return__details">
                    {% block sw_order_detail_return_create_modal_type %}
                    <mt-select
                        v-model="draftType"
                        class="sw-order-detail-return__create-type"
                        :label="$t('sw-order-return.orderTab.labelType')"
                        :options="typeOptions"
                        hide-clearable-button
                    />
                    {% endblock %}

                    {% block sw_order_detail_return_create_modal_reason %}
                    <mt-select
                        v-model="draftReasonId"
                        class="sw-order-detail-return__create-reason"
                        :label="$t('sw-order-return.orderTab.labelReason')"
                        :options="reasonOptions"
                        hide-clearable-button
                    />
                    {% endblock %}
                </div>

                {% block sw_order_detail_return_create_modal_note %}
                <mt-textarea
                    v-model="draftNote"
                    class="sw-order-detail-return__create-note"
                    :label="$t('sw-order-return.orderTab.labelNote')"
                    :placeholder="$t('sw-order-return.orderTab.placeholderNote')"
                />
                {% endblock %}
            </section>
            {% endblock %}
        </div>
        {% endblock %}

        <template #modal-footer>
            {% block sw_order_detail_return_create_modal_footer_cancel %}
            <mt-button
                class="sw-order-detail-return__button-cancel"
                size="default"
                variant="secondary"
                @click="onCloseCreateModal"
            >
                {{ $t('global.default.cancel') }}
            </mt-button>
            {% endblock %}

            {% block sw_order_detail_return_create_modal_footer_confirm %}
            <mt-button
                class="sw-order-detail-return__button-confirm"
                size="default"
                variant="primary"
                :disabled="!canSubmit"
                @click="onSubmit"
            >
                {{ $t('sw-order-return.orderTab.buttonConfirmCreate') }}
            </mt-button>
            {% endblock %}
        </template>
    </sw-modal>
    {% endblock %}
</div>
{% endblock %}
