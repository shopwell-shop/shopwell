{% block sw_blog_author_detail %}
<sw-page
    class="sw-blog-author-detail"
    position-identifier="sw-blog-author-detail"
>
    {% block sw_blog_author_detail_smart_bar_header %}
    <template #smart-bar-header>
        {% block sw_blog_author_detail_smart_bar_header_title %}
        <h2>
            {% block sw_blog_author_detail_smart_bar_header_title_text %}
            <template v-if="author">
                {{ name }}
            </template>
            <sw-skeleton
                v-else
                variant="bold"
            />
            {% endblock %}
        </h2>
        {% endblock %}
    </template>
    {% endblock %}

    {% block sw_blog_author_detail_language_switch %}
    <template #language-switch>
        <sw-language-switch
            class="sw-blog-author-detail__language-switch"
            :disabled="!author"
            :save-changes-function="saveOnLanguageChange"
            :abort-change-function="abortOnLanguageChange"
            @on-change="onChangeLanguage"
        />
    </template>
    {% endblock %}

    {% block sw_blog_author_detail_smart_bar_actions %}
    <template #smart-bar-actions>
        {% block sw_blog_author_detail_actions_cancel %}
        <mt-button
            class="sw-blog-author-detail__action-cancel"
            variant="secondary"
            size="default"
            @click="onCancel"
        >
            {{ $t('global.default.cancel') }}
        </mt-button>
        {% endblock %}

        {% block sw_blog_author_detail_actions_delete %}
        <mt-button
            v-if="author && canDelete"
            class="sw-blog-author-detail__action-delete"
            variant="critical"
            size="default"
            @click="onOpenDeleteModal"
        >
            {{ $t('global.default.delete') }}
        </mt-button>
        {% endblock %}

        {% block sw_blog_author_detail_actions_save %}
        <mt-button
            v-if="author"
            class="sw-blog-author-detail__action-save"
            variant="primary"
            size="default"
            :disabled="!canEdit || undefined"
            :is-loading="isSaving"
            @click="onSave()"
        >
            {{ $t('global.default.save') }}
        </mt-button>
        {% endblock %}
    </template>
    {% endblock %}

    {% block sw_blog_author_detail_content %}
    <template #content>
        {% block sw_blog_author_detail_content_loading %}
        <sw-skeleton
            v-if="!author"
            class="sw-blog-author-detail__loading"
            variant="bold"
        />
        {% endblock %}

        {% block sw_blog_author_detail_content_card_view %}
        <sw-card-view
            v-else
            class="sw-blog-author-detail__card-view"
        >
            {% block sw_blog_author_detail_content_general %}
            <mt-card
                class="sw-blog-author-detail__general"
                position-identifier="sw-blog-author-detail-general"
                :title="$t('sw-blog.author.cardGeneral')"
                :is-loading="isLoading"
            >
                {% block sw_blog_author_detail_content_general_fields %}
                <sw-container
                    columns="1fr 1fr"
                    gap="0 var(--scale-size-32)"
                >
                    <mt-text-field
                        v-model="author.name"
                        class="sw-blog-author-detail__name"
                        required
                        :disabled="!canEdit"
                        :label="$t('sw-blog.author.labelName')"
                        :placeholder="$t('sw-blog.author.placeholderName')"
                    />

                    <mt-text-field
                        v-model="author.email"
                        class="sw-blog-author-detail__email"
                        :disabled="!canEdit"
                        :label="$t('sw-blog.author.labelEmail')"
                        :help-text="$t('sw-blog.author.helpTextEmail')"
                    />

                    <mt-switch
                        v-model="author.active"
                        class="sw-blog-author-detail__active"
                        bordered
                        :disabled="!canEdit"
                        :label="$t('sw-blog.author.labelActive')"
                        :help-text="$t('sw-blog.author.helpTextActive')"
                    />
                </sw-container>
                {% endblock %}

                {% block sw_blog_author_detail_content_general_description %}
                <mt-textarea
                    v-model="author.description"
                    class="sw-blog-author-detail__description"
                    :disabled="!canEdit"
                    :label="$t('sw-blog.author.labelDescription')"
                    :placeholder="$t('sw-blog.author.placeholderDescription')"
                />
                {% endblock %}

                {% block sw_blog_author_detail_content_general_avatar %}
                <div class="sw-blog-author-detail__avatar">
                    <sw-media-compact-upload-v2
                        class="sw-blog-author-detail__avatar-upload"
                        :source="author.mediaId"
                        :upload-tag="mediaUploadTag"
                        :label="$t('sw-blog.author.labelAvatar')"
                        :disabled="!canEdit"
                        :allow-multi-select="false"
                        @selection-change="onAvatarSelected"
                        @delete-item="onAvatarRemoved"
                    />
                </div>
                {% endblock %}
            </mt-card>
            {% endblock %}

            {% block sw_blog_author_detail_content_entries %}
            <mt-card
                class="sw-blog-author-detail__entries"
                position-identifier="sw-blog-author-detail-entries"
                :title="$t('sw-blog.author.cardEntries')"
                :is-loading="isLoading"
            >
                {% block sw_blog_author_detail_content_entries_empty %}
                <mt-empty-state
                    v-if="!entryCount"
                    class="sw-blog-author-detail__entries-empty"
                    icon="regular-image-text"
                    :headline="$t('sw-blog.author.messageNoEntries')"
                    :description="$t('sw-blog.author.messageNoEntriesSubline')"
                />
                {% endblock %}

                {% block sw_blog_author_detail_content_entries_grid %}
                <sw-data-grid
                    v-else
                    class="sw-blog-author-detail__entries-grid"
                    :data-source="entries"
                    :columns="entriesColumns"
                    :show-selection="false"
                    :show-settings="false"
                    :allow-inline-edit="false"
                    :allow-column-edit="false"
                    :plain-appearance="true"
                >
                    {% block sw_blog_author_detail_content_entries_grid_column_title %}
                    <template #column-title="{ item }">
                        <router-link :to="{ name: 'sw.blog.detail', params: { id: item.id } }">
                            {{ item.title }}
                        </router-link>
                    </template>
                    {% endblock %}

                    {% block sw_blog_author_detail_content_entries_grid_column_published_at %}
                    <template #column-publishedAt="{ item }">
                        <sw-blog-status-badge
                            v-if="item.publishedAt"
                            :published-at="item.publishedAt"
                        />
                        <sw-time-ago
                            v-else
                            :date="item.createdAt"
                        />
                    </template>
                    {% endblock %}
                </sw-data-grid>
                {% endblock %}
            </mt-card>
            {% endblock %}

            {% block sw_blog_author_detail_delete_modal %}
            <sw-modal
                v-if="showDeleteModal"
                class="sw-blog-author-detail__delete-modal"
                variant="small"
                :title="$t('sw-blog.author.titleDelete')"
                @modal-close="onCloseDeleteModal"
            >
                <p class="sw-blog-author-detail__delete-message">
                    {{ deleteMessage }}
                </p>

                <template #modal-footer>
                    <mt-button
                        variant="secondary"
                        size="small"
                        @click="onCloseDeleteModal"
                    >
                        {{ $t('global.default.cancel') }}
                    </mt-button>

                    <mt-button
                        v-if="isDeleteBlocked"
                        class="sw-blog-author-detail__delete-deactivate"
                        variant="primary"
                        size="small"
                        @click="onDeactivateInstead"
                    >
                        {{ $t('sw-blog.author.buttonDeactivate') }}
                    </mt-button>

                    <mt-button
                        v-else
                        class="sw-blog-author-detail__delete-confirm"
                        variant="critical"
                        size="small"
                        @click="onDelete"
                    >
                        {{ $t('global.default.delete') }}
                    </mt-button>
                </template>
            </sw-modal>
            {% endblock %}
        </sw-card-view>
        {% endblock %}
    </template>
    {% endblock %}
</sw-page>
{% endblock %}
