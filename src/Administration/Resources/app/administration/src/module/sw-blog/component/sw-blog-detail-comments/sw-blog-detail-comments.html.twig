{% block sw_blog_detail_comments %}
<div class="sw-blog-detail-comments">
    {% block sw_blog_detail_comments_grid %}
    <sw-data-grid
        v-if="comments.length > 0"
        class="sw-blog-detail-comments__grid"
        :data-source="comments"
        :columns="columns"
        :is-loading="isLoading"
        :show-selection="false"
        :show-settings="false"
        :plain-appearance="true"
    >
        {% block sw_blog_detail_comments_grid_column_author %}
        <template #column-externalUser="{ item }">
            {{ authorNameOf(item) }}
        </template>
        {% endblock %}

        {% block sw_blog_detail_comments_grid_column_content %}
        <template #column-content="{ item }">
            {{ excerptOf(item) }}
        </template>
        {% endblock %}

        {% block sw_blog_detail_comments_grid_column_depth %}
        <template #column-parentId="{ item }">
            {{ depthOf(item) }}
        </template>
        {% endblock %}

        {% block sw_blog_detail_comments_grid_column_status %}
        <template #column-status="{ item }">
            <sw-label
                class="sw-blog-detail-comments__status"
                :variant="item.status ? 'success' : 'warning'"
                size="medium"
            >
                {{ statusLabelOf(item) }}
            </sw-label>
        </template>
        {% endblock %}

        {% block sw_blog_detail_comments_grid_actions %}
        <template #actions="{ item }">
            {% block sw_blog_detail_comments_grid_actions_approve %}
            <sw-context-menu-item
                class="sw-blog-detail-comments__action-approve"
                :disabled="!canEdit || item.status"
                @click="onApprove(item)"
            >
                {{ $t('sw-blog.detail.commentsApprove') }}
            </sw-context-menu-item>
            {% endblock %}

            {% block sw_blog_detail_comments_grid_actions_hide %}
            <sw-context-menu-item
                class="sw-blog-detail-comments__action-hide"
                :disabled="!canEdit || !item.status"
                @click="onHide(item)"
            >
                {{ $t('sw-blog.detail.commentsHide') }}
            </sw-context-menu-item>
            {% endblock %}

            {% block sw_blog_detail_comments_grid_actions_delete %}
            <sw-context-menu-item
                class="sw-blog-detail-comments__action-delete"
                variant="danger"
                :disabled="!canEdit"
                @click="onDelete(item)"
            >
                {{ $t('global.default.delete') }}
            </sw-context-menu-item>
            {% endblock %}
        </template>
        {% endblock %}
    </sw-data-grid>
    {% endblock %}

    {% block sw_blog_detail_comments_empty %}
    <mt-empty-state
        v-else-if="!isLoading"
        class="sw-blog-detail-comments__empty"
        icon="regular-box"
        :headline="$t('sw-blog.detail.commentsEmpty')"
    />
    {% endblock %}

    {% block sw_blog_detail_comments_delete_modal %}
    <sw-modal
        v-if="deleteTarget"
        class="sw-blog-detail-comments__delete-modal"
        variant="small"
        :title="$t('sw-blog.detail.commentsTitleDelete')"
        @modal-close="onCloseDeleteModal"
    >
        <p class="sw-blog-detail-comments__delete-message">
            {{ deleteMessage }}
        </p>

        <template #modal-footer>
            <mt-button
                variant="secondary"
                size="small"
                @click="onCloseDeleteModal"
            >
                {{ $t('global.default.cancel') }}
            </mt-button>

            <mt-button
                variant="critical"
                size="small"
                @click="onConfirmDelete"
            >
                {{ $t('global.default.delete') }}
            </mt-button>
        </template>
    </sw-modal>
    {% endblock %}
</div>
{% endblock %}
