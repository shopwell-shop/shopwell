{% block sw_blog_detail %}
<sw-page
    class="sw-blog-detail"
    position-identifier="sw-blog-detail"
>
    {% block sw_blog_detail_smart_bar_header %}
    <template #smart-bar-header>
        <h2 class="sw-blog-detail__header">
            {{ headerTitle }}
            <mt-badge
                v-if="blog"
                class="sw-blog-detail__type"
                variant="neutral"
            >
                {{ typeLabel }}
            </mt-badge>
            <sw-blog-status-badge
                v-if="blog"
                :active="blog.active"
                :published-at="blog.publishedAt"
            />
        </h2>
    </template>
    {% endblock %}

    {% block sw_blog_detail_language_switch %}
    <template #language-switch>
        <sw-language-switch
            :disabled="!blog || isNew || isBusy"
            :save-changes-function="saveOnLanguageChange"
            :abort-change-function="abortOnLanguageChange"
            @on-change="onChangeLanguage"
        />
    </template>
    {% endblock %}

    {% block sw_blog_detail_smart_bar_actions %}
    <template #smart-bar-actions>
        {% block sw_blog_detail_actions_delete %}
        <mt-popover
            v-if="canDelete"
            :child-views="[{ name: 'base' }]"
        >
            <template #trigger="{ toggleFloatingUi }">
                <mt-button
                    variant="secondary"
                    size="default"
                    :disabled="isBusy"
                    square
                    :aria-label="$t('sw-blog.detail.buttonMore')"
                    @click="toggleFloatingUi"
                >
                    <mt-icon
                        name="solid-ellipsis-h-s"
                        size="16px"
                    />
                </mt-button>
            </template>
            <template #popover-items__base="{ toggleFloatingUi }">
                <mt-popover-item
                    class="sw-blog-detail__action-delete"
                    :label="$t('global.default.delete')"
                    :on-label-click="() => { onOpenDeleteModal(); toggleFloatingUi(); }"
                />
            </template>
        </mt-popover>
        {% endblock %}
        {% block sw_blog_detail_actions_save %}
        <mt-button
            v-if="blog"
            class="sw-blog-detail__action-save"
            variant="primary"
            size="default"
            :disabled="!canEdit || isBusy"
            :is-loading="isSaving"
            @click="onSave()"
        >
            {{ $t('global.default.save') }}
        </mt-button>
        <mt-button
            v-if="blog && !blog.active && canEdit"
            class="sw-blog-detail__publish-now"
            variant="secondary"
            size="default"
            :disabled="isBusy"
            @click="onPublishNow"
        >
            {{ $t('sw-blog.detail.buttonPublishNow') }}
        </mt-button>
        {% endblock %}
    </template>
    {% endblock %}

    {% block sw_blog_detail_content %}
    <template #content>
        <sw-skeleton
            v-if="!blog"
            class="sw-blog-detail__loading"
        />
        <div
            v-else
            class="sw-blog-detail__workspace"
        >
            {% block sw_blog_detail_tabs %}
            <mt-tabs
                class="sw-blog-detail__tabs"
                position-identifier="sw-blog-detail-tabs"
                :items="tabItems"
                :default-item="activeTab"
                :use-routes-for-extensions="false"
                @new-item-active="activeTab = $event"
            />
            {% endblock %}
            <div class="sw-blog-detail__layout">
                {% block sw_blog_detail_content_main %}
                <main class="sw-blog-detail__main">
                    <div
                        v-show="activeTab === 'content'"
                        class="sw-blog-detail__canvas"
                    >
                        {% block sw_blog_detail_content_general %}
                        <mt-card
                            class="sw-blog-detail__content-card"
                            position-identifier="sw-blog-detail-general"
                            :is-loading="isLoading"
                        >
                            {% block sw_blog_detail_content_general_fields %}
                            <mt-text-field
                                v-model="blog.title"
                                :error="blogTitleError"
                                class="sw-blog-detail__title"
                                required
                                :disabled="!canEdit || isBusy"
                                :label="$t('sw-blog.detail.labelTitle')"
                                :placeholder="$t('sw-blog.detail.placeholderTitle')"
                            />
                            <mt-textarea
                                v-model="blog.teaser"
                                :error="blogTeaserError"
                                class="sw-blog-detail__teaser"
                                :disabled="!canEdit || isBusy"
                                :label="$t('sw-blog.detail.labelTeaser')"
                                :placeholder="$t('sw-blog.detail.placeholderTeaser')"
                            />
                            {% endblock %}
                            {% block sw_blog_detail_content_content %}
                            <sw-blog-detail-content
                                :blog="blog"
                                :video="video"
                                :is-disabled="!canEdit || isBusy"
                            />
                            {% endblock %}
                            {% block sw_blog_detail_content_extensions %}
                            <sw-extension-component-section position-identifier="sw-blog-detail-content" />
                            {% endblock %}
                        </mt-card>
                        {% endblock %}
                    </div>
                    {% block sw_blog_detail_content_page_layout %}
                    <sw-blog-detail-layout
                        v-if="activeTab === 'layout'"
                        :blog="blog"
                        :is-disabled="!canEdit || isBusy"
                    />
                    {% endblock %}
                    {% block sw_blog_detail_content_seo %}
                    <mt-card
                        v-if="activeTab === 'seo'"
                        class="sw-blog-detail__seo"
                        position-identifier="sw-blog-detail-seo"
                        :title="$t('sw-blog.detail.cardSeo')"
                    >
                        {% block sw_blog_detail_content_seo_fields %}
                        <mt-text-field
                            v-model="blog.slug"
                            :error="blogSlugError"
                            class="sw-blog-detail__slug"
                            :disabled="!canEdit || isBusy"
                            :label="$t('sw-blog.detail.labelSlug')"
                            :help-text="$t('sw-blog.detail.helpTextSlug')"
                        />
                        <mt-text-field
                            v-model="blog.metaTitle"
                            :error="blogMetaTitleError"
                            class="sw-blog-detail__meta-title"
                            :disabled="!canEdit || isBusy"
                            :label="$t('sw-blog.detail.labelMetaTitle')"
                            :placeholder="$t('sw-blog.detail.placeholderMetaTitle')"
                        />
                        <mt-textarea
                            v-model="blog.metaDescription"
                            :error="blogMetaDescriptionError"
                            class="sw-blog-detail__meta-description"
                            :disabled="!canEdit || isBusy"
                            :label="$t('sw-blog.detail.labelMetaDescription')"
                            :placeholder="$t('sw-blog.detail.placeholderMetaDescription')"
                        />
                        <mt-text-field
                            v-model="blog.keywords"
                            :error="blogKeywordsError"
                            :disabled="!canEdit || isBusy"
                            :label="$t('sw-blog.detail.labelKeywords')"
                            :placeholder="$t('sw-blog.detail.placeholderKeywords')"
                        />
                        {% endblock %}
                    </mt-card>
                    {% endblock %}
                </main>
                {% endblock %}

                {% block sw_blog_detail_content_rail %}
                <aside class="sw-blog-detail__rail">
                    <mt-card
                        class="sw-blog-detail__settings"
                        position-identifier="sw-blog-detail-publish"
                    >
                        {% block sw_blog_detail_sidebar_publish %}
                        <section class="sw-blog-detail__settings-section">
                            <h3>{{ $t('sw-blog.detail.sidebarPublish') }}</h3>
                            <mt-switch
                                v-model="blog.active"
                                :disabled="!canEdit || isBusy"
                                :label="$t('sw-blog.detail.labelPublicationEnabled')"
                            />
                            <mt-datepicker
                                v-model="blog.publishedAt"
                                date-type="datetime"
                                :disabled="!canEdit || isBusy"
                                :label="$t('sw-blog.detail.labelPublishedAt')"
                                :help-text="$t('sw-blog.detail.helpTextPublishedAt')"
                            />
                            <mt-button
                                v-if="blog.active || blog.publishedAt"
                                class="sw-blog-detail__clear-schedule"
                                variant="tertiary"
                                size="small"
                                :disabled="!canEdit || isBusy"
                                @click="onClearSchedule"
                            >
                                {{ $t('sw-blog.detail.buttonClearSchedule') }}
                            </mt-button>
                        </section>
                        {% endblock %}
                        {% block sw_blog_detail_rail_categories %}
                        <section class="sw-blog-detail__settings-section">
                            <h3>{{ $t('sw-blog.detail.sectionOrganization') }}</h3>
                            <sw-entity-single-select
                                v-model:value="blog.authorId"
                                class="sw-blog-detail__author"
                                entity="blog_author"
                                :criteria="authorCriteria"
                                :disabled="!canEdit || isBusy"
                                :label="$t('sw-blog.detail.labelAuthor')"
                            />
                            <sw-entity-multi-id-select
                                v-model:value="selectedCategoryIds"
                                :repository="categoryRepository"
                                :disabled="!canEdit || isBusy"
                                :label="$t('sw-blog.detail.labelCategories')"
                                :placeholder="$t('sw-blog.detail.placeholderCategories')"
                            />
                            <sw-entity-tag-select
                                v-model:entity-collection="blog.tags"
                                :error="blogTagsError"
                                :disabled="!canEdit || isBusy"
                                :label="$t('global.sw-tag-field.title')"
                                :placeholder="$t('sw-blog.detail.placeholderTags')"
                            />
                        </section>
                        {% endblock %}
                        {% block sw_blog_detail_sidebar_cover %}
                        <section class="sw-blog-detail__settings-section">
                            <h3>{{ $t('sw-blog.detail.sidebarCover') }}</h3>
                            <sw-media-compact-upload-v2
                                :source="blog.coverMediaId"
                                :upload-tag="mediaUploadTag"
                                :disabled="!canEdit || isBusy"
                                :allow-multi-select="false"
                                @selection-change="onCoverSelected"
                                @delete-item="onCoverRemoved"
                            />
                        </section>
                        {% endblock %}
                        {% block sw_blog_detail_settings_extensions %}
                        <sw-extension-component-section position-identifier="sw-blog-detail-settings" />
                        {% endblock %}
                    </mt-card>
                </aside>
                {% endblock %}
            </div>
        </div>

        {% block sw_blog_detail_delete_modal %}
        <sw-modal
            v-if="showDeleteModal"
            class="sw-blog-detail__delete-modal"
            variant="small"
            :title="$t('sw-blog.list.titleDeleteBlog')"
            @modal-close="onCloseDeleteModal"
        >
            <p>{{ deleteMessage }}</p>
            <template #modal-footer>
                <mt-button
                    variant="secondary"
                    size="small"
                    @click="onCloseDeleteModal"
                >
                    {{ $t('global.default.cancel') }}
                </mt-button>
                <mt-button
                    variant="critical"
                    size="small"
                    @click="onDelete"
                >
                    {{ $t('global.default.delete') }}
                </mt-button>
            </template>
        </sw-modal>
        {% endblock %}
        <sw-discard-changes-modal
            v-if="pendingRoute"
            @keep-editing="pendingRoute = null"
            @discard-changes="onDiscardChanges"
        />
    </template>
    {% endblock %}
</sw-page>
{% endblock %}
