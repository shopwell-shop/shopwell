{% block sw_category_view %}
<sw-card-view
    class="sw-category-view"
    position-identifier="sw-category-view"
>
    {% block sw_category_view_language_info %}
    <sw-language-info
        :entity-description="placeholder(category, 'name', $t('sw-manufacturer.detail.textHeadline'))"
    />
    {% endblock %}

    {% block sw_category_view_column_info %}
    <mt-banner
        v-if="isCategoryColumn"
        class="swag-category-view__column-info"
        variant="info"
    >
        <div class="swag-category-view__column-info-header">
            {{ $t('sw-category.view.columnInfoHeader') }}
        </div>
        <div class="swag-category-view__column-info-content">
            {{ $t('sw-category.view.columnInfo') }}
        </div>
    </mt-banner>
    {% endblock %}

    {% block sw_category_view_tabs %}
    <template v-if="feature.isActive('v6.8.0.0')">
        {% block sw_category_view_mt_tabs %}
        <mt-tabs
            v-if="!isLoading"
            position-identifier="sw-category-view"
            class="sw-category-detail-page__tabs"
            :default-item="$route.name"
            :items="categoryViewTabs"
            :small="true"
        />
        {% endblock %}
    </template>

    <template v-else>
        <sw-tabs
            v-if="!isLoading"
            position-identifier="sw-category-view"
            class="sw-category-detail-page__tabs"
        >
            {% block sw_category_view_tabs_general %}
            <sw-tabs-item
                class="sw-category-detail__tab-base"
                :route="{ name: 'sw.category.detail.base' }"
                :title="$t('sw-category.view.general')"
                :has-error="swCategoryViewError"
            >
                {{ $t('sw-category.view.general') }}
            </sw-tabs-item>
            {% endblock %}

            {% block sw_category_view_tabs_products %}
            <sw-tabs-item
                v-show="isPage"
                class="sw-category-detail__tab-products"
                :route="{ name: 'sw.category.detail.products' }"
                :title="$t('sw-category.view.products')"
            >
                {{ $t('sw-category.view.products') }}
            </sw-tabs-item>
            {% endblock %}

            {% block sw_category_view_tabs_layout %}
            <sw-tabs-item
                v-show="isPage"
                class="sw-category-detail__tab-layout"
                :route="{ name: 'sw.category.detail.layout' }"
                :title="$t('sw-category.view.layout')"
            >
                {{ $t('sw-category.view.layout') }}
            </sw-tabs-item>
            {% endblock %}

            {% block sw_category_view_tabs_seo %}
            <sw-tabs-item
                v-show="isPage"
                class="sw-category-detail__tab-seo"
                :route="{ name: 'sw.category.detail.seo' }"
                :title="$t('sw-category.view.seo')"
            >
                {{ $t('sw-category.view.seo') }}
            </sw-tabs-item>
            {% endblock %}
        </sw-tabs>
    </template>
    {% endblock %}

    {% block sw_category_view_content %}
    <router-view
        v-slot="{ Component }"
    >
        <component
            :is="Component"
            :is-loading="isLoading"
        />
    </router-view>
    {% endblock %}
</sw-card-view>
{% endblock %}
