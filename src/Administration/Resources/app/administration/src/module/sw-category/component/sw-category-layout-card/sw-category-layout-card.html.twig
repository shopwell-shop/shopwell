{% block sw_category_layout_card %}
<mt-card
    :title="$t('sw-experience-studio.general.mainMenuItemGeneral')"
    :is-loading="isLoading"
    position-identifier="sw-category-layout-card"
>
    <p>{{ $t('sw-experience-studio.general.descriptionTextModule') }}</p>
    <mt-button
        :disabled="!acl.can('experience_studio.viewer')"
        variant="secondary"
        @click="$router.push({ name: 'sw.experience.studio.index' })"
    >
        {{ $t('sw-experience-studio.general.mainMenuItemGeneral') }}
    </mt-button>
</mt-card>
{% endblock %}
