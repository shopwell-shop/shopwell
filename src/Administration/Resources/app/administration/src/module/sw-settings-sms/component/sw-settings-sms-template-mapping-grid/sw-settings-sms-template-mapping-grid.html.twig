{% block sw_settings_sms_template_mapping_grid %}
<sw-data-grid
    class="sw-settings-sms-template-mapping-grid"
    :data-source="mappings"
    :columns="columns"
    :show-selection="false"
    :show-actions="true"
    :plain-appearance="true"
    identifier="sw-settings-sms-template-mapping-grid"
>

    {% block sw_settings_sms_template_mapping_grid_column_provider %}
    <template #column-technicalName="{ item }">
        <mt-select
            v-model="item.technicalName"
            class="sw-settings-sms-template-mapping-grid__provider"
            name="technicalName"
            :options="providerOptions"
            :disabled="disabled || undefined"
        />
    </template>
    {% endblock %}

    {% block sw_settings_sms_template_mapping_grid_column_gateway %}
    <template #column-gatewayId="{ item }">
        <mt-select
            v-model="item.gatewayId"
            class="sw-settings-sms-template-mapping-grid__gateway"
            name="gatewayId"
            clearable
            :placeholder="$t('sw-settings-sms.mapping.gatewayAllAccounts')"
            :options="gatewayOptions"
            :disabled="disabled || undefined"
        />
    </template>
    {% endblock %}

    {% block sw_settings_sms_template_mapping_grid_column_template_code %}
    <template #column-templateCode="{ item }">
        <mt-text-field
            v-model="item.templateCode"
            class="sw-settings-sms-template-mapping-grid__template-code"
            name="templateCode"
            :placeholder="$t('sw-settings-sms.mapping.templateCodePlaceholder')"
            :required="needsTemplateCode(item)"
            :disabled="disabled || undefined"
        />
    </template>
    {% endblock %}

    {% block sw_settings_sms_template_mapping_grid_column_sign_name %}
    <template #column-signName="{ item }">
        <mt-text-field
            v-model="item.signName"
            class="sw-settings-sms-template-mapping-grid__sign-name"
            name="signName"
            :placeholder="$t('sw-settings-sms.mapping.signNamePlaceholder')"
            :disabled="disabled || undefined"
        />
    </template>
    {% endblock %}

    {% block sw_settings_sms_template_mapping_grid_column_audit_status %}
    <template #column-auditStatus="{ item }">
        {# The state is what the provider answered, the shop does not type it. #}
        <div class="sw-settings-sms-template-mapping-grid__audit">
            <span class="sw-settings-sms-template-mapping-grid__audit-status">
                {{ auditStatusLabel(item.auditStatus) }}
            </span>

            {% block sw_settings_sms_template_mapping_grid_column_audit_status_code %}
            <span
                v-if="statusCodeOf(item)"
                class="sw-settings-sms-template-mapping-grid__audit-code"
            >
                {{ $t('sw-settings-sms.mapping.providerStatusCode') }}: {{ statusCodeOf(item) }}
            </span>
            {% endblock %}

            {% block sw_settings_sms_template_mapping_grid_column_audit_status_message %}
            <span
                v-if="statusMessageOf(item)"
                class="sw-settings-sms-template-mapping-grid__audit-message"
            >
                {{ statusMessageOf(item) }}
            </span>
            {% endblock %}

            {% block sw_settings_sms_template_mapping_grid_column_audit_last_synced %}
            <span
                v-if="lastSyncedAtOf(item)"
                class="sw-settings-sms-template-mapping-grid__audit-last-synced"
            >
                {{ $t('sw-settings-sms.mapping.lastSyncedAt') }}: {{ lastSyncedAtOf(item) }}
            </span>
            {% endblock %}
        </div>
    </template>
    {% endblock %}

    {% block sw_settings_sms_template_mapping_grid_actions %}
    <template #actions="{ item }">
        {% block sw_settings_sms_template_mapping_grid_action_submit %}
        <sw-context-menu-item
            v-if="canSubmit(item)"
            class="sw-settings-sms-template-mapping-grid__submit"
            :disabled="disabled || isBusy(item) || undefined"
            @click="onOpenSubmission(item)"
        >
            {{ $t('sw-settings-sms.mapping.submitAction') }}
        </sw-context-menu-item>
        {% endblock %}

        {% block sw_settings_sms_template_mapping_grid_action_refresh %}
        <sw-context-menu-item
            v-if="canReadStatus(item)"
            class="sw-settings-sms-template-mapping-grid__refresh"
            :disabled="disabled || isBusy(item) || undefined"
            @click="onRefresh(item)"
        >
            {{ $t('sw-settings-sms.mapping.refreshAction') }}
        </sw-context-menu-item>
        {% endblock %}

        {% block sw_settings_sms_template_mapping_grid_action_confirm %}
        <sw-context-menu-item
            v-if="canConfirmStatus(item)"
            class="sw-settings-sms-template-mapping-grid__confirm"
            :disabled="disabled || isBusy(item) || undefined"
            @click="onOpenConfirmation(item)"
        >
            {{ $t('sw-settings-sms.mapping.confirmAction') }}
        </sw-context-menu-item>
        {% endblock %}

        {% block sw_settings_sms_template_mapping_grid_action_remove %}
        <sw-context-menu-item
            class="sw-settings-sms-template-mapping-grid__remove"
            variant="danger"
            :disabled="disabled || undefined"
            @click="onRemoveMapping(item)"
        >
            {{ $t('global.default.delete') }}
        </sw-context-menu-item>
        {% endblock %}
    </template>
    {% endblock %}

    {% block sw_settings_sms_template_mapping_grid_empty %}
    <template #empty-state>
        <mt-empty-state
            class="sw-settings-sms-template-mapping-grid__empty"
            :description="$t('sw-settings-sms.mapping.emptyState')"
        />
    </template>
    {% endblock %}
</sw-data-grid>

{% block sw_settings_sms_template_mapping_grid_add %}
<mt-button
    class="sw-settings-sms-template-mapping-grid__add"
    variant="secondary"
    size="small"
    :disabled="disabled || undefined"
    @click="onAddMapping"
>
    {{ $t('global.default.add') }}
</mt-button>
{% endblock %}

{% block sw_settings_sms_template_mapping_grid_help %}
<p class="sw-settings-sms-template-mapping-grid__help">
    {{ $t('sw-settings-sms.mapping.helpText') }}
</p>
{% endblock %}

{% block sw_settings_sms_template_mapping_grid_submission_modal %}
<sw-settings-sms-template-submission-modal
    v-if="submissionTarget"
    class="sw-settings-sms-template-mapping-grid__submission"
    :mapping="submissionTarget"
    :template="templateEntity"
    :submission-fields="submissionFields"
    @modal-close="onCloseSubmission"
    @submitted="onSubmissionFinished"
/>
{% endblock %}

{% block sw_settings_sms_template_mapping_grid_confirmation_modal %}
<mt-modal-root
    v-if="confirmationTarget"
    class="sw-settings-sms-template-mapping-grid__confirmation"
    is-open
    @change="onConfirmationModalChange"
>
    <mt-modal
        width="s"
        :title="$t('sw-settings-sms.mapping.confirmModalTitle')"
    >
        {% block sw_settings_sms_template_mapping_grid_confirmation_intro %}
        <p class="sw-settings-sms-template-mapping-grid__confirmation-intro">
            {{ $t('sw-settings-sms.mapping.confirmModalIntro') }}
        </p>
        {% endblock %}

        {% block sw_settings_sms_template_mapping_grid_confirmation_fields %}
        <mt-select
            v-model="confirmationStatus"
            class="sw-settings-sms-template-mapping-grid__confirmation-status"
            name="confirmationStatus"
            required
            :label="$t('sw-settings-sms.mapping.confirmStatusLabel')"
            :options="confirmationStatusOptions"
            :disabled="isConfirming || undefined"
        />

        <mt-textarea
            v-model="confirmationNote"
            class="sw-settings-sms-template-mapping-grid__confirmation-note"
            name="confirmationNote"
            required
            :label="$t('sw-settings-sms.mapping.confirmNoteLabel')"
            :help-text="$t('sw-settings-sms.mapping.confirmNoteHelpText')"
            :disabled="isConfirming || undefined"
        />
        {% endblock %}

        {% block sw_settings_sms_template_mapping_grid_confirmation_footer %}
        <template #footer>
            {% block sw_settings_sms_template_mapping_grid_confirmation_footer_cancel %}
            <mt-modal-close
                as="mt-button"
                variant="secondary"
                size="small"
                :disabled="isConfirming || undefined"
            >
                {{ $t('global.default.cancel') }}
            </mt-modal-close>
            {% endblock %}

            {% block sw_settings_sms_template_mapping_grid_confirmation_footer_confirm %}
            <mt-modal-action
                as="mt-button"
                variant="primary"
                size="small"
                :is-loading="isConfirming"
                :disabled="isConfirming || undefined"
                @click="onConfirm"
            >
                {{ $t('sw-settings-sms.mapping.confirmAction') }}
            </mt-modal-action>
            {% endblock %}
        </template>
        {% endblock %}
    </mt-modal>
</mt-modal-root>
{% endblock %}
{% endblock %}
