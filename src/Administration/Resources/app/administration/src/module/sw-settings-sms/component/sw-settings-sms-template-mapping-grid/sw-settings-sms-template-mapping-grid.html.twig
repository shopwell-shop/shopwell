{% block sw_settings_sms_template_mapping_grid %}
<sw-data-grid
    class="sw-settings-sms-template-mapping-grid"
    :data-source="mappings"
    :columns="columns"
    :show-selection="false"
    :show-actions="true"
    :plain-appearance="true"
    identifier="sw-settings-sms-template-mapping-grid"
>

    {% block sw_settings_sms_template_mapping_grid_column_provider %}
    <template #column-technicalName="{ item }">
        <mt-select
            v-model="item.technicalName"
            class="sw-settings-sms-template-mapping-grid__provider"
            name="technicalName"
            :options="providerOptions"
            :disabled="disabled || undefined"
        />
    </template>
    {% endblock %}

    {% block sw_settings_sms_template_mapping_grid_column_gateway %}
    <template #column-gatewayId="{ item }">
        <mt-select
            v-model="item.gatewayId"
            class="sw-settings-sms-template-mapping-grid__gateway"
            name="gatewayId"
            clearable
            :placeholder="$t('sw-settings-sms.mapping.gatewayAllAccounts')"
            :options="gatewayOptions"
            :disabled="disabled || undefined"
        />
    </template>
    {% endblock %}

    {% block sw_settings_sms_template_mapping_grid_column_template_code %}
    <template #column-templateCode="{ item }">
        <mt-text-field
            v-model="item.templateCode"
            class="sw-settings-sms-template-mapping-grid__template-code"
            name="templateCode"
            :placeholder="$t('sw-settings-sms.mapping.templateCodePlaceholder')"
            :required="needsTemplateCode(item)"
            :disabled="disabled || undefined"
        />
    </template>
    {% endblock %}

    {% block sw_settings_sms_template_mapping_grid_column_sign_name %}
    <template #column-signName="{ item }">
        <mt-text-field
            v-model="item.signName"
            class="sw-settings-sms-template-mapping-grid__sign-name"
            name="signName"
            :placeholder="$t('sw-settings-sms.mapping.signNamePlaceholder')"
            :disabled="disabled || undefined"
        />
    </template>
    {% endblock %}

    {% block sw_settings_sms_template_mapping_grid_column_audit_status %}
    <template #column-auditStatus="{ item }">
        <mt-select
            v-model="item.auditStatus"
            class="sw-settings-sms-template-mapping-grid__audit-status"
            name="auditStatus"
            :options="auditStatusOptions"
            :disabled="disabled || undefined"
        />
    </template>
    {% endblock %}

    {% block sw_settings_sms_template_mapping_grid_actions %}
    <template #actions="{ item }">
        <sw-context-menu-item
            class="sw-settings-sms-template-mapping-grid__remove"
            variant="danger"
            :disabled="disabled || undefined"
            @click="onRemoveMapping(item)"
        >
            {{ $t('global.default.delete') }}
        </sw-context-menu-item>
    </template>
    {% endblock %}

    {% block sw_settings_sms_template_mapping_grid_empty %}
    <template #empty-state>
        <mt-empty-state
            class="sw-settings-sms-template-mapping-grid__empty"
            :description="$t('sw-settings-sms.mapping.emptyState')"
        />
    </template>
    {% endblock %}
</sw-data-grid>

{% block sw_settings_sms_template_mapping_grid_add %}
<mt-button
    class="sw-settings-sms-template-mapping-grid__add"
    variant="secondary"
    size="small"
    :disabled="disabled || undefined"
    @click="onAddMapping"
>
    {{ $t('global.default.add') }}
</mt-button>
{% endblock %}

{% block sw_settings_sms_template_mapping_grid_help %}
<p class="sw-settings-sms-template-mapping-grid__help">
    {{ $t('sw-settings-sms.mapping.helpText') }}
</p>
{% endblock %}
{% endblock %}
