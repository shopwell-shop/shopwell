{% block sw_customer_detail_loyalty_overview %}
<mt-card
    v-if="showOverview"
    class="sw-customer-detail-loyalty-overview"
    position-identifier="sw-customer-detail-loyalty-overview"
    :title="$t('sw-customer.detailLoyaltyOverview.cardTitle')"
    :is-loading="isLoading"
>
    {% block sw_customer_detail_loyalty_overview_content %}
    <sw-container
        columns="repeat(auto-fit, minmax(200px, 1fr))"
        gap="0px 30px"
    >
        {% block sw_customer_detail_loyalty_overview_membership %}
        <div
            v-if="canViewLoyalty"
            class="sw-customer-detail-loyalty-overview__block"
        >
            <p class="sw-customer-detail-loyalty-overview__block-title">
                {{ $t('sw-customer.detailLoyaltyOverview.membershipTitle') }}
            </p>

            <div class="sw-customer-detail-loyalty-overview__row">
                <span class="sw-customer-detail-loyalty-overview__row-label">
                    {{ $t('sw-customer.detailLoyaltyOverview.labelMembershipTier') }}
                </span>
                <span class="sw-customer-detail-loyalty-overview__row-value">
                    <mt-badge
                        v-if="loyalty?.membershipTier"
                        class="sw-customer-detail-loyalty-overview__tier-badge"
                    >
                        {{ membershipTierName }}
                    </mt-badge>
                    <span v-else>{{ membershipTierName }}</span>
                </span>
            </div>

            <div class="sw-customer-detail-loyalty-overview__row">
                <span class="sw-customer-detail-loyalty-overview__row-label">
                    {{ $t('sw-customer.detailLoyaltyOverview.labelGrowthValue') }}
                </span>
                <span class="sw-customer-detail-loyalty-overview__row-value">
                    {{ loyalty ? loyalty.growthValue : '-' }}
                </span>
            </div>

            <div class="sw-customer-detail-loyalty-overview__row">
                <span class="sw-customer-detail-loyalty-overview__row-label">
                    {{ $t('sw-customer.detailLoyaltyOverview.labelMembershipValidUntil') }}
                </span>
                <span class="sw-customer-detail-loyalty-overview__row-value">
                    {{ loyalty ? membershipValidUntilLabel : '-' }}
                </span>
            </div>
        </div>
        {% endblock %}

        {% block sw_customer_detail_loyalty_overview_points %}
        <div
            v-if="canViewLoyalty"
            class="sw-customer-detail-loyalty-overview__block"
        >
            <p class="sw-customer-detail-loyalty-overview__block-title">
                {{ $t('sw-customer.detailLoyaltyOverview.pointsTitle') }}
            </p>

            <div class="sw-customer-detail-loyalty-overview__row">
                <span class="sw-customer-detail-loyalty-overview__row-label">
                    {{ $t('sw-customer.detailLoyaltyOverview.labelPointsBalance') }}
                </span>
                <span class="sw-customer-detail-loyalty-overview__row-value">
                    {{ loyalty ? loyalty.pointsBalance : '-' }}
                </span>
            </div>

            <mt-link
                class="sw-customer-detail-loyalty-overview__link"
                :to="pointsRoute"
            >
                {{ $t('sw-customer.detailLoyaltyOverview.linkPointTransactions') }}
            </mt-link>
        </div>
        {% endblock %}

        {% block sw_customer_detail_loyalty_overview_wallet %}
        <div
            v-if="canViewWallet"
            class="sw-customer-detail-loyalty-overview__block"
        >
            <p class="sw-customer-detail-loyalty-overview__block-title">
                {{ $t('sw-customer.detailLoyaltyOverview.walletTitle') }}
            </p>

            <div class="sw-customer-detail-loyalty-overview__row">
                <span class="sw-customer-detail-loyalty-overview__row-label">
                    {{ $t('sw-customer.detailLoyaltyOverview.labelWalletBalance') }}
                </span>
                <span class="sw-customer-detail-loyalty-overview__row-value">
                    {{ wallet ? formatAmount(wallet.balance) : '-' }}
                </span>
            </div>

            <div class="sw-customer-detail-loyalty-overview__row">
                <span class="sw-customer-detail-loyalty-overview__row-label">
                    {{ $t('sw-customer.detailLoyaltyOverview.labelWalletLockedBalance') }}
                </span>
                <span class="sw-customer-detail-loyalty-overview__row-value">
                    {{ wallet ? formatAmount(wallet.lockedBalance) : '-' }}
                </span>
            </div>

            <mt-link
                class="sw-customer-detail-loyalty-overview__link"
                :to="walletRoute"
            >
                {{ $t('sw-customer.detailLoyaltyOverview.linkWalletTransactions') }}
            </mt-link>
        </div>
        {% endblock %}
    </sw-container>
    {% endblock %}
</mt-card>
{% endblock %}
