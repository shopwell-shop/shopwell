{% block sw_customer_detail_points %}
<div class="sw-customer-detail-points">

    {% block sw_customer_detail_points_membership_card %}
    <mt-card
        class="sw-customer-detail-points__membership"
        position-identifier="sw-customer-detail-points-membership"
        :title="$t('sw-customer.detailPoints.cardMembershipTitle')"
        :is-loading="isLoading"
    >
        {% block sw_customer_detail_points_membership_actions %}
        <template #headerRight>
            <mt-button
                class="sw-customer-detail-points__grant-membership-action"
                variant="secondary"
                size="small"
                :disabled="!allowAdjustPoints || undefined"
                @click="openMembershipModal"
            >
                {{ $t('sw-customer.detailPoints.buttonGrantMembership') }}
            </mt-button>
        </template>
        {% endblock %}

        {% block sw_customer_detail_points_membership_content %}
        <sw-container
            columns="repeat(auto-fit, minmax(200px, 1fr))"
            gap="0px 30px"
        >
            {% block sw_customer_detail_points_membership_tier %}
            <div class="sw-customer-detail-points__item">
                <p class="sw-customer-detail-points__item-label">
                    {{ $t('sw-customer.detailPoints.labelCurrentTier') }}
                </p>
                <p class="sw-customer-detail-points__item-value">
                    {{ loyaltySummary ? membershipTierLabel : '-' }}
                </p>
                <mt-badge
                    v-if="loyaltySummary && loyaltySummary.membershipTier"
                    class="sw-customer-detail-points__membership-state"
                    size="small"
                    :type="membershipIsRunning ? 'success' : 'warning'"
                >
                    {{ membershipIsRunning
                    ? $t('sw-customer.detailPoints.membershipRunning')
                    : $t('sw-customer.detailPoints.membershipExpired') }}
                </mt-badge>
            </div>
            {% endblock %}

            {% block sw_customer_detail_points_membership_valid_until %}
            <div class="sw-customer-detail-points__item">
                <p class="sw-customer-detail-points__item-label">
                    {{ $t('sw-customer.detailPoints.labelMembershipValidUntil') }}
                </p>
                <p class="sw-customer-detail-points__item-value">
                    {{ loyaltySummary ? formatExpiry(membershipValidUntil) : '-' }}
                </p>
            </div>
            {% endblock %}

            {% block sw_customer_detail_points_membership_points_balance %}
            <div class="sw-customer-detail-points__item">
                <p class="sw-customer-detail-points__item-label">
                    {{ $t('sw-customer.detailPoints.labelPointsBalance') }}
                </p>
                <p class="sw-customer-detail-points__item-value">
                    {{ loyaltySummary ? loyaltySummary.pointsBalance : '-' }}
                </p>
            </div>
            {% endblock %}
        </sw-container>
        {% endblock %}

        {% block sw_customer_detail_points_growth %}
        <div
            v-if="nextTier"
            class="sw-customer-detail-points__growth"
        >
            <div class="sw-customer-detail-points__growth-header">
                <span class="sw-customer-detail-points__item-label">
                    {{ $t('sw-customer.detailPoints.labelGrowthValue') }}
                </span>
                <span class="sw-customer-detail-points__growth-values">
                    {{ $t('sw-customer.detailPoints.growthProgress', {
                    current: growthValue,
                    required: nextTier.minGrowthValue,
                    tier: nextTier.name
                    }, 0) }}
                </span>
            </div>
            <mt-progress-bar
                class="sw-customer-detail-points__growth-bar"
                :model-value="growthProgress"
                :max-value="100"
            />
        </div>
        {% endblock %}
    </mt-card>
    {% endblock %}

    {% block sw_customer_detail_points_orders_card %}
    <mt-card
        class="sw-customer-detail-points__orders"
        position-identifier="sw-customer-detail-points-orders"
        :title="$t('sw-customer.detailPoints.cardMembershipOrdersTitle')"
        :is-loading="isLoading"
    >
        {% block sw_customer_detail_points_orders_grid %}
        <sw-data-grid
            v-if="orders.length > 0"
            class="sw-customer-detail-points__order-grid"
            :data-source="orders"
            :columns="orderColumns"
            :show-selection="false"
            :show-settings="false"
            :compact-mode="true"
        >
            {% block sw_customer_detail_points_orders_grid_column_plan %}
            <template #column-planName="{ item }">
                {{ item.planName || '-' }}
            </template>
            {% endblock %}

            {% block sw_customer_detail_points_orders_grid_column_amount %}
            <template #column-amount="{ item }">
                {{ formatAmount(item.amount, item.currency) }}
            </template>
            {% endblock %}

            {% block sw_customer_detail_points_orders_grid_column_state %}
            <template #column-state="{ item }">
                <mt-badge
                    class="sw-customer-detail-points__order-state"
                    size="small"
                    :type="getOrderStateVariant(item.state)"
                >
                    {{ getOrderStateLabel(item.state) }}
                </mt-badge>
            </template>
            {% endblock %}

            {% block sw_customer_detail_points_orders_grid_column_paid_at %}
            <template #column-paidAt="{ item }">
                {{ formatDate(item.paidAt) }}
            </template>
            {% endblock %}
        </sw-data-grid>

        {% block sw_customer_detail_points_orders_empty %}
        <mt-empty-state
            v-else-if="!isLoading"
            class="sw-customer-detail-points__order-empty-state"
            centered
            icon="regular-shopping-bag"
            :headline="$t('sw-customer.detailPoints.emptyMembershipOrders')"
        />
        {% endblock %}
        {% endblock %}
    </mt-card>
    {% endblock %}

    {% block sw_customer_detail_points_transactions_card %}
    <mt-card
        class="sw-customer-detail-points__transactions"
        position-identifier="sw-customer-detail-point-transactions"
        :title="$t('sw-customer.detailPoints.cardPointTransactionsTitle')"
        :is-loading="isLoading"
    >
        {% block sw_customer_detail_points_transactions_actions %}
        <template #headerRight>
            <div class="sw-customer-detail-points__transaction-actions">
                <mt-select
                    v-model="typeFilter"
                    class="sw-customer-detail-points__type-filter"
                    :options="typeFilterOptions"
                    :label="$t('sw-customer.detailPoints.labelFilterType')"
                    size="small"
                    @update:model-value="onFilterChange"
                />
                <mt-button
                    class="sw-customer-detail-points__adjust-points-action"
                    variant="secondary"
                    size="small"
                    :disabled="!allowAdjustPoints || undefined"
                    @click="openPointsModal"
                >
                    {{ $t('sw-customer.detailPoints.buttonAdjustPoints') }}
                </mt-button>
            </div>
        </template>
        {% endblock %}

        {% block sw_customer_detail_points_transactions_grid %}
        <sw-data-grid
            v-if="transactions.length > 0"
            class="sw-customer-detail-points__transaction-grid"
            :data-source="transactions"
            :columns="pointsTransactionColumns"
            :show-selection="false"
            :show-settings="false"
            :compact-mode="true"
        >
            {% block sw_customer_detail_points_transactions_grid_column_date %}
            <template #column-createdAt="{ item }">
                {{ formatDate(item.createdAt) }}
            </template>
            {% endblock %}

            {% block sw_customer_detail_points_transactions_grid_column_type %}
            <template #column-type="{ item }">
                {{ getPointsTransactionTypeLabel(item.type) }}
            </template>
            {% endblock %}

            {% block sw_customer_detail_points_transactions_grid_column_points %}
            <template #column-points="{ item }">
                <span :class="{ 'is--negative': item.points < 0 }">
                    {{ item.points }}
                </span>
            </template>
            {% endblock %}

            {% block sw_customer_detail_points_transactions_grid_column_balance_after %}
            <template #column-balanceAfter="{ item }">
                {{ item.balanceAfter }}
            </template>
            {% endblock %}

            {% block sw_customer_detail_points_transactions_grid_column_comment %}
            <template #column-comment="{ item }">
                {{ item.comment || '-' }}
            </template>
            {% endblock %}
        </sw-data-grid>

        {% block sw_customer_detail_points_transactions_empty_state %}
        <mt-empty-state
            v-else-if="!isLoading"
            class="sw-customer-detail-points__transaction-empty-state"
            centered
            icon="regular-star"
            :headline="$t('sw-customer.detailPoints.emptyPointTransactions')"
        />
        {% endblock %}

        {% block sw_customer_detail_points_transactions_pagination %}
        <sw-pagination
            v-if="total > 0"
            :page="page"
            :limit="limit"
            :total="total"
            @page-change="onPageChange"
        />
        {% endblock %}
        {% endblock %}
    </mt-card>
    {% endblock %}

    {% block sw_customer_detail_points_modal %}
    <sw-modal
        v-if="showPointsModal"
        class="sw-customer-detail-points__points-modal"
        :title="$t('sw-customer.detailPoints.pointsModalTitle')"
        @modal-close="closePointsModal"
    >
        {% block sw_customer_detail_points_modal_content %}
        <mt-number-field
            v-model="pointsForm.points"
            name="sw-field--pointsForm-points"
            class="sw-customer-detail-points__points-input"
            number-type="int"
            :label="$t('sw-customer.detailPoints.labelPoints')"
            :help-text="$t('sw-customer.detailPoints.pointsHelpText')"
        />

        <mt-textarea
            v-model="pointsForm.comment"
            name="sw-field--pointsForm-comment"
            class="sw-customer-detail-points__points-comment"
            :label="$t('sw-customer.detailPoints.labelComment')"
            :placeholder="$t('sw-customer.detailPoints.placeholderComment')"
        />
        {% endblock %}

        {% block sw_customer_detail_points_modal_footer %}
        <template #modal-footer>
            <mt-button
                class="sw-customer-detail-points__points-modal-cancel"
                variant="secondary"
                size="small"
                @click="closePointsModal"
            >
                {{ $t('global.default.cancel') }}
            </mt-button>
            <mt-button
                class="sw-customer-detail-points__points-modal-save"
                variant="primary"
                size="small"
                :is-loading="isSavingPoints"
                :disabled="!isPointsFormValid || undefined"
                @click="onSavePoints"
            >
                {{ $t('global.default.save') }}
            </mt-button>
        </template>
        {% endblock %}
    </sw-modal>
    {% endblock %}

    {% block sw_customer_detail_points_membership_modal %}
    <sw-modal
        v-if="showMembershipModal"
        class="sw-customer-detail-points__membership-modal"
        :title="$t('sw-customer.detailPoints.membershipModalTitle')"
        @modal-close="closeMembershipModal"
    >
        {% block sw_customer_detail_points_membership_modal_content %}
        <p class="sw-customer-detail-points__membership-modal-description">
            {{ $t('sw-customer.detailPoints.membershipHelpText') }}
        </p>

        <mt-select
            v-model="membershipForm.tierId"
            class="sw-customer-detail-points__membership-tier"
            :options="tierOptions"
            :label="$t('sw-customer.detailPoints.labelMembershipTier')"
            required
        />

        <mt-number-field
            v-model="membershipForm.durationDays"
            name="sw-field--membershipForm-durationDays"
            class="sw-customer-detail-points__membership-duration"
            number-type="int"
            :min="1"
            :label="$t('sw-customer.detailPoints.labelMembershipDuration')"
            :help-text="$t('sw-customer.detailPoints.membershipDurationHelpText')"
        />
        {% endblock %}

        {% block sw_customer_detail_points_membership_modal_footer %}
        <template #modal-footer>
            <mt-button
                class="sw-customer-detail-points__membership-modal-cancel"
                variant="secondary"
                size="small"
                @click="closeMembershipModal"
            >
                {{ $t('global.default.cancel') }}
            </mt-button>
            <mt-button
                class="sw-customer-detail-points__membership-modal-save"
                variant="primary"
                size="small"
                :is-loading="isSavingMembership"
                :disabled="!isMembershipFormValid || undefined"
                @click="onSaveMembership"
            >
                {{ $t('global.default.save') }}
            </mt-button>
        </template>
        {% endblock %}
    </sw-modal>
    {% endblock %}
</div>
{% endblock %}
