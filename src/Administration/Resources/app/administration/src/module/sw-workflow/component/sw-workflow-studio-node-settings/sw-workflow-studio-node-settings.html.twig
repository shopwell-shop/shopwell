{% block sw_workflow_studio_node_settings %}
<aside class="sw-workflow-studio-node-settings">
    <div class="sw-workflow-studio-node-settings__header">
        <h3>{{ $t('sw-workflow.panels.settings') }}</h3><mt-icon
            name="regular-cog"
            size="16px"
        />
    </div>
    <div
        v-if="node"
        class="sw-workflow-studio-node-settings__content"
    >
        <div class="sw-workflow-studio-node-settings__identity">
            <span><mt-icon
                :name="presentation.icon"
                size="20px"
            /></span><div><h4>{{ typeLabel }}</h4><p>{{ $t('sw-workflow.panels.basicSettings') }}</p></div>
        </div>
        {% block sw_workflow_studio_node_settings_fields %}
        <div class="sw-workflow-studio-node-settings__fields">
            <mt-text-field
                v-model="label"
                :label="$t('sw-workflow.fields.label')"
                :placeholder="typeLabel"
                :disabled="!allowEdit"
                @blur="commit"
            />
            <mt-textarea
                v-model="description"
                :label="$t('sw-workflow.fields.description')"
                :placeholder="$t('sw-workflow.fields.descriptionPlaceholder')"
                :disabled="!allowEdit"
                @blur="commit"
            />
            <component
                :is="presentation.settingsComponent"
                v-if="presentation.settingsComponent"
                :node="node"
                :document="document"
                :allow-edit="allowEdit"
                @update-config="updateConfig"
            />
        </div>
        {% endblock %}
        <mt-banner
            class="sw-workflow-studio-node-settings__notice"
            variant="info"
        >
            <p>{{ $t('sw-workflow.panels.configurationHint') }}</p>
        </mt-banner>
        <div class="sw-workflow-studio-node-settings__remove">
            <mt-button
                variant="critical"
                :disabled="!allowEdit || !canRemove"
                @click="$emit('remove')"
            >
                {{ $t('sw-workflow.actions.remove') }}
            </mt-button><p v-if="!canRemove">
                {{ $t('sw-workflow.panels.removeHint') }}
            </p>
        </div>
    </div>
    <mt-empty-state
        v-else
        class="sw-workflow-studio-node-settings__empty"
        icon="regular-sitemap"
        :headline="$t('sw-workflow.panels.selectTitle')"
        :description="$t('sw-workflow.panels.selectHint')"
    />
</aside>
{% endblock %}
