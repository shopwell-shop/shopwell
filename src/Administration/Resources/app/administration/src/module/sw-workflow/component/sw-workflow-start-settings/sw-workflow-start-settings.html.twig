{% block sw_workflow_start_settings %}
<section
    v-if="enabled"
    class="sw-workflow-start-settings"
>
    <h4>{{ $t('sw-workflow.form.title') }}</h4>
    <p class="sw-workflow-start-settings__hint">
        {{ $t('sw-workflow.form.hint') }}
    </p>
    <div
        v-for="(field, index) in fields"
        :key="field.key"
        class="sw-workflow-start-settings__field"
    >
        <div class="sw-workflow-start-settings__heading">
            <button
                type="button"
                class="sw-workflow-start-settings__expand"
                :aria-expanded="activeKey === field.key"
                @click="activeKey = activeKey === field.key ? '' : field.key"
            >
                <span>{{ index + 1 }}</span><strong>{{ field.label || $t('sw-workflow.form.newField') }}</strong>
            </button>
            <button
                type="button"
                :aria-label="$t('sw-workflow.condition.moveUp')"
                :disabled="!allowEdit || index === 0"
                @click="move(index, -1)"
            >
                <mt-icon
                    name="regular-chevron-up-xs"
                    size="12px"
                />
            </button>
            <button
                type="button"
                :aria-label="$t('sw-workflow.condition.moveDown')"
                :disabled="!allowEdit || index === fields.length - 1"
                @click="move(index, 1)"
            >
                <mt-icon
                    name="regular-chevron-down-xs"
                    size="12px"
                />
            </button>
        </div>
        <div
            v-if="activeKey === field.key"
            class="sw-workflow-start-settings__settings"
        >
            <mt-text-field
                v-model="field.label"
                class="sw-workflow-start-settings__label"
                :label="$t('sw-workflow.form.label')"
                :disabled="!allowEdit"
                @update:model-value="commit"
            />
            <mt-select
                :model-value="field.type"
                class="sw-workflow-start-settings__type"
                :options="types"
                :hide-clearable-button="true"
                :label="$t('sw-workflow.form.type')"
                :disabled="!allowEdit"
                @update:model-value="selectType(field, $event)"
            />
            <mt-select
                v-if="field.type === 'text'"
                class="sw-workflow-start-settings__data-source"
                :model-value="field.dataSource || ''"
                :options="dataSources"
                :label="$t('sw-workflow.form.dataSource')"
                :hide-clearable-button="true"
                :disabled="!allowEdit"
                @update:model-value="selectDataSource(field, $event)"
            />
            <mt-switch
                v-model="field.required"
                :label="$t('sw-workflow.form.required')"
                :disabled="!allowEdit"
                @update:model-value="commit"
            />
            <template v-if="field.type === 'select'">
                <div
                    v-for="(option, optionIndex) in field.options"
                    :key="option.value"
                    class="sw-workflow-start-settings__option"
                >
                    <mt-text-field
                        v-model="option.label"
                        :label="$t('sw-workflow.form.option')"
                        :disabled="!allowEdit"
                        @update:model-value="commit"
                    />
                    <mt-button
                        variant="tertiary"
                        :disabled="!allowEdit"
                        @click="removeOption(field, optionIndex)"
                    >
                        {{ $t('sw-workflow.form.removeOption') }}
                    </mt-button>
                </div>
                <mt-button
                    class="sw-workflow-start-settings__add-option"
                    variant="secondary"
                    :disabled="!allowEdit || (field.options?.length ?? 0) >= 50"
                    @click="addOption(field)"
                >
                    {{ $t('sw-workflow.form.addOption') }}
                </mt-button>
            </template>
            <mt-button
                class="sw-workflow-start-settings__remove"
                variant="secondary"
                :disabled="!allowEdit"
                @click="remove(field.key)"
            >
                {{ $t('sw-workflow.form.remove') }}
            </mt-button>
        </div>
    </div>
    <mt-button
        class="sw-workflow-start-settings__add"
        variant="secondary"
        :disabled="!allowEdit || fields.length >= 50"
        @click="add"
    >
        {{ $t('sw-workflow.form.add') }}
    </mt-button>
</section>
{% endblock %}
