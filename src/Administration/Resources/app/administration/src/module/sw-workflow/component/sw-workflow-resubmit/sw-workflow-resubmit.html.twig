{% block sw_workflow_resubmit %}
<div class="sw-workflow-resubmit">
    <mt-button
        data-resubmit-open
        variant="primary"
        :disabled="disabled || !instance.canResubmit"
        @click="open"
    >
        {{ $t('sw-workflow.runtime.instance.resubmit') }}
    </mt-button>
    <sw-modal
        v-if="showModal"
        :title="$t('sw-workflow.runtime.instance.resubmit')"
        @modal-close="close"
    >
        {% block sw_workflow_resubmit_fields %}
        <p>{{ $t('sw-workflow.runtime.instance.resubmitHint') }}</p>
        <mt-banner v-if="instance.readOnlyInputKeys?.length" variant="info">
            {{ $t('sw-workflow.runtime.instance.lockedHint') }}
        </mt-banner>
        <mt-banner v-if="error" variant="critical" role="alert">{{ error }}</mt-banner>
        <mt-loader v-if="isLoading" />
        <template v-for="field in fields" :key="field.key">
            <mt-select
                v-if="field.type === 'select' || field.dataSource"
                v-model="values[field.key]"
                :label="field.label"
                :options="field.options"
                :required="field.required"
                :disabled="isSubmitting || isReadOnly(field.key)"
            />
            <mt-textarea
                v-else-if="field.type === 'text'"
                v-model="values[field.key]"
                :label="field.label"
                :required="field.required"
                :disabled="isSubmitting || isReadOnly(field.key)"
            />
            <mt-text-field
                v-else
                v-model="values[field.key]"
                :label="field.label"
                :type="field.type === 'date' ? 'date' : 'text'"
                :inputmode="field.type === 'date' ? undefined : 'decimal'"
                :required="field.required"
                :disabled="isSubmitting || isReadOnly(field.key)"
            />
            <mt-banner v-if="showValidation && fieldErrors[field.key]" variant="critical">
                {{ fieldErrors[field.key] }}
            </mt-banner>
        </template>
        <mt-textarea
            v-model="comment"
            :label="$t('sw-workflow.runtime.instance.explanation')"
            :disabled="isSubmitting"
            :max-length="4000"
        />
        {% endblock %}
        <template #modal-footer>
            <mt-button variant="secondary" :disabled="isSubmitting" @click="close">
                {{ $t('global.default.cancel') }}
            </mt-button>
            <mt-button
                data-resubmit-confirm
                variant="primary"
                :disabled="!isReady || isSubmitting || disabled"
                :is-loading="isSubmitting"
                @click="submit"
            >
                {{ $t('sw-workflow.runtime.instance.resubmit') }}
            </mt-button>
        </template>
    </sw-modal>
</div>
{% endblock %}
