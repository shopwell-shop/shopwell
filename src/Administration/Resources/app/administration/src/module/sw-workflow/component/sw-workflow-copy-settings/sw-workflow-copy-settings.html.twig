{% block sw_workflow_copy_settings %}
<section class="sw-workflow-copy-settings">
    <mt-tabs
        default-item="settings"
        position-identifier="sw-workflow-copy-settings-tabs"
        :items="tabs"
        @new-item-active="activeTab = $event"
    />
    <div
        v-if="activeTab === 'settings'"
        class="sw-workflow-copy-settings__configuration"
    >
        <sw-workflow-users-assignee-select
            :config="configuration"
            :allow-edit="allowEdit"
            label-key="sw-workflow.copy.recipients"
            placeholder-key="sw-workflow.copy.empty"
            @update-config="updateRecipients"
        />
        <p>{{ $t('sw-workflow.copy.hint') }}</p>
    </div>
    <sw-workflow-form-permissions
        v-else-if="activeTab === 'form'"
        :fields="formFields"
        :permissions="formPermissions"
        :allow-edit="allowEdit"
        :copy="true"
        @update-permissions="updateFormPermissions"
    />
</section>
{% endblock %}
