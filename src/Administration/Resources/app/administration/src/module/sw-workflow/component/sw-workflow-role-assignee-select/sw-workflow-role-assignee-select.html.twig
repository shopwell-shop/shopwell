{% block sw_workflow_role_assignee_select %}
<div class="sw-workflow-role-assignee-select">
    <sw-entity-multi-select
        v-if="canRead"
        entity-name="acl_role"
        :entity-collection="collection"
        :criteria="criteria"
        label-property="name"
        :label="$t('sw-workflow.approval.roles.label')"
        :disabled="!allowEdit"
        :show-clearable-button="false"
        @update:entity-collection="change"
    >
        <template #selection-label-property="{ item }">
            {{ item.name }}
        </template>
        <template #result-label-property="{ item }">
            {{ item.name }}
        </template>
    </sw-entity-multi-select>
    <p>{{ $t('sw-workflow.approval.roles.hint') }}</p>
    <p
        v-if="status !== 'ready' && status !== 'empty'"
        role="status"
    >
        {{ $t('sw-workflow.approval.roles.status.' + status) }}
    </p>
    <p
        v-if="unavailableCount"
        role="status"
    >
        {{ $t('sw-workflow.approval.roles.unavailableCount', { count: unavailableCount }) }}
    </p>
    <mt-button
        v-if="status === 'error'"
        variant="secondary"
        size="small"
        @click="retry"
    >
        {{ $t('sw-workflow.actions.retry') }}
    </mt-button>
</div>
{% endblock %}
