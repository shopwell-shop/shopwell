{% block sw_workflow_approval_settings %}
<section class="sw-workflow-approval-settings">
    <mt-select
        v-if="sourceOptions.length > 1 || !source"
        class="sw-workflow-approval-settings__source"
        :hint="$t('sw-workflow.approval.sourceHint')"
        :model-value="source ? settings.assignee.source : null"
        :options="sourceOptions"
        :label="$t('sw-workflow.approval.source')"
        :placeholder="$t('sw-workflow.approval.selectSource')"
        :hide-clearable-button="true"
        :disabled="!allowEdit"
        @update:model-value="changeSource"
    />
    <component
        :is="source.settingsComponent"
        v-if="source"
        :config="settings.assignee.config"
        :node="node"
        :allow-edit="allowEdit"
        @update-config="updateAssignee"
    />
    <p
        v-else
        class="sw-workflow-approval-settings__unavailable"
        role="status"
    >
        {{ $t('sw-workflow.approval.sourceUnavailable') }}
    </p>
    <mt-select
        v-if="modeOptions.length > 1 || !mode"
        class="sw-workflow-approval-settings__mode-select"
        :model-value="mode ? settings.approval.mode : null"
        :options="modeOptions"
        :label="$t('sw-workflow.approval.mode')"
        :placeholder="$t('sw-workflow.approval.selectMode')"
        :hide-clearable-button="true"
        :disabled="!allowEdit"
        @update:model-value="changeMode"
    />
    <p
        v-if="mode && !modeCompatible"
        class="sw-workflow-approval-settings__unavailable"
        role="status"
    >
        {{ $t('sw-workflow.approval.incompatibleMode') }}
    </p>
    <div
        v-if="mode"
        class="sw-workflow-approval-settings__mode"
    >
        <h4>{{ $t(mode.labelKey) }}</h4>
        <p>{{ $t(mode.descriptionKey) }}</p>
        <component
            :is="mode.settingsComponent"
            v-if="mode.settingsComponent"
            :config="settings.approval.config"
            :node="node"
            :allow-edit="allowEdit"
            @update-config="updateApproval"
        />
    </div>
    <p
        v-else
        class="sw-workflow-approval-settings__unavailable"
        role="status"
    >
        {{ $t('sw-workflow.approval.modeUnavailable') }}
    </p>
</section>
{% endblock %}
