{% block sw_workflow_releases %}
<div class="sw-workflow-release-list">
    <mt-banner variant="info">
        {{ $t('sw-workflow.publication.immutable') }}
        <mt-button
            v-if="typeof $route.query.draftId === 'string'"
            variant="secondary"
            size="small"
            @click="$router.push({ name: 'sw.workflow.releases' })"
        >
            {{ $t('sw-workflow.publication.allRecords') }}
        </mt-button>
    </mt-banner>
    <mt-banner
        v-if="hasError"
        variant="critical"
        role="alert"
    >
        {{ $t('sw-workflow.publication.loadFailed') }}
        <mt-button
            variant="secondary"
            @click="load"
        >
            {{ $t('sw-workflow.actions.retry') }}
        </mt-button>
    </mt-banner>
    <div class="sw-workflow-release-list__listing">
        <sw-data-grid
            v-if="!hasError && (isLoading || releases.length)"
            :full-page="true"
            :data-source="releases"
            :columns="columns"
            :is-loading="isLoading"
            :show-selection="false"
            :show-actions="false"
            :allow-inline-edit="false"
        >
            <template #column-createdAt="{ item }">
                {{ formatDate(item.createdAt) }}
            </template>
            <template #pagination>
                <sw-pagination
                    :page="page"
                    :limit="limit"
                    :total="total"
                    @page-change="changePage"
                />
            </template>
        </sw-data-grid>
        <sw-loader v-else-if="isLoading" />
        <mt-empty-state
            v-else-if="!hasError"
            icon="regular-flow"
            :headline="$t('sw-workflow.publication.emptyTitle')"
            :description="$t('sw-workflow.publication.emptyHint')"
        />
    </div>
</div>
{% endblock %}
