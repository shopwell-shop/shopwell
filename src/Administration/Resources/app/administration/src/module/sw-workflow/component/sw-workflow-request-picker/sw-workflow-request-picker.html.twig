{% block sw_workflow_request_picker %}
<sw-modal
    :title="$t('sw-workflow.request.start')"
    variant="large"
    @modal-close="$emit('modal-close')"
>
    <mt-banner
        v-if="hasError"
        variant="critical"
        role="alert"
    >
        {{ $t('sw-workflow.publication.loadFailed') }}
        <mt-button
            variant="secondary"
            size="small"
            @click="load"
        >
            {{ $t('sw-workflow.actions.retry') }}
        </mt-button>
    </mt-banner>
    <sw-data-grid
        v-if="!hasError && (isLoading || releases.length)"
        :data-source="releases"
        :columns="columns"
        :is-loading="isLoading"
        :show-selection="false"
        :show-actions="false"
        :allow-inline-edit="false"
    >
        <template #column-action="{ item }">
            <component
                :is="actionComponent(item)"
                v-if="actionComponent(item)"
                :release="item"
            />
            <span v-else>{{ $t('sw-workflow.publication.unavailable') }}</span>
        </template>
        <template #pagination>
            <sw-pagination
                :page="page"
                :limit="limit"
                :total="total"
                @page-change="changePage"
            />
        </template>
    </sw-data-grid>
    <mt-empty-state
        v-else-if="!hasError && !isLoading"
        icon="regular-flow"
        :headline="$t('sw-workflow.request.emptyTitle')"
        :description="$t('sw-workflow.request.emptyHint')"
    />
    <template #modal-footer>
        <mt-button
            variant="secondary"
            @click="$emit('modal-close')"
        >
            {{ $t('global.default.cancel') }}
        </mt-button>
    </template>
</sw-modal>
{% endblock %}
