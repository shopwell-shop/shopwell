{% block sw_workflow_form_permissions %}
<div class="sw-workflow-form-permissions">
    <p>{{ $t('sw-workflow.formPermissions.hint') }}</p>
    <mt-banner
        v-if="fields.length === 0"
        variant="info"
    >
        {{ $t('sw-workflow.formPermissions.empty') }}
    </mt-banner>
    {% block sw_workflow_form_permissions_fields %}
    <sw-container
        v-for="field in fields"
        :key="field.key"
        columns="1fr 100px"
        gap="0 24px"
    >
        <mt-select
            :label="field.label"
            :model-value="permission(field.key).access"
            :options="options"
            :hide-clearable-button="true"
            :disabled="!allowEdit"
            @update:model-value="changeAccess(field.key, $event)"
        />
        <mt-switch
            v-if="!copy"
            :label="$t('sw-workflow.formPermissions.required')"
            :model-value="permission(field.key).required"
            :disabled="!allowEdit || permission(field.key).access !== 'editable'"
            @update:model-value="changeRequired(field.key, $event)"
        />
    </sw-container>
    {% endblock %}
</div>
{% endblock %}
