{% block sw_workflow_user_assignee_select %}
<div class="sw-workflow-user-assignee-select">
    <sw-entity-single-select
        v-if="canRead"
        :key="userId"
        entity="user"
        :value="status === 'ready' ? userId : null"
        :criteria="criteria"
        :label-callback="displayUser"
        label-property="username"
        :label="$t('sw-workflow.approval.assignee')"
        :placeholder="$t('sw-workflow.approval.status.empty')"
        :show-clearable-button="false"
        :disabled="!allowEdit || status === 'loading'"
        @update:value="select"
    />
    <p
        v-if="status !== 'ready' && status !== 'empty'"
        class="sw-workflow-user-assignee-select__status"
        role="status"
    >
        {{ $t('sw-workflow.approval.status.' + status) }}
    </p>
    <div
        v-if="status === 'error' || (userId && allowEdit && canRead)"
        class="sw-workflow-user-assignee-select__actions"
    >
        <mt-button
            v-if="status === 'error'"
            variant="secondary"
            @click="retry"
        >
            {{ $t('sw-workflow.actions.retry') }}
        </mt-button>
        <mt-button
            v-if="userId && allowEdit && canRead"
            variant="secondary"
            @click="clear"
        >
            {{ $t('sw-workflow.approval.clear') }}
        </mt-button>
    </div>
</div>
{% endblock %}
