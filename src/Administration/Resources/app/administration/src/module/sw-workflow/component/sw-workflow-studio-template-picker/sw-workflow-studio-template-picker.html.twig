{% block sw_workflow_studio_template_picker %}
<sw-modal
    class="sw-workflow-studio-template-picker"
    variant="large"
    :title="$t('sw-workflow.panels.templates')"
    @modal-close="$emit('close')"
>
    <div class="sw-workflow-studio-template-picker__workspace">
        <div class="sw-workflow-studio-template-picker__catalogue">
            <button
                v-for="preset in templates"
                :key="preset.name"
                :data-workflow-template="preset.name"
                type="button"
                class="sw-workflow-studio-template-picker__item"
                :class="{ 'is-selected': selectedName === preset.name }"
                :aria-pressed="selectedName === preset.name"
                @click="selectedName = preset.name"
            >
                <mt-icon
                    :name="preset.icon"
                    size="24px"
                />
                <span><strong>{{ $t(preset.titleKey) }}</strong><small>{{ $t(preset.descriptionKey) }}</small></span>
            </button>
        </div>
        <div class="sw-workflow-studio-template-picker__preview">
            <sw-workflow-studio-canvas
                v-if="preview"
                :key="selectedName"
                :document="preview"
                :node-types="nodeTypes"
                :labels="labels"
                :allow-edit="false"
            />
            <mt-empty-state
                v-else
                icon="regular-flow"
                :headline="$t('sw-workflow.templates.selectTitle')"
                :description="$t('sw-workflow.templates.selectHint')"
            />
        </div>
    </div>
    <mt-banner
        v-if="selected"
        variant="info"
    >
        {{ $t('sw-workflow.templates.replaceHint') }}
    </mt-banner>
    <template #modal-footer>
        <mt-button
            variant="secondary"
            @click="$emit('close')"
        >
            {{ $t('global.default.cancel') }}
        </mt-button>
        <mt-button
            class="sw-workflow-studio-template-picker__apply"
            variant="primary"
            :disabled="!allowEdit || !selected"
            @click="$emit('apply', selectedName)"
        >
            {{ $t('sw-workflow.templates.apply') }}
        </mt-button>
    </template>
</sw-modal>
{% endblock %}
