{% block sw_workflow_organization_assignee_settings %}
<div>
    <mt-banner variant="info">
        {{ $t(isInitiator ? 'sw-workflow.approval.initiatorHint' : 'sw-workflow.approval.hierarchy.hint') }}
    </mt-banner>
    <template v-if="!isInitiator">
        <mt-number-field
            data-testid="hierarchy-level"
            :label="$t('sw-workflow.approval.hierarchy.level')"
            :model-value="level"
            :min="1"
            :max="20"
            :digits="0"
            :disabled="!allowEdit"
            @update:model-value="changeLevel"
        />
        <mt-switch
            data-testid="hierarchy-continuous"
            :label="$t('sw-workflow.approval.hierarchy.continuous')"
            :model-value="config.continuous === true"
            :disabled="!allowEdit"
            @update:model-value="changeContinuous"
        />
    </template>
</div>
{% endblock %}
