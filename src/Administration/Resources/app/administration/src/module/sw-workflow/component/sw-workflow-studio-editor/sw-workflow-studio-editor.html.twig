{% block sw_workflow_studio_editor %}
<div class="sw-workflow-studio-editor">
    {% block sw_workflow_studio_editor_toolbar %}
    <sw-workflow-studio-toolbar
        :can-undo="state.canUndo"
        :can-redo="state.canRedo"
        :allow-edit="allowEdit"
        :download-url="downloadUrl"
        @undo="undo"
        @redo="redo"
        @templates="openTemplates"
    >
        <template
            v-if="$slots['document-info']"
            #document-info
        >
            <slot name="document-info"></slot>
        </template>
        <template #extension-actions>
            <sw-canvas-contributions
                v-if="session"
                :session="session"
                action-position="toolbar"
            />
        </template>
        <template #document-actions>
            <slot
                name="document-actions"
                :has-pending-settings="hasPendingSettings"
            ></slot>
        </template>
    </sw-workflow-studio-toolbar>
    {% endblock %}
    <mt-banner
        v-if="extensionError"
        variant="critical"
    >
        {{ $t('sw-workflow.extensions.failed') }}
    </mt-banner>
    <div class="sw-workflow-studio-editor__workspace">
        {% block sw_workflow_studio_editor_canvas %}
        <main class="sw-workflow-studio-editor__canvas">
            <sw-workflow-studio-canvas
                :layout="layout"
                :document="state.document"
                :node-types="nodeTypes"
                :labels="typeLabels"
                :invalid-ids="invalidIds"
                :selected-node-id="state.selection.nodeId"
                :selected-connection-id="state.selection.connectionId"
                :allow-edit="allowEdit"
                @select-node="selectNode"
                @select-connection="selectConnection"
                @insert-node="openPicker"
                @node-contextmenu="openNodeMenu"
                @connection-contextmenu="openConnectionMenu"
                @canvas-click="canvasClick"
            >
                <template
                    v-if="allowEdit"
                    #node-tools="{ nodeId }"
                >
                    <mt-button
                        size="small"
                        variant="tertiary"
                        square
                        :data-edit-node="nodeId"
                        :title="$t('global.default.edit')"
                        :aria-label="$t('global.default.edit')"
                        @click.stop="selectNode(nodeId)"
                    >
                        <mt-icon
                            name="regular-pencil-s"
                            size="16px"
                        />
                    </mt-button>
                    <sw-canvas-contributions
                        v-if="session"
                        :session="session"
                        action-position="node-menu"
                        icon-only
                        :target="{ nodeId }"
                    />
                </template>
                <template #canvas>
                    <slot name="canvas"></slot>
                </template>
                <template #node-decoration="{ nodeId }">
                    <sw-canvas-contributions
                        v-if="session"
                        :session="session"
                        component-position="node-decoration"
                        :target="{ nodeId }"
                    />
                </template>
            </sw-workflow-studio-canvas>
            <sw-canvas-contributions
                v-if="session"
                class="sw-workflow-studio-editor__overlay"
                :session="session"
                component-position="canvas-overlay"
            />
            <mt-floating-ui
                v-if="menu && session"
                class="sw-workflow-studio-editor__context-menu"
                :is-opened="true"
                :anchor-element="menuAnchor"
                :floating-ui-options="floatingUiOptions"
                :offset="8"
                detached
                @close="menu = null"
            >
                <div
                    role="menu"
                    :aria-label="$t('sw-workflow.panels.settings')"
                >
                    <sw-canvas-contributions
                        :session="session"
                        :action-position="menu.position"
                        :target="menu.target"
                    />
                </div>
            </mt-floating-ui>
        </main>
        {% endblock %}
        {% block sw_workflow_studio_editor_settings %}
        <aside
            v-if="nodeDraft && draftNode"
            class="sw-workflow-studio-editor__settings"
            :aria-label="$t('sw-workflow.panels.settings')"
            role="region"
            tabindex="-1"
        >
            <header class="sw-workflow-studio-editor__settings-header">
                <h3>{{ typeLabel(draftNode.type, draftNode.typeVersion) }}</h3>
                <mt-button
                    size="small"
                    variant="tertiary"
                    square
                    :title="$t('global.default.close')"
                    :aria-label="$t('global.default.close')"
                    @click="requestInteraction(closeEditor)"
                >
                    <mt-icon
                        name="regular-times-s"
                        size="16px"
                    />
                </mt-button>
            </header>
            <div class="sw-workflow-studio-editor__settings-body">
                <sw-workflow-studio-node-settings
                    :key="draftNode.id"
                    :node="draftNode"
                    :document="nodeDraft"
                    :type-label="typeLabel(draftNode.type, draftNode.typeVersion)"
                    :allow-edit="allowEdit"
                    :can-remove="canRemove"
                    @keydown.esc.stop="requestInteraction(closeEditor)"
                    @update-config="stageSettings"
                    @remove="remove"
                />
            </div>
            <footer class="sw-workflow-studio-editor__settings-footer">
                <mt-button
                    class="sw-workflow-studio-editor__cancel"
                    size="small"
                    variant="secondary"
                    @click="closeEditor"
                >{{ $t('global.default.cancel') }}</mt-button>
                <mt-button
                    v-if="allowEdit"
                    class="sw-workflow-studio-editor__save"
                    size="small"
                    variant="primary"
                    @click="saveSettings"
                >{{ $t('global.default.apply') }}</mt-button>
            </footer>
        </aside>
        {% endblock %}
        <aside
            v-if="session && hasExtensionPanel"
            class="sw-workflow-studio-editor__extension-panel"
        >
            <sw-canvas-contributions
                :session="session"
                component-position="panel"
                :target="panelTarget"
            />
        </aside>
    </div>
    {% block sw_workflow_studio_editor_node_picker %}
    <mt-floating-ui
        v-if="pickerOpen"
        class="sw-workflow-studio-editor__node-picker"
        :is-opened="pickerOpen"
        :anchor-element="pickerAnchor"
        :floating-ui-options="floatingUiOptions"
        :offset="8"
        detached
        @close="closePicker"
    >
        <section
            :ref="focusPicker"
            role="dialog"
            tabindex="-1"
            :aria-label="$t('sw-workflow.panels.nodes')"
        >
            <header class="sw-workflow-studio-editor__picker-header">
                <h3>{{ $t('sw-workflow.panels.nodes') }}</h3>
                <mt-button
                    size="small"
                    variant="tertiary"
                    square
                    :title="$t('global.default.close')"
                    :aria-label="$t('global.default.close')"
                    @click="dismissPicker"
                ><mt-icon
                    name="regular-times-s"
                    size="16px"
                /></mt-button>
            </header>
            <sw-workflow-studio-node-picker
                :document="state.document"
                :node-types="nodeTypes"
                :labels="typeLabels"
                :selected-connection-id="state.selection.connectionId"
                :allow-edit="allowEdit"
                @keydown.esc.stop.prevent="dismissPicker"
                @insert="insert"
            />
            <sw-canvas-contributions
                v-if="session"
                :session="session"
                action-position="node-picker"
                :target="{ connectionId: state.selection.connectionId }"
            />
        </section>
    </mt-floating-ui>
    {% endblock %}
    <sw-modal
        v-if="pendingInteraction"
        class="sw-workflow-studio-editor__unsaved-dialog"
        :title="$t('sw-workflow.panels.unsavedTitle')"
        @modal-close="pendingInteraction = null"
    >
        <p>{{ $t('sw-workflow.panels.unsavedHint') }}</p>
        <template #modal-footer>
            <mt-button
                class="sw-workflow-studio-editor__keep-editing"
                variant="secondary"
                @click="pendingInteraction = null"
            >{{ $t('sw-workflow.panels.keepEditing') }}</mt-button>
            <mt-button
                class="sw-workflow-studio-editor__discard-pending"
                variant="secondary"
                @click="continueInteraction(false)"
            >{{ $t('sw-workflow.panels.discardSettings') }}</mt-button>
            <mt-button
                class="sw-workflow-studio-editor__apply-pending"
                variant="primary"
                :disabled="!allowEdit"
                @click="continueInteraction(true)"
            >{{ $t('sw-workflow.panels.applySettings') }}</mt-button>
        </template>
    </sw-modal>
    {% block sw_workflow_studio_editor_templates %}
    <sw-workflow-studio-template-picker
        v-if="templatesOpen"
        :node-types="nodeTypes"
        :labels="typeLabels"
        :allow-edit="allowEdit"
        @close="templatesOpen = false"
        @apply="loadTemplate"
    />
    {% endblock %}
    <sw-canvas-contributions
        v-if="session"
        :session="session"
        component-position="dialog"
    />
    {% block sw_workflow_studio_editor_diagnostics %}
    <footer
        class="sw-workflow-studio-editor__diagnostics"
        aria-live="polite"
    >
        <mt-icon
            :name="hasDiagnosed && allViolations.length === 0 ? 'regular-checkmark' : 'regular-info-circle'"
            size="14px"
        />
        <span v-if="isDiagnosing">{{ $t('sw-workflow.diagnostics.checking') }}</span>
        <template v-else-if="diagnosticError">
            <span>{{ $t('sw-workflow.diagnostics.failed') }}</span>
            <button
                type="button"
                @click="$emit('diagnose', state.document)"
            >
                {{ $t('sw-workflow.actions.retry') }}
            </button>
        </template>
        <span v-else-if="!hasDiagnosed">{{ $t('sw-workflow.diagnostics.hint') }}</span>
        <span v-else-if="allViolations.length === 0">{{ $t('sw-workflow.diagnostics.success') }}</span>
        <button
            v-if="allViolations.length"
            type="button"
            class="sw-workflow-studio-editor__issues-toggle"
            :aria-expanded="issuesOpen"
            @click="issuesOpen = !issuesOpen"
        >
            {{ $t('sw-workflow.diagnostics.issueCount', { count: allViolations.length }, allViolations.length) }}
            <mt-icon
                :name="issuesOpen ? 'regular-chevron-down-xs' : 'regular-chevron-up-xs'"
                size="12px"
            />
        </button>
        <ol
            v-if="issuesOpen && allViolations.length"
            class="sw-workflow-studio-editor__issue-list"
        >
            <li
                v-for="(violation, index) in allViolations"
                :key="index"
            >
                <button
                    type="button"
                    @click="selectNode(violation.nodeId ?? null)"
                >
                    {{ violationMessage(violation) }}
                </button>
            </li>
        </ol>
    </footer>
    {% endblock %}
</div>
{% endblock %}
