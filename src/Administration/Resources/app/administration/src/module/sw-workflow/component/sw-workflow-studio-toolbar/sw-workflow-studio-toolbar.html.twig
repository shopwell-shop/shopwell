{% block sw_workflow_studio_toolbar %}
<header class="sw-workflow-studio-toolbar">
    {% block sw_workflow_studio_toolbar_left %}
    <div class="sw-workflow-studio-toolbar__left">
        <div class="sw-workflow-studio-toolbar__document-info">
            <slot name="document-info">
                <mt-icon
                    name="regular-flow"
                    size="20px"
                />
                <h2>{{ $t('sw-workflow.general.title') }}</h2>
                <span class="sw-workflow-studio-toolbar__status">{{ $t('sw-workflow.general.draft') }}</span>
            </slot>
        </div>
        <div class="sw-workflow-studio-toolbar__history">
            <button
                type="button"
                :aria-label="$t('sw-workflow.actions.undo')"
                :title="$t('sw-workflow.actions.undo')"
                :disabled="!allowEdit || !canUndo"
                @click="$emit('undo')"
            >
                <mt-icon
                    name="regular-undo"
                    size="18px"
                />
            </button>
            <button
                type="button"
                :aria-label="$t('sw-workflow.actions.redo')"
                :title="$t('sw-workflow.actions.redo')"
                :disabled="!allowEdit || !canRedo"
                @click="$emit('redo')"
            >
                <mt-icon
                    name="regular-redo"
                    size="18px"
                />
            </button>
        </div>
    </div>
    {% endblock %}
    {% block sw_workflow_studio_toolbar_right %}
    <div class="sw-workflow-studio-toolbar__right">
        <slot name="extension-actions"></slot>
        <mt-button
            class="sw-workflow-studio-toolbar__templates"
            variant="tertiary"
            size="small"
            square
            :aria-label="$t('sw-workflow.panels.templates')"
            :title="$t('sw-workflow.panels.templates')"
            :disabled="!allowEdit"
            @click="$emit('templates')"
        ><mt-icon
            name="regular-layer-group"
            size="16px"
        /></mt-button>
        <mt-button
            class="sw-workflow-studio-toolbar__export"
            variant="tertiary"
            size="small"
            square
            :aria-label="$t('sw-workflow.actions.export')"
            :title="$t('sw-workflow.actions.export')"
            :link="downloadUrl"
            download="workflow.json"
        ><mt-icon
            name="regular-download"
            size="16px"
        /></mt-button>
        <slot name="document-actions"></slot>
    </div>
    {% endblock %}
</header>
{% endblock %}
