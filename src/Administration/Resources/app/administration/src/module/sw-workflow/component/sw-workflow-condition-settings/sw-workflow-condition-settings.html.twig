{% block sw_workflow_condition_settings %}
<section class="sw-workflow-condition-settings">
    <h4>{{ $t('sw-workflow.condition.title') }}</h4>
    <p class="sw-workflow-condition-settings__hint">
        {{ $t('sw-workflow.condition.hint') }}
    </p>
    <div
        v-for="(branch, index) in branches"
        :key="branch.id"
        class="sw-workflow-condition-settings__branch"
    >
        <div class="sw-workflow-condition-settings__heading">
            <button
                type="button"
                class="sw-workflow-condition-settings__expand"
                :aria-expanded="activeId === branch.id"
                @click="activeId = activeId === branch.id ? '' : branch.id"
            >
                <span>{{ index + 1 }}</span><strong>{{ branch.label || $t('sw-workflow.condition.newBranch') }}</strong>
            </button>
            <button
                type="button"
                :aria-label="$t('sw-workflow.condition.moveUp')"
                :disabled="!allowEdit || index === 0"
                @click="move(index, -1)"
            >
                <mt-icon
                    name="regular-chevron-up-xs"
                    size="12px"
                />
            </button>
            <button
                type="button"
                :aria-label="$t('sw-workflow.condition.moveDown')"
                :disabled="!allowEdit || index === branches.length - 1"
                @click="move(index, 1)"
            >
                <mt-icon
                    name="regular-chevron-down-xs"
                    size="12px"
                />
            </button>
        </div>
        <div
            v-if="activeId === branch.id"
            class="sw-workflow-condition-settings__fields"
        >
            <mt-text-field
                v-model="branch.label"
                class="sw-workflow-condition-settings__branch-name"
                :label="$t('sw-workflow.condition.name')"
                :disabled="!allowEdit"
                @update:model-value="commit"
            />
            <sw-workflow-condition-rule
                :model-value="branchRule(branch)"
                :fields="fields"
                :allow-edit="allowEdit"
                @update:model-value="updateRule(index, $event)"
            />
            <mt-button
                variant="secondary"
                :disabled="!canRemove(branch.id)"
                @click="remove(branch.id)"
            >
                {{ $t('sw-workflow.condition.remove') }}
            </mt-button>
            <p
                v-if="!canRemove(branch.id)"
                class="sw-workflow-condition-settings__hint"
            >
                {{ $t('sw-workflow.condition.removeHint') }}
            </p>
        </div>
    </div>
    <mt-button
        class="sw-workflow-condition-settings__add"
        variant="secondary"
        :disabled="!allowEdit"
        @click="add"
    >
        {{ $t('sw-workflow.condition.add') }}
    </mt-button>
    <div class="sw-workflow-condition-settings__fallback">
        <mt-icon
            name="regular-flow"
            size="16px"
        /><div><h4>{{ $t('sw-workflow.outcomes.fallback') }}</h4><p>{{ $t('sw-workflow.condition.fallbackHint') }}</p></div>
    </div>
</section>
{% endblock %}
