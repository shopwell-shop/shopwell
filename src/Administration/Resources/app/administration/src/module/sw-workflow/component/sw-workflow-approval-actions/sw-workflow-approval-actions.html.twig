{% block sw_workflow_approval_actions %}
<div class="sw-workflow-approval-actions">
    {% block sw_workflow_approval_actions_progress %}
    <p
        v-if="progress"
        class="sw-workflow-approval-actions__progress"
    >
        {{ progress }}
    </p>
    {% endblock %}

    {% block sw_workflow_approval_actions_comment %}
    <mt-textarea
        v-model="comment"
        class="sw-workflow-approval-actions__comment"
        :label="$t('sw-workflow.runtime.actions.commentLabel')"
        :placeholder="$t('sw-workflow.runtime.actions.commentPlaceholder')"
        :max-length="500"
        :disabled="isLoading"
    />
    {% endblock %}

    {% block sw_workflow_approval_actions_buttons %}
    <div class="sw-workflow-approval-actions__buttons">
        <mt-button
            variant="critical"
            :disabled="!canReject"
            :is-loading="isLoading"
            @click="onReject"
        >
            {{ $t('sw-workflow.runtime.actions.reject') }}
        </mt-button>

        <mt-button
            variant="primary"
            :disabled="!canApprove"
            :is-loading="isLoading"
            @click="onApprove"
        >
            {{ $t('sw-workflow.runtime.actions.approve') }}
        </mt-button>
    </div>
    {% endblock %}

    {% block sw_workflow_approval_actions_return %}
    <div
        v-if="availableActions.includes('return')"
        class="sw-workflow-approval-actions__buttons"
    >
        <mt-button
            data-return
            variant="secondary"
            :disabled="!canReject"
            :is-loading="isLoading"
            @click="onReturn"
        >
            {{ $t('sw-workflow.runtime.actions.return') }}
        </mt-button>
    </div>
    {% endblock %}

    {% block sw_workflow_approval_actions_participation %}
    <div
        v-if="participationActions.length"
        class="sw-workflow-approval-actions__buttons"
    >
        <mt-button
            v-for="action in participationActions"
            :key="action"
            :data-participation="action"
            variant="secondary"
            :disabled="isLoading"
            @click="openParticipation(action)"
        >
            {{ $t('sw-workflow.runtime.actions.' + action) }}
        </mt-button>
    </div>

    <sw-modal
        v-if="participationAction"
        :title="$t('sw-workflow.runtime.actions.' + participationAction)"
        @modal-close="participationAction = ''"
    >
        <p>{{ $t('sw-workflow.runtime.actions.' + participationAction + 'Hint') }}</p>
        <sw-entity-single-select
            v-model:value="targetUserId"
            entity="user"
            label-property="name"
            :criteria="participantCriteria"
            :label="$t('sw-workflow.runtime.actions.targetUser')"
            :disabled="isLoading"
        />
        <mt-textarea
            v-model="comment"
            :label="$t('sw-workflow.runtime.actions.reason')"
            :max-length="500"
            :disabled="isLoading"
        />
        <template #modal-footer>
            <mt-button
                variant="secondary"
                @click="participationAction = ''"
            >
                {{ $t('global.default.cancel') }}
            </mt-button>
            <mt-button
                data-participation-confirm
                variant="primary"
                :disabled="!canParticipate"
                :is-loading="isLoading"
                @click="confirmParticipation"
            >
                {{ $t('global.default.confirm') }}
            </mt-button>
        </template>
    </sw-modal>
    {% endblock %}

    {% block sw_workflow_approval_actions_extensions %}
    <component
        :is="operation.actionComponent"
        v-for="operation in extensionOperations"
        :key="operation.name"
        :task-id="taskId"
        :is-loading="isLoading"
        @completed="$emit('completed')"
    />
    {% endblock %}

    {% block sw_workflow_approval_actions_hint %}
    <p class="sw-workflow-approval-actions__hint">
        {{ $t('sw-workflow.runtime.actions.rejectHint') }}
    </p>
    {% endblock %}
</div>
{% endblock %}
