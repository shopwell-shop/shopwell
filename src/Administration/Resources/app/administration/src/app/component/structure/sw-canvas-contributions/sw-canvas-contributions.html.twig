{% block sw_canvas_contributions %}
<div
    v-if="actions.length || components.length || dialog"
    class="sw-canvas-contributions"
    :class="'is-' + (actionPosition || componentPosition)"
>
    <mt-button
        v-for="action in actions"
        :key="action.name"
        :data-canvas-action="action.name"
        :variant="iconOnly ? 'tertiary' : 'secondary'"
        :size="iconOnly ? 'small' : undefined"
        :square="iconOnly"
        :title="iconOnly ? $t(action.labelKey) : undefined"
        :aria-label="$t(action.labelKey)"
        :disabled="!session.canRunAction(action.name, target)"
        @click.stop="session.runAction(action.name, target)"
    >
        <mt-icon
            v-if="action.icon || iconOnly"
            :name="action.icon || 'regular-ellipsis-h'"
            size="16px"
        />
        <span v-if="!iconOnly">{{ $t(action.labelKey) }}</span>
    </mt-button>
    <component
        :is="item.component"
        v-for="item in components"
        :key="item.name"
        v-bind="contributionProps(item.name)"
    />
    <sw-modal
        v-if="dialog"
        :title="dialog.component.titleKey ? $t(dialog.component.titleKey) : ''"
        @modal-close="session.context.ui.closeDialog()"
    >
        <component
            :is="dialog.component.component"
            v-bind="{ ...dialog.props, ...contributionProps(dialog.component.name) }"
        />
    </sw-modal>
</div>
{% endblock %}
