{% block sw_verify_user_modal %}
<sw-modal
    :title="$t('sw-user.users.user-detail.passwordConfirmation.titleConfirmPasswordModal')"
    variant="small"
    @modal-close="onCloseConfirmPasswordModal"
>

    {% block sw_verify_user_modal_field_password %}
    <mt-password-field
        v-model="confirmPassword"
        class="sw-user-detail__confirm-password"
        name="sw-field--confirm-password"
        :password-toggle-able="true"
        autocomplete="current-password"
        :label="$t('sw-user.users.user-detail.passwordConfirmation.labelConfirmPassword')"
        :placeholder="$t('sw-user.users.user-detail.passwordConfirmation.placeholderConfirmPassword')"
        @keypress.enter="onSubmitConfirmPassword"
    />
    {% endblock %}

    {% block sw_verify_user_modal_footer %}
    <template #modal-footer>
        {% block sw_verify_user_modal_footer_cancel %}
        <mt-button
            size="small"
            variant="secondary"
            @click="onCloseConfirmPasswordModal"
        >
            {{ $t('global.default.cancel') }}
        </mt-button>
        {% endblock %}

        {% block sw_verify_user_modal_footer_confirm %}
        <mt-button
            variant="primary"
            :disabled="!confirmPassword"
            size="small"
            @click="onSubmitConfirmPassword"
        >
            {{ $t('global.default.confirm') }}
        </mt-button>
        {% endblock %}
    </template>
    {% endblock %}
</sw-modal>
{% endblock %}
