{% block sw_admin_menu_topbar %}
<template v-if="!enabled">
    <slot name="brand"></slot>
    <slot name="sidebar"></slot>
    <slot name="user"></slot>
</template>

<template v-else>
    <header class="sw-admin-menu-topbar">
        <slot name="brand"></slot>

        <nav
            ref="navigation"
            class="sw-admin-menu-topbar__navigation"
            :aria-label="$t('global.sw-admin-menu.navigation.label')"
            @keydown="onNavigationKeydown"
        >
            <ul class="sw-admin-menu-topbar__items">
                <sw-admin-menu-item
                    v-for="entry in visibleEntries"
                    :key="key(entry)"
                    :entry="entry"
                    presentation="topbar"
                    :data-navigation-key="key(entry)"
                    :collapsible-text="false"
                    :is-expanded="openKey === key(entry)"
                    :navigation-target="opensPanel(entry) || entry.link ? null : target(entry)"
                    @submenu-toggle="onSubmenuToggle"
                    @navigation-link-click="closePanel(false)"
                />
            </ul>

            <button
                ref="more"
                class="sw-admin-menu-topbar__entry sw-admin-menu-topbar__more"
                :class="{ 'is--active': hasActiveOverflow, 'is--empty': !overflowEntries.length }"
                :tabindex="overflowEntries.length ? 0 : -1"
                :aria-hidden="!overflowEntries.length"
                type="button"
                :aria-expanded="openKey === '__more'"
                @click="togglePanel('__more', $event.currentTarget)"
            >
                {{ $t('global.navigationLayout.more') }}
                <mt-icon
                    name="regular-chevron-down-xs"
                    size="8px"
                />
            </button>

            <ul
                ref="measurements"
                class="sw-admin-menu-topbar__measurements sw-admin-menu-topbar__items"
                aria-hidden="true"
                inert
            >
                <sw-admin-menu-item
                    v-for="entry in entries"
                    :key="key(entry)"
                    :entry="entry"
                    presentation="topbar"
                    :collapsible-text="false"
                    :navigation-target="opensPanel(entry) || entry.link ? null : target(entry)"
                />
            </ul>
        </nav>

        <div
            ref="toolbar"
            class="sw-admin-menu-topbar__toolbar"
        ></div>
        <slot name="user"></slot>
    </header>

    <div
        v-if="mode === 'mixed' && hasSidebar"
        class="sw-admin-menu-topbar__sidebar"
    >
        <slot name="sidebar"></slot>
    </div>

    <mt-floating-ui
        v-if="moreAnchor"
        class="sw-admin-menu-topbar__more-floating"
        :is-opened="true"
        :anchor-element="moreAnchor"
        :floating-ui-options="{ placement: 'bottom-start' }"
        :offset="8"
        detached
        @close="openKey === '__more' && onOutsideClose()"
    >
        <nav
            ref="morePanel"
            class="sw-admin-menu-topbar__more-panel"
            :hidden="openKey !== '__more'"
            :aria-label="$t('global.navigationLayout.more')"
            tabindex="-1"
            @keydown="onPanelKeydown"
        >
            <ul class="sw-admin-menu__navigation-list">
                <sw-admin-menu-item
                    v-for="entry in overflowEntries"
                    :key="key(entry)"
                    :entry="entry"
                    presentation="topbar"
                    :collapsible-text="false"
                    :is-expanded="openKey === key(entry)"
                    :navigation-target="opensPanel(entry) || entry.link ? null : target(entry)"
                    @submenu-toggle="onSubmenuToggle"
                    @navigation-link-click="closePanel(false)"
                />
            </ul>
        </nav>
    </mt-floating-ui>

    <mt-floating-ui
        class="sw-admin-menu-topbar__panel-floating"
        :is-opened="true"
        :anchor-element="anchor || moreAnchor"
        :floating-ui-options="{ placement: 'bottom-start' }"
        :offset="8"
        detached
        @close="openKey && openKey !== '__more' && onOutsideClose()"
    >
        <nav
            ref="panel"
            :hidden="!openKey || openKey === '__more'"
            class="sw-admin-menu-topbar__panel sw-admin-menu__floating-navigation"
            :class="{ 'is--module-colored': !!panelModuleColor }"
            :style="panelModuleColorStyle"
            :aria-label="$t('global.sw-admin-menu.navigation.label')"
            tabindex="-1"
            @keydown="onPanelKeydown"
        >
            <div
                v-for="entry in customPanelEntries"
                :key="key(entry)"
                :hidden="activePanelEntry !== entry"
            >
                <slot name="entry-panel" :entry="entry" :close="closePanel"></slot>
            </div>
            <ul
                v-if="activePanelEntry?.children.length"
                class="sw-admin-menu__navigation-list"
            >
                <template
                    v-for="entry in activePanelEntry.children"
                    :key="key(entry)"
                >
                    <li
                        v-if="entry.groupStart"
                        class="sw-admin-menu-item__group-heading"
                        role="presentation"
                    >
                        {{ entry.groupTitle }}
                    </li>
                    <sw-admin-menu-item
                        :entry="entry"
                        :menu-depth="2"
                        :display-icon="false"
                        :sidebar-expanded="true"
                        :collapsible-text="false"
                        @navigation-link-click="closePanel(false)"
                    />
                </template>
            </ul>
        </nav>
    </mt-floating-ui>
</template>
{% endblock %}
