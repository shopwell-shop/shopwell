{% block sw_canvas_editor %}
<div
    class="sw-canvas-editor"
    :class="$attrs.class"
    :style="$attrs.style"
>
    <header
        v-if="$slots.toolbar"
        class="sw-canvas-editor__toolbar"
    >
        <slot name="toolbar"></slot>
    </header>
    <div class="sw-canvas-editor__workspace">
        <aside
            v-if="$slots['sidebar-start']"
            class="sw-canvas-editor__sidebar-start"
        >
            <slot name="sidebar-start"></slot>
        </aside>
        <main class="sw-canvas-editor__surface">
            {% block sw_canvas_editor_surface %}
            <vue-flow
                :id="canvasId"
                v-bind="flowAttributes"
                :nodes="nodes"
                :edges="edges"
                @init="onInit"
                @node-mouse-enter="showNodeTools($event.node.id)"
                @node-mouse-leave="scheduleHideNodeTools($event.node.id)"
                @focusin="onFocusIn"
                @focusout="onFocusOut"
            >
                <template
                    v-for="name in rendererSlots()"
                    #[name]="props"
                >
                    <slot
                        :name="name"
                        v-bind="props"
                    ></slot>
                </template>
                <template v-if="$slots['node-tools']">
                    <node-toolbar
                        v-for="node in nodes"
                        :key="node.id"
                        class="sw-canvas-editor__node-tools nodrag nopan"
                        :node-id="node.id"
                        :data-canvas-node-owner="node.id"
                        :is-visible="hoveredNodeId === node.id || focusedNodeId === node.id ? true : undefined"
                        position="right"
                        align="start"
                        @mouseenter="showNodeTools(node.id)"
                        @focusin="onFocusIn"
                        @mouseleave="scheduleHideNodeTools(node.id)"
                        @focusout="onFocusOut"
                        @click.stop
                    >
                        <slot
                            name="node-tools"
                            :node="node"
                        ></slot>
                    </node-toolbar>
                </template>
                <slot></slot>
            </vue-flow>
            {% endblock %}
            <div
                v-if="$slots.overlay"
                class="sw-canvas-editor__overlay"
            >
                <slot name="overlay"></slot>
            </div>
            <slot
                name="viewport-controls"
                :fit="fit"
                :zoom-in="zoomIn"
                :zoom-out="zoomOut"
            ></slot>
        </main>
        <aside
            v-if="$slots['sidebar-end']"
            class="sw-canvas-editor__sidebar-end"
        >
            <slot name="sidebar-end"></slot>
        </aside>
    </div>
    <footer
        v-if="$slots.footer"
        class="sw-canvas-editor__footer"
    >
        <slot name="footer"></slot>
    </footer>
</div>
{% endblock %}
