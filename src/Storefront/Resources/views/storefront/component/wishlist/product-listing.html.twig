{% block element_wishlist_listing %}
    {% set listingColumns = 'col-sm-6 col-lg-4 col-xl-3' %}

    {% set filterUrl = null %}
    {% set dataUrl = url('widgets.wishlist.pagelet') %}

    {% set boxLayout = 'wishlist' %}
    {% set displayMode = null %}

    {% set sidebar = false %}

    {% set params = { 'no-aggregations': 1 } %}

    {% block element_wishlist_listing_wrapper %}
        {% sw_include '@Storefront/storefront/component/wishlist/listing.html.twig' with {
            searchResult: searchResult,
            dataUrl: dataUrl,
            filterUrl: filterUrl,
            disableEmptyFilter: false,
            params: params,
            sidebar: sidebar,
            boxLayout: boxLayout,
            displayMode: displayMode,
            listingColumns: listingColumns,
            listId: 'wishlist',
            listName: 'wishlist.analyticsListName'|trans
        } %}
    {% endblock %}
{% endblock %}
