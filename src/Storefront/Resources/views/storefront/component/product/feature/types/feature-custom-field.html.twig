{% sw_extends '@Storefront/storefront/component/product/feature/base.html.twig' %}

{% set supportedFieldTypes = [
    constant('\\Shopwell\\Core\\System\\CustomField\\CustomFieldTypes::BOOL'),
    constant('\\Shopwell\\Core\\System\\CustomField\\CustomFieldTypes::DATETIME'),
    constant('\\Shopwell\\Core\\System\\CustomField\\CustomFieldTypes::ENTITY'),
    constant('\\Shopwell\\Core\\System\\CustomField\\CustomFieldTypes::FLOAT'),
    constant('\\Shopwell\\Core\\System\\CustomField\\CustomFieldTypes::HTML'),
    constant('\\Shopwell\\Core\\System\\CustomField\\CustomFieldTypes::INT'),
    constant('\\Shopwell\\Core\\System\\CustomField\\CustomFieldTypes::PRICE'),
    constant('\\Shopwell\\Core\\System\\CustomField\\CustomFieldTypes::SELECT'),
    constant('\\Shopwell\\Core\\System\\CustomField\\CustomFieldTypes::TEXT')
] %}

{% set resolvedFieldTypes = [
    constant('\\Shopwell\\Core\\System\\CustomField\\CustomFieldTypes::ENTITY'),
    constant('\\Shopwell\\Core\\System\\CustomField\\CustomFieldTypes::PRICE'),
    constant('\\Shopwell\\Core\\System\\CustomField\\CustomFieldTypes::SELECT')
] %}

{% set isResolvedFieldType = value.type in resolvedFieldTypes %}
{% set isRenderable = value.type in supportedFieldTypes and (not isResolvedFieldType or value.display is defined) %}

{% block component_product_feature_list_item_base_content_label %}
    {% if isRenderable %}
        {{ '%s:'|format(label)|sw_sanitize }}
    {% endif %}
{% endblock %}

{% block component_product_feature_list_item_base_content_value %}
    {% if isRenderable %}
        {% if value.type is constant('\\Shopwell\\Core\\System\\CustomField\\CustomFieldTypes::BOOL') %}
            {{ (value.content > 0) ? 'component.product.feature.customField.true'|trans : 'component.product.feature.customField.false'|trans }}
        {% elseif value.type is constant('\\Shopwell\\Core\\System\\CustomField\\CustomFieldTypes::DATETIME') %}
            {{ value.content|sw_sanitize|date }}
        {% elseif value.type is constant('\\Shopwell\\Core\\System\\CustomField\\CustomFieldTypes::PRICE') %}
            {{ value.display|currency }}
        {% elseif isResolvedFieldType %}
            {{ value.display|join(', ')|sw_sanitize }}
        {% else %}
            {{ value.content|sw_sanitize }}
        {% endif %}
    {% endif %}
{% endblock %}
