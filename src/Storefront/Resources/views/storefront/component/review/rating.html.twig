{% block component_review_rating %}
    {% set full = points|round(0, 'floor') %}
    {% set left = ((points - full) * 4)|round %}
    {% set left = left / 4 %}

    {% if left > 0 %}
        {% set half = 1 %}
    {% endif %}

    {% set blank = 5 - full - half %}

    {% if altText is not defined %}
        {% set altText = 'detail.reviewAvgRatingAltText'|trans({ '%points%': points|round(2), '%maxPoints%': 5 }) %}
    {% endif %}

    {% block component_review_rating_output %}
        {# `role="img"` + `aria-label` gives screen readers the score as a single
           short label ("4.5/5"); the star icons themselves are aria-hidden. #}
        <div class="product-review-rating" role="img" aria-label="{{ points|round(1) }}/5">
            {% if full > 0 %}
                {% for star in range(1,full) %}
                    {% sw_include '@Storefront/storefront/component/review/point.html.twig' with {
                        type: 'full'
                    } %}
                {% endfor %}
            {% endif %}

            {% if half %}
                {% sw_include '@Storefront/storefront/component/review/point.html.twig' with {
                    type: 'half'
                } %}
            {% endif %}

            {% if blank > 0 %}
                {% for star in range(1,blank) %}
                    {% sw_include '@Storefront/storefront/component/review/point.html.twig' with {
                        type: 'blank'
                    } %}
                {% endfor %}
            {% endif %}
            {# Visible numeric score: #FAC30F on white is only 1.63:1, so the
               number — not the colour — carries the information. #}
            {% block component_review_rating_value %}
                <span class="product-review-rating-value">{{ points|round(1) }}</span>
            {% endblock %}

            <p class="product-review-rating-alt-text visually-hidden">
                {{ altText }}
            </p>
        </div>
    {% endblock %}
{% endblock %}
