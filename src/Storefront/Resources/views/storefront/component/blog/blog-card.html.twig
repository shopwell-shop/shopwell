{# @sw-package discovery #}
{% block sw_blog_card %}
    <twig:Sw:Blog:Card
        :blog="blog"
        :cover="cover|default(null)"
        :layout="layout|default('classic')"
        :featured="featured|default(false)"
        :showAuthor="showAuthor is defined ? showAuthor : true"
        :showReadingTime="showReadingTime is defined ? showReadingTime : true"
        :readingTime="readingTime|default(0)"
    />
{% endblock %}
