{# @sw-package discovery #}
{% block sw_blog_listing %}
    <twig:Sw:Blog:Listing
        :blogs="blogs|default(page is defined ? page.blogs : null)"
        :coverMedia="coverMedia|default(page is defined ? page.coverMedia : null)"
        :readingTimes="readingTimes|default(page is defined ? page.readingTimes : {})"
        :layout="layout|default('classic')"
        :showAuthor="showAuthor is defined ? showAuthor : (page is defined ? page.showAuthor : true)"
        :showReadingTime="showReadingTime is defined ? showReadingTime : (page is defined ? page.showReadingTime : true)"
    />
{% endblock %}
