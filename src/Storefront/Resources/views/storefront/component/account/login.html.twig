{% block component_account_login %}
    <div class="card login-card mb-3">
        <div class="card-body">
            {% block component_account_login_header %}
                {% if cardTitle %}
                    <h2 class="card-title">
                        {{ cardTitle }}
                    </h2>
                {% endif %}
            {% endblock %}

            {% block component_account_login_form %}
                <form class="login-form"
                      action="{{ path('frontend.account.login') }}"
                      method="post"
                      data-form-handler="true">
                    {% block component_account_login_form_redirect %}
                        <input type="hidden"
                               name="redirectTo"
                               value="{{ redirectTo }}">

                        <input type="hidden"
                               name="redirectParameters"
                               value="{{ redirectParameters is iterable ? redirectParameters|json_encode : redirectParameters }}">
                    {% endblock %}

                    {% block component_account_login_form_description %}
                        <p class="login-form-description">
                            {{ 'account.loginFormDescription'|trans|sw_sanitize }}
                        </p>
                    {% endblock %}

                    {% block component_account_login_form_error %}
                        {% if loginError %}
                            {% if errorSnippet != null %}
                                {% sw_include '@Storefront/storefront/utilities/alert.html.twig' with {
                                    type: 'danger',
                                    content: errorSnippet|trans|sw_sanitize({}, true),
                                    announceOnLoad: true,
                                    ariaLive: 'assertive'
                                } %}
                            {% elseif waitTime != null %}
                                {% sw_include '@Storefront/storefront/utilities/alert.html.twig' with {
                                    type: 'info',
                                    content: 'account.loginThrottled'|trans({'%seconds%': waitTime|number_format})|sw_sanitize,
                                    announceOnLoad: true
                                } %}
                            {% else %}
                                {% sw_include '@Storefront/storefront/utilities/alert.html.twig' with {
                                    type: 'danger',
                                    content: 'account.loginBadCredentials'|trans|sw_sanitize,
                                    announceOnLoad: true,
                                    ariaLive: 'assertive'
                                } %}
                            {% endif %}
                        {% endif %}
                    {% endblock %}

                    {% block component_account_login_form_fields %}
                        <div class="row g-2">
                            {% block component_account_login_form_mail %}
                                {% sw_include '@Storefront/storefront/component/form/form-input.html.twig' with {
                                    type: 'email',
                                    label: 'account.loginMailLabel'|trans|sw_sanitize,
                                    id: 'loginMail',
                                    name: 'username',
                                    autocomplete: 'username webauthn',
                                    error: loginError,
                                    validationRules: 'required,email',
                                    additionalClass: 'col-sm-6 col-lg-12',
                                } %}
                            {% endblock %}

                            {% block component_account_login_form_password %}
                                {% sw_include '@Storefront/storefront/component/form/form-input.html.twig' with {
                                    type: 'password',
                                    label: 'account.loginPasswordLabel'|trans|sw_sanitize,
                                    id: 'loginPassword',
                                    name: 'password',
                                    autocomplete: 'current-password',
                                    error: loginError,
                                    validationRules: 'required',
                                    additionalClass: 'col-sm-6 col-lg-12',
                                } %}
                            {% endblock %}
                        </div>
                    {% endblock %}

                    {% block component_account_login_password_recover %}
                        <div class="login-password-recover mb-3">
                            {% block component_account_login_password_recover_link %}
                                <a href="{{ seoUrl('frontend.account.recover.page') }}">
                                    {{ 'account.loginPasswordRecover'|trans }}
                                </a>
                            {% endblock %}
                        </div>
                    {% endblock %}

                    {% block component_account_login_submit %}
                        <div class="login-submit">
                            <button type="submit"
                                    class="btn btn-primary">
                                {{ 'account.loginSubmit'|trans|sw_sanitize }}
                            </button>
                        </div>
                    {% endblock %}
                </form>
            {% endblock %}

            {% block component_account_login_sms %}
                {# the login is on until an administrator switches it off, a missing value must not
                   take the second way into an account away from a fresh installation #}
                {% set smsLoginEnabled = config('core.loginRegistration.loginEnabled') %}

                {% if smsLoginEnabled is null or smsLoginEnabled %}
                    <div class="login-sms mt-3">
                        {% block component_account_login_sms_header %}
                            <h3 class="login-sms-header">
                                {{ 'account.smsLoginHeader'|trans|sw_sanitize }}
                            </h3>
                        {% endblock %}

                        {% block component_account_login_sms_description %}
                            <p class="login-sms-description">
                                {{ 'account.smsLoginDescription'|trans|sw_sanitize }}
                            </p>
                        {% endblock %}

                        {# one form with two submit buttons: the number is typed once, whether the customer
                           asks for a code first or has one already #}
                        {% block component_account_login_sms_form %}
                            <form class="login-sms-form"
                                  action="{{ path('frontend.account.login.sms') }}"
                                  method="post">
                                {% block component_account_login_sms_form_redirect %}
                                    <input type="hidden"
                                           name="redirectTo"
                                           value="{{ redirectTo }}">

                                    <input type="hidden"
                                           name="redirectParameters"
                                           value="{{ redirectParameters is iterable ? redirectParameters|json_encode : redirectParameters }}">
                                {% endblock %}

                                {% block component_account_login_sms_form_phone %}
                                    {% sw_include '@Storefront/storefront/component/form/form-input.html.twig' with {
                                        type: 'tel',
                                        label: 'account.smsLoginPhoneLabel'|trans|sw_sanitize,
                                        id: 'loginSmsPhone',
                                        name: 'phone',
                                        value: phone|default(''),
                                        autocomplete: 'tel',
                                        validationRules: 'required',
                                    } %}
                                {% endblock %}

                                {# the code is not required: the button that asks for one submits the same
                                   form, and the server answers an empty code with the message of an
                                   invalid code, exactly like a code of another number #}
                                {% block component_account_login_sms_form_code %}
                                    {% sw_include '@Storefront/storefront/component/form/form-input.html.twig' with {
                                        type: 'text',
                                        label: 'account.smsLoginCodeLabel'|trans|sw_sanitize,
                                        id: 'loginSmsCode',
                                        name: 'code',
                                        autocomplete: 'one-time-code',
                                        maxlength: 6,
                                        attributes: {
                                            inputmode: 'numeric',
                                            pattern: '\\d{6}',
                                        },
                                    } %}
                                {% endblock %}

                                {% block component_account_login_sms_form_submit %}
                                    <div class="login-submit d-flex gap-2">
                                        <button type="submit"
                                                class="btn btn-secondary"
                                                formaction="{{ path('frontend.account.login.sms-code') }}"
                                                formnovalidate>
                                            {{ 'account.smsLoginSendCodeSubmit'|trans|sw_sanitize }}
                                        </button>

                                        <button type="submit"
                                                class="btn btn-primary">
                                            {{ 'account.smsLoginSubmit'|trans|sw_sanitize }}
                                        </button>
                                    </div>
                                {% endblock %}
                            </form>
                        {% endblock %}
                    </div>
                {% endif %}
            {% endblock %}

            {% block component_account_login_oauth2 %}
                {% set oauth2Channels = page is defined and page.extensions.oauth2Login is defined ? page.extensions.oauth2Login.channels : [] %}

                {% if oauth2Channels is not empty %}
                    <div class="login-oauth2 mt-3">
                        {% block component_account_login_oauth2_header %}
                            <div class="login-oauth2-header">
                                {{ 'sso.oauth2.loginHeader'|trans|sw_sanitize }}
                            </div>
                        {% endblock %}

                        {% block component_account_login_oauth2_channels %}
                            <div class="login-oauth2-channels">
                                {% for channel in oauth2Channels %}
                                    {% set channelName = channel.labelSnippet|trans %}

                                    {% block component_account_login_oauth2_channel %}
                                        <a class="btn btn-outline-secondary login-oauth2-channel login-oauth2-channel-{{ channel.technicalName }}"
                                           href="{{ path('frontend.oauth2-login.start', { channel: channel.technicalName }) }}"
                                           title="{{ 'sso.oauth2.loginWith'|trans({'%channel%': channelName}) }}">
                                            {{ 'sso.oauth2.loginWith'|trans({'%channel%': channelName})|sw_sanitize }}
                                        </a>
                                    {% endblock %}
                                {% endfor %}
                            </div>
                        {% endblock %}
                    </div>
                {% endif %}
            {% endblock %}
        </div>
    </div>
{% endblock %}
