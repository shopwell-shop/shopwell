{% block header %}
    {% block base_header %}
        {% sw_include '@Storefront/storefront/utilities/staging-info.html.twig' %}

        <header class="header-main">
            {% block base_header_inner %}
                <div class="container">
                    {% sw_include '@Storefront/storefront/layout/header/header.html.twig' %}
                </div>
            {% endblock %}
        </header>
    {% endblock %}

    {#
        Main navigation is rendered inline inside the header row
        (see block `layout_header_navbar` in layout/header/header.html.twig)
        to build the single-line header.

        Override `base_navigation` / `base_navigation_inner` to render a
        standalone navigation bar below the header instead.
    #}
    {% block base_navigation %}
        {% block base_navigation_inner %}
        {% endblock %}
    {% endblock %}

    {% block base_offcanvas_navigation %}
        {% if header.navigation %}
            <div class="d-none js-navigation-offcanvas-initial-content">
                {% block base_offcanvas_navigation_inner %}
                    {% sw_include '@Storefront/storefront/layout/navigation/offcanvas/navigation.html.twig' with { navigation: header.navigation } %}
                {% endblock %}
            </div>
        {% endif %}
    {% endblock %}
{% endblock %}
