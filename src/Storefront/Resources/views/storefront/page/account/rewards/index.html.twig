{% sw_extends '@Storefront/storefront/page/account/_page.html.twig' %}

{% block page_account_main_content %}
    {% block page_account_rewards %}
        {% set rewards = page.rewards %}
        {% set isoCode = context.currency.isoCode %}

        <div class="account-rewards">
            {% block page_account_rewards_welcome %}
                <div class="account-welcome">
                    {% block page_account_rewards_welcome_headline %}
                        <h1 class="account-welcome-title">{{ 'account.rewardsTitle'|trans|sw_sanitize }}</h1>
                    {% endblock %}

                    {% block page_account_rewards_welcome_intro %}
                        <p class="account-welcome-intro">{{ 'account.rewardsWelcome'|trans|sw_sanitize }}</p>
                    {% endblock %}
                </div>
            {% endblock %}

            {% block page_account_rewards_overview %}
                <div class="account-panel account-tier-hero">
                    {% block page_account_rewards_overview_metrics %}
                        <div class="account-tier-hero-head">
                            {% block page_account_rewards_tier %}
                                <span class="account-tier-hero-badge">
                                    {% sw_icon 'sparkles' style { size: 'sm' } %}
                                    {% if page.currentTier %}
                                        {{ page.currentTier.name }}
                                    {% else %}
                                        {{ 'account.rewardsNoTier'|trans|sw_sanitize }}
                                    {% endif %}
                                </span>
                            {% endblock %}
                        </div>

                        {% block page_account_rewards_value %}
                            <div class="account-tier-hero-value">
                                {{ rewards.pointsBalance|number_format }}

                                {% block page_account_rewards_balance %}
                                    <small>{{ 'account.rewardsPointsBalance'|trans|sw_sanitize }}</small>
                                {% endblock %}
                            </div>

                            <p class="account-tier-hero-hint">
                                {{ 'account.rewardsRedeemHint'|trans({
                                    '%min%': rewards.minRedeemablePoints,
                                    '%percent%': rewards.maxRedeemablePercent
                                })|sw_sanitize }}
                            </p>
                        {% endblock %}
                    {% endblock %}

                    {% block page_account_rewards_progress %}
                        {% if page.nextTier %}
                            {% set currentTierPoints = page.currentTier ? page.currentTier.minTierPoints : 0 %}
                            {% set targetTierPoints = page.nextTier.minTierPoints %}
                            {% set progressRange = targetTierPoints - currentTierPoints %}
                            {% set progress = progressRange > 0 ? ((rewards.tierPoints - currentTierPoints) / progressRange * 100)|round(0, 'floor') : 0 %}
                            {% set progress = progress < 0 ? 0 : (progress > 100 ? 100 : progress) %}

                            <div class="account-tier-hero-progress">
                                {% block page_account_rewards_progress_header %}
                                    <div class="account-tier-hero-progress-header">
                                        <span>{{ 'account.overviewTierToNext'|trans({ '%tier%': page.nextTier.name, '%points%': targetTierPoints - rewards.tierPoints })|sw_sanitize }}</span>
                                        <span>{{ rewards.tierPoints }} / {{ targetTierPoints }}</span>
                                    </div>
                                {% endblock %}

                                {% block page_account_rewards_progress_bar %}
                                    <div class="progress account-progress"
                                         role="progressbar"
                                         aria-valuenow="{{ progress }}"
                                         aria-valuemin="0"
                                         aria-valuemax="100"
                                         aria-label="{{ 'account.overviewTierProgressAria'|trans({ '%tier%': page.nextTier.name })|striptags }}">
                                        <div class="progress-bar account-progress-bar" style="width: {{ progress }}%"></div>
                                    </div>
                                {% endblock %}
                            </div>
                        {% endif %}
                    {% endblock %}

                    <div class="account-tier-hero-actions">
                        <a class="btn btn-primary btn-sm" href="{{ path('frontend.home.page') }}">
                            {{ 'account.rewardsEarnCta'|trans|sw_sanitize }}
                        </a>
                        <a class="btn btn-outline-primary btn-sm" href="{{ path('frontend.account.membership.page') }}">
                            {{ 'account.rewardsBenefitsCta'|trans|sw_sanitize }}
                        </a>
                    </div>
                </div>
            {% endblock %}

            {% block page_account_rewards_redeem %}
                {% set levels = rewards.redemptionLevels ?? [] %}

                <div class="account-panel account-rewards-redeem">
                    {% block page_account_rewards_redeem_title %}
                        <div class="account-panel-head">
                            <h2 class="account-panel-title">{{ 'account.rewardsRedeemTitle'|trans|sw_sanitize }}</h2>
                        </div>
                    {% endblock %}

                    {% block page_account_rewards_redeem_levels %}
                        {% if levels is empty %}
                            {% sw_include '@Storefront/storefront/utilities/alert.html.twig' with {
                                type: 'info',
                                content: 'account.rewardsRedeemEmpty'|trans|sw_sanitize
                            } %}
                        {% else %}
                            <div class="account-rewards-redeem-grid">
                                {% for level in levels %}
                                    <div class="account-rewards-redeem-level{% if rewards.pointsBalance < level.points %} is-locked{% endif %}">
                                        <div class="account-rewards-redeem-points">
                                            {{ 'account.rewardsRedeemFrom'|trans({ '%points%': level.points })|sw_sanitize }}
                                        </div>
                                        <div class="account-rewards-redeem-rate">
                                            {{ 'account.rewardsRedeemRate'|trans({
                                                '%value%': level.valuePerPoint|number_format(4),
                                                '%currency%': isoCode
                                            })|sw_sanitize }}
                                        </div>
                                        {% if rewards.pointsBalance < level.points %}
                                            <div class="account-rewards-redeem-locked">
                                                {{ 'account.rewardsRedeemLocked'|trans({ '%points%': level.points - rewards.pointsBalance })|sw_sanitize }}
                                            </div>
                                        {% endif %}
                                    </div>
                                {% endfor %}
                            </div>
                        {% endif %}
                    {% endblock %}

                    {% block page_account_rewards_redeem_hint %}
                        <p class="account-rewards-redeem-hint">
                            {{ 'account.rewardsRedeemHint'|trans({
                                '%min%': rewards.minRedeemablePoints,
                                '%percent%': rewards.maxRedeemablePercent
                            })|sw_sanitize }}
                        </p>
                    {% endblock %}
                </div>
            {% endblock %}

            {% block page_account_rewards_earn %}
                <div class="account-panel account-rewards-earn">
                    {% block page_account_rewards_earn_title %}
                        <div class="account-panel-head">
                            <h2 class="account-panel-title">{{ 'account.rewardsEarnTitle'|trans|sw_sanitize }}</h2>
                        </div>
                    {% endblock %}

                    {% block page_account_rewards_earn_rules %}
                        <ul class="account-rules">
                            <li>{% sw_icon 'checkmark' style { size: 'sm' } %}<span>{{ 'account.rewardsEarnPoints'|trans({ '%currency%': isoCode, '%points%': rewards.pointsPerCurrencyUnit })|sw_sanitize }}</span></li>
                            <li>{% sw_icon 'checkmark' style { size: 'sm' } %}<span>{{ 'account.rewardsEarnTierPoints'|trans({ '%currency%': isoCode, '%points%': rewards.tierPointsPerCurrencyUnit })|sw_sanitize }}</span></li>
                            {% if page.currentTier and page.currentTier.benefits.earn_multiplier|default(1) > 1 %}
                                <li>{% sw_icon 'checkmark' style { size: 'sm' } %}<span>{{ 'account.rewardsEarnMultiplier'|trans({ '%tier%': page.currentTier.name, '%multiplier%': page.currentTier.benefits.earn_multiplier|default(1) })|sw_sanitize }}</span></li>
                            {% endif %}
                        </ul>
                    {% endblock %}
                </div>
            {% endblock %}

            {% block page_account_rewards_tiers %}
                {% if rewards.tiers is not empty %}
                    <div class="account-panel account-rewards-tiers">
                        {% block page_account_rewards_tiers_title %}
                            <div class="account-panel-head">
                                <h2 class="account-panel-title">{{ 'account.rewardsTiersTitle'|trans|sw_sanitize }}</h2>
                                <a class="account-link-muted" href="{{ path('frontend.account.membership.page') }}">
                                    {{ 'account.membershipLink'|trans|sw_sanitize }}
                                </a>
                            </div>
                        {% endblock %}

                        {% block page_account_rewards_tiers_table %}
                            <div class="table-responsive">
                                <table class="table account-data-table account-rewards-tiers-table">
                                    <thead>
                                        {% block page_account_rewards_tiers_table_head %}
                                            <tr>
                                                <th scope="col">{{ 'account.rewardsTierColumnName'|trans|sw_sanitize }}</th>
                                                <th scope="col">{{ 'account.rewardsTierColumnTierPoints'|trans|sw_sanitize }}</th>
                                                <th scope="col">{{ 'account.rewardsTierColumnMultiplier'|trans|sw_sanitize }}</th>
                                                <th scope="col" class="text-end">{{ 'account.rewardsTierColumnDiscount'|trans|sw_sanitize }}</th>
                                            </tr>
                                        {% endblock %}
                                    </thead>
                                    <tbody>
                                        {% block page_account_rewards_tiers_table_body %}
                                            {% for tier in rewards.tiers %}
                                                <tr class="{% if page.currentTier and tier.id is same as(page.currentTier.id) %}account-rewards-tier-current fw-bold{% endif %}">
                                                    <td>{{ tier.name }}</td>
                                                    <td class="account-data-amount">{{ tier.minTierPoints }}</td>
                                                    <td>{{ tier.benefits.earn_multiplier|default(1) }}</td>
                                                    <td class="text-end">
                                                        {% if tier.benefits.cart_discount|default(0) > 0 %}
                                                            {{ tier.benefits.cart_discount }}%
                                                        {% else %}
                                                            &ndash;
                                                        {% endif %}
                                                    </td>
                                                </tr>
                                            {% endfor %}
                                        {% endblock %}
                                    </tbody>
                                </table>
                            </div>
                        {% endblock %}
                    </div>
                {% endif %}
            {% endblock %}
        </div>
    {% endblock %}
{% endblock %}
