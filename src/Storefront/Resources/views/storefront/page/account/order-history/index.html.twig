{% sw_extends '@Storefront/storefront/page/account/_page.html.twig' %}

{% block page_account_main_content %}
    {% block page_account_orders %}
        <div class="account-orders">
            {% block page_account_orders_welcome %}
                <div class="account-welcome">
                    {% block page_account_orders_welcome_headline %}
                        <h1 class="account-welcome-title">{{ 'account.ordersTitle'|trans|sw_sanitize }}</h1>
                    {% endblock %}

                    {% block page_account_orders_welcome_intro %}
                        <p class="account-welcome-intro">{{ 'account.ordersIntro'|trans|sw_sanitize }}</p>
                    {% endblock %}
                </div>
            {% endblock %}

            {#
                Status tag row (原型 `.sw-tag` row).

                The numbers are the ones the loader counted with the very filter the tag stands for
                (`page.orderStateCounts`), so a tag can never promise a different count than the list it
                opens. The row sits outside the empty-state branch on purpose: it is the only way back
                out of an empty filter.
            #}
            {% block page_account_orders_state_filter %}
                <nav class="account-orders-filters"
                     aria-label="{{ 'account.orderFilterAriaLabel'|trans|sw_sanitize }}">
                    {% block page_account_orders_state_filter_list %}
                        {% set filterLabels = {
                            'all': 'account.orderFilterAll',
                            'pending_payment': 'account.orderFilterPendingPayment',
                            'pending_shipment': 'account.orderFilterPendingShipment',
                            'pending_delivery': 'account.orderFilterPendingDelivery',
                            'completed': 'account.orderFilterCompleted',
                            'cancelled': 'account.orderFilterCancelled'
                        } %}

                        {% for filter, label in filterLabels %}
                            {% set isActive = page.orderStateFilter == filter %}

                            {% if filter == 'all' %}
                                {% set filterParams = {} %}
                            {% else %}
                                {% set filterParams = { orderState: filter } %}
                            {% endif %}

                            <a class="sw-tag{{ isActive ? ' sw-tag--active' : '' }}"
                               href="{{ path('frontend.account.order.page', filterParams) }}"
                               {% if isActive %}aria-current="page"{% endif %}>
                                <span class="sw-tag-label">{{ label|trans|sw_sanitize }}</span>
                                <span class="sw-tag-count">{{ page.getOrderStateCount(filter) }}</span>
                            </a>
                        {% endfor %}
                    {% endblock %}
                </nav>
            {% endblock %}

            {% block page_account_orders_main %}
                <div class="account-orders-main">
                    {% if page.orders.total == 0 %}
                        {% block page_account_orders_info_empty %}
                            {% if page.orderStateFilter == 'all' %}
                                {# no orders at all: the only useful next step is the catalogue #}
                                <div class="account-empty">
                                    {% sw_icon 'bag' style { size: 'lg' } %}
                                    <p class="account-empty-text">{{ 'account.ordersInfoEmpty'|trans|sw_sanitize }}</p>
                                    <a class="btn btn-primary btn-sm" href="{{ path('frontend.home.page') }}">
                                        {{ 'checkout.continueShopping'|trans|sw_sanitize }}
                                    </a>
                                </div>
                            {% else %}
                                {# the shop has orders, this tag has none: lead back to the full list #}
                                <div class="account-empty">
                                    {% sw_icon 'bag' style { size: 'lg' } %}
                                    <p class="account-empty-text">{{ 'account.ordersEmptyInFilter'|trans|sw_sanitize }}</p>
                                    <a class="btn btn-secondary btn-sm" href="{{ path('frontend.account.order.page') }}">
                                        {{ 'account.orderFilterReset'|trans|sw_sanitize }}
                                    </a>
                                </div>
                            {% endif %}
                        {% endblock %}
                    {% else %}
                        {% block page_account_orders_overview %}

                            <ul class="account-orders-overview list-unstyled">
                                {% block page_account_orders_table %}
                                    {% block page_account_orders_table_body %}
                                        {% for order in page.orders.entities %}
                                            <li class="order-table" data-order-detail-loader="true">
                                                {% sw_include '@Storefront/storefront/page/account/order-history/order-item.html.twig' %}
                                            </li>
                                        {% endfor %}
                                    {% endblock %}
                                {% endblock %}
                            </ul>
                        {% endblock %}

                        {% block page_account_orders_paging %}

                            {% set totalPages = (page.orders.total/(page.orders.limit ?: 1))|round(0,'ceil') %}

                            {% if totalPages > 1 %}
                                {% set formAjaxSubmitOptions = {
                                    replaceSelectors: '.account-orders-main',
                                    submitOnChange: true
                                } %}

                                {% block page_account_orders_paging_form %}
                                    <div class="account-orders-pagination">
                                        <form class="account-orders-pagination-form"
                                              action="{{ path('frontend.account.order.page') }}"
                                              method="post"
                                              data-form-ajax-submit="true"
                                              data-form-ajax-submit-options="{{ formAjaxSubmitOptions|json_encode }}"
                                              data-form-ajax-pagination="true">

                                            <input type="hidden" name="p" value="1">

                                            {# paging posts back, so the active tag has to travel with it #}
                                            {% if page.orderStateFilter != 'all' %}
                                                <input type="hidden" name="orderState" value="{{ page.orderStateFilter }}">
                                            {% endif %}

                                            {% sw_include '@Storefront/storefront/component/pagination.html.twig' with {entities: page.orders}  %}
                                        </form>
                                    </div>
                                {% endblock %}
                            {% endif %}
                        {% endblock %}
                    {% endif %}
                </div>
            {% endblock %}
        </div>
    {% endblock %}
{% endblock %}

{% block base_footer_inner %}
    {% sw_include '@Storefront/storefront/layout/footer/footer.html.twig' with {
        showVatNotice: false
    } %}
{% endblock %}
