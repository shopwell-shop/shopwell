{% sw_extends '@Storefront/storefront/page/account/_page.html.twig' %}

{% block page_account_main_content %}
    {% block page_account_membership %}
        {% set membership = page.membership %}
        {% set isoCode = context.currency.isoCode %}
        {% set channels = membership.channels ?? [] %}
        {% set subscription = membership.subscription %}

        <div class="account-membership">
            {% block page_account_membership_welcome %}
                <div class="account-welcome">
                    {% block page_account_membership_welcome_headline %}
                        <h1 class="account-welcome-title">{{ 'account.membershipTitle'|trans|sw_sanitize }}</h1>
                    {% endblock %}

                    {% block page_account_membership_welcome_intro %}
                        <p class="account-welcome-intro">{{ 'account.membershipWelcome'|trans|sw_sanitize }}</p>
                    {% endblock %}
                </div>
            {% endblock %}

            {% block page_account_membership_current %}
                <div class="account-panel account-membership-current">
                    <div class="account-panel-head">
                        {% block page_account_membership_current_title %}
                            <h2 class="account-panel-title">{{ 'account.membershipCurrentTitle'|trans|sw_sanitize }}</h2>
                        {% endblock %}

                        {% block page_account_membership_current_state %}
                            <p class="account-membership-current-state" data-membership-state>
                                {% if subscription %}
                                    <span class="badge badge-new">{{ 'account.membershipActive'|trans|sw_sanitize }}</span>
                                    {% if subscription.planName %}
                                        <span class="account-membership-current-plan">{{ subscription.planName }}</span>
                                    {% endif %}
                                {% else %}
                                    <span class="badge badge-neutral">{{ 'account.membershipInactive'|trans|sw_sanitize }}</span>
                                {% endif %}
                            </p>
                        {% endblock %}
                    </div>

                    {% block page_account_membership_current_valid_until %}
                        {% if subscription %}
                            <p class="account-membership-current-valid-until">
                                {{ 'account.membershipPaidUntil'|trans({
                                    '%date%': subscription.endsAt|date('Y-m-d')
                                })|sw_sanitize }}
                            </p>
                        {% endif %}
                    {% endblock %}
                </div>
            {% endblock %}

            {% block page_account_membership_plans %}
                <div class="account-panel account-membership-plans"
                     data-membership-purchase="true"
                     data-membership-purchase-options="{{ {
                         purchaseUrl: path('frontend.account.membership.purchase'),
                         statusUrl: path('frontend.account.membership.json'),
                         returnUrl: url('frontend.account.membership.page'),
                         qrHintTemplate: 'account.membershipQrHint'|trans,
                         membershipProcessing: 'account.membershipProcessing'|trans,
                         membershipErrorGeneric: 'account.membershipErrorGeneric'|trans,
                         membershipSdkUnsupported: 'account.membershipSdkUnsupported'|trans,
                         membershipOpen: 'account.membershipOpen'|trans,
                         membershipActivated: 'account.membershipActivated'|trans,
                         membershipFailed: 'account.membershipFailed'|trans,
                         pollInterval: 4000,
                         pollTimeout: 600000
                     }|json_encode }}">
                    <div class="account-panel-head">
                        {% block page_account_membership_plans_title %}
                            <h2 class="account-panel-title">{{ 'account.membershipPlansTitle'|trans|sw_sanitize }}</h2>
                        {% endblock %}

                        {% block page_account_membership_plans_channel %}
                            {% if channels is not empty %}
                                <div class="account-membership-plans-channel">
                                    <label class="form-label" for="membershipChannel">
                                        {{ 'account.membershipChannelLabel'|trans|sw_sanitize }}
                                    </label>

                                    <select class="form-select form-select-sm"
                                            id="membershipChannel"
                                            data-membership-purchase-channel>
                                        {% for channel in channels %}
                                            <option value="{{ channel.channel }}"
                                                    data-flow="{{ channel.flow }}">
                                                {{ channel.label }}
                                            </option>
                                        {% endfor %}
                                    </select>
                                </div>
                            {% endif %}
                        {% endblock %}
                    </div>

                    {% if membership.plans is empty %}
                        {% block page_account_membership_plans_empty %}
                            {% sw_include '@Storefront/storefront/utilities/alert.html.twig' with {
                                type: 'info',
                                content: 'account.membershipPlansEmpty'|trans|sw_sanitize
                            } %}
                        {% endblock %}
                    {% else %}
                        <div class="account-membership-plan-grid">
                            {% block page_account_membership_plans_grid %}
                                {% for plan in membership.plans %}
                                    <div class="account-membership-plan{% if subscription and subscription.planName is same as(plan.name) %} is-current{% endif %}">
                                        {% if subscription and subscription.planName is same as(plan.name) %}
                                            <span class="account-membership-plan-flag">{{ 'account.membershipPlanCurrent'|trans|sw_sanitize }}</span>
                                        {% endif %}

                                        {% block page_account_membership_plan_header %}
                                            <h3 class="account-membership-plan-name">{{ plan.name }}</h3>

                                            {% if plan.tier %}
                                                <p class="account-membership-plan-tier">
                                                    {{ 'account.membershipPlanTier'|trans({ '%tier%': plan.tier.name })|sw_sanitize }}
                                                </p>
                                            {% endif %}

                                            <p class="account-membership-plan-price">
                                                {{ plan.price|currency(isoCode) }}
                                            </p>

                                            <p class="account-membership-plan-duration">
                                                {{ 'account.membershipPlanDuration'|trans({ '%days%': plan.durationDays })|sw_sanitize }}
                                            </p>
                                        {% endblock %}

                                        {% block page_account_membership_plan_description %}
                                            {% if plan.description %}
                                                <p class="account-membership-plan-description">{{ plan.description }}</p>
                                            {% endif %}
                                        {% endblock %}

                                        {% block page_account_membership_plan_action %}
                                            <button type="button"
                                                    class="btn btn-primary account-membership-plan-buy"
                                                    data-membership-plan-id="{{ plan.id }}"
                                                    data-membership-plan-name="{{ plan.name }}"
                                                    {% if channels is empty %}disabled{% endif %}>
                                                {{ 'account.membershipPlanBuy'|trans|sw_sanitize }}
                                            </button>
                                        {% endblock %}
                                    </div>
                                {% endfor %}
                            {% endblock %}
                        </div>
                    {% endif %}

                    {% block page_account_membership_plans_no_channel %}
                        {% if channels is empty %}
                            {% sw_include '@Storefront/storefront/utilities/alert.html.twig' with {
                                type: 'info',
                                content: 'account.membershipNoChannel'|trans|sw_sanitize
                            } %}
                        {% endif %}
                    {% endblock %}

                    {% block page_account_membership_feedback %}
                        <div class="alert account-membership-feedback d-none mt-3"
                             role="status"
                             aria-live="polite"
                             data-membership-purchase-feedback>
                            <span data-membership-purchase-message></span>
                        </div>
                    {% endblock %}

                    {% block page_account_membership_qrcode %}
                        <div class="account-membership-qrcode d-none mt-3"
                             data-membership-purchase-qrcode>
                            <h3 class="account-membership-qrcode-title">
                                {{ 'account.membershipQrTitle'|trans|sw_sanitize }}
                            </h3>

                            <div class="account-membership-qrcode-target"
                                 data-membership-purchase-qrcode-target></div>

                            <p class="account-membership-qrcode-hint"
                               data-membership-purchase-qrcode-hint></p>

                            <button type="button"
                                    class="btn btn-outline-primary"
                                    data-membership-purchase-check>
                                {{ 'account.membershipQrCheck'|trans|sw_sanitize }}
                            </button>
                        </div>
                    {% endblock %}
                </div>
            {% endblock %}

            {% block page_account_membership_orders %}
                {% if membership.orders is not empty %}
                    {% set orderStateLabels = {
                        open: 'account.membershipOrderStateOpen',
                        activated: 'account.membershipOrderStateActivated',
                        failed: 'account.membershipOrderStateFailed'
                    } %}
                    {% set orderStateVariants = {
                        open: 'badge-warn',
                        activated: 'badge-new',
                        failed: 'badge-danger'
                    } %}

                    <div class="account-panel account-membership-orders">
                        {% block page_account_membership_orders_title %}
                            <div class="account-panel-head">
                                <h2 class="account-panel-title">{{ 'account.membershipOrdersTitle'|trans|sw_sanitize }}</h2>
                            </div>
                        {% endblock %}

                        <div class="table-responsive">
                            <table class="table account-data-table account-membership-orders-table">
                                <thead>
                                    {% block page_account_membership_orders_head %}
                                        <tr>
                                            <th scope="col">{{ 'account.membershipOrderColumnDate'|trans|sw_sanitize }}</th>
                                            <th scope="col">{{ 'account.membershipOrderColumnPlan'|trans|sw_sanitize }}</th>
                                            <th scope="col">{{ 'account.membershipOrderColumnAmount'|trans|sw_sanitize }}</th>
                                            <th scope="col" class="text-end">{{ 'account.membershipOrderColumnState'|trans|sw_sanitize }}</th>
                                        </tr>
                                    {% endblock %}
                                </thead>
                                <tbody>
                                    {% block page_account_membership_orders_body %}
                                        {% for order in membership.orders %}
                                            <tr data-membership-order-id="{{ order.id }}">
                                                <td class="account-data-date">
                                                    {% if order.createdAt %}
                                                        {{ order.createdAt|format_datetime('medium', 'short', locale=app.request.locale) }}
                                                    {% else %}
                                                        &ndash;
                                                    {% endif %}
                                                </td>
                                                <td>{{ order.planName }}</td>
                                                <td class="account-data-amount">{{ order.amount|currency(order.currency) }}</td>
                                                <td class="text-end">
                                                    <span class="badge {{ orderStateVariants[order.state]|default('badge-neutral') }}">
                                                        {{ orderStateLabels[order.state]|default('account.membershipOrderStateOpen')|trans|sw_sanitize }}
                                                    </span>
                                                </td>
                                            </tr>
                                        {% endfor %}
                                    {% endblock %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                {% endif %}
            {% endblock %}
        </div>
    {% endblock %}
{% endblock %}
