{% block block_wishlist_listing %}
    <div class="col-12">
        {% if searchResult.total > 0 %}
            {% block block_wishlist_listing_header %}
                <div class="wishlist-header">
                    {% block block_wishlist_listing_header_text %}
                        <div class="wishlist-header__text">
                            <h1 class="wishlist-header__title">
                                {% block block_wishlist_listing_header_title %}
                                    {{ 'wishlist.headline'|trans }}
                                {% endblock %}
                            </h1>
                            {% block block_wishlist_listing_header_count %}
                                <p class="wishlist-header__subtitle">
                                    {{ 'wishlist.subtitle'|trans({ '%count%': searchResult.total })|sw_sanitize }}
                                </p>
                            {% endblock %}
                        </div>
                    {% endblock %}

                    {% block block_wishlist_listing_header_continue %}
                        <a class="wishlist-header__continue"
                           href="{{ seoUrl('frontend.navigation.page', { navigationId: context.salesChannel.navigationCategoryId }) }}">
                            {{ 'wishlist.continueShopping'|trans|sw_sanitize }}
                        </a>
                    {% endblock %}
                </div>
            {% endblock %}
        {% endif %}

        {% block block_wishlist_listing_inner %}
            {% sw_include '@Storefront/storefront/element/cms-element-wishlist-listing.html.twig' ignore missing %}
        {% endblock %}
    </div>
{% endblock %}
