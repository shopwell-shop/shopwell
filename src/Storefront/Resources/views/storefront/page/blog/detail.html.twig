{% sw_extends '@Storefront/storefront/base.html.twig' %}

{# @var page \Shopwell\Storefront\Page\Blog\BlogDetailPage #}
{% block base_head %}
    {% sw_include '@Storefront/storefront/page/blog/meta.html.twig' %}
{% endblock %}

{% block base_content %}
    {% block sw_blog_detail %}
        {% set blog = page.blog %}

        {% if page.entityBoundLayout %}
            <div class="content-page blog-detail__content-layout">
                <twig:Sw:Content:Page :page="page.contentPage" />
            </div>
        {% else %}
            {% sw_include '@Storefront/storefront/component/blog/blog-detail-content.html.twig' with { page: page } %}
        {% endif %}
    {% endblock %}
{% endblock %}
