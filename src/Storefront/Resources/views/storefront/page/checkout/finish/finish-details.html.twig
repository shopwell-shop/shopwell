{% block page_checkout_finish_details_inner %}
    {% block page_checkout_finish_data %}
        <div class="card checkout-card"
             data-checkout-customer-storage-reset="true">
            <div class="card-body">
                {% block page_checkout_finish_success_icon %}
                    <div class="finish-success-icon" aria-hidden="true">
                        {% sw_icon 'checkmark' style { 'size': 'lg' } %}
                    </div>
                {% endblock %}

                {% block page_checkout_finish_header %}
                    <h1 class="finish-header">
                        {% if page.changedPayment == true %}
                            {{ 'checkout.finishUpdateHeader'|trans|sw_sanitize }}
                        {% else %}
                            {{ 'checkout.finishHeader'|trans({
                                '%shop%': config('core.basicInformation.shopName')
                            })|sw_sanitize }}
                        {% endif %}
                    </h1>
                {% endblock %}

                {% block page_checkout_finish_ordernumber %}
                    <p class="finish-ordernumber" data-order-number="{{ page.order.orderNumber }}">
                        {{ 'checkout.finishInfoOrdernumber'|trans|sw_sanitize }}{{ page.order.orderNumber }}
                    </p>
                {% endblock %}

                {% block page_checkout_finish_enhanced_conversions %}
                    {% if storefrontAnalytics and storefrontAnalytics.isActive() and storefrontAnalytics.isTrackOrders() and storefrontAnalytics.isEnhancedConversions() %}
                        {# Google Enhanced Conversions requires email normalization before hashing:
                           https://support.google.com/google-ads/answer/13258081 #}
                        {% set email = page.order.orderCustomer.email|lower|trim %}
                        {% set emailParts = email|split('@') %}
                        {% if emailParts[1] == 'gmail.com' or emailParts[1] == 'googlemail.com' %}
                            {% set email = emailParts[0]|replace({'.': ''}) ~ '@' ~ emailParts[1] %}
                        {% endif %}
                        <script>
                            gtag('set', 'user_data', {
                                'sha256_email_address': '{{ email|sha256 }}'
                            });
                        </script>
                    {% endif %}
                {% endblock %}

                {% block page_checkout_finish_hidden_information_line_items %}
                    {% sw_include '@Storefront/storefront/component/checkout/hidden-line-items-information.html.twig' with {
                        cart: page.order,
                        lineItems: page.order.lineItems,
                    } %}
                {% endblock %}

                {% block page_checkout_finish_subtitle %}
                    {% if page.changedPayment == true %}
                        {% if feature('v6.8.0.0') %}
                            {% set paymentName = page.order.primaryOrderTransaction.paymentMethod.translated.name %}
                        {% else %}
                            {# @deprecated tag:v6.8.0 - Use `order.primaryOrderTransaction` instead of the last transaction. #}
                            {% set paymentName = page.order.transactions.last.paymentMethod.translated.name %}
                        {% endif %}
                        <p class="finish-order-subtitle">
                            {{ 'checkout.finishPaymentHeader'|trans({'%paymentName%': paymentName})|sw_sanitize }}
                        </p>
                    {% endif %}
                {% endblock %}

                {% block page_checkout_finish_content %}
                    <div class="finish-content">
                        {% block page_checkout_finish_teaser %}
                            {% if page.changedPayment != true %}
                                <p class="finish-teaser">{{ 'checkout.finishInfoConfirmationMail'|trans|sw_sanitize }}</p>
                            {% endif %}
                        {% endblock %}

                        {% block page_checkout_finish_create_account %}
                        {% if context.customer.guest %}
                            <div class="finish-create-account-container">
                                <h5>{{ 'checkout.createAccountHeading'|trans|sw_sanitize }}</h5>
                                <a class="btn btn-light" href="{{ url('frontend.account.convert.page') }}">{{ 'checkout.createAccountButton'|trans|sw_sanitize }}</a>
                            </div>
                        {% endif %}
                        {% endblock %}
                    </div>
                {% endblock %}

                {% block page_checkout_finish_info_grid %}
                    {% set finishPaymentName = feature('v6.8.0.0')
                        ? page.order.primaryOrderTransaction.paymentMethod.translated.name
                        : page.order.transactions.last.paymentMethod.translated.name %}

                    <dl class="finish-detail-grid">
                        {% block page_checkout_finish_info_grid_date %}
                            <div class="finish-detail-item">
                                <dt class="finish-detail-label">{{ 'checkout.finishInfoOrderDate'|trans|sw_sanitize }}</dt>
                                <dd class="finish-detail-value">{{ page.order.orderDate|date('Y-m-d H:i') }}</dd>
                            </div>
                        {% endblock %}

                        {% block page_checkout_finish_info_grid_payment %}
                            <div class="finish-detail-item">
                                <dt class="finish-detail-label">{{ 'checkout.finishInfoPaymentShort'|trans|sw_sanitize }}</dt>
                                <dd class="finish-detail-value">{{ finishPaymentName }}</dd>
                            </div>
                        {% endblock %}

                        {% block page_checkout_finish_info_grid_shipping %}
                            {% if feature('v6.8.0.0') %}
                                {% set finishShippingName = page.order.primaryOrderDelivery is defined ? page.order.primaryOrderDelivery.shippingMethod.translated.name : null %}
                            {% else %}
                                {% set finishShippingName = page.order.deliveries.first is not empty ? page.order.deliveries.first.shippingMethod.translated.name : null %}
                            {% endif %}

                            {% if finishShippingName %}
                                <div class="finish-detail-item">
                                    <dt class="finish-detail-label">{{ 'checkout.finishInfoShippingShort'|trans|sw_sanitize }}</dt>
                                    <dd class="finish-detail-value">{{ finishShippingName }}</dd>
                                </div>
                            {% endif %}
                        {% endblock %}

                        {% block page_checkout_finish_info_grid_amount %}
                            <div class="finish-detail-item">
                                <dt class="finish-detail-label">{{ 'checkout.finishInfoAmount'|trans|sw_sanitize }}</dt>
                                <dd class="finish-detail-value finish-detail-amount">{{ page.order.price.totalPrice|currency(context.currency.isoCode) }}</dd>
                            </div>
                        {% endblock %}
                    </dl>
                {% endblock %}
            </div>
        </div>
    {% endblock %}

    {% block page_checkout_finish_order %}
        <div class="row finish-info">
            {% block page_checkout_finish_order_address %}
                <div class="col-md-8 finish-address">
                    {% sw_include '@Storefront/storefront/page/checkout/finish/finish-address.html.twig' %}
                </div>
            {% endblock %}

            {% block page_checkout_finish_order_details %}
                <div class="col-md-4 finish-order-details">
                    <div class="card checkout-card">
                        <div class="card-body">
                            {% block page_checkout_finish_order_title %}
                                <div class="card-title">
                                    {{ 'checkout.finishInfoHeader'|trans|sw_sanitize }}
                                </div>
                            {% endblock %}

                            {% block page_checkout_finish_order_payment_method %}
                                {% if feature('v6.8.0.0') %}
                                    <p>
                                        <strong>{{ 'checkout.finishInfoPayment'|trans|sw_sanitize }}</strong>
                                        {{ page.order.primaryOrderTransaction.paymentMethod.translated.name }}
                                    </p>
                                {% else %}
                                    <p>
                                        <strong>{{ 'checkout.finishInfoPayment'|trans|sw_sanitize }}</strong>
                                        {{ page.order.transactions.last.paymentMethod.translated.name }}
                                    </p>
                                {% endif %}
                            {% endblock %}

                            {% block page_checkout_finish_order_dispatch_method %}
                                {% if feature('v6.8.0.0') %}
                                    {% if page.order.primaryOrderDelivery is defined %}
                                        <p>
                                            <strong>{{ 'checkout.finishInfoShipping'|trans|sw_sanitize }}</strong>
                                            {{ page.order.primaryOrderDelivery.shippingMethod.translated.name }}
                                        </p>
                                    {% endif %}
                                {% else %}
                                    {% if page.order.deliveries.first.shippingMethod is defined %}
                                        <p>
                                            <strong>{{ 'checkout.finishInfoShipping'|trans|sw_sanitize }}</strong>
                                            {{ page.order.deliveries.first.shippingMethod.translated.name }}
                                        </p>
                                    {% endif %}
                                {% endif %}
                            {% endblock %}
                        </div>
                    </div>
                </div>
            {% endblock %}
        </div>
    {% endblock %}
{% endblock %}
