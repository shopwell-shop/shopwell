{% sw_extends '@Storefront/storefront/page/error/_page.html.twig' %}

{% block base_head %}
    {% sw_include '@Storefront/storefront/page/error/meta.html.twig' %}
{% endblock %}

{% block base_content %}
    <div class="content-main">
        {% block not_found_error_content %}
            <div class="container mt-5">
                <div class="error-page">
                    {% block not_found_error_code %}
                        <p class="error-page__code" aria-hidden="true">404</p>
                    {% endblock %}

                    {% block not_found_error_header %}
                        <h1 class="error-page__title">{{ 'general.404ErrorPageHeader'|trans|sw_sanitize }}</h1>
                    {% endblock %}

                    {% block not_found_error_description %}
                        <p class="error-page__text">{{ 'general.404ErrorDescription'|trans|sw_sanitize }}</p>
                    {% endblock %}

                    {% block not_found_error_return %}
                        <div class="error-page__actions">
                            <a href="{{ path('frontend.home.page') }}"
                               class="btn btn-primary justify-center">
                                {{ 'general.404ErrorReturn'|trans|sw_sanitize }}
                            </a>
                        </div>
                    {% endblock %}
                </div>
            </div>
        {% endblock %}
    </div>
{% endblock %}
