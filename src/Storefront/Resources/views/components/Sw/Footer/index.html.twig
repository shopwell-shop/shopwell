{% props
    footer,
    shopName = config('core.basicInformation.shopName'),
    contactPage = config('core.basicInformation.contactPage'),
    shippingPage = config('core.basicInformation.shippingPaymentInfoPage'),
    showVatNotice = true,
    taxState = context.taxState,
    slots = [],
%}

{% set attributeDefaults = { class: 'sw-footer' } %}

<div {{ attributes.defaults(attributeDefaults) }}>
    {% block newsletter %}
        <twig:Slot name="newsletter"></twig:Slot>
    {% endblock %}

    <div class="sw-footer__main container">
        {% block brand %}
            <div class="sw-footer__brand">
                <twig:Slot name="brand">
                    <a class="sw-footer__name" href="{{ path('frontend.home.page') }}">{{ shopName }}</a>
                    <p>{{ 'storefrontTheme.footerIntro'|trans }}</p>
                </twig:Slot>
            </div>
        {% endblock %}

        {% block navigation %}
            <twig:Slot name="navigation">
                <nav class="sw-footer__column" aria-labelledby="footer-account-title">
                    <h2 class="sw-footer__title" id="footer-account-title">{{ 'account.myAccount'|trans }}</h2>
                    <a href="{{ path('frontend.account.home.page') }}">{{ 'account.overviewLink'|trans }}</a>
                    <a href="{{ path('frontend.account.order.page') }}">{{ 'account.ordersLink'|trans }}</a>
                    <a href="{{ path('frontend.account.address.page') }}">{{ 'account.addressLink'|trans }}</a>
                    <a href="{{ path('frontend.wishlist.page') }}">{{ 'header.wishlist'|trans }}</a>
                </nav>
                {% for root in footer.navigation.tree %}
                    <nav class="sw-footer__column" aria-labelledby="footer-nav-{{ loop.index }}">
                        <h2 class="sw-footer__title" id="footer-nav-{{ loop.index }}">{% if root.category.type != 'folder' and root.category.seoUrl %}
                            <a href="{{ root.category.seoUrl }}"{% if root.category.shouldOpenInNewTab %} target="_blank" rel="noopener"{% endif %}>{{ root.category.translated.name }}</a>
                        {% else %}{{ root.category.translated.name }}{% endif %}</h2>
                        {% for item in root.children %}
                            {% if item.category.seoUrl %}
                                <a href="{{ item.category.seoUrl }}"{% if item.category.shouldOpenInNewTab %} target="_blank" rel="noopener"{% endif %}>{{ item.category.translated.name }}</a>
                            {% endif %}
                        {% endfor %}
                    </nav>
                {% endfor %}
                <nav class="sw-footer__column" aria-labelledby="footer-help-title">
                    <h2 class="sw-footer__title" id="footer-help-title">{{ 'storefrontTheme.help'|trans }}</h2>
                    <a href="{{ path('frontend.blog.index') }}">{{ 'storefrontTheme.inspiration'|trans }}</a>
                    {% if contactPage %}<a href="{{ path('frontend.content.page.full', { id: contactPage }) }}">{{ 'storefrontTheme.contact'|trans }}</a>{% endif %}
                    {% if shippingPage %}<a href="{{ path('frontend.content.page.full', { id: shippingPage }) }}">{{ 'storefrontTheme.shippingInfo'|trans }}</a>{% endif %}
                    <a href="{{ path('frontend.account.profile.page') }}">{{ 'account.profileLink'|trans }}</a>
                </nav>
            </twig:Slot>
        {% endblock %}
    </div>

    {% block legal %}
        <div class="sw-footer__bottom container">
            <twig:Slot name="legal">
                <nav class="sw-footer__legal" aria-label="{{ 'storefrontTheme.legal'|trans }}">
                    {% for item in footer.serviceMenu %}
                        <a href="{{ item.seoUrl }}"{% if item.shouldOpenInNewTab %} target="_blank" rel="noopener"{% endif %}>{{ item.translated.name }}</a>
                    {% endfor %}
                </nav>
                {% if showVatNotice %}
                    <p class="sw-footer__vat">{{ (taxState == 'gross' ? 'storefrontTheme.pricesIncludeTax' : 'storefrontTheme.pricesExcludeTax')|trans }}</p>
                {% endif %}
                <p class="sw-footer__copyright">{{ 'footer.copyrightInfo'|trans|sw_sanitize }}</p>
            </twig:Slot>
        </div>
    {% endblock %}
</div>
