{# ludtwig-ignore-file #}
{# @sw-package framework #}
{# @internal #}

{% props
    review,
    maxPoints = 5,
%}

{% set attributeDefaults = {
    class: 'sw-product-reviews__item',
} %}

<article {{ attributes.defaults(attributeDefaults) }}{% if not feature('JSON_LD_DATA') %} itemprop="review" itemscope itemtype="https://schema.org/Review"{% endif %}>
    {% if not feature('JSON_LD_DATA') %}
        <meta itemprop="datePublished" content="{{ review.createdAt|date('c') }}">
        <meta itemprop="name" content="{{ review.title }}">
        {% if review.language %}
            <meta itemprop="inLanguage" content="{{ review.language.translationCode.code }}">
        {% endif %}
        {% if review.externalUser %}
            <div itemprop="author" itemscope itemtype="https://schema.org/Person">
                <meta itemprop="name" content="{{ review.externalUser }}">
            </div>
        {% endif %}
        <div itemprop="reviewRating" itemscope itemtype="https://schema.org/Rating">
            <meta itemprop="ratingValue" content="{{ review.points }}">
            <meta itemprop="bestRating" content="{{ maxPoints }}">
        </div>
    {% endif %}
    {% block info %}
        <div class="sw-product-reviews__item-info">
            <p class="sw-product-reviews__item-date">
                <small>{{ review.createdAt|format_date('long') }} {{ review.createdAt|format_time('short') }}</small>
            </p>

            <div class="sw-product-reviews__item-points">
                <twig:Sw:Rating:Stars
                    :stars="review.points"
                    :maxStars="maxPoints"
                    :allowHalf="true"
                    altText="{{ 'detail.reviewRatingAltText'|trans({ '%points%': review.points, '%maxPoints%': maxPoints }) }}"
                />
            </div>

            <h5 class="sw-product-reviews__item-title"{% if review.language %} lang="{{ review.language.translationCode.code }}"{% endif %}>
                {{ review.title }}
            </h5>
        </div>
    {% endblock %}

    {% block content %}
        <p class="sw-product-reviews__item-content"{% if not feature('JSON_LD_DATA') %} itemprop="description"{% endif %}{% if review.language %} lang="{{ review.language.translationCode.code }}"{% endif %}>
            {{ review.content|nl2br }}
        </p>
    {% endblock %}

    {% block comment %}
        {% if review.comment %}
            <div class="sw-product-reviews__item-comment">
                <blockquote class="blockquote">
                    <footer class="blockquote-footer">
                        {{ 'detail.reviewCommentLabel'|trans|sw_sanitize }}{{ review.comment }}
                    </footer>
                </blockquote>
            </div>
        {% endif %}
    {% endblock %}
</article>
