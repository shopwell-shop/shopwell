{# ludtwig-ignore-file #}
{# @sw-package framework #}
{# @internal #}

{% props
    product = null,
    extraFormData = {},
    jsOptions = {},
%}

{% set buyButtonCVA = cva({
    base: 'sw-buy-widget d-grid',
    variants: {
        buyable: {
            true: 'is--buyable',
        },
    },
}) %}

{% if product is not null %}
    {% set buyable = product.available and product.childCount <= 0 and product.calculatedMaxPurchase > 0 %}

    {% if not buyable %}
        {% set attributeDefaults = {
            class: buyButtonCVA.apply({ buyable: false }),
        } %}

        <div {{ attributes.defaults(attributeDefaults) }}>
            {% block fallback %}
                <p {{ attributes.nested('sold-out').defaults({ class: 'sw-buy-widget__sold-out mb-0' }) }}>
                    <twig:Sw:Badge
                        variant="danger"
                        :dot="true"
                        {{ ...attributes.nested('sold-out-indicator').defaults({
                            class: 'sw-buy-widget__sold-out-indicator me-1',
                            'aria-hidden': 'true',
                        }) }}
                    />
                    {{ 'detail.soldOut'|trans|sw_sanitize }}
                </p>
            {% endblock %}
        </div>
    {% else %}
        {% set attributeDefaults = {
            class: buyButtonCVA.apply({ buyable: true }),
            method: 'post',
            action: path('frontend.checkout.line-item.add'),
            id: "product-buy-form-#{product.id}",
            'data-component': 'Sw:Product:BuyButton',
            'data-component-options': jsOptions|json_encode,
        } %}

        {% set formData = {
            redirectTo: 'frontend.detail.page',
            redirectParameters: { productId: product.id }|json_encode,
            ("lineItems[#{product.id}][id]"): product.id,
            ("lineItems[#{product.id}][referencedId]"): product.id,
            ("lineItems[#{product.id}][type]"): 'product',
            ("lineItems[#{product.id}][stackable]"): '1',
            ("lineItems[#{product.id}][removable]"): '1',
            ("lineItems[#{product.id}][product-name]"): product.translated.name,
            ("lineItems[#{product.id}][payload][manufacturerName]"): product.manufacturer ? product.manufacturer.name : '',
            'product-name': product.translated.name,
            'brand-name': product.manufacturer ? product.manufacturer.name : '',
        } %}

        {% set seoCategory = product.seoCategory %}
        {% if seoCategory is null %}
            {% set mainCategories = product.mainCategories|default([])|filter(mainCategory => mainCategory.salesChannelId == context.salesChannelId) %}
            {% set mainCategory = mainCategories|first %}
            {% set seoCategory = mainCategory ? mainCategory.category : null %}
        {% endif %}
        {% set categoryNames = seoCategory ? seoCategory.plainBreadcrumb : {} %}
        {% set trimmed = false %}
        {% for entryPoint in [context.salesChannel.navigationCategoryId, context.salesChannel.serviceCategoryId, context.salesChannel.footerCategoryId] %}
            {% if not trimmed and entryPoint and entryPoint in categoryNames|keys %}
                {% for categoryId in categoryNames|keys %}
                    {% if categoryId == entryPoint %}
                        {% set categoryNames = categoryNames|slice(loop.index) %}
                    {% endif %}
                {% endfor %}
                {% set trimmed = true %}
            {% endif %}
        {% endfor %}
        {% for categoryId, categoryName in categoryNames|slice(0, 5) %}
            {% set formData = formData|merge({
                ("lineItems[#{product.id}][payload][categoryNames][#{categoryId}]"): categoryName,
            }) %}
        {% endfor %}

        {% if extraFormData %}
            {% set formData = formData|merge(extraFormData) %}
        {% endif %}

        <form {{ attributes.defaults(attributeDefaults) }}>
            {% block form_data_inputs %}
                {% for name, value in formData %}
                    <input
                        type="hidden"
                        name="{{ name }}"
                        value="{{ value }}"
                        {% if name == 'redirectParameters' %}
                            data-redirect-parameters="true"
                        {% endif %}
                        >
                {% endfor %}

                {% if product.minPurchase > 1 and formData["lineItems[#{product.id}][quantity]"] is not defined %}
                    <input
                        type="hidden"
                        name="lineItems[{{ product.id }}][quantity]"
                        value="{{ product.minPurchase }}"
                        data-quantity-fallback="true"
                        >
                {% endif %}
            {% endblock %}

            {% block buy_button %}
                <twig:Slot name="buy-button">
                    <twig:Sw:Button variant="buy" type="submit">
                        {{ 'listing.boxAddProduct'|trans|sw_sanitize }}
                    </twig:Sw:Button>
                </twig:Slot>
            {% endblock %}
        </form>
    {% endif %}
{% endif %}
