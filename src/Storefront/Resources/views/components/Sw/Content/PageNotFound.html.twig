{# @sw-package discovery #}
{# @internal #}

{% props title = '' %}

{% set heading = title ?: 'general.404ErrorPageHeader'|trans %}

<div {{ attributes.defaults({ class: 'sw-page-not-found container mt-5' }) }}>
    <img src="{{ asset('assets/illustration/404_error.svg', 'theme') }}"
         alt="{{ heading|striptags }}"
         class="rounded mx-auto d-block w-75">

    <h1 class="mt-5 text-center">{{ heading|sw_sanitize }}</h1>
    <p class="text-center w-60-l">{{ 'general.404ErrorDescription'|trans|sw_sanitize }}</p>

    <div class="text-center">
        <a href="{{ path('frontend.home.page') }}"
           class="btn btn-primary justify-center">
            {{ 'general.404ErrorReturn'|trans|sw_sanitize }}
        </a>
    </div>
</div>
