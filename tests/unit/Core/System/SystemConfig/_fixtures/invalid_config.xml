<?xml version="1.0" encoding="UTF-8" ?>
<config>

    <card>
        <sw-field>
            <name>email</name>
            <label>eMail</label>
            <label lang="zh_CN">电子邮箱</label>
            <placeholder>Enter your eMail address</placeholder>
            <placeholder lang="zh_CN">请输入你的邮箱地址</placeholder>
            <copyable>true</copyable>
        </sw-field>

        <sw-field type="single-select">
            <name>mailMethod</name>
            <label>Mailing protocol</label>
            <label lang="zh_CN">邮件发送协议</label>
            <placeholder>Choose your preferred transfer method</placeholder>
            <placeholder lang="zh_CN">请选择你偏好的发送协议</placeholder>
            <options>
                <option>
                    <id>smtp</id>
                    <name>SMTP</name>
                </option>
                <option>
                    <id>pop3</id>
                    <name>POP3</name>
                </option>
            </options>
        </sw-field>
    </card>

</config>
