<?xml version="1.0" encoding="UTF-8" ?>
<config>

    <card>
        <title>Basic configuration</title>
        <title lang="zh-CN">基础设置</title>
        <subtitle>Basic configuration subtitle</subtitle>
        <subtitle lang="zh-CN">基础配置副标题</subtitle>
        <input-field>
            <name>email</name>
            <copyable>true</copyable>
            <label>eMail</label>
            <label lang="zh-CN">电子邮箱</label>
            <placeholder>Enter your eMail address</placeholder>
            <placeholder lang="zh-CN">请输入你的邮箱地址</placeholder>
            <defaultValue>42</defaultValue>
        </input-field>

        <input-field>
            <name>stringWithQuoteDefaultValueRemovesQuotes</name>
            <defaultValue>"42"</defaultValue>
        </input-field>

        <input-field>
            <name>nullDefault</name>
            <defaultValue>null</defaultValue>
        </input-field>

        <input-field type="int">
            <name>int</name>
            <defaultValue>42</defaultValue>
        </input-field>

        <input-field type="float">
            <name>float</name>
            <defaultValue>42</defaultValue>
        </input-field>

        <input-field type="float">
            <name>floatWithStringValueExpectsValueIsCastedToFloat</name>
            <defaultValue>"42.5"</defaultValue>
        </input-field>

        <input-field type="bool" cache-relevant="true">
            <name>bool</name>
            <defaultValue>true</defaultValue>
        </input-field>

        <input-field type="single-select">
            <name>mailMethod</name>
            <options>
                <option>
                    <id>smtp</id>
                    <name>SMTP</name>
                </option>
                <option>
                    <id>pop3</id>
                    <name>POP3</name>
                </option>
            </options>
            <label>Mailing protocol</label>
            <label lang="zh-CN">邮件发送协议</label>
            <placeholder>Choose your preferred transfer method</placeholder>
            <placeholder lang="zh-CN">请选择你偏好的发送协议</placeholder>
            <defaultValue>smtp</defaultValue>
        </input-field>

        <input-field type="single-select">
            <name>period</name>
            <options>
                <option>
                    <id>30</id>
                    <name>1 Month</name>
                </option>
                <option>
                    <id>60</id>
                    <name>2 Months</name>
                </option>
            </options>
            <defaultValue>30</defaultValue>
        </input-field>

        <component name="sw-select" cache-relevant="true">
            <name>mailMethodComponent</name>
            <disabled>true</disabled>
            <options>
                <option>
                    <id>smtp</id>
                    <name>English smtp</name>
                    <name lang="zh-CN">中文 smtp</name>
                </option>
                <option>
                    <id>pop3</id>
                    <name>English pop3</name>
                    <name lang="zh-CN">中文 pop3</name>
                </option>
            </options>
            <defaultValue>pop3</defaultValue>
        </component>
    </card>
</config>
