<?xml version="1.0" encoding="UTF-8"?>
<manifest xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/shopwell-shop/shopwell/trunk/src/Core/Framework/App/Manifest/Schema/manifest-3.0.xsd">
    <meta>
        <name>test</name>
        <label>Swag App Test</label>
        <label lang="zh-CN">Swag 应用测试</label>
        <description>Test for App System</description>
        <description lang="zh-CN">应用系统测试</description>
        <author>Shopwell</author>
        <copyright>(c) by Shopwell</copyright>
        <version>1.0.0</version>
        <icon>icon.png</icon>
        <license>MIT</license>
        <privacy>https://test.com/privacy</privacy>
        <privacyPolicyExtensions>
            Following personal information will be processed on Shopwell's servers:

            - Name
            - Billing address
            - Order value
        </privacyPolicyExtensions>
        <privacyPolicyExtensions lang="zh-CN">
            以下用户数据将在 Shopwell 的服务器上处理：

            - Name
            - 账单地址
            - 订单金额
        </privacyPolicyExtensions>
    </meta>
    <setup>
        <registrationUrl>https://my.app.com/test/registration</registrationUrl>
        <secret>s3cr3t</secret>
    </setup>
    <admin>
        <action-button
            action="viewOrder"
            entity="order"
            view="detail"
            url="https://swag-test.com/your-order">
            <label>View Order</label>
            <label lang="zh-CN">查看订单</label>
        </action-button>
        <action-button
            action="doStuffWithProducts"
            entity="product"
            view="list"
            url="https://swag-test.com/do-stuff">
            <label>Do Stuff</label>
            <label lang="zh-CN">执行操作</label>
        </action-button>
        <module name="first-module" source="https://test.com" parent="sw-test-structure-module" position="10">
            <label>My first own module</label>
            <label lang="zh-CN">我的第一个模块</label>
        </module>
        <module name="structure-module" parent="sw-catalogue" position="50">
            <label>My menu entry for modules</label>
            <label lang="zh-CN">我的模块菜单项</label>
        </module>
        <main-module source="https://main-module"/>
        <base-app-url>https://base-url.com</base-app-url>
    </admin>
    <permissions>
        <create>product</create>
        <update>product</update>
        <delete>product</delete>
        <delete>category</delete>
        <create>product_manufacturer</create>
        <delete>product_manufacturer</delete>
        <create>tax</create>
        <read>language</read>
        <update>custom_field_set</update>
        <read>order</read>
        <permission>user_change_me</permission>
    </permissions>
    <storefront>
        <template-load-priority>100</template-load-priority>
    </storefront>
    <custom-fields>
        <custom-field-set global="true">
            <name>custom_field_test</name>
            <label>Custom field test</label>
            <label lang="zh-CN">自定义字段测试</label>
            <related-entities>
                <product/>
                <customer/>
            </related-entities>
            <fields>
                <bool name="bla_test">
                    <label>Test</label>
                </bool>
                <bool name="bla_test2">
                    <label>Test</label>
                    <allow-customer-write>true</allow-customer-write>
                    <allow-cart-expose>true</allow-cart-expose>
                </bool>
            </fields>
        </custom-field-set>
    </custom-fields>
    <webhooks>
        <webhook name="hook1" url="https://test.com/hook" event="checkout.customer.before.login"/>
        <webhook name="hook2" url="https://test.com/hook2" event="checkout.order.placed"/>
    </webhooks>
    <cookies>
        <cookie>
            <snippet-name>Swoogle Analytics</snippet-name>
            <cookie>swag.analytics</cookie>
            <value></value>
            <expiration>30</expiration>
        </cookie>
        <group>
            <snippet-name>App Cookies</snippet-name>
            <snippet-description>Cookies required for this app to work</snippet-description>
            <entries>
                <cookie>
                    <snippet-name>Something</snippet-name>
                    <cookie>swag.app.something</cookie>
                </cookie>
                <cookie>
                    <snippet-name>Lorem ipsum</snippet-name>
                    <cookie>swag.app.lorem-ipsum</cookie>
                </cookie>
            </entries>
        </group>
    </cookies>
    <payments>
        <payment-method>
            <identifier>myMethod</identifier>
            <name>The app payment method</name>
            <name lang="zh-CN">应用支付方式</name>
            <description>This is a description</description>
            <description lang="zh-CN">支付方式说明</description>
            <pay-url>https://payment.app/payment/process</pay-url>
            <finalize-url>https://payment.app/payment/finalize</finalize-url>
            <validate-url>https://payment.app/payment/validate</validate-url>
            <refund-url>https://payment.app/payment/refund</refund-url>
            <recurring-url>https://payment.app/payment/recurring</recurring-url>
            <icon>Resources/payment.png</icon>
        </payment-method>
        <payment-method>
            <identifier>anotherMethod</identifier>
            <name>Another app payment method</name>
            <description>This is another description</description>
        </payment-method>
    </payments>
    <rule-conditions>
        <rule-condition>
            <identifier>myCustomCondition</identifier>
            <name>My custom rule condition</name>
            <group>customer</group>
            <script>customer-group-rule-script.twig</script>
            <constraints>
                <single-select name="operator">
                    <label>Operator</label>
                    <placeholder>Choose an operator...</placeholder>
                    <options>
                        <option value="=">
                            <name>Is equal to</name>
                        </option>
                        <option value="!=">
                            <name>Is not equal to</name>
                        </option>
                    </options>
                    <required>true</required>
                </single-select>
                <multi-entity-select name="customerGroupIds">
                    <label>Customer groups</label>
                    <placeholder>Choose customer groups...</placeholder>
                    <entity>customer_group</entity>
                    <required>true</required>
                </multi-entity-select>
            </constraints>
        </rule-condition>
    </rule-conditions>
</manifest>
