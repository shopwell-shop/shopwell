<flow-extensions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://gitlab.shopwell.cn/shopwell/6/product/platform/-/raw/7a0708804d0669cb63cc5f677b034bedec43e64e/src/Core/Framework/App/Flow/Schema/flow-1.0.xsd">
    <flow-events>
        <flow-event>
            <name>swag.before.open_the_doors</name>
            <aware>customerAware</aware>
        </flow-event>
    </flow-events>
    <flow-actions>
        <flow-action>
            <meta>
                <name>abc.cde.ccc</name>
                <badge>abc</badge>
                <label>First action app</label>
                <label lang="zh-CN">第一个动作应用</label>
                <headline>Headline for action</headline>
                <headline lang="zh-CN">动作标题</headline>
                <description>First action app description</description>
                <description lang="zh-CN">第一个动作应用说明</description>
                <url>https://example.xyz</url>
                <icon>resource/pencil</icon>
                <sw-icon>sw-pencil</sw-icon>
                <requirements>order</requirements>
                <requirements>customer</requirements>
                <delayable>true</delayable>
            </meta>
            <headers>
                <parameter type="string" name="content-type" value="application/json"/>
                <parameter type="string" name="auth-token" value="token string"/>
            </headers>
            <parameters>
                <parameter type="string" name="to" value="{{ customer.name }}"/>
                <parameter type="string" name="from" value="{{ admin.name }}"/>
                <parameter type="string" name="message" value="string message"/>
            </parameters>
            <config>
                <input-field>
                    <name>textField</name>
                    <label>To</label>
                    <label lang="zh-CN">收件人</label>
                    <place-holder>Enter to...</place-holder>
                    <place-holder lang="zh-CN">输入收件人...</place-holder>
                    <helpText>Help text</helpText>
                    <helpText lang="zh-CN">帮助文本</helpText>
                    <required>true</required>
                    <defaultValue>Shopwell 6</defaultValue>
                </input-field>
                <input-field>
                    <name>textField</name>
                    <label>From</label>
                    <label lang="zh-CN">发件人</label>
                    <place-holder>Enter from...</place-holder>
                    <place-holder lang="zh-CN">输入发件人...</place-holder>
                    <required>true</required>
                    <defaultValue>Shopwell 6</defaultValue>
                </input-field>
                <input-field type="text">
                    <name>textField</name>
                    <label>Message</label>
                    <label lang="zh-CN">消息</label>
                    <place-holder>Enter message...</place-holder>
                    <place-holder lang="zh-CN">输入消息...</place-holder>
                    <required>true</required>
                    <defaultValue>Hello</defaultValue>
                </input-field>
                <input-field type="single-select">
                    <name>mailMethod</name>
                    <options>
                        <option value="smtp">
                            <label>English label</label>
                            <label lang="zh-CN">中文标签</label>
                        </option>
                        <option value="pop3">
                            <label>English label</label>
                            <label lang="zh-CN">中文标签</label>
                        </option>
                    </options>
                </input-field>
            </config>
        </flow-action>
    </flow-actions>
</flow-extensions>
