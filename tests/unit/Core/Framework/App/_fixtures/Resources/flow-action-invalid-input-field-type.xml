<?xml version="1.0" encoding="utf-8" ?>
<flow-extensions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://gitlab.shopwell.cn/shopwell/6/product/platform/-/raw/7a0708804d0669cb63cc5f677b034bedec43e64e/src/Core/Framework/App/Flow/Schema/flow-1.0.xsd">
    <flow-actions>
        <flow-action>
            <meta>
                <name>abc.cde.ccc</name>
                <label>First action app</label>
                <label lang="zh-CN">第一个动作应用</label>
                <description>First action app description</description>
                <description lang="zh-CN">第一个动作应用说明</description>
                <url>https://example.xyz</url>
            </meta>
            <headers>
                <parameter type="string" name="content-type" value="application/json"/>
                <parameter type="string" name="auth-token" value="token string"/>
            </headers>
            <parameters>
                <parameter type="string" name="to" value="{{ customer.name }}"/>
                <parameter type="string" name="from" value="{{ admin.name }}"/>
                <parameter type="string" name="message" value="string message"/>
            </parameters>
            <config>
                <input-field type="shopwell">
                    <name>shopwell</name>
                    <label>To</label>
                    <label lang="zh-CN">收件人</label>
                    <place-holder>Enter to...</place-holder>
                    <place-holder lang="zh-CN">输入收件人...</place-holder>
                    <required>true</required>
                    <editable>false</editable>
                    <defaultValue>Shopwell 6</defaultValue>
                </input-field>
            </config>
        </flow-action>
    </flow-actions>
</flow-extensions>
