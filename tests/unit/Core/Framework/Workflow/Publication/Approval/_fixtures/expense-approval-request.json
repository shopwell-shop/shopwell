{
    "schemaVersion": 1,
    "policy": "core:structured",
    "nodes": [
        {
            "id": "start",
            "type": "core:start",
            "typeVersion": 1,
            "config": {
                "inputType": "core:approval-request",
                "formFields": [
                    {
                        "key": "reason",
                        "label": "Reason",
                        "type": "text",
                        "required": true
                    },
                    {
                        "key": "amount",
                        "label": "Amount",
                        "type": "amount",
                        "required": true
                    },
                    {
                        "key": "expenseDate",
                        "label": "Date",
                        "type": "date",
                        "required": true
                    },
                    {
                        "key": "category",
                        "label": "Category",
                        "type": "select",
                        "required": true,
                        "options": [
                            {
                                "value": "travel",
                                "label": "Travel"
                            },
                            {
                                "value": "office",
                                "label": "Office"
                            }
                        ]
                    },
                    {
                        "key": "quantity",
                        "label": "Quantity",
                        "type": "number"
                    }
                ]
            }
        },
        {
            "id": "department",
            "type": "core:approval",
            "typeVersion": 1,
            "config": {
                "label": "department",
                "assignee": {
                    "source": "core:user",
                    "config": {
                        "userId": "0123456789abcdef0123456789abcdef"
                    }
                },
                "approval": {
                    "mode": "core:single",
                    "config": {}
                }
            }
        },
        {
            "id": "threshold",
            "type": "core:condition",
            "typeVersion": 1,
            "config": {
                "branches": [
                    {
                        "id": "branch-high",
                        "label": "Over 5000",
                        "field": "request.amount",
                        "fieldType": "amount",
                        "operator": "greaterThan",
                        "value": "5000"
                    }
                ]
            }
        },
        {
            "id": "finance",
            "type": "core:approval",
            "typeVersion": 1,
            "config": {
                "label": "finance",
                "assignee": {
                    "source": "core:user",
                    "config": {
                        "userId": "abcdef0123456789abcdef0123456789"
                    }
                },
                "approval": {
                    "mode": "core:single",
                    "config": {}
                }
            }
        },
        {
            "id": "default-end",
            "type": "core:end",
            "typeVersion": 1,
            "config": {}
        },
        {
            "id": "finance-end",
            "type": "core:end",
            "typeVersion": 1,
            "config": {}
        },
        {
            "id": "department-reject",
            "type": "core:end",
            "typeVersion": 1,
            "config": {}
        },
        {
            "id": "finance-reject",
            "type": "core:end",
            "typeVersion": 1,
            "config": {}
        }
    ],
    "connections": [
        {
            "id": "begin",
            "source": "start",
            "sourcePort": "out",
            "target": "department",
            "targetPort": "in"
        },
        {
            "id": "department-approved",
            "source": "department",
            "sourcePort": "approved",
            "target": "threshold",
            "targetPort": "in"
        },
        {
            "id": "department-rejected",
            "source": "department",
            "sourcePort": "rejected",
            "target": "department-reject",
            "targetPort": "in"
        },
        {
            "id": "high",
            "source": "threshold",
            "sourcePort": "branch-high",
            "target": "finance",
            "targetPort": "in"
        },
        {
            "id": "default",
            "source": "threshold",
            "sourcePort": "fallback",
            "target": "default-end",
            "targetPort": "in"
        },
        {
            "id": "finance-approved",
            "source": "finance",
            "sourcePort": "approved",
            "target": "finance-end",
            "targetPort": "in"
        },
        {
            "id": "finance-rejected",
            "source": "finance",
            "sourcePort": "rejected",
            "target": "finance-reject",
            "targetPort": "in"
        }
    ]
