<?xml version="1.0" encoding="UTF-8"?>
<manifest xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/shopwell-shop/shopwell/trunk/src/Core/Framework/App/Manifest/Schema/manifest-3.0.xsd">
    <meta>
        <name>SwagManufacturerLeak</name>
        <label>Swag Manufacturer Leak</label>
        <description>Declares an entity SEO URL whose template reads an association it may not read</description>
        <author>Shopwell</author>
        <copyright>(c) by Shopwell</copyright>
        <version>1.0.0</version>
        <license>MIT</license>
    </meta>
    <storefront>
        <entity-seo-url name="manufacturer-product" entity="product">
            <default-template>product/{{ product.manufacturer.name }}</default-template>
        </entity-seo-url>
    </storefront>
    <permissions>
        <read>product</read>
    </permissions>
</manifest>
