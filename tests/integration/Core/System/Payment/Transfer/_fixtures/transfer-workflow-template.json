{
    "schemaVersion": 1,
    "policy": "core:structured",
    "nodes": [
        {
            "id": "start",
            "type": "core:start",
            "typeVersion": 1,
            "config": {
                "inputType": "core:approval-request",
                "requestAction": "payment:transfer",
                "formFields": [
                    {
                        "key": "amount",
                        "label": "Amount",
                        "type": "number",
                        "required": true
                    },
                    {
                        "key": "currency",
                        "label": "Currency",
                        "type": "text",
                        "required": true,
                        "dataSource": "core:currency"
                    },
                    {
                        "key": "recipient",
                        "label": "Recipient",
                        "type": "text",
                        "required": true
                    },
                    {
                        "key": "paymentAccount",
                        "label": "Payment account",
                        "type": "text",
                        "required": true
                    },
                    {
                        "key": "reason",
                        "label": "Note",
                        "type": "text",
                        "required": false
                    }
                ]
            }
        },
        {
            "id": "department",
            "type": "core:approval",
            "typeVersion": 1,
            "config": {
                "label": "Department position review",
                "assignee": {
                    "source": "core:positions",
                    "config": {
                        "positionIds": []
                    }
                },
                "approval": {
                    "mode": "core:all",
                    "config": {}
                }
            }
        },
        {
            "id": "review-policy",
            "type": "core:condition",
            "typeVersion": 1,
            "config": {
                "branches": [
                    {
                        "id": "branch-review",
                        "label": "Non-CNY or CNY over 5000",
                        "operator": "or",
                        "conditions": [
                            {
                                "field": "request.currency",
                                "fieldType": "text",
                                "operator": "notEquals",
                                "value": "CNY"
                            },
                            {
                                "operator": "and",
                                "conditions": [
                                    {
                                        "field": "request.currency",
                                        "fieldType": "text",
                                        "operator": "equals",
                                        "value": "CNY"
                                    },
                                    {
                                        "field": "request.amount",
                                        "fieldType": "number",
                                        "operator": "greaterThan",
                                        "value": "5000"
                                    }
                                ]
                            }
                        ]
                    }
                ]
            }
        },
        {
            "id": "finance",
            "type": "core:approval",
            "typeVersion": 1,
            "config": {
                "label": "Finance review",
                "assignee": {
                    "source": "core:user",
                    "config": {
                        "userId": null
                    }
                },
                "approval": {
                    "mode": "core:single",
                    "config": {}
                }
            }
        },
        {
            "id": "copy-reviewed",
            "type": "core:copy",
            "typeVersion": 1,
            "config": {
                "label": "Notify recipients",
                "userIds": []
            }
        },
        {
            "id": "copy-standard",
            "type": "core:copy",
            "typeVersion": 1,
            "config": {
                "label": "Notify recipients",
                "userIds": []
            }
        },
        {
            "id": "department-rejected",
            "type": "core:end",
            "typeVersion": 1,
            "config": {}
        },
        {
            "id": "finance-rejected",
            "type": "core:end",
            "typeVersion": 1,
            "config": {}
        },
        {
            "id": "reviewed-approved",
            "type": "core:end",
            "typeVersion": 1,
            "config": {}
        },
        {
            "id": "standard-approved",
            "type": "core:end",
            "typeVersion": 1,
            "config": {}
        }
    ],
    "connections": [
        {
            "id": "start-out-department",
            "source": "start",
            "sourcePort": "out",
            "target": "department",
            "targetPort": "in"
        },
        {
            "id": "department-approved-review-policy",
            "source": "department",
            "sourcePort": "approved",
            "target": "review-policy",
            "targetPort": "in"
        },
        {
            "id": "department-rejected-department-rejected",
            "source": "department",
            "sourcePort": "rejected",
            "target": "department-rejected",
            "targetPort": "in"
        },
        {
            "id": "review-policy-branch-review-finance",
            "source": "review-policy",
            "sourcePort": "branch-review",
            "target": "finance",
            "targetPort": "in"
        },
        {
            "id": "review-policy-fallback-copy-standard",
            "source": "review-policy",
            "sourcePort": "fallback",
            "target": "copy-standard",
            "targetPort": "in"
        },
        {
            "id": "finance-approved-copy-reviewed",
            "source": "finance",
            "sourcePort": "approved",
            "target": "copy-reviewed",
            "targetPort": "in"
        },
        {
            "id": "finance-rejected-finance-rejected",
            "source": "finance",
            "sourcePort": "rejected",
            "target": "finance-rejected",
            "targetPort": "in"
        },
        {
            "id": "copy-reviewed-out-reviewed-approved",
            "source": "copy-reviewed",
            "sourcePort": "out",
            "target": "reviewed-approved",
            "targetPort": "in"
        },
        {
            "id": "copy-standard-out-standard-approved",
            "source": "copy-standard",
            "sourcePort": "out",
            "target": "standard-approved",
            "targetPort": "in"
        }
    ]
}
